module zkc::multilinear;
use zkc::vector::{Vector, split, elements, length};
use zkc::indices::{less, divide, remainder};

// A prefix/value obligation. Sumcheck binds a polynomial and interprets value
// as the sum over the remaining Boolean variables. A full point leaves no sum.
// This record carries no polynomial identity or proof certificate.
pub struct Evaluation<F: Field> {
  pub point: Vector<F>,
  pub value: F
}

// Row-major factor evaluations. Rows enumerate Boolean assignments MSB-first;
// each row contains columns independent factors, not their pointwise product.
pub struct Table<F: Field> {
  entries: Vector<F>,
  dimensions: index,
  columns: index
}

fn rows(dimensions: index) -> index {
  require less(dimensions, 64);
  let mut count: index = 1;
  for _ in 0..dimensions { count = count * 2; }
  return count;
}

pub fn has_shape<F: Field>(entries: Vector<F>, dimensions: index, columns: index) -> bool {
  return less(0, columns) && less(dimensions, 64)
    && remainder(length(entries), columns) == 0
    && divide(length(entries), columns) == rows(dimensions);
}

pub fn table<F: Field>(entries: Vector<F>, dimensions: index, columns: index) -> Table<F> {
  require has_shape(entries, dimensions, columns);
  return Table<F> { entries: entries, dimensions: dimensions, columns: columns };
}

pub math fn values<F: Field>(input: Table<F>) -> Vector<F> { return input.entries; }
pub math fn variables<F: Field>(input: Table<F>) -> index { return input.dimensions; }
pub math fn width<F: Field>(input: Table<F>) -> index { return input.columns; }

pub fn halves<F: Field>(input: Table<F>) -> (Vector<F>, Vector<F>) {
  require less(0, input.dimensions);
  return split(input.entries);
}

math fn interpolate<F: Field>(low: F, high: F, r: F) -> F {
  return low + (high - low) * r;
}

// Fix the leading Boolean coordinate of every factor.
pub fn fix_first<F: Field>(input: Table<F>, challenge: F) -> Table<F> {
  let parts = halves(input);
  let entries = map interpolate(each parts.0, each parts.1, challenge);
  return Table<F> { entries: entries, dimensions: input.dimensions - 1, columns: input.columns };
}

pub fn fix_prefix<F: Field>(input: Table<F>, point: Vector<F>) -> Table<F> {
  return zkc::finite::fold(elements(point), input, fn(current, r) => fix_first(current, r));
}
