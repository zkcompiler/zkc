module zkc::curve;

// Total mathematical zero; the native realization retains allocation limits.
pub math fn identity<G: Group>() -> G where zkc::curve::ScalarAction(G)
  = primitive("curve.identity");

pub type Groups<G: Group> = builtin("groups", G);
pub domain fn elements<G: Group>(values: Groups<G>) -> domain<G> = domain("elements");
pub domain fn indices<G: Group>(values: Groups<G>) -> domain<index> = domain("indices");
pub math fn at<G: Group>(values: Groups<G>, position: index) -> G where in_bounds(position, values)
  = primitive("container.at");
pub fn collect<I: Type + Copy + Drop, G: Group>(
  rows: domain<I>, body: fn(I) -> G effects(stop) on(rows)
) -> Groups<G> effects(stop) = finite("local.collect.groups");

// Bounds follow the selected total accessor; checked access can be rebound locally.
pub indexing values[position] = at(values, position);
