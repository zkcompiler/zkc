module zkc::sampling;

// Uniformity requires independent uniform 64-bit words from this provider.
// The compiler checks signatures and execution, not that probabilistic premise.
pub interface Words {
  type State;
  fn next(state: State) -> (State, index) effects(stop, opaque);
}

// Reject the short prefix so each residue has equally many accepted preimages.
// This is threshold rejection as described in PCG's bounded-rands article:
// https://www.pcg-random.org/posts/bounded-rands.html
// Exhaustion is explicit; it never substitutes a biased fallback sample.
pub fn uniform_index<W: Words, Attempts: nat>(initial: W::State, bound: index)
    -> (W::State, index) {
  require !(bound == 0);
  // Computing 2^64 mod bound this way never overflows the u64 index carrier.
  let threshold = kernel("index.mod", kernel("index.mod", 18446744073709551615, bound) + 1, bound);
  let mut state = initial;
  let mut chosen: index = 0;
  let mut found = false;
  for _ in 0..index<Attempts>() {
    let next = if found {
      (state, chosen, true)
    } else {
      let (next, word) = W::next(state);
      let accepted = !kernel("index.less", word, threshold);
      (next, kernel("index.mod", word, bound), accepted)
    };
    state = next.0;
    chosen = next.1;
    found = next.2;
  }
  return if found { (state, chosen) } else { stop "exhausted"; };
}

fn pending(found: bool) -> index { return if found { 0 } else { 1 }; }

// A bounded rejection sampler over an explicit managed field service. Repeated
// draws retain the same service root; no fallback changes the distribution.
// Independent uniform field draws give a uniform nonzero result conditional on
// success. Exhaustion stops; the compiler does not prove the provider premise.
pub protocol Nonzero<F: Field, Attempts: nat> roles(P)
    (randomness: Random<F> @P) -> (value: F @P) {
  let mut chosen: F @P = 0;
  let mut found @P = false;
  for _ in 0..index<Attempts>() roles(P) max Attempts {
    let needed @P = pending(found);
    for _ in 0..needed roles(P) max 1 {
      let candidate = randomness.draw();
      chosen = candidate;
      found = !(candidate == 0);
    }
  }
  require found;
  return (value = chosen);
}
