module zkc::finite;
use zkc::sequence::{Sequence};
use zkc::accumulation::{Combiner, FieldSum, FieldProduct, GroupSum};

pub fn fold<I: Type + Copy + Drop, S: Type>(
  rows: domain<I>, initial: S,
  step: fn(S, I) -> S effects(stop) on(rows)
) -> S effects(stop) = finite("local.fold");

pub fn fold_where<I: Type + Copy + Drop, S: Type>(
  rows: domain<I>, initial: S,
  keep: fn(I) -> bool effects(stop) on(rows),
  step: fn(S, I) -> S effects(stop) on(rows)
) -> S effects(stop) = finite("local.fold_where");

pub fn collect<I: Type + Copy + Drop, T: Type + Copy + Drop>(
  rows: domain<I>, body: fn(I) -> T effects(stop) on(rows)
) -> Sequence<T> effects(stop) = finite("local.collect.sequence");

pub fn collect_where<I: Type + Copy + Drop, T: Type + Copy + Drop>(
  rows: domain<I>, keep: fn(I) -> bool effects(stop) on(rows),
  body: fn(I) -> T effects(stop) on(rows)
) -> Sequence<T> effects(stop) = finite("local.collect.sequence_where");

pub fn accumulate<I: Type + Copy + Drop, T: Type + Copy + Drop, C: Combiner<T>>(
  rows: domain<I>, body: fn(I) -> T effects(stop) on(rows)
) -> T effects(stop) {
  return fold(rows, C::identity(), fn(state, item) => C::combine(state, body(item)));
}

pub fn accumulate_where<I: Type + Copy + Drop, T: Type + Copy + Drop, C: Combiner<T>>(
  rows: domain<I>, keep: fn(I) -> bool effects(stop) on(rows),
  body: fn(I) -> T effects(stop) on(rows)
) -> T effects(stop) {
  return fold_where(rows, C::identity(), keep, fn(state, item) => C::combine(state, body(item)));
}

pub fn sum<I: Type + Copy + Drop, F: Field>(
  rows: domain<I>, body: fn(I) -> F effects(stop) on(rows)
) -> F effects(stop) {
  return accumulate<I, F, FieldSum<F>>(rows, body);
}

pub fn sum_where<I: Type + Copy + Drop, F: Field>(
  rows: domain<I>, keep: fn(I) -> bool effects(stop) on(rows),
  body: fn(I) -> F effects(stop) on(rows)
) -> F effects(stop) {
  return accumulate_where<I, F, FieldSum<F>>(rows, keep, body);
}

pub fn product<I: Type + Copy + Drop, F: Field>(
  rows: domain<I>, body: fn(I) -> F effects(stop) on(rows)
) -> F effects(stop) {
  return accumulate<I, F, FieldProduct<F>>(rows, body);
}

pub fn product_where<I: Type + Copy + Drop, F: Field>(
  rows: domain<I>, keep: fn(I) -> bool effects(stop) on(rows),
  body: fn(I) -> F effects(stop) on(rows)
) -> F effects(stop) {
  return accumulate_where<I, F, FieldProduct<F>>(rows, keep, body);
}

pub fn group_sum<I: Type + Copy + Drop, G: Group>(
  rows: domain<I>, body: fn(I) -> G effects(stop) on(rows)
) -> G effects(stop) where zkc::curve::ScalarAction(G) {
  return accumulate<I, G, GroupSum<G>>(rows, body);
}

pub fn group_sum_where<I: Type + Copy + Drop, G: Group>(
  rows: domain<I>, keep: fn(I) -> bool effects(stop) on(rows),
  body: fn(I) -> G effects(stop) on(rows)
) -> G effects(stop) where zkc::curve::ScalarAction(G) {
  return accumulate_where<I, G, GroupSum<G>>(rows, keep, body);
}

pub reduction ∑ = sum, sum_where;
pub reduction ∏ = product, product_where;
