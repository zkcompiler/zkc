module zkc::vector;

pub type Vector<F: Field> = builtin("vector", F);

pub fn length<F: Field>(values: Vector<F>) -> index {
  return kernel<F>("vector.length", values);
}
pub fn get<F: Field>(values: Vector<F>, position: index) -> F {
  return kernel<F>("vector.get", values, position);
}
pub fn sum<F: Field>(values: Vector<F>) -> F {
  return kernel<F>("vector.sum", values);
}
pub fn split<F: Field>(values: Vector<F>) -> (Vector<F>, Vector<F>) {
  return kernel<F>("vector.split", values);
}
pub fn add<F: Field>(left: Vector<F>, right: Vector<F>) -> Vector<F> {
  return kernel<F>("vector.add", left, right);
}
pub fn scale<F: Field>(values: Vector<F>, scalar: F) -> Vector<F> {
  return kernel<F>("vector.scale", values, scalar);
}
pub fn dot<F: Field>(left: Vector<F>, right: Vector<F>) -> F {
  return kernel<F>("vector.dot", left, right);
}
pub fn fill<F: Field>(value: F, count: index) -> Vector<F> {
  return kernel<F>("vector.fill", value, count);
}
// Contiguous halves: fix the most significant Boolean coordinate.
// Requires a positive even length, as does split.
pub fn fold<F: Field>(values: Vector<F>, challenge: F) -> Vector<F> {
  let halves = split(values);
  return add(scale(halves.0, 1 - challenge), scale(halves.1, challenge));
}
pub fn has_length<F: Field, N: nat>(values: Vector<F>) -> bool {
  return length(values) == index<N>();
}
