module zkc::vector;

pub type Vector<F: Field> = builtin("vector", F);

pub fn length<F: Field>(values: Vector<F>) -> index = primitive("vector.length");
pub fn get<F: Field>(values: Vector<F>, position: index) -> F = primitive("vector.get");
pub fn sum<F: Field>(values: Vector<F>) -> F = primitive("vector.sum");
pub fn split<F: Field>(values: Vector<F>) -> (Vector<F>, Vector<F>) = primitive("vector.split");
pub fn add<F: Field>(left: Vector<F>, right: Vector<F>) -> Vector<F> = primitive("vector.add");
pub fn hadamard<F: Field>(left: Vector<F>, right: Vector<F>) -> Vector<F> = primitive("vector.mul");
pub fn scale<F: Field>(values: Vector<F>, scalar: F) -> Vector<F> = primitive("vector.scale");
pub fn dot<F: Field>(left: Vector<F>, right: Vector<F>) -> F = primitive("vector.dot");
pub fn fill<F: Field>(value: F, count: index) -> Vector<F> = primitive("vector.fill");
math fn interpolate<F: Field>(low: F, high: F, r: F) -> F {
  return low + (high - low) * r;
}
// Contiguous halves: fix the most significant Boolean coordinate.
// Requires a positive even length, as does split.
pub fn fold<F: Field>(values: Vector<F>, challenge: F) -> Vector<F> {
  let halves = split(values);
  return map interpolate(each halves.0, each halves.1, challenge);
}
pub fn has_length<F: Field, N: nat>(values: Vector<F>) -> bool {
  return length(values) == index<N>();
}

pub operator + = add;
pub operator * = scale;

pub operator infixl(70) ⊙ = hadamard;
pub notation ⟪ left, right ⟫ = dot(left, right);
