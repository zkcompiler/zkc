module zkc::vector;

pub type Vector<F: Field> = builtin("vector", F);

pub fn empty<F: Field>() -> Vector<F> = primitive("vector.empty");
pub fn append<F: Field>(values: Vector<F>, value: F) -> Vector<F> = primitive("vector.append");

pub fn length<F: Field>(values: Vector<F>) -> index = primitive("vector.length");
pub fn get<F: Field>(values: Vector<F>, position: index) -> F = primitive("vector.get");
pub fn sum<F: Field>(values: Vector<F>) -> F = primitive("vector.sum");
pub fn product<F: Field>(values: Vector<F>) -> F = primitive("vector.product");
pub fn split<F: Field>(values: Vector<F>) -> (Vector<F>, Vector<F>) = primitive("vector.split");
pub fn add<F: Field>(left: Vector<F>, right: Vector<F>) -> Vector<F> = primitive("vector.add");
pub fn hadamard<F: Field>(left: Vector<F>, right: Vector<F>) -> Vector<F> = primitive("vector.mul");
pub fn scale<F: Field>(values: Vector<F>, scalar: F) -> Vector<F> = primitive("vector.scale");
pub fn dot<F: Field>(left: Vector<F>, right: Vector<F>) -> F = primitive("vector.dot");
pub fn fill<F: Field>(value: F, count: index) -> Vector<F> = primitive("vector.fill");
pub fn has_length<F: Field, N: nat>(values: Vector<F>) -> bool {
  return length(values) == index<N>();
}

pub operator + = add;
pub operator * = scale;

pub operator infixl(70) ⊙ = hadamard;
pub notation ⟪ left, right ⟫ = dot(left, right);

pub use zkc::finite::{reduction ∑, reduction ∏};

pub domain fn elements<F: Field>(values: Vector<F>) -> domain<F> = domain("elements");
pub domain fn indices<F: Field>(values: Vector<F>) -> domain<index> = domain("indices");
pub math fn at<F: Field>(values: Vector<F>, position: index) -> F where in_bounds(position, values)
  = primitive("container.at");

pub fn collect<I: Type + Copy + Drop, F: Field>(
  rows: domain<I>, body: fn(item: I) -> F effects(stop) where item_from(item, rows)
) -> Vector<F> effects(stop) = finite("local.collect.vector");
pub fn collect_where<I: Type + Copy + Drop, F: Field>(
  rows: domain<I>, keep: fn(item: I) -> bool effects(stop) where item_from(item, rows),
  body: fn(item: I) -> F effects(stop) where item_from(item, rows)
) -> Vector<F> effects(stop) = finite("local.collect.vector_where");

// Materialize every selected body result before invoking the reducer once.
pub fn reduce<I: Type + Copy + Drop, F: Field, R: Type>(
  rows: domain<I>, body: fn(item: I) -> F effects(stop) where item_from(item, rows),
  reducer: fn(Vector<F>) -> R effects(stop)
) -> R effects(stop) {
  return reducer(collect(rows, body));
}

// Bounds follow the selected total accessor; checked access can be rebound locally.
pub indexing values[position] = at(values, position);

pub fn concat<F: Field>(left: Vector<F>, right: Vector<F>) -> Vector<F> {
  return kernel<F>("vector.concat", left, right);
}

pub fn slice<F: Field>(values: Vector<F>, start: index, count: index) -> Vector<F> {
  return kernel<F>("vector.slice", values, start, count);
}

math fn add_product<F: Field>(current: F, term: F, weight: F) -> F {
  return current + term * weight;
}

pub fn accumulate<F: Field>(current: Vector<F>, term: Vector<F>, weight: F) -> Vector<F> {
  return map add_product<F>(each current, each term, weight);
}

pub fn transpose<F: Field>(values: Vector<F>, rows: index, columns: index) -> Vector<F> {
  return kernel<F>("vector.transpose", values, rows, columns);
}

pub fn subtract<F: Field>(a: Vector<F>, b: Vector<F>) -> Vector<F> = primitive("vector.sub");

pub fn inverse<F: Field>(values: Vector<F>) -> Vector<F> = primitive("vector.inverse");
pub fn geometric<F: Field>(base: F, count: index) -> Vector<F> = primitive("vector.geometric");
