module zkc::matrix;
use zkc::vector::{Vector};

pub type Matrix<F: Field> = builtin("matrix", F);
pub fn get<F: Field>(matrix: Matrix<F>, row: index, column: index) -> F = primitive("matrix.get");
pub fn multiply<F: Field>(matrix: Matrix<F>, values: Vector<F>) -> Vector<F> = primitive("matrix.mul_vector");
pub fn transpose_multiply<F: Field>(matrix: Matrix<F>, values: Vector<F>) -> Vector<F> = primitive("matrix.transpose_mul_vector");
pub fn bilinear<F: Field>(matrix: Matrix<F>, left: Vector<F>, right: Vector<F>) -> F = primitive("matrix.bilinear");
pub fn rows<F: Field>(matrix: Matrix<F>) -> index {
  return kernel<F>("matrix.dimension", matrix; "0");
}
pub fn columns<F: Field>(matrix: Matrix<F>) -> index {
  return kernel<F>("matrix.dimension", matrix; "1");
}

pub operator * = multiply;

pub domain fn row_values<F: Field>(values: Matrix<F>, position: index) -> scoped domain<F> = domain("matrix.row");
pub domain fn column_values<F: Field>(values: Matrix<F>, position: index) -> scoped domain<F> = domain("matrix.column");
pub domain fn row_indices<F: Field>(values: Matrix<F>) -> scoped domain<index> = domain("indices.rows");
pub domain fn column_indices<F: Field>(values: Matrix<F>) -> scoped domain<index> = domain("indices.columns");
pub domain fn coordinates<F: Field>(values: Matrix<F>) -> scoped domain<(index, index)> = domain("matrix.coordinates.row_major");
pub domain fn column_coordinates<F: Field>(values: Matrix<F>) -> scoped domain<(index, index)> = domain("matrix.coordinates.column_major");
pub math fn at<F: Field>(values: Matrix<F>, row: index, column: index) -> F
  where in_bounds(row, values, 0), in_bounds(column, values, 1)
  = primitive("matrix.at");

pub indexing values[row, column] = at(values, row, column);
