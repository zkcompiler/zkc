module air_table;
use air_polynomial::{Vector, Indices, length, empty, append, concat, get, slice, fill,
  add, scale, accumulate, multiply, inverse, less, not, both, point,
  transpose, column_at, vanishing, vanishing_values, recombine,
  index_list, index_push, index_get, index_length};

pub struct Shape {
  pub witness: index,
  pub configuration: index,
  pub public_columns: index,
  pub public_slots: index,
  pub inputs: index,
  pub assertions: index,
  pub chunks: index
}
pub fn shape<F: Field, Table: nat, B: Bundle>(height: index) -> Shape {
  let facts = kernel<F,Table>("relation.table_shape", height; B);
  return Shape { witness: facts.0, configuration: facts.1,
    public_columns: facts.2, public_slots: facts.3, inputs: facts.4,
    assertions: facts.5, chunks: facts.6 };
}
fn descriptor<F: Field, Table: nat, B: Bundle>(height: index, slot: index)
    -> (index, index, index) {
  return kernel<F,Table>("relation.table_input", height, slot; B);
}
fn scope<F: Field, Table: nat, B: Bundle>(height: index, assertion: index)
    -> (index, index) {
  return kernel<F,Table>("relation.table_scope", height, assertion; B);
}
fn shifted_point<F: Field>(height: index, rotation: index, zeta: F) -> F {
  return zeta * point<F>(1, height, rotation);
}

// Each ordered arena input's authority (0 public slot, 1 witness, 2
// configuration, 3 public column), combined column and rotation modulo the
// height, as the Bundle describes them.
pub struct Inputs {
  pub kind: Indices,
  pub column: Indices,
  pub rotation: Indices
}
pub fn inputs<F: Field, Table: nat, B: Bundle>(height: index) -> Inputs {
  let facts = shape<F,Table,B>(height);
  let mut kind = index_list();
  let mut column = index_list();
  let mut rotation = index_list();
  for slot in 0..facts.inputs {
    let binding = descriptor<F,Table,B>(height, slot);
    kind = index_push(kind, binding.0);
    column = index_push(column, binding.1);
    rotation = index_push(rotation, binding.2);
  }
  return Inputs { kind, column, rotation };
}

// Substitution assignments are in the captured arena's input order. All
// matrices here have contiguous columns; metadata supplies authority and
// column, never an author-supplied interpretation of an input slot.
pub fn input_values<F: Field>(slots: Inputs, witness: Vector<F>,
    configuration: Vector<F>, public_columns: Vector<F>, public_data: Vector<F>,
    height: index, zeta: F) -> Vector<F> {
  let mut assignments = empty<F>();
  for slot in 0..index_length(slots.kind) {
    let kind = index_get(slots.kind, slot);
    let column = index_get(slots.column, slot);
    let x = shifted_point(height, index_get(slots.rotation, slot), zeta);
    let value = if kind == 0 { get(public_data, column) }
      else { if kind == 1 { column_at(witness, column, height, x, 1) }
      else { if kind == 2 { column_at(configuration, column, height, x, 1) }
      else { column_at(public_columns, column, height, x, 1) } } };
    assignments = append(assignments, value);
  }
  return assignments;
}
pub fn claims<F: Field, Table: nat, B: Bundle>(witness: Vector<F>,
    configuration: Vector<F>, public_columns: Vector<F>, public_data: Vector<F>,
    height: index, zeta: F) -> Vector<F> {
  let facts = shape<F,Table,B>(height);
  require both(length(witness) == height * facts.witness,
    both(length(configuration) == height * facts.configuration,
      both(length(public_columns) == height * facts.public_columns,
           length(public_data) == facts.public_slots)));
  return input_values(inputs<F,Table,B>(height), witness, configuration, public_columns,
    public_data, height, zeta);
}

// Every ordered arena input at each point of a size-`size` domain, row-major
// with one column per input. Columns hold `size` evaluations of polynomials
// interpolated on the order-`height` subgroup; `height` divides `size`, so
// rotation r is the left rotation by r*size/height. With size = height the
// rows are the table's own rows, with cyclic reads.
pub fn input_assignments<F: Field>(slots: Inputs, witness: Vector<F>,
    configuration: Vector<F>, public_columns: Vector<F>, public_data: Vector<F>,
    height: index, size: index) -> Vector<F> {
  let blowup = kernel("index.div", size, height);
  require size == height * blowup;
  let count = index_length(slots.kind);
  let mut columns = empty<F>();
  for slot in 0..count {
    let kind = index_get(slots.kind, slot);
    let column = index_get(slots.column, slot);
    let evaluations = if kind == 0 { fill(get(public_data, column), size) }
      else {
        let values = if kind == 1 { slice(witness, column * size, size) }
          else { if kind == 2 { slice(configuration, column * size, size) }
          else { slice(public_columns, column * size, size) } };
        kernel<F>("vector.rotate", values, index_get(slots.rotation, slot) * blowup)
      };
    columns = concat(columns, evaluations);
  }
  return transpose(columns, count, size);
}
pub fn domain_assignments<F: Field, Table: nat, B: Bundle>(witness: Vector<F>,
    configuration: Vector<F>, public_columns: Vector<F>, public_data: Vector<F>,
    height: index, size: index) -> Vector<F> {
  let facts = shape<F,Table,B>(height);
  require both(length(witness) == size * facts.witness,
    both(length(configuration) == size * facts.configuration,
      both(length(public_columns) == size * facts.public_columns,
           length(public_data) == facts.public_slots)));
  return input_assignments(inputs<F,Table,B>(height), witness, configuration, public_columns,
    public_data, height, size);
}

pub fn assertion_scopes<F: Field, Table: nat, B: Bundle>(height: index) -> (Indices, Indices) {
  let facts = shape<F,Table,B>(height);
  let mut begin = index_list();
  let mut end = index_list();
  for assertion in 0..facts.assertions {
    let interval = scope<F,Table,B>(height, assertion);
    begin = index_push(begin, interval.0);
    end = index_push(end, interval.1);
  }
  return (begin, end);
}

// Constraint k has numerator column k (contiguous, `size` values) and active
// rows [begin_k, end_k). Nonempty scopes are divided by their vanishing
// polynomial and weighted by successive powers of alpha; empty scopes neither
// contribute nor advance the weight.
pub fn divide_scopes<F: Field>(numerators: Vector<F>, begin: Indices, end: Indices,
    height: index, shift: F, size: index, alpha: F) -> Vector<F> {
  let count = index_length(begin);
  require both(index_length(end) == count, length(numerators) == count * size);
  let mut result = fill<F>(0, size);
  let mut weight: F = 1;
  for constraint in 0..count {
    let first = index_get(begin, constraint);
    let last = index_get(end, constraint);
    if less(first, last) {
      let denominator = vanishing_values(height, first, last, shift, size);
      let quotient = multiply(slice(numerators, constraint * size, size),
        kernel<F>("vector.inverse", denominator));
      result = accumulate(result, quotient, weight);
      weight = weight * alpha;
    }
  }
  return result;
}
pub fn combine_scopes<F: Field>(values: Vector<F>, begin: Indices, end: Indices,
    height: index, zeta: F, alpha: F) -> F {
  let count = index_length(begin);
  require both(index_length(end) == count, length(values) == count);
  let mut combined: F = 0;
  let mut weight: F = 1;
  for constraint in 0..count {
    let first = index_get(begin, constraint);
    let last = index_get(end, constraint);
    if less(first, last) {
      combined = combined + weight * get(values, constraint) *
        inverse(vanishing(height, first, last, zeta));
      weight = weight * alpha;
    }
  }
  return combined;
}

pub fn quotient_values<F: Field, Table: nat, B: Bundle>(witness: Vector<F>,
    configuration: Vector<F>, public_columns: Vector<F>, public_data: Vector<F>,
    height: index, shift: F, size: index, alpha: F) -> Vector<F> {
  let facts = shape<F,Table,B>(height);
  let assignments = domain_assignments<F,Table,B>(witness, configuration,
    public_columns, public_data, height, size);
  let rows = kernel<F,Table>("relation.table_points", assignments, size; B);
  let scopes = assertion_scopes<F,Table,B>(height);
  return divide_scopes(transpose(rows, size, facts.assertions), scopes.0, scopes.1,
    height, shift, size, alpha);
}

pub fn opening_claims<F: Field>(columns: Vector<F>, count: index, shift: F,
    size: index, zeta: F) -> Vector<F> {
  require length(columns) == count * size;
  let mut result = empty<F>();
  for column in 0..count {
    result = append(result, column_at(columns, column, size, zeta, shift));
  }
  return result;
}

// Values the verifier knows: public slots and configuration/public columns
// at their opening points. Witness reads are left to the opening argument.
pub fn known_values<F: Field>(slots: Inputs, assignments: Vector<F>,
    configuration: Vector<F>, public_columns: Vector<F>, public_data: Vector<F>,
    height: index, zeta: F) -> bool {
  require length(assignments) == index_length(slots.kind);
  let mut known = true;
  for slot in 0..index_length(slots.kind) {
    let kind = index_get(slots.kind, slot);
    let column = index_get(slots.column, slot);
    if not(kind == 1) {
      let x = shifted_point(height, index_get(slots.rotation, slot), zeta);
      let expected = if kind == 0 { get(public_data, column) }
        else { if kind == 2 { column_at(configuration, column, height, x, 1) }
        else { column_at(public_columns, column, height, x, 1) } };
      known = both(known, get(assignments, slot) == expected);
    }
  }
  return known;
}
pub fn known_inputs<F: Field, Table: nat, B: Bundle>(assignments: Vector<F>,
    configuration: Vector<F>, public_columns: Vector<F>, public_data: Vector<F>,
    height: index, zeta: F) -> bool {
  let facts = shape<F,Table,B>(height);
  require length(assignments) == facts.inputs;
  require both(length(configuration) == height * facts.configuration,
    both(length(public_columns) == height * facts.public_columns, length(public_data) == facts.public_slots));
  return known_values(inputs<F,Table,B>(height), assignments, configuration, public_columns,
    public_data, height, zeta);
}

pub fn identity<F: Field, Table: nat, B: Bundle>(assignments: Vector<F>,
    quotient_claims: Vector<F>, configuration: Vector<F>, public_columns: Vector<F>,
    public_data: Vector<F>, height: index, zeta: F, alpha: F) -> bool {
  let facts = shape<F,Table,B>(height);
  require both(length(assignments) == facts.inputs, length(quotient_claims) == facts.chunks);
  let known = known_inputs<F,Table,B>(assignments, configuration, public_columns,
    public_data, height, zeta);
  let residuals = kernel<F,Table>("relation.table_point", assignments; B);
  let scopes = assertion_scopes<F,Table,B>(height);
  let combined = combine_scopes(residuals, scopes.0, scopes.1, height, zeta, alpha);
  return both(known, combined == recombine(quotient_claims, height, zeta));
}

// Each witness read is a polynomial opening at zeta*g^offset. The same
// commitment column is used for every offset. Known configuration/public
// columns were checked directly and need no probabilistic opening reduction.
// Terms continue the caller's running sum and power of rho.
pub fn read_quotients<F: Field>(slots: Inputs, witness: Vector<F>,
    assignments: Vector<F>, height: index, shift: F, size: index, zeta: F, rho: F,
    initial: Vector<F>, first_weight: F) -> (Vector<F>, F) {
  require length(assignments) == index_length(slots.kind);
  let mut result = initial;
  let mut weight = first_weight;
  for slot in 0..index_length(slots.kind) {
    if index_get(slots.kind, slot) == 1 {
      let column = slice(witness, index_get(slots.column, slot) * size, size);
      let x = shifted_point(height, index_get(slots.rotation, slot), zeta);
      let reduced = kernel<F>("poly.opening_quotient", column, shift, x, get(assignments, slot));
      result = accumulate(result, reduced, weight);
      weight = weight * rho;
    }
  }
  return (result, weight);
}
pub fn deep_reads<F: Field, Table: nat, B: Bundle>(witness: Vector<F>,
    assignments: Vector<F>, height: index, shift: F, size: index, zeta: F, rho: F,
    initial: Vector<F>, first_weight: F) -> (Vector<F>, F) {
  let facts = shape<F,Table,B>(height);
  require both(length(assignments) == facts.inputs, length(witness) == facts.witness * size);
  return read_quotients(inputs<F,Table,B>(height), witness, assignments, height, shift, size,
    zeta, rho, initial, first_weight);
}
pub fn read_values<F: Field>(slots: Inputs, witness_row: Vector<F>,
    assignments: Vector<F>, height: index, x: F, zeta: F, rho: F,
    initial: F, first_weight: F) -> (F, F) {
  require length(assignments) == index_length(slots.kind);
  let mut result = initial;
  let mut weight = first_weight;
  for slot in 0..index_length(slots.kind) {
    if index_get(slots.kind, slot) == 1 {
      let at = shifted_point(height, index_get(slots.rotation, slot), zeta);
      let reduced = (get(witness_row, index_get(slots.column, slot)) - get(assignments, slot)) *
        inverse(x - at);
      result = result + weight * reduced;
      weight = weight * rho;
    }
  }
  return (result, weight);
}
pub fn deep_read_values<F: Field, Table: nat, B: Bundle>(witness_row: Vector<F>,
    assignments: Vector<F>, height: index, x: F, zeta: F, rho: F,
    initial: F, first_weight: F) -> (F, F) {
  let facts = shape<F,Table,B>(height);
  require both(length(witness_row) == facts.witness, length(assignments) == facts.inputs);
  return read_values(inputs<F,Table,B>(height), witness_row, assignments, height, x, zeta, rho,
    initial, first_weight);
}
// Opening j reads column selected_j at zeta*g^rotation_j, with claimed value_j.
pub fn deep_columns<F: Field>(columns: Vector<F>, selected: Indices, rotations: Indices,
    values: Vector<F>, height: index, shift: F, size: index, zeta: F, rho: F,
    initial: Vector<F>, first_weight: F) -> (Vector<F>, F) {
  let count = index_length(selected);
  require both(index_length(rotations) == count, length(values) == count);
  let mut result = initial;
  let mut weight = first_weight;
  for opening in 0..count {
    let column = slice(columns, index_get(selected, opening) * size, size);
    let x = shifted_point(height, index_get(rotations, opening), zeta);
    let reduced = kernel<F>("poly.opening_quotient", column, shift, x, get(values, opening));
    result = accumulate(result, reduced, weight);
    weight = weight * rho;
  }
  return (result, weight);
}
pub fn deep_column_values<F: Field>(row: Vector<F>, selected: Indices, rotations: Indices,
    values: Vector<F>, height: index, x: F, zeta: F, rho: F,
    initial: F, first_weight: F) -> (F, F) {
  let count = index_length(selected);
  require both(index_length(rotations) == count, length(values) == count);
  let mut result = initial;
  let mut weight = first_weight;
  for opening in 0..count {
    let at = shifted_point(height, index_get(rotations, opening), zeta);
    let reduced = (get(row, index_get(selected, opening)) - get(values, opening)) * inverse(x - at);
    result = result + weight * reduced;
    weight = weight * rho;
  }
  return (result, weight);
}
// Quotient chunks are opened at zeta itself: rotation zero.
pub fn same_rotation(count: index, rotation: index) -> (Indices, Indices) {
  let mut selected = index_list();
  let mut rotations = index_list();
  for column in 0..count {
    selected = index_push(selected, column);
    rotations = index_push(rotations, rotation);
  }
  return (selected, rotations);
}

pub fn deep_word<F: Field, Table: nat, B: Bundle>(witness: Vector<F>,
    quotients: Vector<F>, assignments: Vector<F>, quotient_claims: Vector<F>,
    height: index, shift: F, size: index, zeta: F, rho: F, adjustment: F) -> Vector<F> {
  let facts = shape<F,Table,B>(height);
  require both(length(assignments) == facts.inputs, length(quotient_claims) == facts.chunks);
  require both(length(witness) == facts.witness * size, length(quotients) == facts.chunks * size);
  let reads = deep_reads<F,Table,B>(witness, assignments, height, shift, size, zeta, rho,
    fill<F>(0, size), 1);
  let chunks = same_rotation(facts.chunks, 0);
  let combined = deep_columns(quotients, chunks.0, chunks.1, quotient_claims, height, shift, size,
    zeta, rho, reads.0, reads.1);
  let result = combined.0;
  let xs = kernel<F>("poly.domain_points", shift, size);
  return multiply(result, add(fill<F>(1, size), scale(xs, adjustment)));
}

pub fn deep_value<F: Field, Table: nat, B: Bundle>(witness_row: Vector<F>,
    quotient_row: Vector<F>, assignments: Vector<F>, quotient_claims: Vector<F>,
    height: index, x: F, zeta: F, rho: F, adjustment: F) -> F {
  let facts = shape<F,Table,B>(height);
  require both(length(witness_row) == facts.witness, length(quotient_row) == facts.chunks);
  require both(length(assignments) == facts.inputs, length(quotient_claims) == facts.chunks);
  let reads = deep_read_values<F,Table,B>(witness_row, assignments, height, x, zeta, rho, 0, 1);
  let chunks = same_rotation(facts.chunks, 0);
  let combined = deep_column_values(quotient_row, chunks.0, chunks.1, quotient_claims, height, x,
    zeta, rho, reads.0, reads.1);
  let result = combined.0;
  return result * (1 + adjustment * x);
}
