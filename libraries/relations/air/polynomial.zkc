module air::polynomial;
use zkc::vector as vector;
use zkc::boolean as boolean;
use zkc::vector::{Vector, length, concat, fill, scale};

use zkc::polynomial as polynomial;
use zkc::coset as coset;
use zkc::scalar::{inverse, power};
use zkc::indices::{less, maximum, divide};
use zkc::boolean::{both};

use zkc::coset::{point, interpolate};

use zkc::finite_math as total;

// Coefficient blocks of length `height` needed by a quotient C/Z_A, where C
// has degree at most degree*(height-1) and A has `active` rows. Zero means
// exact divisibility forces C to vanish, as in relation.table_shape.
pub fn chunks_for(degree: index, height: index, active: index) -> index effects(stop) where () {
  let numerator = degree * (height - 1);
  return if less(numerator, active) { 0 }
    else { divide(numerator - active, height) + 1 };
}

// The active scope is an interval [begin,end) of the trace subgroup. All,
// first, last and almost-all scopes use the smaller of the interval and its
// complement. At a complement root the quotient has a removable pole; use
// the direct product there. General intervals retain their linear cost.
pub fn vanishing<F: Field>(height: index, begin: index, end: index, x: F) -> F effects(stop) where zkc::algebra::TwoAdicField(F) {
  require both(boolean::negate(less(end, begin)), boolean::negate(less(height, end)));
  let count = end - begin;
  let complement = height - count;
  let use_complement = less(complement, count);
  let mut product: F = 1;
  if use_complement {
    for row in 0..begin { product = product * (x - point<F>(1, height, row)); }
    for row in end..height { product = product * (x - point<F>(1, height, row)); }
    if product == 0 {
      product = 1;
      for row in begin..end { product = product * (x - point<F>(1, height, row)); }
    } else {
      product = (power(x, height) - 1) * inverse(product);
    }
  } else {
    for row in begin..end { product = product * (x - point<F>(1, height, row)); }
  }
  return product;
}

// A polynomial of degree below count*width is split into coefficient blocks.
// The padding is only representation padding, never a change in degree bound.
pub fn split_quotient<F: Field>(values: Vector<F>, shift: F, size: index,
    width: index, count: index) -> Vector<F> effects(stop) where zkc::algebra::TwoAdicField(F) {
  let coefficients = polynomial::coefficients(interpolate(coset::word(values, shift)));
  let actual = length(coefficients);
  let capacity = width * count;
  require boolean::negate(less(capacity, actual));
  let padded = concat(coefficients, fill<F>(0, capacity - actual));
  return coset::evaluate_batch(padded, count, width, shift, size);
}
pub fn recombine<F: Field>(claims: Vector<F>, height: index, x: F) -> F effects(stop) where () {
  let stride = power(x, height);
  let initial: (F, F) = (0, 1);
  let combined = total::fold(vector::elements(claims), initial,
    fn((value, weight), claim) => (value + weight * claim, weight * stride));
  return combined.0;
}

// Vector form of the same interval vanishing polynomial. The subgroup
// polynomial is evaluated geometrically, so full/interior scopes take work
// linear in the coset size on disjoint domains. Two two-adic cosets intersect
// exactly when shift^max(height,size) = 1. On an intersecting coset, use the
// direct product to avoid inverting zero at complement roots. A full scope
// has denominator one and keeps the geometric evaluation on every coset.
pub fn vanishing_values<F: Field>(height: index, begin: index, end: index,
    shift: F, size: index) -> Vector<F> effects(stop) where zkc::algebra::TwoAdicField(F) {
  require both(boolean::negate(less(end, begin)), boolean::negate(less(height, end)));
  let count = end - begin;
  let complement = height - count;
  let use_complement = if less(complement, count) {
    if complement == 0 { true }
    else { boolean::negate(power(shift, maximum(height, size)) == 1) }
  } else { false };
  let points = coset::points(shift, size);
  let mut product = fill<F>(1, size);
  if use_complement {
    for row in 0..begin {
      let factor = vector::subtract(points, fill(point<F>(1, height, row), size));
      product = vector::hadamard(product, factor);
    }
    for row in end..height {
      let factor = vector::subtract(points, fill(point<F>(1, height, row), size));
      product = vector::hadamard(product, factor);
    }
    let root = coset::root<F>(size);
    let monomials = scale(vector::geometric(power(root, height), size), power(shift, height));
    let full = vector::subtract(monomials, fill<F>(1, size));
    product = vector::hadamard(full, vector::inverse(product));
  } else {
    for row in begin..end {
      let factor = vector::subtract(points, fill(point<F>(1, height, row), size));
      product = vector::hadamard(product, factor);
    }
  }
  return product;
}
