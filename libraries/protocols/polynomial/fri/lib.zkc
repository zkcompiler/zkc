module fri;
use zkc::indices as indices;
use zkc::indices::{Indices, less};
use zkc::vector::{Vector, length, append, get, empty, concat, fill};
use zkc::polynomial as polynomial;
use zkc::coset as coset;
use zkc::scalar as scalar;

// Mathematical choices only. Authentication and layout are deployment choices.
// The challenge conversion's joint distribution law is an external premise;
// implementing this interface does not prove that law.
pub interface Configuration {
  type Value: Field;
  type Challenge: Field;
  fn challenge(draw: Challenge) -> Value effects(stop);
}

pub module Direct<F: Field>: Configuration {
  type Value: Field = F;
  type Challenge: Field = F;
  fn challenge(draw: F) -> F effects() where () { return draw; }
}

pub type FieldTable<F: Field> = builtin("oracle.table", F);
pub type Oracle<K: OracleKind> = builtin("oracle", K);
type Oracles<K: OracleKind, Capacity: nat> = builtin("oracle_sequence", K, Capacity);

// The constructor and all fields are private to this module. Privacy keeps
// independently obtained components from being accidentally recombined; it is
// not an authentication, randomness or proximity theorem.
#[logical]
#[shape(initial.rows, bound = pow2(LogSize))]
#[shape(layers.rows, bound = pow2(LogSize))]
#[shape(folds.rows, bound = pow2(LogSize))]
pub struct CommitmentState<C: Configuration, LogSize: nat, TerminalLog: nat,
                 Rounds: nat> {
  initial: Oracle<FieldTable<C::Value>>,
  layers: Oracles<FieldTable<C::Value>, Rounds>,
  folds: Oracles<FieldTable<C::Value>, Rounds>,
  geometry: coset::CosetDomain<C::Value>,
  coefficients: Vector<C::Value>,
  round_count: index
}

#[logical]
#[shape(initial.rows, bound = pow2(LogSize))]
#[shape(layers.rows, bound = pow2(LogSize))]
#[shape(folds.rows, bound = pow2(LogSize))]
pub struct QueryState<C: Configuration, LogSize: nat, TerminalLog: nat,
                 Rounds: nat, Queries: nat> {
  initial: Oracle<FieldTable<C::Value>>,
  layers: Oracles<FieldTable<C::Value>, Rounds>,
  folds: Oracles<FieldTable<C::Value>, Rounds>,
  geometry: coset::CosetDomain<C::Value>,
  coefficients: Vector<C::Value>,
  positions: Indices,
  round_count: index,
  query_count: index
}

pub use zkc::scalar::{power_word};

pub math fn fold_value<F: Field>(low: F, high: F, beta: F,
                                inverse_two: F, inverse_x: F) -> F where () {
  return (low + high) * inverse_two + beta * (low - high) * inverse_two * inverse_x;
}

math fn pair_low(position: index, rows: index) -> index where () {
  return indices::bit_and(position,
    indices::wrapping_sub(indices::logical_shift_right(rows, 1), 1));
}

// Total even for inadmissible captures. The predicate separately ties these
// captures to the actual source shape and a nonzero natural-order coset.
math fn binary_domain<F: Field>(rows: index, shift: F, generator: F,
    inverse_shift: F, inverse_generator: F, inverse_two: F) -> bool where () {
  return !(rows == 0) && !(rows == 1) &&
    indices::bit_and(rows, indices::wrapping_sub(rows, 1)) == 0 &&
    shift * inverse_shift == 1 && generator * inverse_generator == 1 &&
    (1 + 1) * inverse_two == 1 &&
    power_word(generator, indices::logical_shift_right(rows, 1)) == 0 - 1 &&
    power_word(generator, rows) == 1;
}

#[shape(source.rows, bound = Maximum)]
#[shape(result.rows, value = rows, bound = Maximum)]
oracle def Fold<F: Field, Maximum: nat>(source: Oracle<FieldTable<F>>,
    beta: F, source_rows: index, rows: index, shift: F, generator: F,
    inverse_shift: F, inverse_generator: F, inverse_two: F)
    -> Oracle<FieldTable<F>> {
  requires source_size: source_rows == oracle.rows(source);
  requires result_size: rows == indices::logical_shift_right(source_rows, 1);
  requires source_domain: binary_domain(source_rows, shift, generator,
    inverse_shift, inverse_generator, inverse_two);
  query(position: index) {
    let low = pair_low(position, source_rows);
    let high = indices::wrapping_add(low, indices::logical_shift_right(source_rows, 1));
    let left <- oracle.query(source, low);
    let right <- oracle.query(source, high);
    let inverse_x = inverse_shift * power_word(inverse_generator, low);
    return fold_value(left, right, beta, inverse_two, inverse_x);
  }
}

fn padded<F: Field>(coefficients: Vector<F>, count: index) -> Vector<F> {
  require !less(count, length(coefficients));
  return concat(coefficients, fill<F>(0, count - length(coefficients)));
}

fn terminal<F: Field>(coefficients: Vector<F>, shift: F, size: index,
                      position: index) -> F {
  let value = polynomial::from_coefficients(coefficients);
  let point = coset::point<F>(shift, size, position);
  return polynomial::evaluate(value, point);
}

// Exact positive static profile, traversed by bounded dynamic loops. Initial
// degree < 2^(TerminalLog+Rounds); terminal degree < 2^TerminalLog. The degree
// test is not a claim about proximity or the soundness gap.
pub protocol Commit<C: Configuration, LogSize: nat, TerminalLog: nat,
                    Rounds: nat> roles(P,V)
    (word: Vector<C::Value> @P, prover_shift: C::Value @P,
     verifier_shift: C::Value @V, round_count: index @(P,V),
     coins: Random<C::Challenge> @V)
    -> (state: CommitmentState<C,LogSize,TerminalLog,Rounds> @P->V)
    where zkc::algebra::TwoAdicField(C::Value),
      zkc::algebra::CharacteristicNotTwo(C::Value),
      LogSize <= 63,
      1 <= Rounds, TerminalLog+Rounds+1 <= LogSize {
  require @V round_count == index<Rounds>();
  require @P round_count == index<Rounds>();
  let initial_rows = index<pow2(LogSize)>();
  require @P length(word) == initial_rows;
  let shift = @(P = prover_shift, V = verifier_shift);
  let geometryP @P = coset::coset_domain(shift, initial_rows);
  let geometryV @V = coset::coset_domain(shift, initial_rows);
  let geometry = @(P = geometryP, V = geometryV);
  let mut current @P = coset::word(word, prover_shift);
  let mut layers = oracle.empty<FieldTable<C::Value>,Rounds> roles(P,V)();
  let mut folds = oracle.empty<FieldTable<C::Value>,Rounds> roles(P,V)();
  let mut rows = initial_rows;
  let mut offset = shift;
  let generatorP @P = coset::root<C::Value>(initial_rows);
  let generatorV @V = coset::root<C::Value>(initial_rows);
  let mut generator = @(P = generatorP, V = generatorV);
  let inverse_twoP @P = scalar::inverse<C::Value>(1 + 1);
  let inverse_twoV @V = scalar::inverse<C::Value>(1 + 1);
  let inverse_two = @(P = inverse_twoP, V = inverse_twoV);
  for round in 0..round_count roles(P,V) max Rounds {
    let values @P = coset::values(current);
    let source <- send P -> V(values)
      as oracle<FieldTable<C::Value>>(rows = rows) max pow2(LogSize);
    let kept_layer <- oracle.append(layers, source);
    layers = kept_layer;
    let drawV = coins.draw();
    let drawP = send V -> P(drawV);
    let betaP @P = C::challenge(drawP);
    let betaV @V = C::challenge(drawV);
    let beta = @(P = betaP, V = betaV);

    // Rows come from this actual anchor before virtual construction. The
    // separate result-shape capture is checked equal to half those rows.
    let source_rows = oracle.rows(source);
    require @P source_rows == rows;
    require @V source_rows == rows;
    let next_rows = indices::logical_shift_right(source_rows, 1);
    let installed_generatorP @P = coset::root<C::Value>(source_rows);
    let installed_generatorV @V = coset::root<C::Value>(source_rows);
    require @P installed_generatorP == generator;
    require @V installed_generatorV == generator;
    let inverse_shiftP @P = scalar::inverse(offset);
    let inverse_shiftV @V = scalar::inverse(offset);
    let inverse_shift = @(P = inverse_shiftP, V = inverse_shiftV);
    let inverse_generatorP @P = scalar::inverse(generator);
    let inverse_generatorV @V = scalar::inverse(generator);
    let inverse_generator = @(P = inverse_generatorP, V = inverse_generatorV);
    require @P binary_domain(source_rows, offset, generator,
      inverse_shift, inverse_generator, inverse_two);
    require @V binary_domain(source_rows, offset, generator,
      inverse_shift, inverse_generator, inverse_two);
    let view <- Fold<C::Value,pow2(LogSize)>(source, beta, source_rows, next_rows,
      offset, generator, inverse_shift, inverse_generator, inverse_two);
    let kept_fold <- oracle.append(folds, view);
    folds = kept_fold;
    let next @P = coset::fold(current, betaP);
    current = next;
    rows = next_rows;
    offset = offset * offset;
    generator = generator * generator;
  }
  let terminal_generatorP @P = coset::root<C::Value>(rows);
  let terminal_generatorV @V = coset::root<C::Value>(rows);
  require @P terminal_generatorP == generator;
  require @V terminal_generatorV == generator;
  let proposed @P = padded(polynomial::coefficients(coset::interpolate(current)),
    index<pow2(TerminalLog)>());
  let received = send P -> V(proposed);
  require @V length(received) == index<pow2(TerminalLog)>();
  let coefficients = @(P = proposed, V = received);
  let initial <- oracle.at(layers, 0);
  let state = CommitmentState<C,LogSize,TerminalLog,Rounds> {
    initial, layers, folds, geometry, coefficients, round_count
  };
  return (state = state);
}

// Query acquisition is a separate source-selected law. Binding the resulting
// sequence below checks its shape, not uniformity or independence.
pub protocol ScalarQueries<F: Field, LogSize: nat, Queries: nat> roles(P,V)
    (query_count: index @(P,V), coins: Random<F> @V)
    -> (positions: Indices @(P,V))
    where zkc::random::IndexRandomness(F), LogSize <= 63, 1 <= Queries {
  require @V query_count == index<Queries>();
  require @P query_count == index<Queries>();
  let positionsP @P = indices::empty();
  let positionsV @V = indices::empty();
  let mut positions = @(P = positionsP, V = positionsV);
  for query in 0..query_count roles(P,V) max Queries {
    let positionV = coins.index<pow2(LogSize)>();
    let positionP = send V -> P(positionV);
    let position = @(P = positionP, V = positionV);
    let rememberedP @P = indices::append(positions, position);
    let rememberedV @V = indices::append(positions, position);
    positions = @(P = rememberedP, V = rememberedV);
  }
  return (positions = positions);
}

pub protocol BlockQueries<F: Field, LogSize: nat, Queries: nat> roles(P,V)
    (query_count: index @(P,V), coins: Random<F> @V)
    -> (positions: Indices @(P,V))
    where zkc::random::IndexBlockRandomness(F), LogSize <= 63, 1 <= Queries {
  require @V query_count == index<Queries>();
  require @P query_count == index<Queries>();
  #[site(positions)]
  let positionsV = coins.indices(pow2(LogSize),Queries);
  let positionsP = send V -> P(positionsV);
  let positions = @(P = positionsP, V = positionsV);
  return (positions = positions);
}

fn bounded_positions(positions: Indices, bound: index) -> bool {
  let mut bounded = true;
  for query in 0..indices::length(positions) {
    let position = indices::get(positions, query);
    bounded = bounded && less(position, bound);
  }
  return bounded;
}

// Distinct flat logical records express the phase boundary without embedding
// a logical record or an owner-local resource in shared logical metadata.
pub protocol BindQueries<C: Configuration, LogSize: nat, TerminalLog: nat,
                         Rounds: nat, Queries: nat> roles(P,V)
    (committed: CommitmentState<C,LogSize,TerminalLog,Rounds> @P->V,
     positions: Indices @(P,V))
    -> (state: QueryState<C,LogSize,TerminalLog,Rounds,Queries> @P->V)
    where LogSize <= 63, 1 <= Queries {
  require @V indices::length(positions) == index<Queries>();
  require @P indices::length(positions) == index<Queries>();
  let boundedV @V = bounded_positions(positions, index<pow2(LogSize)>());
  require @V boundedV;
  let boundedP @P = bounded_positions(positions, index<pow2(LogSize)>());
  require @P boundedP;
  let state = QueryState<C,LogSize,TerminalLog,Rounds,Queries> {
    initial: committed.initial, layers: committed.layers,
    folds: committed.folds, geometry: committed.geometry,
    coefficients: committed.coefficients, positions,
    round_count: committed.round_count, query_count: index<Queries>()
  };
  return (state = state);
}

pub protocol Positions<C: Configuration, LogSize: nat, TerminalLog: nat,
                       Rounds: nat, Queries: nat> roles(P,V)
    (state: QueryState<C,LogSize,TerminalLog,Rounds,Queries> @P->V)
    -> (positions: Indices @(P,V)) where () {
  let positions = state.positions;
  return (positions = positions);
}

#[shape(initial.rows, bound = pow2(LogSize))]
pub protocol Initial<C: Configuration, LogSize: nat, TerminalLog: nat,
                     Rounds: nat, Queries: nat> roles(P,V)
    (state: QueryState<C,LogSize,TerminalLog,Rounds,Queries> @P->V)
    -> (initial: Oracle<FieldTable<C::Value>> @P->V) where () {
  let initial = state.initial;
  return (initial = initial);
}

fn association_size<F: Field>(enabled: bool, values: Vector<F>, count: index) -> bool {
  return if enabled { length(values) == count } else { true };
}

fn associated_value<F: Field>(enabled: bool, values: Vector<F>, position: index,
                              actual: F) -> bool {
  return if enabled { actual == get(values, position) } else { true };
}

// One checker for both entrypoints. Association means an actual equality with
// the authenticated initial handle at this state's exact positions, before
// each fold chain. The flag and the vector alone establish no binding claim.
protocol Check<C: Configuration, LogSize: nat, TerminalLog: nat,
               Rounds: nat, Queries: nat> roles(P,V)
    (state: QueryState<C,LogSize,TerminalLog,Rounds,Queries> @P->V,
     associate: bool @V, first: Vector<C::Value> @V)
    -> (accepted: bool @V, valuesV: Vector<C::Value> @V)
    where zkc::algebra::TwoAdicField(C::Value),
      zkc::algebra::CharacteristicNotTwo(C::Value), LogSize <= 63,
      1 <= Rounds, 1 <= Queries, TerminalLog+Rounds+1 <= LogSize {
  require @V state.round_count == index<Rounds>() && state.query_count == index<Queries>();
  require @V oracle.length(state.layers) == state.round_count;
  require @V oracle.length(state.folds) == state.round_count;
  require @V indices::length(state.positions) == state.query_count;
  require @V length(state.coefficients) == index<pow2(TerminalLog)>();
  require @V coset::domain_size(state.geometry) == index<pow2(LogSize)>();
  require @V oracle.rows(state.initial) == coset::domain_size(state.geometry);
  require @V association_size(associate, first, state.query_count);
  let remaining_rounds = indices::wrapping_sub(state.round_count, 1);
  let mut valuesV @V = empty<C::Value>();
  for query in 0..state.query_count roles(P,V) max Queries {
    let positionV @V = indices::get(state.positions, query);
    let selected @V <- query state.initial at positionV;
    require @V associated_value(associate, first, query, selected);
    let remembered @V = append(valuesV, selected);
    valuesV = remembered;

    // The initial read already supplies round zero's actual-layer value.
    // Peel its fold so every later iteration has the same distributed schedule.
    let initial_rowsV @V = coset::domain_size(state.geometry);
    let initial_shiftV @V = coset::domain_shift(state.geometry);
    let first_lowV @V = pair_low(positionV, initial_rowsV);
    let first_view <- oracle.at(state.folds, 0);
    require @V oracle.rows(first_view) == indices::logical_shift_right(initial_rowsV, 1);
    let first_folded @V <- query first_view at first_lowV;
    let mut expected @V = first_folded;
    let mut atV @V = first_lowV;
    let mut rowsV @V = indices::logical_shift_right(initial_rowsV, 1);
    let mut shiftV @V = initial_shiftV * initial_shiftV;
    for step in 0..remaining_rounds roles(P,V) max Rounds {
      let round = indices::wrapping_add(step, 1);
      let actual <- oracle.at(state.layers, round);
      require @V oracle.rows(actual) == rowsV;
      let value @V <- query actual at atV;
      require @V value == expected;
      let lowV @V = pair_low(atV, rowsV);
      let view <- oracle.at(state.folds, round);
      require @V oracle.rows(view) == indices::logical_shift_right(rowsV, 1);
      let folded @V <- query view at lowV;
      expected = folded;
      atV = lowV;
      rowsV = indices::logical_shift_right(rowsV, 1);
      shiftV = shiftV * shiftV;
    }
    let evaluated @V = terminal(state.coefficients, shiftV, rowsV, atV);
    require @V evaluated == expected;
  }
  let accepted @V = true;
  return (accepted = accepted, valuesV = valuesV);
}

pub protocol Query<C: Configuration, LogSize: nat, TerminalLog: nat,
                   Rounds: nat, Queries: nat> roles(P,V)
    (state: QueryState<C,LogSize,TerminalLog,Rounds,Queries> @P->V)
    -> (accepted: bool @V, valuesV: Vector<C::Value> @V)
    where zkc::algebra::TwoAdicField(C::Value),
      zkc::algebra::CharacteristicNotTwo(C::Value), LogSize <= 63,
      1 <= Rounds, 1 <= Queries, TerminalLog+Rounds+1 <= LogSize {
  let first @V = empty<C::Value>();
  let (accepted, valuesV) <- Check<C,LogSize,TerminalLog,Rounds,Queries>(state,
    false, first);
  return (accepted = accepted, valuesV = valuesV);
}

pub protocol QueryAssociated<C: Configuration, LogSize: nat, TerminalLog: nat,
                             Rounds: nat, Queries: nat> roles(P,V)
    (state: QueryState<C,LogSize,TerminalLog,Rounds,Queries> @P->V,
     first: Vector<C::Value> @V)
    -> (accepted: bool @V)
    where zkc::algebra::TwoAdicField(C::Value),
      zkc::algebra::CharacteristicNotTwo(C::Value), LogSize <= 63,
      1 <= Rounds, 1 <= Queries, TerminalLog+Rounds+1 <= LogSize {
  let (accepted, _) <- Check<C,LogSize,TerminalLog,Rounds,Queries>(state, true, first);
  return (accepted = accepted);
}

// Explicit scalar policy over the common commitment and query phases.
pub protocol ScalarLowDegree<C: Configuration, LogSize: nat, TerminalLog: nat,
                       Rounds: nat, Queries: nat> roles(P,V)
    (word: Vector<C::Value> @P, prover_shift: C::Value @P,
     verifier_shift: C::Value @V, round_count: index @(P,V),
     query_count: index @(P,V), coins: Random<C::Challenge> @V)
    -> (accepted: bool @V, positionsP: Indices @P,
        positionsV: Indices @V, valuesV: Vector<C::Value> @V)
    where zkc::algebra::TwoAdicField(C::Value),
      zkc::algebra::CharacteristicNotTwo(C::Value),
      zkc::random::IndexRandomness(C::Challenge), LogSize <= 63,
      1 <= Rounds, 1 <= Queries, TerminalLog+Rounds+1 <= LogSize {
  let committed <- Commit<C,LogSize,TerminalLog,Rounds>(word, prover_shift,
    verifier_shift, round_count, coins);
  #[site(queries)]
  let positions <- ScalarQueries<C::Challenge,LogSize,Queries>(query_count, coins);
  let state <- BindQueries<C,LogSize,TerminalLog,Rounds,Queries>(committed, positions);
  let (accepted, valuesV) <- Query<C,LogSize,TerminalLog,Rounds,Queries>(state);
  let positionsP @P = positions;
  let positionsV @V = positions;
  return (accepted = accepted, positionsP = positionsP, positionsV = positionsV,
    valuesV = valuesV);
}

// Explicit product-block policy; no capability fallback to scalar requests.
pub protocol BlockLowDegree<C: Configuration, LogSize: nat, TerminalLog: nat,
                       Rounds: nat, Queries: nat> roles(P,V)
    (word: Vector<C::Value> @P, prover_shift: C::Value @P,
     verifier_shift: C::Value @V, round_count: index @(P,V),
     query_count: index @(P,V), coins: Random<C::Challenge> @V)
    -> (accepted: bool @V, positionsP: Indices @P,
        positionsV: Indices @V, valuesV: Vector<C::Value> @V)
    where zkc::algebra::TwoAdicField(C::Value),
      zkc::algebra::CharacteristicNotTwo(C::Value),
      zkc::random::IndexBlockRandomness(C::Challenge), LogSize <= 63,
      1 <= Rounds, 1 <= Queries, TerminalLog+Rounds+1 <= LogSize {
  let committed <- Commit<C,LogSize,TerminalLog,Rounds>(word, prover_shift,
    verifier_shift, round_count, coins);
  #[site(queries)]
  let positions <- BlockQueries<C::Challenge,LogSize,Queries>(query_count, coins);
  let state <- BindQueries<C,LogSize,TerminalLog,Rounds,Queries>(committed, positions);
  let (accepted, valuesV) <- Query<C,LogSize,TerminalLog,Rounds,Queries>(state);
  let positionsP @P = positions;
  let positionsV @V = positions;
  return (accepted = accepted, positionsP = positionsP, positionsV = positionsV,
    valuesV = valuesV);
}
