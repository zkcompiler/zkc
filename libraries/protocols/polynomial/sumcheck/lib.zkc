module sumcheck;
pub module expression;

use zkc::vector::{Vector, sum, length, empty, append};

use zkc::multilinear as multilinear;
use zkc::multilinear::{Table, fix_first, fix_prefix};

// An obligation at V, with sealed construction and consumption. The reference
// polynomial is a logical parameter, never a field available to the verifier.
#[linear]
pub struct Pending<F: Field> {
  pub point: Vector<F>,
  pub value: F
}

// Admission records a caller's scalar statement; it does not prove the sum.
pub fn pending<F: Field>(claim: F) -> Pending<F> effects(stop) where () {
  return Pending<F> { point: empty<F>(), value: claim };
}

fn open_claim<F: Field>(claim: Pending<F>) -> (Vector<F>, F) {
  return unpack(claim);
}

fn at_prefix<F: Field>(point: Vector<F>, value: F) -> Pending<F> {
  return Pending<F> { point: point, value: value };
}

math fn total<F: Field>(values: Vector<F>) -> F {
  return zkc::finite_math::fold(zkc::vector::elements(values), 0,
    fn(current, value) => current + value);
}

// Exact cube shape and repeat bound, evaluated at the verifier's input copy.
// Carrier representability and agreement between role copies belong to ABI admission.
pub relation TableShape<F: Field, Max: nat>(parameter values: Vector<F>,
    parameter rounds: index) {
  return zkc::indices::power_of_two(intrinsic<F>("vector.length", values), rounds)
    && !intrinsic("index.less", index<Max>(), rounds);
}

// The parameter is one fixed table selected by the property consumer. Purpose
// labels alone neither choose its authority nor existentially quantify it.
pub relation Sum<F: Field>(parameter values: Vector<F>, statement claim: F) {
  return claim == total(values);
}

// One relation for every prefix of the same fixed mathematical table. Its
// assignment is rebound at the caller, independently of P's working table.
pub relation Residual<F: Field>(parameter values: Table<F>,
    statement point: Vector<F>, statement claim: F) {
  return claim == total(intrinsic<F>("multilinear.restrict_prefix",
    multilinear::values(values), point));
}

// Shape is independent of residual truth. Total prefix restriction itself
// neither validates the cube nor checks that the prefix fits its dimension.
pub relation Shape<F: Field>(parameter values: Table<F>) {
  return multilinear::width(values) == 1
    && zkc::indices::power_of_two(intrinsic<F>("vector.length", multilinear::values(values)),
      multilinear::variables(values));
}

fn sums<F: Field>(values: Table<F>) {
  let halves = multilinear::halves(values);
  return (sum(halves.0), sum(halves.1));
}

// Pair-valued multilinear rounds. V checks each received boundary sum before
// drawing; P retains the residual table for a subsequent opening argument.
// A complete caller must discharge the returned evaluation and dimension.
pub protocol Reduce<F: Field, Max: nat> roles(P,V)
    (values: Table<F> @P, claim: Pending<F> @V, rounds: index @(P,V),
     challenges: Random<F> @V)
    -> (point: Vector<F> @P, residual: Table<F> @P,
        evaluation: Pending<F> @V)
    where () spec {
      input shape = Shape<F>(in.values);
      continuation initial_sum = Residual<F>(in.values, in.claim.point, in.claim.value)
        residual Residual<F>(in.values, out.evaluation.point, out.evaluation.value);
    }
{
  require @P multilinear::width(values) == 1;
  require @P !zkc::indices::less(multilinear::variables(values), rounds);
  let mut tableP = values;
  let mut pointP @P = empty<F>();
  let initial @V = open_claim(claim);
  let mut pointV @V = initial.0;
  let mut current = initial.1;
  for _ in 0..rounds roles(P,V) max Max {
    let parts = sums(tableP);
    #[site(round)] let actual = send P -> V(parts);
    require current == actual.0 + actual.1;
    #[site(challenge)] let cv = challenges.draw();
    #[site(delivery)] let cp = send V -> P(cv);
    tableP = fix_first(tableP, cp);
    pointP = append(pointP, cp);
    pointV = append(pointV, cv);
    current = (1 - cv) * actual.0 + cv * actual.1;
  }
  let evaluation @V = at_prefix(pointV, current);
  return (point = pointP, residual = tableP, evaluation = evaluation);
}

// Complete public-table discharge. The supplied point must fix every variable.
fn check_table<F: Field>(values: Vector<F>, point: Vector<F>, expected: F) -> bool {
  let table = multilinear::table(values, length(point), 1);
  let remaining = fix_prefix(table, point);
  return sum(multilinear::values(remaining)) == expected;
}
pub fn check<F: Field>(values: Vector<F>, evaluation: Pending<F>) -> bool effects(stop) where () {
  let payload = unpack(evaluation);
  return multilinear::has_shape(values, length(payload.0), 1)
    && check_table(values, payload.0, payload.1);
}

pub protocol Sumcheck<F: Field, Max: nat> roles(P,V)
    (values: Vector<F> @(P,V), claim: F @V, rounds: index @(P,V),
     challenges: Random<F> @V) -> (accepted: bool @V)
    where () spec {
      input shape = TableShape<F, Max>(in.values@V, in.rounds@V);
      target public_sum = Sum<F>(in.values@V, in.claim) accept out.accepted;
    }
{
  let table @P = multilinear::table(values, rounds, 1);
  let initial @V = pending(claim);
  #[site(reduce)] let (point, residual, evaluation) =
    Reduce<F,Max>(table, initial, rounds, challenges);
  return check(values, evaluation);
}
