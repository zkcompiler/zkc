module stark::single_table;
pub module low_degree;
use stark::configurations::contract::{Configuration};
use stark::single_table::low_degree::{FriConfiguration};
use fri::{CommitmentState, QueryState, Commit, ScalarQueries, BlockQueries, BindQueries, Positions, QueryAssociated};
use zkc::oracle::{Root, State};
use zkc::vector::{Vector, length, get, append, empty, fill, transpose};
use zkc::indices::{Indices, less};
use zkc::coset::{extend_columns, disjoint_coset, outside_domains};
use zkc::opening as opening_context;
use zkc::opening::{opening_claims, deep_columns, deep_row, same_rotation};
use zkc::coset as coset;
use air::polynomial::{split_quotient};
use air::table::{Shape, Inputs, shape, inputs, quotient_values, identity, read_quotients,
  read_values, input_values};

// The verifier's statement. Configuration and public columns are row-major,
// public data in the Bundle's public-slot order. The coset shift is not part of
// the statement: the configuration fixes it.
pub struct Statement<F: Field> {
  pub configuration: Vector<F>,
  pub public_columns: Vector<F>,
  pub public_data: Vector<F>
}

// These records stay at their owner. In particular, native commitment state
// never becomes shared logical metadata or part of the verifier's statement.
struct ProverOpenings<K: Configuration> {
  trace: State<K::BaseRows>,
  quotient: State<K::ExtensionRows>,
  size: index
}

struct VerifierOpenings<K: Configuration> {
  trace: Root<K::BaseRows>,
  quotient: Root<K::ExtensionRows>,
  facts: Shape,
  slots: Inputs,
  opened: Vector<K::Extension>,
  opened_quotient: Vector<K::Extension>,
  height: index,
  size: index,
  geometry: coset::CosetDomain<K::Extension>,
  zeta: K::Extension,
  gamma: K::Extension,
  adjustment: K::Extension
}

fn admissible<F: Field>(facts: Shape, statement: Statement<F>, height: index, size: index,
    shift: F) -> bool {
  return !(facts.witness == 0) && !less(size, facts.chunks * height) &&
    disjoint_coset(height, size, shift) &&
    length(statement.configuration) == facts.configuration * height &&
    length(statement.public_columns) == facts.public_columns * height &&
    length(statement.public_data) == facts.public_slots;
}

// Preserve the AIR input prefix, then cover every otherwise unread committed
// witness column at rotation zero, in column order. This is the DEEP inventory,
// not a second interpretation of the AIR's expression-arena inputs.
fn degree_inputs(slots: Inputs, width: index) -> Inputs {
  let mut kind = slots.kind;
  let mut column = slots.column;
  let mut rotation = slots.rotation;
  for candidate in 0..width {
    let mut covered = false;
    for slot in 0..zkc::indices::length(slots.kind) {
      covered = covered || (zkc::indices::get(slots.kind, slot) == 1 &&
        zkc::indices::get(slots.column, slot) == candidate);
    }
    if !covered {
      kind = zkc::indices::append(kind, 1);
      column = zkc::indices::append(column, candidate);
      rotation = zkc::indices::append(rotation, 0);
    }
  }
  return Inputs { kind, column, rotation };
}

// DEEP quotient values at the queried points: every witness read at its
// opening point, then every quotient chunk at zeta, with successive powers of
// gamma. Rows are the authenticated rows in query order.
fn deep_values<F: Field>(slots: Inputs, chunks: (Indices, Indices), witness_rows: Vector<F>,
    width: index, quotient_rows: Vector<F>, count: index, opened: Vector<F>,
    opened_quotient: Vector<F>, height: index, geometry: coset::CosetDomain<F>, positions: Indices, zeta: F, gamma: F, adjustment: F)
    -> Vector<F> {
  let mut result = empty<F>();
  let bound = opening_context::bind_openings(geometry, count, height, zeta,
    zkc::opening_claims::checked(chunks.0, chunks.1, opened_quotient));
  for query in 0..zkc::indices::length(positions) {
    let position = zkc::indices::get(positions, query);
    let x = coset::domain_point(geometry, position);
    let reads = read_values(slots, zkc::vector::slice(witness_rows, query * width, width),
      opened, height, x, zeta, gamma, 0, 1);
    let row = opening_context::query_row(geometry, count, position,
      zkc::vector::slice(quotient_rows, query * count, count));
    let state = opening_context::scalar_accumulator(geometry, position, gamma, reads.0, reads.1);
    result = append(result, opening_context::scalar_value(deep_row(row, bound, state)) *
      (1 + adjustment * x));
  }
  return result;
}

// A nonhiding STARK for the assertions of one present table of a relation
// Bundle, generic over its configuration K. The trace has height
// n = 2^(LogFinal + Rounds) and is extended to N = n * 2^LogBlowup points of
// the configuration's coset. FRI tests the DEEP word against degree < n with
// Rounds folds and a final polynomial of 2^LogFinal coefficients.
//
// Order: trace commitment; constraint-composition challenge alpha; quotient
// commitment; one out-of-domain point zeta, rejected unless outside the trace
// subgroup and the evaluation coset; trace and quotient evaluations at the
// opening points, checked against the AIR; DEEP batching challenge gamma and
// independent degree-adjustment challenge; FRI
// commitments, fold challenges and final polynomial; every query position;
// then the openings: trace and quotient rows, followed by the FRI layers.
protocol Prepare<K: Configuration, Table: nat, B: Bundle, LogFinal: nat, Rounds: nat,
    LogBlowup: nat> roles(P,V)
    (trace: Vector<K::Base> @P, statementP: Statement<K::Base> @P,
     statementV: Statement<K::Base> @V, coins: Random<K::Challenge> @V)
    -> (committed: CommitmentState<FriConfiguration<K>,LogFinal+Rounds+LogBlowup,LogFinal,Rounds> @P->V,
        prover: ProverOpenings<K> @P, verifier: VerifierOpenings<K> @V)
    where zkc::algebra::TwoAdicField(K::Base), zkc::algebra::TwoAdicField(K::Extension),
      zkc::algebra::CharacteristicNotTwo(K::Extension),
      zkc::oracle::VectorCommitment(K::ExtensionRows),
      LogFinal+Rounds+LogBlowup <= 63, 1 <= Rounds, 1 <= LogBlowup {
  let heightP @P = index<pow2(LogFinal + Rounds)>();
  let heightV @V = index<pow2(LogFinal + Rounds)>();
  let sizeP @P = index<pow2(LogFinal + Rounds + LogBlowup)>();
  let sizeV @V = index<pow2(LogFinal + Rounds + LogBlowup)>();
  let shiftP @P = K::shift();
  let shiftV @V = K::shift();
  let factsP @P = shape<K::Base,Table,B>(heightP);
  let factsV @V = shape<K::Base,Table,B>(heightV);
  require @V admissible(factsV, statementV, heightV, sizeV, shiftV);
  require @P admissible(factsP, statementP, heightP, sizeP, shiftP);
  require @P length(trace) == factsP.witness * heightP;

  // Trace columns, extended to the coset and committed as rows.
  let trace_columns @P = transpose(trace, heightP, factsP.witness);
  let configP @P = transpose(statementP.configuration, heightP, factsP.configuration);
  let configV @V = transpose(statementV.configuration, heightV, factsV.configuration);
  let publicP @P = transpose(statementP.public_columns, heightP, factsP.public_columns);
  let publicV @V = transpose(statementV.public_columns, heightV, factsV.public_columns);
  let trace_lde @P = extend_columns(trace_columns, factsP.witness, heightP, shiftP, sizeP);
  let config_lde @P = extend_columns(configP, factsP.configuration, heightP, shiftP, sizeP);
  let public_lde @P = extend_columns(publicP, factsP.public_columns, heightP, shiftP, sizeP);
  let trace_tree @P = K::commit_base(transpose(trace_lde, factsP.witness, sizeP), factsP.witness);
  let trace_root = send P -> V(trace_tree.0);

  // Constraint composition and the quotient commitment.
  let alphaDraw = coins.draw();
  let alphaSent = send V -> P(alphaDraw);
  let alphaV @V = K::challenge(alphaDraw);
  let alphaP @P = K::challenge(alphaSent);
  let shift_extensionP @P = K::lift(shiftP);
  let shift_extensionV @V = K::lift(shiftV);
  let geometryP @P = coset::coset_domain(shift_extensionP, sizeP);
  let geometryV @V = coset::coset_domain(shift_extensionV, sizeV);
  let trace_extension @P = K::embed(trace_lde);
  let dataP @P = K::embed(statementP.public_data);
  let dataV @V = K::embed(statementV.public_data);
  let quotient @P = quotient_values<K::Extension,Table,B>(trace_extension, K::embed(config_lde),
    K::embed(public_lde), dataP, heightP, shift_extensionP, sizeP, alphaP);
  let chunks @P = split_quotient(quotient, shift_extensionP, sizeP, heightP, factsP.chunks);
  let quotient_tree @P = K::commit_extension(transpose(chunks, factsP.chunks, sizeP), factsP.chunks);
  let quotient_root = send P -> V(quotient_tree.0);

  // One out-of-domain point. Both roles stop unless it avoids the trace
  // subgroup and the evaluation coset; rotations by the trace generator stay
  // outside the coset.
  let zetaDraw = coins.draw();
  let zetaSent = send V -> P(zetaDraw);
  let zetaV @V = K::challenge(zetaDraw);
  let zetaP @P = K::challenge(zetaSent);
  require @V outside_domains(heightV, sizeV, shift_extensionV, zetaV);
  require @P outside_domains(heightP, sizeP, shift_extensionP, zetaP);
  let slotsP @P = degree_inputs(inputs<K::Extension,Table,B>(heightP), factsP.witness);
  let slotsV @V = degree_inputs(inputs<K::Extension,Table,B>(heightV), factsV.witness);
  let proposed @P = input_values(slotsP, K::embed(trace_columns), K::embed(configP),
    K::embed(publicP), dataP, heightP, zetaP);
  let proposed_quotient @P = opening_claims(coset::column_batch(geometryP, factsP.chunks, chunks), zetaP);
  let opened = send P -> V(proposed);
  let opened_quotient = send P -> V(proposed_quotient);
  require @V length(opened) == zkc::indices::length(slotsV.kind);
  require @V identity<K::Extension,Table,B>(zkc::vector::slice(opened, 0, factsV.inputs),
    opened_quotient, K::embed(configV),
    K::embed(publicV), dataV, heightV, zetaV, alphaV);

  // DEEP batching of all covered witness columns and quotient chunks. The
  // fresh linear factor raises the honest quotient bound < n-1 to FRI's < n;
  // it is not a deterministic multiplication by X on a coset word.
  let gammaDraw = coins.draw();
  let gammaSent = send V -> P(gammaDraw);
  let gammaV @V = K::challenge(gammaDraw);
  let gammaP @P = K::challenge(gammaSent);
  let adjustmentDraw = coins.draw();
  let adjustmentSent = send V -> P(adjustmentDraw);
  let adjustmentV @V = K::challenge(adjustmentDraw);
  let adjustmentP @P = K::challenge(adjustmentSent);
  let chunk_openingsP @P = same_rotation(factsP.chunks, 0);
  let witness_batch @P = coset::column_batch(geometryP, factsP.witness, trace_extension);
  let reads @P = read_quotients(slotsP, witness_batch, proposed, heightP,
    zetaP, gammaP, fill<K::Extension>(0, sizeP), 1);
  let chunk_batch @P = coset::column_batch(geometryP, factsP.chunks, chunks);
  let chunk_bounds @P = opening_context::bind_openings(geometryP, factsP.chunks, heightP, zetaP,
    zkc::opening_claims::checked(chunk_openingsP.0, chunk_openingsP.1, proposed_quotient));
  let initial @P = opening_context::vector_accumulator(geometryP, gammaP, reads.0, reads.1);
  let word @P = deep_columns(chunk_batch, chunk_bounds, initial);
  let adjusted @P = zkc::vector::hadamard(opening_context::vector_values(word),
    zkc::vector::add(fill<K::Extension>(1, sizeP),
      zkc::vector::scale(coset::points(shift_extensionP, sizeP), adjustmentP)));
  let committed <- Commit<FriConfiguration<K>,LogFinal+Rounds+LogBlowup,LogFinal,Rounds>(
    adjusted, shift_extensionP, shift_extensionV, index<Rounds>(), coins);
  let prover @P = ProverOpenings<K> { trace: trace_tree.1,
    quotient: quotient_tree.1, size: sizeP };
  let verifier @V = VerifierOpenings<K> { trace: trace_root, quotient: quotient_root,
    facts: factsV, slots: slotsV, opened, opened_quotient, height: heightV, size: sizeV,
    geometry: geometryV, zeta: zetaV, gamma: gammaV, adjustment: adjustmentV };
  return (committed = committed, prover = prover, verifier = verifier);
}

protocol Complete<K: Configuration, LogFinal: nat, Rounds: nat, LogBlowup: nat,
                  Queries: nat> roles(P,V)
    (fri_state: QueryState<FriConfiguration<K>,LogFinal+Rounds+LogBlowup,LogFinal,Rounds,Queries> @P->V,
     prover: ProverOpenings<K> @P, verifier: VerifierOpenings<K> @V)
    -> (accepted: bool @V)
    where zkc::algebra::TwoAdicField(K::Extension),
      zkc::algebra::CharacteristicNotTwo(K::Extension),
      zkc::oracle::VectorCommitment(K::ExtensionRows),
      LogFinal+Rounds+LogBlowup <= 63, 1 <= Rounds, 1 <= LogBlowup, 1 <= Queries {
  let positions <- Positions<FriConfiguration<K>,LogFinal+Rounds+LogBlowup,LogFinal,Rounds,Queries>(fri_state);
  let positionsP @P = positions;
  let positionsV @V = positions;
  let sizeP @P = prover.size;
  let trace_root @V = verifier.trace;
  let quotient_root @V = verifier.quotient;
  let factsV @V = verifier.facts;
  let slotsV @V = verifier.slots;
  let opened @V = verifier.opened;
  let opened_quotient @V = verifier.opened_quotient;
  let heightV @V = verifier.height;
  let sizeV @V = verifier.size;
  let geometryV @V = verifier.geometry;
  let zetaV @V = verifier.zeta;
  let gammaV @V = verifier.gamma;
  let adjustmentV @V = verifier.adjustment;
  // Openings, after every request.
  let trace_open @P = K::open_base(prover.trace, positionsP, sizeP);
  let quotient_open @P = K::open_extension(prover.quotient, positionsP, sizeP);
  let trace_rows = send P -> V(trace_open.0);
  let trace_proof = send P -> V(trace_open.1);
  let quotient_rows = send P -> V(quotient_open.0);
  let quotient_proof = send P -> V(quotient_open.1);
  require @V K::check_base(trace_root, factsV.witness, sizeV, positionsV, trace_rows, trace_proof);
  require @V K::check_extension(quotient_root, factsV.chunks, sizeV, positionsV, quotient_rows,
    quotient_proof);
  let first @V = deep_values(slotsV, same_rotation(factsV.chunks, 0), K::embed(trace_rows),
    factsV.witness, quotient_rows, factsV.chunks, opened, opened_quotient, heightV,
    geometryV, positionsV, zetaV, gammaV, adjustmentV);
  // QueryAssociated reads this state's initial handle at the very positions
  // used above, then checks each authenticated value against the DEEP equation
  // before its fold chain. No supplied sibling replaces that equality.
  let accepted <- QueryAssociated<FriConfiguration<K>,LogFinal+Rounds+LogBlowup,LogFinal,Rounds,Queries>(
    fri_state, first);
  return (accepted = accepted);
}

// The sampler is explicit in the entrypoint. Reduction, commitment, query
// association and authentication have one implementation shared by both laws.
pub protocol ScalarTableArgument<K: Configuration, Table: nat, B: Bundle, LogFinal: nat,
    Rounds: nat, LogBlowup: nat, Queries: nat> roles(P,V)
    (trace: Vector<K::Base> @P, statementP: Statement<K::Base> @P,
     statementV: Statement<K::Base> @V, coins: Random<K::Challenge> @V)
    -> (accepted: bool @V)
    where zkc::algebra::TwoAdicField(K::Base), zkc::algebra::TwoAdicField(K::Extension),
      zkc::algebra::CharacteristicNotTwo(K::Extension), zkc::random::IndexRandomness(K::Challenge),
      zkc::oracle::VectorCommitment(K::ExtensionRows),
      LogFinal+Rounds+LogBlowup <= 63, 1 <= Rounds, 1 <= LogBlowup, 1 <= Queries {
  let (committed, prover, verifier) <- Prepare<K,Table,B,LogFinal,Rounds,LogBlowup>(
    trace, statementP, statementV, coins);
  #[site(fri_queries)]
  let positions <- ScalarQueries<K::Challenge,LogFinal+Rounds+LogBlowup,Queries>(index<Queries>(), coins);
  let fri_state <- BindQueries<FriConfiguration<K>,LogFinal+Rounds+LogBlowup,LogFinal,Rounds,Queries>(
    committed, positions);
  let accepted <- Complete<K,LogFinal,Rounds,LogBlowup,Queries>(fri_state, prover, verifier);
  return (accepted = accepted);
}

// The sampler is explicit in the entrypoint. Reduction, commitment, query
// association and authentication have one implementation shared by both laws.
pub protocol BlockTableArgument<K: Configuration, Table: nat, B: Bundle, LogFinal: nat,
    Rounds: nat, LogBlowup: nat, Queries: nat> roles(P,V)
    (trace: Vector<K::Base> @P, statementP: Statement<K::Base> @P,
     statementV: Statement<K::Base> @V, coins: Random<K::Challenge> @V)
    -> (accepted: bool @V)
    where zkc::algebra::TwoAdicField(K::Base), zkc::algebra::TwoAdicField(K::Extension),
      zkc::algebra::CharacteristicNotTwo(K::Extension), zkc::random::IndexBlockRandomness(K::Challenge),
      zkc::oracle::VectorCommitment(K::ExtensionRows),
      LogFinal+Rounds+LogBlowup <= 63, 1 <= Rounds, 1 <= LogBlowup, 1 <= Queries {
  let (committed, prover, verifier) <- Prepare<K,Table,B,LogFinal,Rounds,LogBlowup>(
    trace, statementP, statementV, coins);
  #[site(fri_queries)]
  let positions <- BlockQueries<K::Challenge,LogFinal+Rounds+LogBlowup,Queries>(index<Queries>(), coins);
  let fri_state <- BindQueries<FriConfiguration<K>,LogFinal+Rounds+LogBlowup,LogFinal,Rounds,Queries>(
    committed, positions);
  let accepted <- Complete<K,LogFinal,Rounds,LogBlowup,Queries>(fri_state, prover, verifier);
  return (accepted = accepted);
}
