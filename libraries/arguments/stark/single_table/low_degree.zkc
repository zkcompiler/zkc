module stark::single_table::low_degree;
use stark::configurations::contract::{Configuration};
use fri as fri;

// Preserve the configuration's ordinary challenge conversion, including the
// installed octic-to-quartic projection. This adapter owns no FRI rounds,
// commitments, pair layout, query implementation or randomness theorem.
pub module FriConfiguration<K: Configuration>: fri::Configuration {
  type Value: Field = K::Extension;
  type Challenge: Field = K::Challenge;
  fn challenge(draw: K::Challenge) -> K::Extension effects(stop) where () {
    return K::challenge(draw);
  }
}
