module stark::single_table::low_degree;
use stark::configurations::contract::{Configuration};
use zkc::vector::{Vector, length, get, append, empty, concat, fill};
use zkc::indices::{Indices, less, divide, remainder};
use zkc::indices as indices;
use zkc::oracle as oracle;
use zkc::oracle::{Roots, States};
use zkc::coset as coset;
use zkc::polynomial as polynomial;
use zkc::scalar as scalar;
use fri::{fold_value};

// Binary FRI over a configuration's extension field, in two parts so that the
// caller can open its own commitments between them. The word lives on the
// coset shift*<g_N>, N = 2^(LogFinal + Rounds + LogBlowup), in natural order;
// the test bound is degree < 2^(LogFinal + Rounds).
//
// Commit: each round commits the current word as pair leaves, then draws its
// fold challenge. The 2^LogFinal coefficients of the last word's polynomial
// follow the last round. Then every query position is drawn, consecutively,
// before any opening. Open: one pruned multi-opening per layer, for all
// queries. The verifier supplies each query's first-layer value from its own
// opening equation, receives only the sibling of every pair, and checks the
// reconstructed leaves, the fold chain and the final polynomial.

fn padded<F: Field>(coefficients: Vector<F>, count: index) -> Vector<F> {
  require !less(count, length(coefficients));
  return concat(coefficients, fill<F>(0, count - length(coefficients)));
}

pub protocol Commit<K: Configuration, LogFinal: nat, Rounds: nat, LogBlowup: nat,
                    Queries: nat> roles(P,V)
    (word: Vector<K::Extension> @P, shift: K::Base @P, coins: Random<K::Challenge> @V)
    -> (statesP: States<K::ExtensionRows> @P, positionsP: Indices @P,
        rootsV: Roots<K::ExtensionRows> @V, betasV: Vector<K::Extension> @V,
        finalV: Vector<K::Extension> @V, positionsV: Indices @V)
    where zkc::algebra::TwoAdicField(K::Extension), zkc::algebra::CharacteristicNotTwo(K::Extension),
      zkc::random::IndexRandomness(K::Challenge), zkc::oracle::VectorCommitment(K::ExtensionRows),
      1 <= Rounds, 1 <= LogBlowup, 1 <= Queries {
  let size @P = index<pow2(LogFinal + Rounds + LogBlowup)>();
  require @P length(word) == size;
  let mut current @P = coset::word(word, K::lift(shift));
  let mut roots @V = oracle::roots<K::ExtensionRows>();
  let mut states @P = oracle::states<K::ExtensionRows>();
  let mut betas @V = empty<K::Extension>();
  for round in 0..index<Rounds>() roles(P,V) max Rounds {
    let layer @P = K::commit_pairs(coset::values(current));
    let root = send P -> V(layer.0);
    let kept_root @V = oracle::append_root(roots, root);
    let kept_state @P = oracle::append_state(states, layer.1);
    roots = kept_root;
    states = kept_state;
    let drawV = coins.draw();
    let drawP = send V -> P(drawV);
    let betaV @V = K::challenge(drawV);
    let betaP @P = K::challenge(drawP);
    let kept_beta @V = append(betas, betaV);
    betas = kept_beta;
    let next @P = coset::fold(current, betaP);
    current = next;
  }
  let proposed @P = padded(polynomial::coefficients(coset::interpolate(current)),
    index<pow2(LogFinal)>());
  let final = send P -> V(proposed);
  require @V length(final) == index<pow2(LogFinal)>();
  let mut positionsP @P = indices::empty();
  let mut positionsV @V = indices::empty();
  for query in 0..index<Queries>() roles(P,V) max Queries {
    let positionV = coins.index<pow2(LogFinal + Rounds + LogBlowup)>();
    let positionP = send V -> P(positionV);
    let rememberedP @P = indices::append(positionsP, positionP);
    let rememberedV @V = indices::append(positionsV, positionV);
    positionsP = rememberedP;
    positionsV = rememberedV;
  }
  return (statesP = states, positionsP = positionsP, rootsV = roots, betasV = betas,
          finalV = final, positionsV = positionsV);
}

// Pair k of a word of length 2*half holds positions k and k + half.
fn pair_indices(positions: Indices, half: index) -> Indices {
  let mut result = indices::empty();
  for query in 0..indices::length(positions) {
    result = indices::append(result, remainder(indices::get(positions, query), half));
  }
  return result;
}
fn sibling_values<F: Field>(rows: Vector<F>, positions: Indices, half: index) -> Vector<F> {
  let mut result = empty<F>();
  for query in 0..indices::length(positions) {
    let lower = less(indices::get(positions, query), half);
    result = append(result, if lower { get(rows, 2 * query + 1) } else { get(rows, 2 * query) });
  }
  return result;
}
fn leaves<F: Field>(own: Vector<F>, siblings: Vector<F>, positions: Indices, half: index)
    -> Vector<F> {
  let mut result = empty<F>();
  for query in 0..indices::length(positions) {
    let value = get(own, query);
    let sibling = get(siblings, query);
    if less(indices::get(positions, query), half) {
      result = append(append(result, value), sibling);
    } else {
      result = append(append(result, sibling), value);
    }
  }
  return result;
}
// Row (f(x), f(-x)) folds to f_even(x^2) + beta * f_odd(x^2), where x is the
// query's point when it lies in the lower half and -x otherwise.
fn fold_leaves<F: Field>(rows: Vector<F>, points: Vector<F>, positions: Indices,
    half: index, beta: F) -> Vector<F> {
  let inverse_two = scalar::inverse<F>(1 + 1);
  let mut result = empty<F>();
  for query in 0..indices::length(positions) {
    let point = get(points, query);
    let lower = if less(indices::get(positions, query), half) { point } else { 0 - point };
    result = append(result, fold_value(get(rows, 2 * query), get(rows, 2 * query + 1), beta,
      inverse_two, scalar::inverse<F>(lower)));
  }
  return result;
}
fn squares<F: Field>(points: Vector<F>) -> Vector<F> {
  let mut result = empty<F>();
  for query in 0..length(points) {
    let point = get(points, query);
    result = append(result, point * point);
  }
  return result;
}
// The coset points of natural positions, in query order.
pub fn query_points<F: Field>(shift: F, size: index, positions: Indices) -> Vector<F> effects(stop) where zkc::algebra::TwoAdicField(F) {
  let mut result = empty<F>();
  for query in 0..indices::length(positions) {
    result = append(result, coset::point<F>(shift, size, indices::get(positions, query)));
  }
  return result;
}
fn final_values<F: Field>(coefficients: Vector<F>, points: Vector<F>, values: Vector<F>) -> bool {
  let value = polynomial::from_coefficients(coefficients);
  let mut equal = true;
  for query in 0..length(points) {
    equal = equal && polynomial::evaluate(value, get(points, query)) == get(values, query);
  }
  return equal;
}

pub protocol Open<K: Configuration, LogFinal: nat, Rounds: nat, LogBlowup: nat,
                  Queries: nat> roles(P,V)
    (statesP: States<K::ExtensionRows> @P, positionsP: Indices @P,
     rootsV: Roots<K::ExtensionRows> @V, betasV: Vector<K::Extension> @V,
     finalV: Vector<K::Extension> @V, positionsV: Indices @V,
     firstV: Vector<K::Extension> @V, shift: K::Base @V)
    -> (accepted: bool @V)
    where zkc::algebra::TwoAdicField(K::Extension), zkc::algebra::CharacteristicNotTwo(K::Extension),
      zkc::oracle::VectorCommitment(K::ExtensionRows), 1 <= Rounds, 1 <= LogBlowup, 1 <= Queries {
  let initial @V = index<pow2(LogFinal + Rounds + LogBlowup)>();
  require @V both_lengths(indices::length(positionsV), length(firstV), index<Queries>());
  let mut atP @P = positionsP;
  let mut atV @V = positionsV;
  let mut sizeP @P = index<pow2(LogFinal + Rounds + LogBlowup)>();
  let mut sizeV @V = initial;
  let mut own @V = firstV;
  let mut points @V = query_points<K::Extension>(K::lift(shift), initial, positionsV);
  for round in 0..index<Rounds>() roles(P,V) max Rounds {
    let nextP @P = divide(sizeP, 2);
    let pairsP @P = pair_indices(atP, nextP);
    let opened @P = K::open_pairs(oracle::state_at(statesP, round), pairsP, nextP);
    let proposed @P = sibling_values(opened.0, atP, nextP);
    let sent = send P -> V(proposed);
    let proof = send P -> V(opened.1);
    let nextV @V = divide(sizeV, 2);
    let pairsV @V = pair_indices(atV, nextV);
    require @V length(sent) == index<Queries>();
    let rows @V = leaves(own, sent, atV, nextV);
    let authentic @V = K::check_pairs(oracle::root_at(rootsV, round), nextV, pairsV, rows, proof);
    require @V authentic;
    let folded @V = fold_leaves(rows, points, atV, nextV, get(betasV, round));
    let squared @V = squares(points);
    own = folded;
    points = squared;
    atV = pairsV;
    atP = pairsP;
    sizeV = nextV;
    sizeP = nextP;
  }
  let terminal @V = final_values(finalV, points, own);
  require @V terminal;
  let accepted @V = true;
  return (accepted = accepted);
}

fn both_lengths(positions: index, values: index, expected: index) -> bool {
  return positions == expected && values == expected;
}
