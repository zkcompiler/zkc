module stark::configurations::koala_bear_quartic;
use stark::configurations::contract::{Configuration};
use zkc::vector::{Vector};
use zkc::indices::{Indices};
use zkc::oracle as oracle;
use zkc::oracle::{Root, Path, State};
use zkc::bytes as bytes;
use zkc::encoding as encoding;

pub domain Base = field("koala-bear");
pub domain Challenge = field("koala-bear.ext8-binomial3");
pub domain Quartic = field("koala-bear.ext4-binomial3");
pub domain KoalaBearRows = commitment("rows.merkle-poseidon2-16.koala-bear/0");
pub domain QuarticRows = commitment("rows.merkle-poseidon2-16.koala-bear.ext4-binomial3/0");

// KoalaBear trace rows, quartic-extension challenges and FRI, width-16
// Poseidon2 Merkle trees with pruned multi-openings, natural-order outer
// rows and the coset shift 3.
// FRI authentication and layout are selected separately by deployment.
//
// Challenges come from the octic KoalaBear Merlin suite, the installed suite
// with a KoalaBear challenge field. Its draws have independently
// rejection-sampled coordinates, so the first four coordinates of a uniform
// octic draw are a uniform quartic element. A transcript suite that draws
// quartic elements directly replaces this one member.
pub module Poseidon2: Configuration {
  type Base: Field = stark::configurations::koala_bear_quartic::Base;
  type Extension: Field = Quartic;
  type Challenge: Field = stark::configurations::koala_bear_quartic::Challenge;
  type BaseRows: Commitment = KoalaBearRows;
  type ExtensionRows: Commitment = QuarticRows;

  fn challenge(draw: Challenge) -> Quartic effects(stop) where () {
    let words = encoding::field_le<Challenge>(draw);
    let (valid, value) = encoding::field_from_le<Quartic>(bytes::slice(words, 0, 16));
    require valid;
    return value;
  }
  fn embed(values: Vector<Base>) -> Vector<Quartic> effects(stop) where () {
    return kernel<Quartic>("vector.embed", values);
  }
  fn lift(value: Base) -> Quartic effects(stop) where () { return kernel<Quartic>("field.embed", value); }
  // A generator of the multiplicative group; no power of it lies in a
  // proper two-adic subgroup of the field.
  fn shift() -> Base effects() where () { return 3; }

  fn commit_base(rows: Vector<Base>, width: index)
      -> (Root<KoalaBearRows>, State<KoalaBearRows>) effects(stop) where () {
    return oracle::commit<KoalaBearRows>(rows, width);
  }
  fn open_base(state: State<KoalaBearRows>, positions: Indices, height: index)
      -> (Vector<Base>, Path<KoalaBearRows>) effects(stop) where () {
    return oracle::open_many<KoalaBearRows>(state, positions);
  }
  fn check_base(root: Root<KoalaBearRows>, width: index, height: index,
      positions: Indices, rows: Vector<Base>,
      proof: Path<KoalaBearRows>) -> bool effects(stop) where () {
    return oracle::check_many<KoalaBearRows>(root, width, height, positions, rows, proof);
  }
  fn commit_extension(rows: Vector<Quartic>, width: index) -> (Root<QuarticRows>, State<QuarticRows>) effects(stop) where () {
    return oracle::commit<QuarticRows>(rows, width);
  }
  fn open_extension(state: State<QuarticRows>, positions: Indices, height: index)
      -> (Vector<Quartic>, Path<QuarticRows>) effects(stop) where () {
    return oracle::open_many<QuarticRows>(state, positions);
  }
  fn check_extension(root: Root<QuarticRows>, width: index, height: index, positions: Indices,
      rows: Vector<Quartic>, proof: Path<QuarticRows>) -> bool effects(stop) where () {
    return oracle::check_many<QuarticRows>(root, width, height, positions, rows, proof);
  }
}
