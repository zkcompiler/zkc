module stark::configurations::goldilocks_quadratic;
use stark::configurations::contract::{Configuration, natural_pairs};
use zkc::vector::{Vector};
use zkc::indices::{Indices};
use zkc::oracle as oracle;
use zkc::oracle::{Root, Path, State};

pub domain Base = field("goldilocks");
pub domain Extension = field("goldilocks.ext2-binomial7");
pub domain BaseRows = commitment("rows.merkle-poseidon2-8.goldilocks/0");
pub domain ExtensionRows = commitment("rows.merkle-poseidon2-8.goldilocks.ext2-binomial7/0");

// Natural-order rows and FRI pairs, width-8 Poseidon2 with pruned
// multi-openings, and the primitive base-field coset shift 7.
// The selected transcript draws this extension directly.
pub module Poseidon2: Configuration {
  type Base: Field = stark::configurations::goldilocks_quadratic::Base;
  type Extension: Field = stark::configurations::goldilocks_quadratic::Extension;
  type Challenge: Field = stark::configurations::goldilocks_quadratic::Extension;
  type BaseRows: Commitment = stark::configurations::goldilocks_quadratic::BaseRows;
  type ExtensionRows: Commitment = stark::configurations::goldilocks_quadratic::ExtensionRows;

  fn challenge(draw: Challenge) -> Extension effects() where () { return draw; }
  fn embed(values: Vector<Base>) -> Vector<Extension> effects(stop) where () {
    return kernel<Extension>("vector.embed", values);
  }
  fn lift(value: Base) -> Extension effects(stop) where () { return kernel<Extension>("field.embed", value); }
  // A primitive multiplicative generator lies outside every two-adic subgroup.
  fn shift() -> Base effects() where () { return 7; }

  fn commit_base(rows: Vector<Base>, width: index)
      -> (Root<BaseRows>, State<BaseRows>) effects(stop) where () {
    return oracle::commit<BaseRows>(rows, width);
  }
  fn open_base(state: State<BaseRows>, positions: Indices, height: index)
      -> (Vector<Base>, Path<BaseRows>) effects(stop) where () {
    return oracle::open_many<BaseRows>(state, positions);
  }
  fn check_base(root: Root<BaseRows>, width: index, height: index,
      positions: Indices, rows: Vector<Base>,
      proof: Path<BaseRows>) -> bool effects(stop) where () {
    return oracle::check_many<BaseRows>(root, width, height, positions, rows, proof);
  }
  fn commit_extension(rows: Vector<Extension>, width: index) -> (Root<ExtensionRows>, State<ExtensionRows>) effects(stop) where () {
    return oracle::commit<ExtensionRows>(rows, width);
  }
  fn open_extension(state: State<ExtensionRows>, positions: Indices, height: index)
      -> (Vector<Extension>, Path<ExtensionRows>) effects(stop) where () {
    return oracle::open_many<ExtensionRows>(state, positions);
  }
  fn check_extension(root: Root<ExtensionRows>, width: index, height: index, positions: Indices,
      rows: Vector<Extension>, proof: Path<ExtensionRows>) -> bool effects(stop) where () {
    return oracle::check_many<ExtensionRows>(root, width, height, positions, rows, proof);
  }
  fn commit_pairs(word: Vector<Extension>) -> (Root<ExtensionRows>, State<ExtensionRows>) effects(stop) where () {
    return oracle::commit<ExtensionRows>(natural_pairs(word), 2);
  }
  fn open_pairs(state: State<ExtensionRows>, pairs: Indices, half: index)
      -> (Vector<Extension>, Path<ExtensionRows>) effects(stop) where () {
    return oracle::open_many<ExtensionRows>(state, pairs);
  }
  fn check_pairs(root: Root<ExtensionRows>, half: index, pairs: Indices, rows: Vector<Extension>,
      proof: Path<ExtensionRows>) -> bool effects(stop) where () {
    return oracle::check_many<ExtensionRows>(root, 2, half, pairs, rows, proof);
  }
}
