module schnorr;

pub relation DLog<G: Group>(parameter base: G, statement point: G,
                           witness scalar: G::Scalar) {
  return point == base * scalar;
}

pub protocol Schnorr<G: Group+Share+Wire> roles(P, V)
    (base: G @(P,V), point: G @(P,V), scalar: G::Scalar @P,
     nonces: Random<G::Scalar> @P, challenges: Random<G::Scalar> @V)
    -> (accepted: bool @V)
    where Share(G::Scalar), Wire(G::Scalar)
    spec {
      target knowledge = DLog<G>(in.base@V, in.point@V, in.scalar)
        accept out.accepted;
    } {
  let nonce = nonces.draw();
  #[site(commitment)] let commitment = send P -> V(base * nonce);
  #[site(challenge)] let challenge = challenges.draw();
  #[site(delivery)] let received = send V -> P(challenge);
  #[site(response)] let response = send P -> V(nonce + received * scalar);
  let accepted = base * response == commitment + point * challenge;
  return (accepted = accepted);
}
