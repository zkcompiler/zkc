module spongefish;
use zkc::bytes as bytes;
use zkc::bytes::{Bytes};
use zkc::shake128 as shake;
use zkc::shake128::{State};
use zkc::encoding as encoding;

// Spongefish 0.7.4 StdHash initialization. Tags are bytes supplied by the
// application; the protocol identifier occupies a full SHAKE128 rate block.
fn pad(value: Bytes, width: index) -> Bytes {
  require !kernel("index.less", width, bytes::length(value));
  let mut result = value;
  for _ in bytes::length(value)..width { result = bytes::append(result, 0); }
  return result;
}
fn session_tag() -> Bytes {
  // ASCII "fiat-shamir/session-id".
  let mut result = bytes::empty();
  result = bytes::append(result, 102);
  result = bytes::append(result, 105);
  result = bytes::append(result, 97);
  result = bytes::append(result, 116);
  result = bytes::append(result, 45);
  result = bytes::append(result, 115);
  result = bytes::append(result, 104);
  result = bytes::append(result, 97);
  result = bytes::append(result, 109);
  result = bytes::append(result, 105);
  result = bytes::append(result, 114);
  result = bytes::append(result, 47);
  result = bytes::append(result, 115);
  result = bytes::append(result, 101);
  result = bytes::append(result, 115);
  result = bytes::append(result, 115);
  result = bytes::append(result, 105);
  result = bytes::append(result, 111);
  result = bytes::append(result, 110);
  result = bytes::append(result, 45);
  result = bytes::append(result, 105);
  result = bytes::append(result, 100);
  return pad(result, 168);
}
pub fn initialize(protocol_id: Bytes, session: Bytes) -> State {
  require !kernel("index.less", 64, bytes::length(protocol_id));
  let root = shake::absorb(shake::init(), pad(protocol_id, 168));
  let session_state = shake::absorb(shake::init(), session_tag());
  let session_state = shake::absorb(session_state, session);
  let (_, digest) = shake::squeeze(session_state, 32);
  return shake::absorb(root, bytes::concat(pad(bytes::empty(), 32), digest));
}
pub fn observe_point<G: Group>(state: State, value: G) -> State {
  return shake::absorb(state, encoding::group_compressed(value));
}
pub fn observe_scalar<F: Field>(state: State, value: F) -> State {
  return shake::absorb(state, encoding::field_be(value));
}
pub fn challenge<F: Field>(state: State) -> (State, F) {
  let (next, sampled) = shake::squeeze(state, 64);
  return (next, encoding::field_reduce_be<F>(sampled));
}
pub fn read_point<G: Group>(state: State, proof: Bytes, offset: index) -> (State, G) {
  let (valid, value) = encoding::group_from_compressed<G>(bytes::slice(proof, offset, 48));
  require valid;
  return (observe_point(state, value), value);
}
pub fn read_scalar<F: Field>(state: State, proof: Bytes, offset: index) -> (State, F) {
  let (valid, value) = encoding::field_from_be<F>(bytes::slice(proof, offset, 32));
  require valid;
  return (observe_scalar(state, value), value);
}
