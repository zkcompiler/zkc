module zkc::pairing;
use zkc::primitives::curve::{Groups};

// The pairing contracts name only the field's associated groups in their
// ports, so these wrappers supply the field explicitly.

// Whether the product of the pairings of corresponding entries is the target
// identity. Lengths must be equal; the empty product is the identity.
pub fn check<F: Field>(left: Groups<F::PairingG1>, right: Groups<F::PairingG2>) -> bool
    effects(stop) where zkc::algebra::PairingField(F) {
  return kernel<F>("pairing.check", left, right);
}

// The bilinear pairing in the prime-order target group, after final exponentiation.
pub fn apply<F: Field>(left: F::PairingG1, right: F::PairingG2) -> F::PairingGT
    effects(stop) where zkc::algebra::PairingField(F), zkc::curve::ScalarAction(F::PairingGT) {
  return kernel<F>("pairing.apply", left, right);
}
