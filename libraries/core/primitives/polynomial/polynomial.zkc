module zkc::polynomial;
use zkc::primitives::vector::{Vector};

// Runtime univariate coefficients, distinct from formal polynomial expressions.
pub type Polynomial<F: Field> = builtin("polynomial", F);
pub fn from_coefficients<F: Field>(values: Vector<F>) -> Polynomial<F> effects(stop) where () {
  return kernel<F>("poly.from_coefficients", values);
}
pub fn evaluate<F: Field>(value: Polynomial<F>, point: F) -> F effects(stop) where () {
  return kernel<F>("poly.univariate_evaluate", value, point);
}
pub fn boundary<F: Field>(value: Polynomial<F>) -> F effects(stop) where () {
  return kernel<F>("poly.univariate_boundary", value);
}

pub fn coefficients<F: Field>(value: Polynomial<F>) -> Vector<F> effects(stop) where () { return kernel<F>("poly.coefficients", value); }
