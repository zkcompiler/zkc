module zkc::primitives::coset;
use zkc::primitives::vector::{Vector};
use zkc::polynomial::{Polynomial};

pub fn point<F:Field>(shift:F,size:index,position:index)->F = primitive("poly.domain_point");
pub fn root<F:Field>(size:index)->F = primitive("poly.domain_root");
pub fn points<F:Field>(shift:F,size:index)->Vector<F> = primitive("poly.domain_points");
pub fn interpolate<F:Field>(values:Vector<F>,shift:F)->Polynomial<F> = primitive("poly.coset_interpolate");
pub fn evaluate<F:Field>(value:Polynomial<F>,shift:F,size:index)->Vector<F> = primitive("poly.coset_evaluate");
pub fn extend<F:Field>(values:Vector<F>,width:index,height:index,input_shift:F,output_shift:F,size:index)->Vector<F> = primitive("poly.coset_extend");
pub fn evaluate_at<F:Field>(values:Vector<F>,width:index,height:index,shift:F,position:F)->Vector<F> = primitive("poly.coset_evaluate_at");
pub fn fold<F:Field>(values:Vector<F>,shift:F,beta:F)->Vector<F> = primitive("poly.even_odd_fold");
pub fn opening_quotient<F:Field>(entries:Vector<F>,shift:F,at:F,value:F)->Vector<F> = primitive("poly.opening_quotient");
