use zkc::transport::{NativeMessage}

pub interface Relay:
    protocol pass<T: Type> roles(P, V)(x: T @P) -> T @V effects() where NativeMessage(T)

pub module NativeRelay: Relay:
    protocol pass<U: Type> roles(A, B)(x: U @A) -> U @B where NativeMessage(U):
        y <- send x to B
        return y

pub protocol Forward<T: Type, C: Relay> roles(P, V)(x: T @P) -> T @V where NativeMessage(T):
    y <- C::pass<T>(x) @(P, V)
    return y
