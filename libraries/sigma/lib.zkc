module sigma;

pub relation DLogPair<G: Group>(parameter first_base: G, statement first_point: G,
                                parameter second_base: G, statement second_point: G,
                                witness first_scalar: G::Scalar,
                                witness second_scalar: G::Scalar) {
  return first_point == first_base * first_scalar && second_point == second_base * second_scalar;
}

pub relation DLogEquality<G: Group>(parameter first_base: G, statement first_point: G,
                                    parameter second_base: G, statement second_point: G,
                                    witness scalar: G::Scalar) {
  return first_point == first_base * scalar && second_point == second_base * scalar;
}

pub protocol SchnorrAnd<G: Group> roles(P, V)
    (first_base: G @(P,V), first_point: G @(P,V),
     second_base: G @(P,V), second_point: G @(P,V),
     first_scalar: G::Scalar @P, second_scalar: G::Scalar @P,
     nonces: Random<G::Scalar> @P, challenges: Random<G::Scalar> @V)
    -> (accepted: bool @V)
    spec {
      target knowledge = DLogPair<G>(in.first_base@V, in.first_point@V,
                                     in.second_base@V, in.second_point@V,
                                     in.first_scalar, in.second_scalar)
        accept out.accepted;
    } {
  let first_nonce = nonces.draw();
  let second_nonce = nonces.draw();
  #[site(first_commitment)] let first_commitment = send P -> V(first_base * first_nonce);
  #[site(second_commitment)] let second_commitment = send P -> V(second_base * second_nonce);
  #[site(challenge)] let challenge = challenges.draw();
  #[site(delivery)] let received = send V -> P(challenge);
  #[site(first_response)] let first_response = send P -> V(first_nonce + received * first_scalar);
  #[site(second_response)] let second_response =
    send P -> V(second_nonce + received * second_scalar);
  let accepted = first_base * first_response == first_commitment + first_point * challenge
    && second_base * second_response == second_commitment + second_point * challenge;
  return (accepted = accepted);
}

pub protocol ChaumPedersen<G: Group> roles(P, V)
    (first_base: G @(P,V), first_point: G @(P,V),
     second_base: G @(P,V), second_point: G @(P,V),
     scalar: G::Scalar @P,
     nonces: Random<G::Scalar> @P, challenges: Random<G::Scalar> @V)
    -> (accepted: bool @V)
    spec {
      target knowledge = DLogEquality<G>(in.first_base@V, in.first_point@V,
                                         in.second_base@V, in.second_point@V, in.scalar)
        accept out.accepted;
    } {
  let nonce = nonces.draw();
  #[site(first_commitment)] let first_commitment = send P -> V(first_base * nonce);
  #[site(second_commitment)] let second_commitment = send P -> V(second_base * nonce);
  #[site(challenge)] let challenge = challenges.draw();
  #[site(delivery)] let received = send V -> P(challenge);
  #[site(response)] let response = send P -> V(nonce + received * scalar);
  let accepted = first_base * response == first_commitment + first_point * challenge
    && second_base * response == second_commitment + second_point * challenge;
  return (accepted = accepted);
}
