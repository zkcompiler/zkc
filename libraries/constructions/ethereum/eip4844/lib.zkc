module ethereum::eip4844;
use zkc::bytes as bytes;
use zkc::bytes::{Bytes};
use zkc::encoding as encoding;
use zkc::vector as vec;
use zkc::vector::{Vector};
use zkc::curve as curve;
use zkc::curve::{Groups};
use zkc::scalar as scalar;
use zkc::indices as indices;
use zkc::evaluation_domain as evaluation;
use zkc::evaluation_domain::{EvaluationDomain};
use zkc::proof::{Stream};
use zkc::pairing as pairing;

pub module transcript;

// EIP-4844 polynomial commitments, as specified by Ethereum's normative KZG
// functions (ethereum/cryptography-specs, EthCryptographySpecs/Kzg/Core.lean)
// and implemented by c-kzg-4844 v2.1.8. A blob is 4096 canonical 32-byte
// big-endian scalars; blob element i is the polynomial's value at
// roots()[i]. Commitments and proofs are 48-byte compressed G1 points.
pub domain F = field("bls12-381.fr");
pub domain G1 = group("bls12-381.g1");
pub domain G2 = group("bls12-381.g2");

// The low `width` bytes of a field element's 32-byte big-endian encoding.
// Byte constants below are written as integers this way.
fn word(value: F, width: index) -> Bytes {
  return bytes::slice(encoding::field_be<F>(value), 32 - width, width);
}
// An index as a `width`-byte big-endian integer; `width` is at most 32, and
// widths below 8 truncate.
fn integer(value: index, width: index) -> Bytes {
  return word(scalar::from_index<F>(value), width);
}
// "FSBLOBVERIFY_V1_", hex 4653424c4f425645524946595f56315f.
fn statement_tag() -> Bytes { return word(93478265029106206173025204607185727839, 16); }
// "RCKZGBATCH___V1_", hex 52434b5a4742415443485f5f5f56315f.
fn batch_tag() -> Bytes { return word(109346107877193368497902085645469626719, 16); }

// [tau] in G2: entry 1 of the G2 monomial points of the Ethereum KZG ceremony
// output (trusted_setup.txt beside this module), hex b5bfd7dd...20c1def2.
pub fn verifier_key() -> G2 effects(stop) where () {
  let high = bytes::concat(word(4456482016712906131089672928675071722038789079662468001704, 24),
    word(393241800224441641364328280344783217016623594907082792818, 24));
  let low = bytes::concat(word(597361946949406391845034008586228261317402208891527031497, 24),
    word(4006740001764314803285745872079905794031965694700191604466, 24));
  let (valid, point) = encoding::group_from_compressed<G2>(bytes::concat(high, low));
  require valid;
  return point;
}
// SHA-256 of the 4096 concatenated compressed G1 Lagrange points of that
// file, in file order: 52c7615a9bd3eb20df67eb5a81ee701c96787c82a5ff638740b54fbadfde960b.
fn setup_digest() -> Bytes {
  return bytes::concat(word(110031937301704083004775805315386863644, 16),
    word(200009800360587312626269816699486115339, 16));
}
// The prover's basis: the ceremony's 4096 G1 Lagrange points in file order.
// Only the pinned points are admitted, so commitments and proofs are those of
// the deployed setup.
pub fn admit_setup(setup: Groups<G1>) -> Groups<G1> effects(stop) where () {
  require curve::length(setup) == 4096;
  require bytes::equal(bytes::sha256(encoding::groups_compressed(setup)), setup_digest());
  return setup;
}

// The 4096th roots of unity in bit-reversed order: entry i is omega^rev(i)
// for omega = 7^((r-1)/4096). If R lists the 2^k-th roots in this order, then
// R ++ w R lists the 2^(k+1)-th roots, where w is a primitive 2^(k+1)-th root.
pub fn blob_domain() -> EvaluationDomain<F> effects(stop) where () {
  let omega: F = 39033254847818212395286706435128746857159659164139250548781411570340225835782;
  return evaluation::two_adic_bit_reversed(4096, omega);
}
pub fn roots() -> Vector<F> effects(stop) where () {
  return evaluation::points(blob_domain());
}

fn reverse3(row: index) -> index {
  let mut rest = row;
  let mut result: index = 0;
  for _ in 0..3 {
    result = 2 * result + indices::remainder(rest, 2);
    rest = indices::divide(rest, 2);
  }
  return result;
}
// The 64 rows of a 64 x 64 matrix in six-bit-reversed order: output row
// 8*high + low is input row 8*reverse3(low) + reverse3(high). Gathering blocks
// of eight rows before the outer concatenation copies about nine times the
// vector length, instead of about thirty-two for one growing vector.
fn reverse_rows(values: Vector<F>) -> Vector<F> {
  let mut result = vec::empty<F>();
  for high in 0..8 {
    let mut block = vec::empty<F>();
    for low in 0..8 {
      let row = 8 * reverse3(low) + reverse3(high);
      block = vec::concat(block, vec::slice(values, 64 * row, 64));
    }
    result = vec::concat(result, block);
  }
  return result;
}
// The bit-reversal permutation of 4096 = 64 x 64 entries. With an index split
// into six-bit halves (high, low), reversing all twelve bits sends it to
// (reverse(low), reverse(high)): reverse the rows, transpose, reverse again.
pub fn bit_reverse(values: Vector<F>) -> Vector<F> effects(stop) where () {
  require vec::length(values) == 4096;
  return reverse_rows(vec::transpose(reverse_rows(values), 64, 64));
}

// blob_to_polynomial: every element must be a canonical scalar.
pub fn blob_to_polynomial(blob: Bytes) -> Vector<F> effects(stop) where () {
  require bytes::length(blob) == 131072;
  let (valid, values) = encoding::fields_from_be<F>(blob);
  require valid;
  return values;
}
// bytes_to_kzg_commitment and bytes_to_kzg_proof: a canonical compressed
// point of the prime-order subgroup, including the encoding of infinity.
pub fn bytes_to_point(raw: Bytes) -> G1 effects(stop) where () {
  require bytes::length(raw) == 48;
  let (valid, value) = encoding::group_from_compressed<G1>(raw);
  require valid;
  return value;
}
// bytes_to_bls_field: a canonical 32-byte big-endian scalar.
pub fn bytes_to_scalar(raw: Bytes) -> F effects(stop) where () {
  let (valid, value) = encoding::field_from_be<F>(raw);
  require valid;
  return value;
}

// compute_challenge: SHA-256 of FSBLOBVERIFY_V1_, the 16-byte big-endian
// degree bound 4096, the blob and the commitment, reduced modulo r as a
// big-endian integer. This binds the evaluation point to the whole statement.
pub fn compute_challenge(blob: Bytes, commitment: Bytes) -> F effects(stop) where () {
  let header = bytes::concat(statement_tag(), integer(4096, 16));
  let data = bytes::concat(bytes::concat(header, blob), commitment);
  return encoding::field_reduce_be<F>(bytes::sha256(data));
}

// The commitment to blob values under the bit-reversed Lagrange basis: the
// basis is stored in natural order, so the values are bit-reversed instead.
fn commit_values(basis: Groups<G1>, values: Vector<F>) -> G1 {
  return curve::msm(bit_reverse(values), basis);
}

// e(commitment - [y], -[1]) * e(proof, [tau] - [z]) = 1 (verify_kzg_proof_impl).
pub fn check(commitment: G1, z: F, y: F, proof: G1) -> bool effects(stop) where () {
  let one = curve::generator<G1>();
  let two = curve::generator<G2>();
  let left = curve::append(curve::append(curve::empty<G1>(), commitment + curve::neg(one * y)),
    proof);
  let right = curve::append(curve::append(curve::empty<G2>(), curve::neg(two)),
    verifier_key() + curve::neg(two * z));
  return pairing::check<F>(left, right);
}
// A random linear combination of openings with weights r^i
// (verify_kzg_proof_batch):
// e(sum r^i proof_i, -[tau]) * e(sum r^i (commitment_i - [y_i] + z_i proof_i), [1]) = 1.
// The weights must be unpredictable to the prover when it fixes the proofs.
pub fn check_batch(commitments: Groups<G1>, zs: Vector<F>, ys: Vector<F>, proofs: Groups<G1>,
    r: F) -> bool effects(stop) where () {
  let n = curve::length(commitments);
  require curve::length(proofs) == n;
  require vec::length(zs) == n;
  require vec::length(ys) == n;
  let weights = vec::geometric(r, n);
  let proof_sum = curve::msm(weights, proofs);
  let shifted = curve::msm(weights, commitments)
    + curve::neg(curve::generator<G1>() * vec::dot(weights, ys))
    + curve::msm(vec::hadamard(weights, zs), proofs);
  let left = curve::append(curve::append(curve::empty<G1>(), proof_sum), shifted);
  let right = curve::append(curve::append(curve::empty<G2>(), curve::neg(verifier_key())),
    curve::generator<G2>());
  return pairing::check<F>(left, right);
}
// The opening proof at z and the value y = p(z), for an admitted basis.
pub fn opening(basis: Groups<G1>, values: Vector<F>, z: F) -> (G1, F) effects(stop) where () {
  let (quotient, y) = kzg::quotient(evaluation::evaluations(blob_domain(), values), z);
  return (commit_values(basis, quotient), y);
}

// blob_to_kzg_commitment.
pub fn blob_to_kzg_commitment(blob: Bytes, setup: Groups<G1>) -> Bytes effects(stop) where () {
  let values = blob_to_polynomial(blob);
  return encoding::group_compressed(commit_values(admit_setup(setup), values));
}
// compute_kzg_proof: the proof and the 32-byte big-endian value p(z).
pub fn compute_kzg_proof(blob: Bytes, z: Bytes, setup: Groups<G1>) -> (Bytes, Bytes) effects(stop) where () {
  let values = blob_to_polynomial(blob);
  let at = bytes_to_scalar(z);
  let (proof, y) = opening(admit_setup(setup), values, at);
  return (encoding::group_compressed(proof), encoding::field_be(y));
}
// verify_kzg_proof.
pub fn verify_kzg_proof(commitment: Bytes, z: Bytes, y: Bytes, proof: Bytes) -> bool effects(stop) where () {
  let c = bytes_to_point(commitment);
  let at = bytes_to_scalar(z);
  let value = bytes_to_scalar(y);
  return check(c, at, value, bytes_to_point(proof));
}

// The point evaluation precompile at address 0x0A. Its 192-byte input is
// versioned_hash, z, y, commitment and proof; the versioned hash is 0x01
// followed by the last 31 bytes of SHA-256 of the commitment. On success it
// returns 4096 and the scalar modulus as 32-byte big-endian integers; any
// failed check stops.
pub fn point_evaluation(input: Bytes) -> Bytes effects(stop) where () {
  require bytes::length(input) == 192;
  let commitment = bytes::slice(input, 96, 48);
  let versioned = bytes::concat(word(1, 1), bytes::slice(bytes::sha256(commitment), 1, 31));
  require bytes::equal(versioned, bytes::slice(input, 0, 32));
  require verify_kzg_proof(commitment, bytes::slice(input, 32, 32), bytes::slice(input, 64, 32),
    bytes::slice(input, 144, 48));
  // r = 0x73eda753299d7d483339d80809a1d805_53bda402fffe5bfeffffffff00000001.
  let modulus = bytes::concat(word(154095187621958656428822154526901524485, 16),
    word(111310594309268602877181240610339684353, 16));
  return bytes::concat(integer(4096, 32), modulus);
}

// Local entry points for the blob and point functions of EIP-4844.
pub protocol Commit roles(P)(blob: Bytes @P, setup: Groups<G1> @P) -> (commitment: Bytes @P) where () {
  return blob_to_kzg_commitment(blob, setup);
}
pub protocol Prove roles(P)(blob: Bytes @P, z: Bytes @P, setup: Groups<G1> @P)
    -> (proof: Bytes @P, y: Bytes @P) where () {
  let (proof, y) = compute_kzg_proof(blob, z, setup);
  return (proof = proof, y = y);
}
// compute_challenge itself hashes its bytes as given; this entry point first
// applies the input checks of c-kzg-4844's Go binding: a whole blob, hashed
// without decoding its scalars, and a commitment that decodes as a point.
pub protocol Challenge roles(P)(blob: Bytes @P, commitment: Bytes @P) -> (challenge: Bytes @P) where () {
  require bytes::length(blob) == 131072;
  let _ = bytes_to_point(commitment);
  return encoding::field_be(compute_challenge(blob, commitment));
}
pub protocol PointEvaluation roles(P)(input: Bytes @P) -> (output: Bytes @P) where () {
  return point_evaluation(input);
}

// One opening at a point fixed by the statement (verify_kzg_proof). The
// prover holds the blob behind the commitment and the setup.
fn point_proof(blob: Bytes, commitment: Bytes, z: Bytes, y: Bytes, setup: Groups<G1>) -> Bytes {
  require bytes::equal(blob_to_kzg_commitment(blob, setup), commitment);
  let (proof, value) = compute_kzg_proof(blob, z, setup);
  require bytes::equal(value, y);
  return proof;
}
pub protocol PointOpening roles(P, V)
    (commitment: Bytes @(P,V), z: Bytes @(P,V), y: Bytes @(P,V), blob: Bytes @P,
     setup: Groups<G1> @P) -> (accepted: bool @V) where () {
  let proof @P = point_proof(blob, commitment, z, y, setup);
  #[site(proof)] let received = send P -> V(proof);
  let accepted @V = verify_kzg_proof(commitment, z, y, received);
  return accepted;
}
// The proof is the 48-byte compressed point alone; the verifier's point
// decoding refuses every other length.
pub construction Point for PointOpening {
  base authored;
  format RawBytes;
}

// The blob statement: a valid commitment and a canonical blob.
fn statement(blob: Bytes, commitment: Bytes) -> Vector<F> {
  let _ = bytes_to_point(commitment);
  return blob_to_polynomial(blob);
}
fn blob_proof(basis: Groups<G1>, values: Vector<F>, z: F) -> Bytes {
  let (proof, _) = opening(basis, values, z);
  return encoding::group_compressed(proof);
}
// The verifier evaluates the blob at z itself and checks the opening.
fn blob_check(values: Vector<F>, commitment: Bytes, z: F, proof: Bytes) -> bool {
  let opened = bytes_to_point(proof);
  let y = kzg::evaluate(evaluation::evaluations(blob_domain(), values), z);
  return check(bytes_to_point(commitment), z, y, opened);
}

// Opening of a blob at a verifier-chosen point (verify_blob_kzg_proof). The
// interactive verifier draws z after the statement is fixed; the construction
// derives it from the statement alone (compute_blob_kzg_proof).
pub protocol BlobOpening roles(P, V)
    (blob: Bytes @(P,V), commitment: Bytes @(P,V), setup: Groups<G1> @P,
     challenges: Random<F> @V) -> (accepted: bool @V) where () {
  let valuesP @P = statement(blob, commitment);
  let valuesV @V = statement(blob, commitment);
  let basis @P = admit_setup(setup);
  #[site(z)] let zV = challenges.draw();
  #[site(z_delivery)] let zP = send V -> P(zV);
  let proof @P = blob_proof(basis, valuesP, zP);
  #[site(proof)] let received = send P -> V(proof);
  let accepted @V = blob_check(valuesV, commitment, zV, received);
  return accepted;
}
pub construction Blob for BlobOpening {
  transcript transcript::Statement;
  replace challenges;
  format Stream;
  on start(t, blob, commitment) { return transcript::Statement::start(t, blob, commitment); }
  on query z(t) { return transcript::Statement::draw(t); }
  on message z_delivery(t, value) { return t; }
  on message proof(t, value) { return t; }
  on encode proof(r, value) { return Stream::append(r, value); }
  on receive proof(r, proof) { return Stream::take(r, 48); }
  on decode proof(chunk) { return chunk; }
}

// The number of blobs: commitments are 48 bytes each and blobs 131072 bytes.
fn blob_count(blobs: Bytes, commitments: Bytes) -> index {
  let n = indices::divide(bytes::length(commitments), 48);
  require bytes::length(commitments) == 48 * n;
  require bytes::length(blobs) == 131072 * n;
  return n;
}
pub fn blob_at(blobs: Bytes, i: index) -> Bytes effects(stop) where () { return bytes::slice(blobs, 131072 * i, 131072); }
pub fn commitment_at(commitments: Bytes, i: index) -> Bytes effects(stop) where () { return bytes::slice(commitments, 48 * i, 48); }

// Openings of several blobs checked with one random linear combination
// (verify_blob_kzg_proof_batch). Each opening point is that blob's own
// evaluation challenge, computed locally from its blob and commitment alone:
// it carries no batch position, so equal statements share a point. The only
// verifier draw is the combination weight, after every proof is fixed; the
// construction binds it to every commitment, point, value and proof.
pub protocol BlobBatch<MaxBlobs: nat> roles(P, V)
    (blobs: Bytes @(P,V), commitments: Bytes @(P,V), count: index @(P,V),
     setup: Groups<G1> @P, challenges: Random<F> @V) -> (accepted: bool @V) where () {
  require @P count == blob_count(blobs, commitments);
  require @V count == blob_count(blobs, commitments);
  let basis @P = admit_setup(setup);
  let unity @V = blob_domain();
  let mut points @V = curve::empty<G1>();
  let mut zs @V = vec::empty<F>();
  let mut ys @V = vec::empty<F>();
  let mut proofs @V = curve::empty<G1>();
  for i in 0..count roles(P, V) max MaxBlobs {
    let blobP @P = blob_at(blobs, i);
    let commitmentP @P = commitment_at(commitments, i);
    let valuesP @P = statement(blobP, commitmentP);
    let proof @P = blob_proof(basis, valuesP, compute_challenge(blobP, commitmentP));
    #[site(proof)] let received = send P -> V(proof);
    let blobV @V = blob_at(blobs, i);
    let commitmentV @V = commitment_at(commitments, i);
    let valuesV @V = statement(blobV, commitmentV);
    let zV @V = compute_challenge(blobV, commitmentV);
    points = curve::append(points, bytes_to_point(commitmentV));
    zs = vec::append(zs, zV);
    ys = vec::append(ys, kzg::evaluate(evaluation::evaluations(unity, valuesV), zV));
    proofs = curve::append(proofs, bytes_to_point(received));
  }
  #[site(r)] let rV = challenges.draw();
  #[site(r_delivery)] let rP = send V -> P(rV);
  let accepted @V = check_batch(points, zs, ys, proofs, rV);
  return accepted;
}
pub construction Batch<MaxBlobs: nat> for BlobBatch<MaxBlobs> {
  transcript transcript::Combination;
  replace challenges;
  format Stream;
  on start(t, blobs, commitments, count) {
    return transcript::Combination::start(t, blobs, commitments, count);
  }
  on message proof(t, value) { return transcript::Combination::proof(t, value); }
  on query r(t) { return transcript::Combination::draw(t); }
  on message r_delivery(t, value) { return t; }
  on encode proof(r, value) { return Stream::append(r, value); }
  on receive proof(r, proof) { return Stream::take(r, 48); }
  on decode proof(chunk) { return chunk; }
}
