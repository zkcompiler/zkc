module spongefish::bls12_381::schnorr;
use spongefish::bls12_381 as transcript;
use spongefish::bls12_381::{G};
use zkc::bytes as bytes;
use zkc::bytes::{Bytes};
use zkc::encoding as encoding;
use zkc::shake128::{State};

fn start(tag: Bytes, session: Bytes, base: G, point: G) -> State {
  let state = transcript::initialize(tag, session);
  let state = transcript::observe_point(state, base);
  return transcript::observe_point(state, point);
}

pub fn produce(tag: Bytes, session: Bytes, base: G, point: G,
                         scalar: G::Scalar, nonce: G::Scalar) -> Bytes effects(stop) where () {
  let state = start(tag, session, base, point);
  let commitment = base * nonce;
  let state = transcript::observe_point(state, commitment);
  let (state, sampled) = transcript::challenge(state);
  let response = nonce + sampled * scalar;
  let state = transcript::observe_scalar(state, response);
  return bytes::concat(encoding::group_compressed(commitment),
                       encoding::field_be(response));
}

pub fn verify(tag: Bytes, session: Bytes, base: G, point: G,
                        proof: Bytes) -> bool effects(stop) where () {
  let state = start(tag, session, base, point);
  let (state, commitment) = transcript::read_point(state, proof, 0);
  let (state, sampled) = transcript::challenge(state);
  let (state, response) = transcript::read_scalar(state, proof, 48);
  require base * response == commitment + point * sampled;
  require bytes::length(proof) == 80;
  return true;
}

pub protocol Schnorr roles(P, V)
    (tag: Bytes @(P, V), session: Bytes @(P, V), base: G @(P, V), point: G @(P, V),
     scalar: G::Scalar @P, nonces: Random<G::Scalar> @P) -> (accepted: bool @V) where () {
  let nonce = nonces.draw();
  let proof @P = produce(tag, session, base, point, scalar, nonce);
  let actual = send P -> V(proof);
  let accepted @V = verify(tag, session, base, point, actual);
  return (accepted = accepted);
}
