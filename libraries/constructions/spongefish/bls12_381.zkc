module spongefish::bls12_381;
pub module schnorr;
use zkc::bytes::{Bytes};
use zkc::shake128 as shake;
use spongefish::duplex as duplex;
use zkc::bytes as bytes;
use zkc::encoding as encoding;
use zkc::vector as vector;
pub use spongefish::duplex::{initialize};

pub domain G = group("bls12-381.g1");

pub domain Fr = field("bls12-381.fr");

pub fn observe_point(state: shake::State, value: G) -> shake::State effects(stop) where () {
  return duplex::absorb(state, encoding::group_compressed(value));
}
pub fn observe_scalar(state: shake::State, value: Fr) -> shake::State effects(stop) where () {
  return duplex::absorb(state, encoding::field_be(value));
}
// An empty collection performs no observation, including after a squeeze.
pub fn observe_scalars(state: shake::State, values: vector::Vector<Fr>) -> shake::State effects(stop) where () {
  return if vector::length(values) == 0 { state }
    else { duplex::absorb(state, encoding::fields_be(values)) };
}
pub fn challenge(state: shake::State) -> (shake::State, Fr) effects(stop) where () {
  let (next, sampled) = duplex::squeeze(state, 64);
  return (next, encoding::field_reduce_be<Fr>(sampled));
}
pub fn read_point(state: shake::State, proof: Bytes, offset: index) -> (shake::State, G) effects(stop) where () {
  let (valid, value) = encoding::group_from_compressed<G>(bytes::slice(proof, offset, 48));
  require valid;
  return (observe_point(state, value), value);
}
pub fn read_scalar(state: shake::State, proof: Bytes, offset: index) -> (shake::State, Fr) effects(stop) where () {
  let (valid, value) = encoding::field_from_be<Fr>(bytes::slice(proof, offset, 32));
  require valid;
  return (observe_scalar(state, value), value);
}

// Managed construction adapter for this concrete encoding. Application tag,
// session and statement initialization remains an explicit on-start call.
pub interface TranscriptState {
  type State: Copy + Drop;
  fn initialize() -> State effects(stop, opaque);
  fn start(state: State, tag: Bytes, session: Bytes, base: G, public_point: G)
      -> State effects(stop, opaque);
  fn point(state: State, value: G) -> State effects(stop, opaque);
  fn scalar(state: State, value: G::Scalar) -> State effects(stop, opaque);
  fn draw(state: State) -> (State, G::Scalar) effects(stop, opaque);
}

pub module Provider: TranscriptState {
  type State: Copy + Drop = builtin("shake128_state");

  fn initialize() -> State effects(stop) where () { return State(shake::init()); }

  fn start(state: State, tag: Bytes, session: Bytes, base: G, public_point: G) -> State effects(stop) where () {
    let initial = duplex::initialize(tag, session);
    let observed = observe_point(initial, base);
    return State(observe_point(observed, public_point));
  }

  fn point(state: State, value: G) -> State effects(stop) where () {
    return State(observe_point(unpack(state), value));
  }

  fn scalar(state: State, value: G::Scalar) -> State effects(stop) where () {
    return State(observe_scalar(unpack(state), value));
  }

  fn draw(state: State) -> (State, G::Scalar) effects(stop) where () {
    let (next, value) = challenge(unpack(state));
    return (State(next), value);
  }
}
