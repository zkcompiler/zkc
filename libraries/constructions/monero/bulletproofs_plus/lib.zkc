module monero::bulletproofs_plus;
use zkc::bytes as bytes;
use zkc::bytes::{Bytes};
use zkc::encoding as encoding;
use zkc::vector as vec;
use zkc::vector::{Vector};
use zkc::indices as indices;
use zkc::indices::{Indices};
use zkc::scalar as scalar;
use zkc::curve as curve;
use zkc::finite_domain::{range};
use zkc::sampling::fields as sampling;
use zkc::linear as linear;
use bulletproofs::weighted_inner_product as ip;

pub module transcript;
pub module codec;

pub domain G = group("edwards25519.prime");
pub domain F = field("ristretto255.scalar");

pub module Wire: ip::PointEncoding<G> {
  fn emit(point: G) -> Bytes effects(stop) where () {
    return encoding::group_compressed(point * scalar::inverse<F>(8));
  }
  fn admit(raw: Bytes) -> G effects(stop) where () {
    let (valid, point) = encoding::group_decode_cofactor<G>(raw);
    require valid;
    return point;
  }
}
fn value_base_bytes() -> Bytes {
  let mut result = bytes::empty();
  result = bytes::append(result, 139);
  result = bytes::append(result, 101);
  result = bytes::append(result, 89);
  result = bytes::append(result, 112);
  result = bytes::append(result, 21);
  result = bytes::append(result, 55);
  result = bytes::append(result, 153);
  result = bytes::append(result, 175);
  result = bytes::append(result, 42);
  result = bytes::append(result, 234);
  result = bytes::append(result, 220);
  result = bytes::append(result, 159);
  result = bytes::append(result, 241);
  result = bytes::append(result, 173);
  result = bytes::append(result, 208);
  result = bytes::append(result, 234);
  result = bytes::append(result, 108);
  result = bytes::append(result, 114);
  result = bytes::append(result, 81);
  result = bytes::append(result, 213);
  result = bytes::append(result, 65);
  result = bytes::append(result, 84);
  result = bytes::append(result, 207);
  result = bytes::append(result, 169);
  result = bytes::append(result, 44);
  result = bytes::append(result, 23);
  result = bytes::append(result, 58);
  result = bytes::append(result, 13);
  result = bytes::append(result, 211);
  result = bytes::append(result, 156);
  result = bytes::append(result, 31);
  result = bytes::append(result, 148);
  return result;
}
fn generator_tag() -> Bytes {
  let mut result = bytes::empty();
  result = bytes::append(result, 98);
  result = bytes::append(result, 117);
  result = bytes::append(result, 108);
  result = bytes::append(result, 108);
  result = bytes::append(result, 101);
  result = bytes::append(result, 116);
  result = bytes::append(result, 112);
  result = bytes::append(result, 114);
  result = bytes::append(result, 111);
  result = bytes::append(result, 111);
  result = bytes::append(result, 102);
  result = bytes::append(result, 95);
  result = bytes::append(result, 112);
  result = bytes::append(result, 108);
  result = bytes::append(result, 117);
  result = bytes::append(result, 115);
  return result;
}
fn transcript_tag() -> Bytes {
  let mut result = generator_tag();
  result = bytes::append(result, 95);
  result = bytes::append(result, 116);
  result = bytes::append(result, 114);
  result = bytes::append(result, 97);
  result = bytes::append(result, 110);
  result = bytes::append(result, 115);
  result = bytes::append(result, 99);
  result = bytes::append(result, 114);
  result = bytes::append(result, 105);
  result = bytes::append(result, 112);
  result = bytes::append(result, 116);
  return result;
}

pub fn value_base() -> G effects(stop) where () {
  let (valid, point) = encoding::group_from_compressed<G>(value_base_bytes());
  require valid;
  return point;
}
pub fn mask_base() -> G effects(stop) where () { return curve::generator<G>(); }

fn mapped(preimage: Bytes) -> G {
  return encoding::cryptonote_map(bytes::keccak256(bytes::keccak256(preimage)));
}
pub fn initial_transcript() -> Bytes effects(stop) where () { return encoding::group_compressed(mapped(transcript_tag())); }
pub fn hash_scalar(value: Bytes) -> F effects(stop) where () { return encoding::field_reduce_le<F>(bytes::keccak256(value)); }

// The count is not a serialized proof field. It comes from the statement.
pub fn dimensions(commitments: Bytes) -> (index, index, index) effects(stop) where () {
  let width = bytes::length(commitments);
  require indices::remainder(width, 32) == 0;
  let count = indices::divide(width, 32);
  require !indices::less(count, 1);
  require !indices::less(16, count);
  let mut padded: index = 1;
  let mut rounds: index = 6;
  for _ in 0..4 {
    if indices::less(padded, count) { padded = padded * 2; rounds = rounds + 1; }
  }
  return (count, padded * 64, rounds);
}
pub fn generators(size: index) -> ip::Bases<G> effects(stop) where () {
  require !indices::less(1024, size);
  let prefix = bytes::concat(value_base_bytes(), generator_tag());
  // Bounded blocks avoid repeatedly copying the entire growing vector in
  // the sequential interpreter. The generator index remains unchanged.
  let mut left = curve::empty<G>();
  let mut right = curve::empty<G>();
  for block in 0..indices::divide(size + 63, 64) {
    let begin = block * 64;
    let end = if indices::less(size, begin + 64) { size } else { begin + 64 };
    let gs = curve::collect(range(begin, end),
      fn(i) => mapped(bytes::concat(prefix, encoding::index_uleb128(2 * i + 1))));
    let hs = curve::collect(range(begin, end),
      fn(i) => mapped(bytes::concat(prefix, encoding::index_uleb128(2 * i))));
    left = curve::concat(left, gs);
    right = curve::concat(right, hs);
  }
  return ip::Bases<G>{left: left, right: right};
}

// V contains Monero's inverse-eight commitments, in their original byte form.
pub fn commit(values: Indices, masks: Vector<F>) -> Bytes effects(stop) where () {
  let count = indices::length(values);
  require vec::length(masks) == count;
  require !indices::less(count, 1);
  require !indices::less(16, count);
  let value = value_base();
  let blind = mask_base();
  let mut result = bytes::empty();
  for i in 0..count {
    let amount = scalar::from_index<F>(indices::get(values, i));
    result = bytes::concat(result, Wire::emit(value * amount + blind * vec::get(masks, i)));
  }
  return result;
}
fn decompose(values: Indices, masks: Vector<F>, statement: Bytes, size: index) -> Vector<F> {
  let count = indices::length(values);
  require bytes::length(statement) == 32 * count;
  require vec::length(masks) == count;
  let mut result = vec::empty<F>();
  for j in 0..indices::divide(size, 64) {
    let mut amount: index = 0;
    if indices::less(j, count) {
      amount = indices::get(values, j);
      let expected = value_base() * scalar::from_index<F>(amount)
        + mask_base() * vec::get(masks, j);
      require Wire::admit(bytes::slice(statement, j * 32, 32)) == expected;
    }
    for _ in 0..64 {
      result = vec::append(result, scalar::from_index<F>(indices::remainder(amount, 2)));
      amount = indices::divide(amount, 2);
    }
  }
  return result;
}
fn window(size: index, z: F) -> Vector<F> {
  let mut result = vec::empty<F>();
  let mut weight = z * z;
  for _ in 0..indices::divide(size, 64) {
    let mut bit = weight;
    for _ in 0..64 { result = vec::append(result, bit); bit = bit + bit; }
    weight = weight * z * z;
  }
  return result;
}
fn reverse_weights(size: index, y: F) -> Vector<F> {
  return vec::scale(vec::geometric(scalar::inverse(y), size), scalar::power(y, size));
}
fn bit_commit(bases: ip::Bases<G>, bits: Vector<F>, alpha: F) -> G {
  let right = vec::subtract(bits, vec::fill<F>(1, vec::length(bits)));
  return curve::msm(bits, bases.left)
    + curve::msm(right, bases.right) + mask_base() * alpha;
}
fn witness(bits: Vector<F>, masks: Vector<F>, alpha: F, y: F, z: F) -> ip::Witness<F> {
  let size = vec::length(bits);
  let d = window(size, z);
  let weighted = vec::hadamard(d, reverse_weights(size, y));
  let left = vec::subtract(bits, vec::fill(z, size));
  let right = vec::add(vec::add(bits, vec::fill(z - 1, size)), weighted);
  let z_powers = vec::scale(vec::geometric(z * z, vec::length(masks)), z * z);
  let mask = alpha + scalar::power(y, size + 1) * vec::dot(z_powers, masks);
  return ip::Witness<F>{left: left, right: right, mask: mask};
}
fn claim(bases: ip::Bases<G>, statement: Bytes, commitment: Bytes, y: F, z: F) -> ip::Claim<G> {
  let size = ip::count(bases);
  let d = window(size, z);
  let power = scalar::power(y, size + 1);
  let right = vec::add(vec::fill(z, size), vec::hadamard(d, reverse_weights(size, y)));
  let mut rest = linear::term<G>(1, Wire::admit(commitment));
  let mut weight = z * z * power;
  for j in 0..indices::divide(bytes::length(statement), 32) {
    rest = linear::append(rest, weight, Wire::admit(bytes::slice(statement, j * 32, 32)));
    weight = weight * z * z;
  }
  let sum_y = vec::sum(vec::scale(vec::geometric(y, size), y));
  let correction = (z * z - z) * sum_y + power * z * vec::sum(d);
  rest = linear::append(rest, 0 - correction, value_base());
  return ip::Claim<G>{left: vec::fill<F>(0 - z, size), right: right, rest: rest};
}

// One explicit attempt. A zero challenge stops; a caller may start a fresh
// invocation with fresh private coins. The verifier rejects zero challenges.
pub protocol Range roles(P,V)
    (commitments: Bytes @(P,V), rounds: index @(P,V), values: Indices @P, masks: Vector<F> @P,
     nonces: Random<F> @P, challenges: Random<F> @V) -> (accepted: bool @V) where () {
  let shapeP @P = dimensions(commitments);
  let shapeV @V = dimensions(commitments);
  require @P rounds == shapeP.2;
  require @V rounds == shapeV.2;
  let basesP @P = generators(shapeP.1);
  let basesV @V = generators(shapeV.1);
  let valueP @P = value_base();
  let valueV @V = value_base();
  let blindP @P = mask_base();
  let blindV @V = mask_base();
  let bits @P = decompose(values, masks, commitments, shapeP.1);
  let alpha = sampling::Nonzero<F,32>(nonces);
  let proposed @P = Wire::emit(bit_commit(basesP, bits, alpha));
  #[site(commitment)] let actual = send P -> V(proposed);
  #[site(y)] let yV = challenges.draw();
  require @V !(yV == 0);
  #[site(y_delivery)] let yP = send V -> P(yV);
  require @P !(yP == 0);
  #[site(z)] let zV = challenges.draw();
  require @V !(zV == 0);
  #[site(z_delivery)] let zP = send V -> P(zV);
  require @P !(zP == 0);
  let secret @P = witness(bits, masks, alpha, yP, zP);
  let adjusted @V = claim(basesV, commitments, actual, yV, zV);
  #[site(argument)] let accepted = ip::Argument<G,Wire,10>(basesP, basesV, valueP, valueV, blindP, blindV,
    yP, yV, secret, adjusted, rounds, nonces, challenges);
  return (accepted = accepted);
}

pub construction Monero for Range {
  transcript transcript::Provider;
  replace challenges;
  format codec::Codec(commitments, rounds);
  on start(t, commitments, rounds) { return transcript::Provider::start(t, commitments); }
  on message commitment(t, value) { return transcript::Provider::observe(t, value); }
  on query y(t) { return transcript::Provider::draw(t); }
  on message y_delivery(t, value) { return t; }
  on query z(t) { return transcript::Provider::draw(t); }
  on message z_delivery(t, value) { return t; }
  on message argument.fold(t, value) { return transcript::Provider::pair(t, value); }
  on query argument.fold_challenge(t) { return transcript::Provider::draw(t); }
  on message argument.fold_delivery(t, value) { return t; }
  on message argument.terminal(t, value) { return transcript::Provider::pair(t, value); }
  on query argument.terminal_challenge(t) { return transcript::Provider::draw(t); }
  on message argument.terminal_delivery(t, value) { return t; }
  on message argument.response(t, value) { return t; }

  on encode commitment(r, value) { return codec::Codec::commitment(r, value); }
  on receive commitment(r, proof) { return codec::Codec::take_commitment(r); }
  on decode commitment(raw) { return raw; }
  on encode argument.fold(r, value) { return codec::Codec::fold(r, value); }
  on receive argument.fold(r, proof) { return codec::Codec::take_fold(r); }
  on decode argument.fold(raw: (Bytes,Bytes)) { return raw; }
  on encode argument.terminal(r, value) { return codec::Codec::terminal(r, value); }
  on receive argument.terminal(r, proof) { return codec::Codec::take_terminal(r); }
  on decode argument.terminal(raw: (Bytes,Bytes)) { return raw; }
  on encode argument.response(r, value) { return codec::Codec::response(r, value); }
  on receive argument.response(r, proof) { return codec::Codec::take_response(r); }
  on decode argument.response(raw: (Bytes,Bytes,Bytes)) {
    return (codec::decode_scalar(raw.0),codec::decode_scalar(raw.1),codec::decode_scalar(raw.2));
  }
}
