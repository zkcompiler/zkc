module monero::bulletproofs_plus::codec;

// Protocol order is A, L/R rounds, A1/B, responses. Monero's serialized
// BulletproofPlus object instead places the L and R vectors at the end.
pub interface ProofCodec {
  type Record: Copy + Drop;
  fn initialize(layout: (Bytes,index)) -> Record effects(stop, opaque);
  fn write(record: Record) -> Bytes effects(stop, opaque);
  fn finish(record: Record, proof: Bytes) -> () effects(stop, opaque);
  fn commitment(record: Record, raw: Bytes) -> (Record,Bytes) effects(stop, opaque);
  fn fold(record: Record, raw: (Bytes,Bytes)) -> (Record,(Bytes,Bytes)) effects(stop, opaque);
  fn terminal(record: Record, raw: (Bytes,Bytes)) -> (Record,(Bytes,Bytes)) effects(stop, opaque);
  fn response(record: Record, raw: (F,F,F)) -> (Record,(Bytes,Bytes,Bytes)) effects(stop, opaque);
  fn take_commitment(record: Record) -> (Record,(index,index)) effects(stop, opaque);
  fn take_fold(record: Record) -> (Record,((index,index),(index,index))) effects(stop, opaque);
  fn take_terminal(record: Record) -> (Record,((index,index),(index,index))) effects(stop, opaque);
  fn take_response(record: Record) -> (Record,((index,index),(index,index),(index,index))) effects(stop, opaque);
}
pub module Codec: ProofCodec {
  type Record: Copy + Drop = (Bytes,Bytes,Bytes,Bytes,Bytes,index,index);
  fn initialize(layout: (Bytes,index)) -> Record effects(stop) where () {
    let shape = dimensions(layout.0);
    require shape.2 == layout.1;
    let empty = bytes::empty();
    return Record((empty,empty,empty,empty,empty,shape.2,0));
  }
  fn write(record: Record) -> Bytes effects(stop) where () {
    let (a,terminal_bytes,response_bytes,left,right,rounds,cursor) = unpack(record);
    require cursor == rounds;
    require bytes::length(a) == 32;
    require bytes::length(terminal_bytes) == 64;
    require bytes::length(response_bytes) == 96;
    require bytes::length(left) == 32 * rounds;
    require bytes::length(right) == 32 * rounds;
    let header = bytes::concat(bytes::concat(a,terminal_bytes),response_bytes);
    // dimensions bounds rounds by 10, so the counts occupy one byte each.
    let count = encoding::index_uleb128(rounds);
    return bytes::concat(bytes::concat(bytes::concat(bytes::concat(header,count),left),count),right);
  }
  fn finish(record: Record, proof: Bytes) -> () effects(stop) where () {
    let (_,_,_,_,_,rounds,cursor) = unpack(record);
    require cursor == rounds;
    require bytes::length(proof) == 194 + 64 * rounds;
    require bytes::at(proof,192) == rounds;
    require bytes::at(proof,193 + 32 * rounds) == rounds;
    return ();
  }
  fn commitment(record: Record, raw: Bytes) -> (Record,Bytes) effects() where () {
    let (_,t,s,l,r,n,i) = unpack(record);
    return (Record((raw,t,s,l,r,n,i)),raw);
  }
  fn fold(record: Record, raw: (Bytes,Bytes)) -> (Record,(Bytes,Bytes)) effects(stop) where () {
    let (a,t,s,l,r,n,i) = unpack(record);
    require indices::less(i,n);
    return (Record((a,t,s,bytes::concat(l,raw.0),bytes::concat(r,raw.1),n,i+1)),raw);
  }
  fn terminal(record: Record, raw: (Bytes,Bytes)) -> (Record,(Bytes,Bytes)) effects(stop) where () {
    let (a,_,s,l,r,n,i) = unpack(record);
    return (Record((a,bytes::concat(raw.0,raw.1),s,l,r,n,i)),raw);
  }
  fn response(record: Record, raw: (F,F,F)) -> (Record,(Bytes,Bytes,Bytes)) effects(stop) where () {
    let (a,t,_,l,r,n,i) = unpack(record);
    let words = (encoding::field_le(raw.0),encoding::field_le(raw.1),encoding::field_le(raw.2));
    let all = bytes::concat(bytes::concat(words.0,words.1),words.2);
    return (Record((a,t,all,l,r,n,i)),words);
  }
  fn take_commitment(record: Record) -> (Record,(index,index)) effects() where () { return (record,(0,32)); }
  fn take_fold(record: Record) -> (Record,((index,index),(index,index))) effects(stop) where () {
    let (a,t,s,l,r,n,i) = unpack(record);
    require indices::less(i,n);
    return (Record((a,t,s,l,r,n,i+1)),((193+32*i,32),(194+32*n+32*i,32)));
  }
  fn take_terminal(record: Record) -> (Record,((index,index),(index,index))) effects() where () {
    return (record,((32,32),(64,32)));
  }
  fn take_response(record: Record) -> (Record,((index,index),(index,index),(index,index))) effects() where () {
    return (record,((96,32),(128,32),(160,32)));
  }
}
pub fn decode_scalar(raw: Bytes) -> F effects(stop) where () {
  let (valid,value) = encoding::field_from_le<F>(raw);
  require valid;
  return value;
}
