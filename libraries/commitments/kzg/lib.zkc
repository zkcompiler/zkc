module kzg;
use zkc::vector as vec;
use zkc::vector::{Vector};
use zkc::scalar as scalar;
use zkc::indices as indices;
use zkc::evaluation_domain as evaluation;
use zkc::evaluation_domain::{EvaluationDomain, Evaluations};


// Univariate KZG commitments to polynomials of degree below n in evaluation
// form: values[i] is p(points[i]), where points lists the n-th roots of unity
// of F in a fixed order. The opening proof for p(z) = y commits to the
// quotient (p(X) - y) / (X - z), which these functions compute in the same
// form. Commitments, pairings and transcripts belong to a concrete
// construction such as ethereum::eip4844.

// z is a domain point exactly when z^n = 1, because the domain is the whole
// group of n-th roots of unity.
pub fn in_domain<F: Field>(input: EvaluationDomain<F>, z: F) -> bool effects(stop) where () {
  return scalar::power(z, evaluation::size(input)) == 1;
}

// The position of a domain point, found by scanning the domain.
fn position_in_points<F: Field>(points: Vector<F>, z: F) -> index {
  let n = vec::length(points);
  let found = vec::find_last(points, z);
  require indices::less(found, n);
  return found;
}
pub fn position<F: Field>(input: EvaluationDomain<F>, z: F) -> index effects(stop) where () {
  return position_in_points(evaluation::points(input), z);
}

// The n-entry vector with a single one at position m.
pub fn unit<F: Field>(n: index, m: index) -> Vector<F> effects(stop) where () {
  require indices::less(m, n);
  let ones = vec::concat(vec::fill<F>(0, m), vec::fill<F>(1, 1));
  return vec::concat(ones, vec::fill<F>(0, n - m - 1));
}

// Outside the domain, inverses[i] = 1 / (points[i] - z) and vanishing = 1 - z^n.
fn barycentric_value<F: Field>(points: Vector<F>, values: Vector<F>,
    inverses: Vector<F>, vanishing: F, n: index) -> F effects(stop) where () {
  let sum = vec::dot(vec::hadamard(points, inverses), values);
  return sum * vanishing * scalar::inverse(scalar::from_index<F>(n));
}

// p(z). Inside the domain this is the stored value; outside it is the
// barycentric formula p(z) = (1 - z^n) / n * sum_i values[i] points[i] / (points[i] - z).
pub fn evaluate<F: Field>(input: Evaluations<F>, z: F) -> F effects(stop) where () {
  let unity = evaluation::evaluation_domain(input);
  let points = evaluation::points(unity);
  let values = evaluation::values(input);
  let n = evaluation::size(unity);
  let vanishing = 1 - scalar::power(z, n);
  return if vanishing == 0 {
    vec::get(values, position_in_points(points, z))
  } else {
    let inverses = vec::inverse(vec::subtract(points, vec::fill(z, n)));
    barycentric_value(points, values, inverses, vanishing, n)
  };
}

// Compute y = p(z) and return ((p(X) - y) / (X - z), y).
// At a domain point z = points[m], entry m is the derivative form
// sum_{i != m} (values[i] - y) points[i] / (z (z - points[i])); every other
// entry is (values[i] - y) / (points[i] - z).
pub fn quotient<F: Field>(input: Evaluations<F>, z: F) -> (Vector<F>, F) effects(stop) where () {
  let unity = evaluation::evaluation_domain(input);
  let points = evaluation::points(unity);
  let values = evaluation::values(input);
  let n = evaluation::size(unity);
  let vanishing = 1 - scalar::power(z, n);
  return if vanishing == 0 {
    let m = position_in_points(points, z);
    let y = vec::get(values, m);
    let shifted = vec::subtract(values, vec::fill(y, n));
    // shifted[m] = values[m] - y = 0, so a unit placeholder denominator at m
    // contributes nothing and avoids inverting zero.
    let single = unit<F>(n, m);
    let away = vec::add(vec::subtract(points, vec::fill(z, n)), single);
    let rest = vec::hadamard(shifted, vec::inverse(away));
    // rest[m] = 0. The missing quotient value is p'(z) = -sum_i rest[i] points[i] / z.
    // A domain root is nonzero, including the singleton root 1.
    let at = (0 - vec::dot(rest, points)) * scalar::inverse(z);
    (vec::add(rest, vec::scale(single, at)), y)
  } else {
    let inverses = vec::inverse(vec::subtract(points, vec::fill(z, n)));
    let y = barycentric_value(points, values, inverses, vanishing, n);
    let shifted = vec::subtract(values, vec::fill(y, n));
    (vec::hadamard(shifted, inverses), y)
  };
}
