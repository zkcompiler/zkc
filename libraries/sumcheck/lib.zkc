module sumcheck;

pub type Vector<F: Field> = builtin("vector", F);
fn sums<F: Field>(values: Vector<F>) {
  let halves = kernel<F>("vector.split", values);
  return (kernel<F>("vector.sum", halves.0), kernel<F>("vector.sum", halves.1));
}
fn fold<F: Field>(values: Vector<F>, challenge: F) {
  let halves = kernel<F>("vector.split", values);
  let low = kernel<F>("vector.scale", halves.0, 1 - challenge);
  let high = kernel<F>("vector.scale", halves.1, challenge);
  return kernel<F>("vector.add", low, high);
}
math fn both(a: bool, b: bool) { return intrinsic("bool.and", a, b); }
fn terminal<F: Field>(values: Vector<F>, claim: F) {
  let size = kernel<F>("vector.length", values);
  return both(size == 1, kernel<F>("vector.sum", values) == claim);
}

// Multilinear public-table Sumcheck. V evaluates the public table directly at
// the delivered point; there is no commitment or hidden evaluation callback.
pub protocol Sumcheck<F: Field+Share+Wire, Max: nat> roles(P, V)
    (values: Vector<F> @(P,V), claim: F @V, rounds: index @(P,V),
     challenges: Random<F> @V) -> (accepted: bool @V) {
  let mut tableP @P = values;
  let mut tableV @V = values;
  let mut current = claim;
  for _ in 0..rounds roles(P, V) max Max {
    let parts = sums(tableP);
    let actual = send P -> V(parts);
    require current == actual.0 + actual.1;
    let cv = challenges.draw();
    let cp = send V -> P(cv);
    tableP = fold(tableP, cp);
    tableV = fold(tableV, cv);
    current = (1 - cv) * actual.0 + cv * actual.1;
  }
  let accepted = terminal(tableV, current);
  return accepted;
}
