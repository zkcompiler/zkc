module sumcheck;
pub module expression;

use zkc::vector::{Vector, sum, length, empty, append};

// An evaluation obligation, not an acceptance certificate. The caller binds
// the polynomial and its dimension; coordinates are MSB-first.
pub use zkc::multilinear::{Evaluation};
use zkc::multilinear as multilinear;
use zkc::multilinear::{Table, fix_first, fix_prefix};

math fn total<F: Field>(values: Vector<F>) -> F {
  return zkc::finite_math::fold(zkc::vector::elements(values), 0,
    fn(current, value) => current + value);
}

// The parameter is one fixed table selected by the property consumer. Purpose
// labels alone neither choose its authority nor existentially quantify it.
pub relation Sum<F: Field>(parameter values: Vector<F>, statement claim: F) {
  return claim == total(values);
}

// Width, dimension and decoding are separate domain obligations. In particular,
// this formula does not make an arbitrary prover table authoritative for V.
pub relation TableSum<F: Field>(parameter values: Table<F>, statement claim: F) {
  return claim == total(multilinear::values(values));
}

fn sums<F: Field>(values: Table<F>) {
  let halves = multilinear::halves(values);
  return (sum(halves.0), sum(halves.1));
}

// Pair-valued multilinear rounds. V checks each received boundary sum before
// drawing; P retains the residual table for a subsequent opening argument.
// A complete caller must discharge the returned evaluation and dimension.
pub protocol Reduce<F: Field, Max: nat> roles(P,V)
    (values: Table<F> @P, claim: F @V, rounds: index @(P,V),
     challenges: Random<F> @V)
    -> (point: Vector<F> @P, residual: Table<F> @P,
        evaluation: Evaluation<F> @V)
    spec { input initial_sum = TableSum<F>(in.values, in.claim); }
{
  require @P multilinear::width(values) == 1;
  require @P !zkc::indices::less(multilinear::variables(values), rounds);
  let mut tableP = values;
  let mut pointP @P = empty<F>();
  let mut pointV @V = empty<F>();
  let mut current = claim;
  for _ in 0..rounds roles(P,V) max Max {
    let parts = sums(tableP);
    #[site(round)] let actual = send P -> V(parts);
    require current == actual.0 + actual.1;
    #[site(challenge)] let cv = challenges.draw();
    #[site(delivery)] let cp = send V -> P(cv);
    tableP = fix_first(tableP, cp);
    pointP = append(pointP, cp);
    pointV = append(pointV, cv);
    current = (1 - cv) * actual.0 + cv * actual.1;
  }
  let evaluation @V = Evaluation<F> { point: pointV, value: current };
  return (point = pointP, residual = tableP, evaluation = evaluation);
}

// Complete public-table discharge. The supplied point must fix every variable.
fn check_table<F: Field>(values: Vector<F>, evaluation: Evaluation<F>) -> bool {
  let table = multilinear::table(values, length(evaluation.point), 1);
  let remaining = fix_prefix(table, evaluation.point);
  return sum(multilinear::values(remaining)) == evaluation.value;
}
pub fn check<F: Field>(values: Vector<F>, evaluation: Evaluation<F>) -> bool {
  return multilinear::has_shape(values, length(evaluation.point), 1)
    && check_table(values, evaluation);
}

pub protocol Sumcheck<F: Field, Max: nat> roles(P,V)
    (values: Vector<F> @(P,V), claim: F @V, rounds: index @(P,V),
     challenges: Random<F> @V) -> (accepted: bool @V)
    spec { target public_sum = Sum<F>(in.values@V, in.claim) accept out.accepted; }
{
  let table @P = multilinear::table(values, rounds, 1);
  #[site(reduce)] let (point, residual, evaluation) =
    Reduce<F,Max>(table, claim, rounds, challenges);
  return check(values, evaluation);
}
