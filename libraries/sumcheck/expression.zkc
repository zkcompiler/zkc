module expression_sumcheck;

use zkc::vector::{Vector, split, length, fold, has_length};
use zkc::polynomial::{from_coefficients, boundary, evaluate};

// The captured arena A fixes one closed expression and its ordered factor
// slots. Values are row-major assignments with A::Inputs columns. Round
// returns the exact coefficient sum over affine pairs; terminal substitutes
// the final factor values and reads the single output.
fn round<F: Field, A: Ring>(values: Vector<F>) -> Vector<F> {
  let halves = split(values);
  let rows = kernel("index.div", length(halves.0),
                    index<A::Inputs>());
  return kernel<F>("ring.affine_sum", halves.0, halves.1, rows; A);
}
fn terminal<F: Field, A: Ring>(values: Vector<F>) -> F {
  let result = kernel<F>("ring.point", values; A);
  return kernel<F>("vector.at", result; "0");
}
// Public factor tables, MSB-first variable order. The verifier folds the public
// factors and checks the exact terminal expression. The table width and the
// round-polynomial degree are derived from the captured arena: each round
// carries A::Degree + 1 coefficients and the terminal row has A::Inputs
// factors. A commitment/opening protocol can replace this direct terminal
// evaluation in a separate library.
pub protocol Sumcheck<F: Field+Share+Wire, Max: nat, A: Ring> roles(P,V)
    (prover_values: Vector<F> @P, verifier_values: Vector<F> @V,
     claim: F @V, rounds: index @(P,V),
     challenges: Random<F> @V) -> (accepted: bool @V)
    where 1 <= A::Inputs, 1 <= A::Outputs, A::Outputs <= 1 {
  let mut tableP = prover_values;
  let mut tableV = verifier_values;
  let mut current = claim;
  for i in 0..rounds roles(P,V) max Max {
    let proposed @P = round<F,A>(tableP);
    let received = send P -> V(proposed);
    let actual @V = from_coefficients(received);
    let size_ok @V = has_length<F,A::Degree+1>(received);
    require @V size_ok;
    let total @V = boundary(actual);
    let sum_ok @V = current == total;
    require @V sum_ok;
    let cv = challenges.draw();
    let cp = send V -> P(cv);
    let nextP @P = fold(tableP, cp);
    let nextV @V = fold(tableV, cv);
    let nextClaim @V = evaluate(actual, cv);
    tableP = nextP;
    tableV = nextV;
    current = nextClaim;
  }
  let size_ok @V = has_length<F,A::Inputs>(tableV);
  require @V size_ok;
  let evaluated @V = terminal<F,A>(tableV);
  let accepted @V = evaluated == current;
  return (accepted = accepted);
}
