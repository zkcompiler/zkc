domain C = commitment("multilinear.kzg.bls12-381/0")
type VK = builtin("verifier_key", C)
type Opening = builtin("opening_state", C)

struct Context roles(P, V):
    pub key: VK @V
    pub opening: Opening @P
    pub witness: bool @P

pub protocol Opened roles(P, V)(context: Context roles(P, V)) -> bool @V:
    return true

scheme OpenedJob = Opened:
    prover P
    verifier V
    setup pcs {context.key, context.opening}
    public context.key
    accept result
    construction authored
