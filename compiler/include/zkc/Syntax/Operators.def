// Fixed syntax only. Callable meaning still comes from visible declarations.
// OPERATOR(position, association, spelling, precedence, arity)
OPERATOR(Infix, Left, "or", 10, 2)
OPERATOR(Infix, Left, "∨", 10, 2)
OPERATOR(Infix, Left, "||", 10, 2)
OPERATOR(Infix, Left, "and", 20, 2)
OPERATOR(Infix, Left, "∧", 20, 2)
OPERATOR(Infix, Left, "&&", 20, 2)
OPERATOR(Infix, None, "==", 50, 2)
OPERATOR(Infix, None, "!=", 50, 2)
OPERATOR(Infix, None, "<=", 50, 2)
OPERATOR(Infix, None, ">=", 50, 2)
OPERATOR(Infix, None, "<", 50, 2)
OPERATOR(Infix, None, ">", 50, 2)
OPERATOR(Infix, None, "∈", 50, 2)
OPERATOR(Infix, Left, "+", 65, 2)
OPERATOR(Infix, Left, "-", 65, 2)
OPERATOR(Infix, Left, "++", 65, 2)
OPERATOR(Infix, Left, "*", 70, 2)
OPERATOR(Infix, Left, "/", 70, 2)
OPERATOR(Infix, Left, "⋅", 70, 2)
OPERATOR(Infix, Left, "%", 70, 2)
OPERATOR(Infix, Right, "^", 72, 2)
OPERATOR(Prefix, None, "-", 75, 1)
OPERATOR(Prefix, None, "!", 75, 1)
OPERATOR(Prefix, None, "not", 75, 1)
OPERATOR(Prefix, None, "¬", 75, 1)
