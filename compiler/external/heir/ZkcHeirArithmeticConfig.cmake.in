@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(ZkcHeirArithmetic_HEIR_REVISION "@HEIR_REVISION@")
set(ZkcHeirArithmetic_PATCH_SHA256 "@HEIR_PATCH_SHA256@")
if(DEFINED LLVM_PACKAGE_VERSION AND
    NOT LLVM_PACKAGE_VERSION VERSION_EQUAL "@LLVM_PACKAGE_VERSION@")
  set(ZkcHeirArithmetic_FOUND FALSE)
  set(ZkcHeirArithmetic_NOT_FOUND_MESSAGE "HEIR arithmetic requires LLVM/MLIR @LLVM_PACKAGE_VERSION@")
  return()
endif()
find_dependency(LLVM @LLVM_PACKAGE_VERSION@ EXACT CONFIG)
find_dependency(MLIR @LLVM_PACKAGE_VERSION@ EXACT CONFIG)
if(TARGET ortools::ortools AND
    (NOT DEFINED ORTOOLS_VERSION OR
     NOT ORTOOLS_VERSION VERSION_EQUAL "@ZKC_HEIR_ORTOOLS_VERSION@"))
  set(ZkcHeirArithmetic_FOUND FALSE)
  set(ZkcHeirArithmetic_NOT_FOUND_MESSAGE "Loaded OR-Tools does not match @ZKC_HEIR_ORTOOLS_VERSION@")
  return()
endif()
find_dependency(ortools @ZKC_HEIR_ORTOOLS_VERSION@ EXACT CONFIG)
get_filename_component(_heir_package "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
foreach(_heir_target ZkcHeir::Arithmetic ZkcHeir::Admission)
  if(TARGET ${_heir_target})
    get_target_property(_heir_owner ${_heir_target} ZKC_HEIR_PACKAGE_DIRECTORY)
    if(NOT _heir_owner STREQUAL _heir_package)
      set(ZkcHeirArithmetic_FOUND FALSE)
      set(ZkcHeirArithmetic_NOT_FOUND_MESSAGE "HEIR target belongs to another installation")
      return()
    endif()
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ZkcHeirArithmeticTargets.cmake")
foreach(_heir_target ZkcHeir::Arithmetic ZkcHeir::Admission)
  set_property(TARGET ${_heir_target} PROPERTY ZKC_HEIR_PACKAGE_DIRECTORY "${_heir_package}")
endforeach()
get_target_property(_heir_includes ZkcHeir::Arithmetic INTERFACE_INCLUDE_DIRECTORIES)
list(APPEND _heir_includes ${LLVM_INCLUDE_DIRS} ${MLIR_INCLUDE_DIRS})
list(REMOVE_DUPLICATES _heir_includes)
set_property(TARGET ZkcHeir::Arithmetic PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_heir_includes}")
check_required_components(ZkcHeirArithmetic)
