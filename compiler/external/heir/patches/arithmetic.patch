+// Cancel only explicit inverse roots in the same ring.
+// RNS cancellation is conservatively left to ordinary execution.
+static bool haveInverseRoots(PrimitiveRootAttr a, PrimitiveRootAttr b) {
+  if (!a || !b || a.getDegree() != b.getDegree()) return false;
+  auto left = dyn_cast<mod_arith::ModArithAttr>(a.getValue());
+  auto right = dyn_cast<mod_arith::ModArithAttr>(b.getValue());
+  if (!left || !right || left.getType() != right.getType()) return false;
+  APInt q = cast<mod_arith::ModArithType>(left.getType()).getModulus().getValue();
+  if (q.isZero()) return false;
+  unsigned width = 2 * q.getBitWidth();
+  return (left.getValue().getValue().zextOrTrunc(width) *
+          right.getValue().getValue().zextOrTrunc(width)).urem(q.zext(width)).isOne();
+}
