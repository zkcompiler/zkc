+// The RNS utility keeps bit-reversed slots and accepts a forward root for
+// both transforms. Convert only at the IR operation boundary.
+static RNSPolynomial reverseEvaluationOrder(const RNSPolynomial& poly) {
+  unsigned n = poly.getNumCoeffs();
+  unsigned width = 0;
+  for (unsigned extent = n; extent > 1; extent >>= 1) ++width;
+  SmallVector<uint64_t> data(poly.getData().begin(), poly.getData().end());
+  for (size_t limb = 0; limb < poly.getNumLimbs(); ++limb)
+    for (unsigned i = 0; i < n; ++i)
+      data[limb * n + i] = poly.getElement(limb, reverseBits(i, width));
+  return RNSPolynomial(std::move(data),
+                       SmallVector<uint64_t>(poly.getModuli()),
+                       poly.getRepresentation());
+}
+
+static std::optional<RNSPolynomial> foldTransform(
+    const RNSPolynomial& poly, ArrayRef<uint64_t> roots, bool inverse) {
+  unsigned n = poly.getNumCoeffs();
+  if (!n || (n & (n - 1)) || roots.size() != poly.getNumLimbs())
+    return std::nullopt;
+  if (poly.getRepresentation() != (inverse ? Form::EVAL : Form::COEFF))
+    return std::nullopt;
+  if (!inverse) {
+    auto result = poly.toNtt(roots);
+    if (!result) return std::nullopt;
+    return reverseEvaluationOrder(*result);
+  }
+  SmallVector<uint64_t> forwardRoots;
+  for (size_t i = 0; i < roots.size(); ++i) {
+    APInt root = multiplicativeInverse(APInt(64, roots[i]),
+                                      APInt(64, poly.getModuli()[i]));
+    if (root.isZero()) return std::nullopt;
+    forwardRoots.push_back(root.getZExtValue());
+  }
+  return reverseEvaluationOrder(poly).toCoefficient(forwardRoots);
+}
+
+static std::optional<RNSPolynomial> foldTransform(
+    const RNSPolynomial& poly, rns::RNSAttr root, bool inverse) {
+  if (!root) return std::nullopt;
+  SmallVector<uint64_t> roots;
+  for (Attribute value : root.getValues()) {
+    auto modular = dyn_cast<mod_arith::ModArithAttr>(value);
+    if (!modular) return std::nullopt;
+    roots.push_back(modular.getValue().getValue().getZExtValue());
+  }
+  return foldTransform(poly, roots, inverse);
+}
