@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(MLIR CONFIG)
# The installed library carries the ABI of the LLVM/MLIR release it was built with.
if(NOT LLVM_PACKAGE_VERSION VERSION_EQUAL "@LLVM_PACKAGE_VERSION@")
  message(FATAL_ERROR
    "ZkcCompiler was built with LLVM/MLIR @LLVM_PACKAGE_VERSION@; found ${LLVM_PACKAGE_VERSION}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ZkcCompilerTargets.cmake")
# MLIR's imported libraries do not propagate header search paths themselves.
set_property(TARGET Zkc::Compiler APPEND PROPERTY
  INTERFACE_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS};${MLIR_INCLUDE_DIRS}")
set_property(TARGET Zkc::Compiler APPEND PROPERTY
  INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS};${MLIR_INCLUDE_DIRS}")
separate_arguments(zkc_llvm_definitions NATIVE_COMMAND "${LLVM_DEFINITIONS}")
set_property(TARGET Zkc::Compiler APPEND PROPERTY
  INTERFACE_COMPILE_OPTIONS "${zkc_llvm_definitions}")
check_required_components(ZkcCompiler)
