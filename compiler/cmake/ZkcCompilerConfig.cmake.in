@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(ZkcCompiler_FOUND TRUE)
unset(ZkcCompiler_NOT_FOUND_MESSAGE)
set(_zkc_components "@ZKC_SDK_COMPONENTS@")
@ZKC_SDK_DEPENDENCIES@
if(NOT ZkcCompiler_FIND_COMPONENTS)
  set(ZkcCompiler_FIND_COMPONENTS Compiler Tools)
  set(ZkcCompiler_FIND_REQUIRED_Compiler TRUE)
  set(ZkcCompiler_FIND_REQUIRED_Tools TRUE)
endif()
foreach(_zkc_component IN LISTS _zkc_components ZkcCompiler_FIND_COMPONENTS)
  set(ZkcCompiler_${_zkc_component}_FOUND FALSE)
endforeach()
set(_zkc_pending)
foreach(_zkc_component IN LISTS ZkcCompiler_FIND_COMPONENTS)
  if(_zkc_component IN_LIST _zkc_components)
    list(APPEND _zkc_pending ${_zkc_component})
  elseif(ZkcCompiler_FIND_REQUIRED_${_zkc_component})
    set(ZkcCompiler_FOUND FALSE)
    set(ZkcCompiler_NOT_FOUND_MESSAGE "Unknown ZkcCompiler component: ${_zkc_component}")
    return()
  endif()
endforeach()
set(_zkc_requested)
while(_zkc_pending)
  list(POP_FRONT _zkc_pending _zkc_component)
  if(NOT _zkc_component IN_LIST _zkc_requested)
    list(APPEND _zkc_requested ${_zkc_component})
    list(APPEND _zkc_pending ${_zkc_dependencies_${_zkc_component}})
  endif()
endwhile()

# A later request may expand this installation, but must not silently combine
# component libraries (and contribution catalogs) from different installations.
get_filename_component(_zkc_package_directory "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
foreach(_zkc_component IN LISTS _zkc_components)
  set(_zkc_targets Zkc::${_zkc_component})
  if(_zkc_component STREQUAL "Tools")
    set(_zkc_targets Zkc::zkc-compile Zkc::zkc-opt Zkc::zkc-tblgen)
  endif()
  foreach(_zkc_target IN LISTS _zkc_targets)
    if(TARGET ${_zkc_target})
      get_target_property(_zkc_owner ${_zkc_target} ZKC_SDK_PACKAGE_DIRECTORY)
      if(NOT _zkc_owner STREQUAL _zkc_package_directory)
        message(FATAL_ERROR "ZkcCompiler target belongs to a different installation: ${_zkc_target}")
      endif()
    endif()
  endforeach()
endforeach()

# Only contribution discovery needs a function to contain find_dependency's
# early return. LLVM/MLIR discovery stays in the caller's scope so external
# dialects retain all upstream build variables, including TableGen and modules.
function(_zkc_find_contribution_dependencies)
  set(_zkc_native_found FALSE PARENT_SCOPE)
  set(ZkcCompiler_FIND_REQUIRED FALSE)
  set(ZkcCompiler_FIND_QUIETLY TRUE)
  @ZKC_CONTRIBUTION_FIND_DEPENDENCIES@
  set(_zkc_native_found TRUE PARENT_SCOPE)
endfunction()

set(_zkc_llvm_found FALSE)
set(_zkc_native_found FALSE)
set(_zkc_unicode_found TRUE)
set(_zkc_dependency_error "LLVM/MLIR @LLVM_PACKAGE_VERSION@ or installed contributions unavailable")
if("Language" IN_LIST _zkc_requested AND NOT "@ZKC_SDK_UTF8PROC_VERSION@" STREQUAL "")
  set(_zkc_unicode_found FALSE)
  # Do not replace an already imported target with another library version.
  if(TARGET utf8proc::utf8proc AND
      (NOT DEFINED utf8proc_VERSION OR
       NOT utf8proc_VERSION VERSION_EQUAL "@ZKC_SDK_UTF8PROC_VERSION@"))
    set(_zkc_dependency_error "Loaded utf8proc does not match @ZKC_SDK_UTF8PROC_VERSION@")
  else()
    set(_zkc_utf8proc_search)
    set(_zkc_selected_utf8proc_dir "${utf8proc_DIR}")
    if(utf8proc_DIR)
      set(_zkc_utf8proc_search PATHS "${utf8proc_DIR}" NO_DEFAULT_PATH)
    endif()
    find_package(utf8proc @ZKC_SDK_UTF8PROC_VERSION@ EXACT QUIET CONFIG ${_zkc_utf8proc_search})
    if(utf8proc_FOUND AND TARGET utf8proc::utf8proc AND
        utf8proc_VERSION VERSION_EQUAL "@ZKC_SDK_UTF8PROC_VERSION@")
      set(_zkc_unicode_found TRUE)
    else()
      if(_zkc_selected_utf8proc_dir)
        set(utf8proc_DIR "${_zkc_selected_utf8proc_dir}" CACHE PATH "utf8proc package directory" FORCE)
        set(utf8proc_DIR "${_zkc_selected_utf8proc_dir}")
      endif()
      set(_zkc_dependency_error "utf8proc @ZKC_SDK_UTF8PROC_VERSION@ unavailable")
    endif()
  endif()
endif()
if(_zkc_requested)
  # Imported LLVM targets cannot be replaced by a later find_package. Refuse
  # an already loaded incompatible ABI before its variables can be overwritten.
  if(DEFINED LLVM_PACKAGE_VERSION AND
      NOT LLVM_PACKAGE_VERSION VERSION_EQUAL "@LLVM_PACKAGE_VERSION@")
    set(_zkc_dependency_error
      "ZkcCompiler was built with LLVM/MLIR @LLVM_PACKAGE_VERSION@; found ${LLVM_PACKAGE_VERSION}")
  else()
    set(_zkc_llvm_search)
    set(_zkc_selected_llvm_dir "${LLVM_DIR}")
    if(LLVM_DIR)
      # An explicit or previously resolved directory must not silently fall
      # back to another installation when CMake rejects its version.
      set(_zkc_llvm_search PATHS "${LLVM_DIR}" NO_DEFAULT_PATH)
    elseif("IR" IN_LIST _zkc_requested AND MLIR_DIR)
      set(_zkc_llvm_search HINTS "${MLIR_DIR}/../llvm" "${MLIR_DIR}/../LLVM")
    endif()
    # Upstream MLIRConfig uses EXACT REQUIRED LLVM discovery. Preflight it
    # quietly so missing LLVM can still make an optional SDK request not found.
    find_package(LLVM @LLVM_PACKAGE_VERSION@ EXACT QUIET CONFIG ${_zkc_llvm_search})
    if(NOT LLVM_FOUND AND _zkc_selected_llvm_dir)
      # find_package replaces a rejected directory in the cache with NOTFOUND.
      # Retain the selection across both repeated calls and reconfiguration.
      set(LLVM_DIR "${_zkc_selected_llvm_dir}" CACHE PATH "LLVM package directory" FORCE)
      set(LLVM_DIR "${_zkc_selected_llvm_dir}")
    endif()
    if(LLVM_FOUND AND LLVM_PACKAGE_VERSION VERSION_EQUAL "@LLVM_PACKAGE_VERSION@")
      set(_zkc_llvm_found TRUE)
      if("IR" IN_LIST _zkc_requested)
        set(_zkc_mlir_search)
        set(_zkc_selected_mlir_dir "${MLIR_DIR}")
        if(MLIR_DIR)
          set(_zkc_mlir_search PATHS "${MLIR_DIR}" NO_DEFAULT_PATH)
        endif()
        find_package(MLIR @LLVM_PACKAGE_VERSION@ EXACT QUIET CONFIG ${_zkc_mlir_search})
        if(NOT MLIR_FOUND AND _zkc_selected_mlir_dir)
          set(MLIR_DIR "${_zkc_selected_mlir_dir}" CACHE PATH "MLIR package directory" FORCE)
          set(MLIR_DIR "${_zkc_selected_mlir_dir}")
        endif()
        if(NOT LLVM_PACKAGE_VERSION VERSION_EQUAL "@LLVM_PACKAGE_VERSION@")
          set(_zkc_llvm_found FALSE)
          set(_zkc_dependency_error
            "ZkcCompiler was built with LLVM/MLIR @LLVM_PACKAGE_VERSION@; found ${LLVM_PACKAGE_VERSION}")
        elseif(MLIR_FOUND)
          _zkc_find_contribution_dependencies()
        endif()
      endif()
    endif()
  endif()
endif()

foreach(_zkc_component IN LISTS _zkc_components)
  if(NOT _zkc_component IN_LIST _zkc_requested)
    continue()
  endif()
  set(_zkc_available ${_zkc_llvm_found})
  if(_zkc_component STREQUAL "IR" AND NOT _zkc_native_found)
    set(_zkc_available FALSE)
  endif()
  if(_zkc_component STREQUAL "Language" AND NOT _zkc_unicode_found)
    set(_zkc_available FALSE)
  endif()
  foreach(_zkc_dependency IN LISTS _zkc_dependencies_${_zkc_component})
    if(NOT ZkcCompiler_${_zkc_dependency}_FOUND)
      set(_zkc_available FALSE)
    endif()
  endforeach()
  if(NOT _zkc_available)
    if(ZkcCompiler_FIND_REQUIRED_${_zkc_component})
      set(ZkcCompiler_NOT_FOUND_MESSAGE
        "Dependencies unavailable for ZkcCompiler component: ${_zkc_component} (${_zkc_dependency_error})")
    endif()
    continue()
  endif()
  # External imported libraries do not propagate their header paths themselves.
  # Decorate each target once, including across repeated find_package calls.
  set(_zkc_new_target TRUE)
  if(TARGET Zkc::${_zkc_component})
    set(_zkc_new_target FALSE)
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/Zkc${_zkc_component}Targets.cmake")
  if(_zkc_component STREQUAL "Tools")
    set(_zkc_targets Zkc::zkc-compile Zkc::zkc-opt Zkc::zkc-tblgen)
  else()
    set(_zkc_targets Zkc::${_zkc_component})
  endif()
  foreach(_zkc_target IN LISTS _zkc_targets)
    set_property(TARGET ${_zkc_target} PROPERTY ZKC_SDK_PACKAGE_DIRECTORY "${_zkc_package_directory}")
  endforeach()
  if(_zkc_new_target)
    set(_zkc_includes)
    if(_zkc_component STREQUAL "Support")
      set(_zkc_includes ${LLVM_INCLUDE_DIRS})
    elseif(_zkc_component STREQUAL "IR")
      set(_zkc_includes ${MLIR_INCLUDE_DIRS})
    endif()
    if(_zkc_includes)
      set_property(TARGET Zkc::${_zkc_component} APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${_zkc_includes}")
      set_property(TARGET Zkc::${_zkc_component} APPEND PROPERTY
        INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${_zkc_includes}")
    endif()
  endif()
  set(ZkcCompiler_${_zkc_component}_FOUND TRUE)
endforeach()
check_required_components(ZkcCompiler)
