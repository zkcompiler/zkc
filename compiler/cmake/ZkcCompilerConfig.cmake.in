@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(MLIR CONFIG)
# The installed library carries the ABI of the LLVM/MLIR release it was built with.
if(NOT LLVM_PACKAGE_VERSION VERSION_EQUAL "@LLVM_PACKAGE_VERSION@")
  message(FATAL_ERROR
    "ZkcCompiler was built with LLVM/MLIR @LLVM_PACKAGE_VERSION@; found ${LLVM_PACKAGE_VERSION}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ZkcCompilerTargets.cmake")
# External imported libraries do not propagate their header paths themselves.
foreach(component Support Contracts Relation Protocol Claims IR Frontend FrontendLoading Transforms CompilerCore Driver)
  set_property(TARGET Zkc::${component} APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS}")
  set_property(TARGET Zkc::${component} APPEND PROPERTY
    INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS}")
endforeach()
set_property(TARGET Zkc::IR APPEND PROPERTY
  INTERFACE_INCLUDE_DIRECTORIES "${MLIR_INCLUDE_DIRS}")
set_property(TARGET Zkc::IR APPEND PROPERTY
  INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${MLIR_INCLUDE_DIRS}")
check_required_components(ZkcCompiler)
