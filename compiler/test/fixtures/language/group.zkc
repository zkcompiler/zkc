module sample;
domain Fr = field("bls12-381.fr");
domain G = group("bls12-381.g1");

math fn scaled<H:Group>(point:H, scalar:H::Scalar)->H {
  return point * scalar + point;
}
fn work<H:Group>(point:H, scalar:H::Scalar)->H {
  return scaled(point, scalar);
}
protocol Run<H:Group> roles(P,V)(point:H@P, scalar:H::Scalar@P)->(result:H@V)
{
  let result @P = work(point, scalar);
  let received = send P->V(result);
  return(result=received);
}
run Demo(inputs: Run<G>::Inputs) { return Run<G>::run(inputs); }
