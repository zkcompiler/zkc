module sample;
domain Fr=field("bls12-381.fr");
type Vector<F:Field>=builtin("vector",F);
fn filled<F:Field>(x:F,n:index)->Vector<F>{return kernel<F>("vector.fill",x,n);}
fn split<F:Field>(xs:Vector<F>)->(Vector<F>,Vector<F>){return kernel<F>("vector.split",xs);}
fn sum<F:Field>(xs:Vector<F>)->F{return kernel<F>("vector.sum",xs);}
protocol Run roles(P,V)(x:Fr@P,n:index@P)->(left:Fr@V,right:Fr@V){
 let xs @P =filled(x,n);
 let parts @P =split(xs);
 let ys=send P->V(parts);
 let left @V =sum(ys.0);
 let right @V =sum(ys.1);
 return(left=left,right=right);
}
run Demo=Run;
