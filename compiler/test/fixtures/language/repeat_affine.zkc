module sample;
domain Fr = field("bls12-381.fr");
struct State: Drop { value: Fr }
fn make(x: Fr) -> State { return State { value: x }; }
fn identity(x: State) -> State { return x; }
fn take(x: State) -> Fr { let fields = unpack(x); return fields.0; }
protocol Run roles(P)(n: index @P, x: Fr @P) -> (result: Fr @P) {
  let mut state @P = make(x);
  for i in 0..n roles(P) max 4 {
    state = identity(state);
  }
  let result @P = take(state);
  return result;
}
run Demo = Run;
