module sample;
domain Fr = field("bls12-381.fr");
math fn add(a: Fr, b: Fr) -> Fr { return a + b; }
fn sum(x: Fr, n: index) -> Fr {
  let mut total: Fr = 0;
  for _ in 0..n { total = add(total, x); }
  return total;
}
protocol Run roles(P)(x: Fr @P, n: index @P) -> (r: Fr @P) {
  let result @P = sum(x, n);
  return result;
}
entry Demo = Run;
