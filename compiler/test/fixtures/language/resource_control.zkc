module sample;

struct Ticket:Share {}
enum State { Live(Ticket), Empty() }

fn work(n:index, go:bool)->() {
  let mut carried = Ticket{};
  for _ in 0..n {
    carried = carried;
  }
  let state = State::Live(carried);
  let result = match state  {
    Live(value) => {
      let checked = if go  {
        value
      } else {
        stop "reject";
      };
      consume checked;
      ()
    },
    Empty() => { () }
  };
  return result;
}

protocol Run roles(P)(n:index@P, go:bool@P)->() {
  let result @P = work(n, go);
  return ();
}
run Demo = Run;
