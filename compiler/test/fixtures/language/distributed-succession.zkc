struct Pair:
    pub first: index
    pub second: index
    empty: ()

struct Nested roles(L, R):
    pub value: index @R
    pub empty: () @L

#[sealed]
#[linear]
struct Ticket<Tag: nat> roles(A, B):
    nested: Nested roles(B, A)
    data: Pair @B
    zeros: [bool; 0] @A
    empty: () @B

protocol advance<Tag: nat> roles(X, Y)(value: Ticket<Tag> roles(Y, X)) -> Ticket<Tag> roles(Y, X):
    observed <- zkc::records::inspect_record(value)
    incremented <- observed.1.1.first + 1
    data = Pair {first: incremented, second: observed.1.1.second, empty: ()}
    next <- zkc::records::repack_record(observed.0, (observed.1.0, data, observed.1.2, observed.1.3))
    return next

pub protocol Run roles(P, Q, V)() -> index @P:
    nested = Nested roles(P, V) {value: 9, empty: ()}
    first <- Ticket<3> roles(V, P) {data: Pair {first: 7, second: 11, empty: ()}, nested: nested, zeros: [], empty: ()}
    second <- Ticket<3> roles(V, P) {nested: nested, data: Pair {first: 17, second: 19, empty: ()}, empty: (), zeros: []}
    mut state = first
    mut other = second
    for i in 0..3 roles(P, V):
        next <- state.advance()
        next_other <- other.advance()
        state := next
        other := next_other
    fields <- zkc::records::unpack(state)
    other_fields <- zkc::records::unpack(other)
    result <- fields.1.first + other_fields.1.first
    return result
