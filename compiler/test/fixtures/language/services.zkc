module sample;
domain Fr = field("bls12-381.fr");

protocol Draw<F: Field + Share + Wire> roles(P, V)(first: Random<F> @V, second: Random<F> @V) -> (p: F @P, v: F @V) {
  let unused = first.draw();
  let v = second.draw();
  let p = send V -> P(v);
  return (p = p, v = v);
}
protocol Run roles(P, V)(go: bool @V, coins: Random<Fr> @V)
    -> (p: Fr @P, v: Fr @V) {
  require @V go;
  let alias = coins;
  let (p, v) = Draw<Fr>(alias, coins);
  return (p = p, v = v);
}
entry Demo = Run;
