module sample;
domain Fr = field("bls12-381.fr");
enum Choice { A(Fr), B(), C(Fr, Fr), unpack() }
fn make(x: Fr, y: Fr, a: bool, b: bool) -> Choice {
  return if a {
    if b { Choice::unpack() } else { Choice::A(x) }
  } else {
    if b { Choice::C(x, y) } else { Choice::B() }
  };
}
fn read(choice: Choice, fallback: Fr) -> Fr {
  return match choice {
    C(x, y) => { y },
    unpack() => { fallback + fallback },
    B() => { fallback },
    A(x) => { x }
  };
}
protocol Run roles(P,V)(x:Fr@P, y:Fr@P, fallback:Fr@V, a:bool@P, b:bool@P)->(result:Fr@V) {
  let choice @P = make(x, y, a, b);
  let received = send P->V(choice);
  let result @V = read(received, fallback);
  return(result=result);
}
run Demo = Run;
