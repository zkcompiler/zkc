module sample;
domain Fr = field("bls12-381.fr");
protocol Run roles(P)(n: index @P, m: index @P, x: Fr @P) -> (result: Fr @P) {
  let result = repeat roles(P)(i < n, max 3) carry(a = x) capture(m, x) {
    let next = repeat roles(P)(j < m, max 2) carry(b = a) capture(x) {
      yield (b = b + x);
    };
    yield (a = next);
  };
  return (result = result);
}
entry Demo = Run;
