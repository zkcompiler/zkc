module sample;
domain Kzg=commitment("multilinear.kzg.bls12-381/1");
type PK<C:Commitment>=builtin("prover_key",C);
type VK<C:Commitment>=builtin("verifier_key",C);
type Vector<F:Field>=builtin("vector",F);
type Commit<C:Commitment>=builtin("commitment",C);
type Proof<C:Commitment>=builtin("proof",C);
fn produce<C:Commitment>(pk:PK<C>,data:Vector<C::ValueField>,point:Vector<C::PointField>)
  ->(Commit<C>,C::EvaluationField,Proof<C>) where zkc::pcs::MultilinearOpening(C) {
  let table=kernel<C::ValueField>("vector.to_table",data);
  let at=kernel<C::PointField>("vector.to_point",point);
  let committed=kernel<C>("pcs.commit",pk,table);
  let opened=kernel<C>("pcs.open",committed.1,at);
  return(committed.0,opened.0,opened.1);
}
fn check<C:Commitment>(vk:VK<C>,c:Commit<C>,point:Vector<C::PointField>,value:C::EvaluationField,proof:Proof<C>)
  ->bool where zkc::pcs::MultilinearOpening(C) {
  let at=kernel<C::PointField>("vector.to_point",point);
  return kernel<C>("pcs.check",vk,c,at,value,proof);
}
protocol Opening<C:Commitment> roles(P,V)
  (vk:VK<C>@V,pk:PK<C>@P,data:Vector<C::ValueField>@P,point:Vector<C::PointField>@(P,V))
  ->(accepted:bool@V) where zkc::pcs::MultilinearOpening(C), Share(C::PointField), Share(C::EvaluationField), Wire(C::EvaluationField) {
  local P let opened=produce<C>(pk,data,point);
  let c=send P->V(opened.0);
  let value=send P->V(opened.1);
  let proof=send P->V(opened.2);
  local V let ok=check<C>(vk,c,point,value,proof);
  return(accepted=ok);
}
math fn both(a:bool,b:bool)->bool{return intrinsic("bool.and",a,b);}
struct Claim{pub c:Commit<Kzg>,pub tag:bool}
protocol Pair roles(P,V)
  (claim:Claim@(P,V),vk0:VK<Kzg>@V,pk0:PK<Kzg>@P,data0:Vector<Kzg::ValueField>@P,
   vk1:VK<Kzg>@V,pk1:PK<Kzg>@P,data1:Vector<Kzg::ValueField>@P,
   point:Vector<Kzg::PointField>@(P,V),vk_alias:VK<Kzg>@V)->(accepted:bool@V,ready:bool@P) {
  let first=apply Opening<Kzg> roles(P,V)(vk0,pk0,data0,point);
  let second=apply Opening<Kzg> roles(P,V)(vk1,pk1,data1,point);
  let ok=both(first,second);
  return(accepted=ok,ready=claim.tag);
}
entry Run=Pair{setup first{vk_alias,claim.c,vk0,pk0};setup second{vk1,pk1};}
entry Prove=Pair{
  setup first{vk_alias,claim.c,vk0,pk0};setup second{vk1,pk1};
  prover P;verifier V;public{claim,vk0,vk1,point,vk_alias};accept accepted;complete ready;construction authored;
}
