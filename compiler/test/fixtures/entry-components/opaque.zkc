#[sealed]
struct Secret:
    value: bool

local def reveal(secret: Secret) -> bool:
    fields = unpack(secret)
    return fields.0

struct State roles(P, V):
    pub statement: bool @(P, V)
    pub witness: Secret @P
    pub empty: () @V

pub protocol Round roles(P, V)(state: State roles(P, V)) -> bool @V:
    value <- reveal(state.witness)
    received <- send value from P to V
    return received == state.statement

scheme Demo = Round:
    prover P
    verifier V
    public state.statement, state.empty
    accept result
    construction authored

entry def Produce(public: Demo::Public, value: bool) -> Demo::Proof:
    secret = Secret {value: value}
    witness = Demo::Witness {state_witness: secret}
    produced <- Demo::prove(public, witness)
    return produced.proof

entry def Check(public: Demo::Public, candidate: Demo::Proof) -> Demo::VerifyResult:
    checked <- Demo::verify(public, candidate)
    return checked

entry def Run(statement: bool, value: bool) -> bool:
    secret = Secret {value: value}
    prover = Round::Inputs::P {state_statement: statement, state_witness: secret}
    verifier = Round::Inputs::V {state_statement: statement, state_empty: ()}
    inputs = Round::Inputs {P: prover, V: verifier}
    completed <- Round::run(inputs)
    return completed.V.result

entry def Import(secret: Secret) -> Secret:
    return secret
