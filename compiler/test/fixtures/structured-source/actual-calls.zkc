module actual_calls;
domain Fr = field("bls12-381.fr");

math fn difference(x:Fr,y:Fr)->Fr { return x-y; }

protocol Twice roles(P)(x:Fr@P,y:Fr@P)->(first:Fr@P,second:Fr@P) {
  let first = difference(x,y);
  let second = difference(y,x);
  return (first=first,second=second);
}

protocol Select roles(P,V)(go:bool@(P,V),x:Fr@P,coins:Random<Fr>@P)->(out:Fr@V) {
  let y @P = if go { coins.draw() } else { x };
  let sent = send P->V(y);
  return sent;
}

protocol Nested roles(P)(first:bool@P,second:bool@P,x:Fr@P,y:Fr@P)->(out:Fr@P) {
  return if first {
    if second { difference(x,y) } else { difference(y,x) }
  } else { x };
}

fn reject_value()->Fr { stop "reject"; }

protocol DrawPair roles(P)(enabled:bool@P,left:Random<Fr>@P,right:Random<Fr>@P)
    ->(first:Fr@P,second:Fr@P) {
  let first @P = if enabled { left.draw() } else { reject_value() };
  let second = right.draw();
  return (first=first,second=second);
}
