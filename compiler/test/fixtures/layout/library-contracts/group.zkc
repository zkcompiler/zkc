module group_client

domain Curve = group("bls12-381.g1")

pub relation DLog<G: Group>(base: G, point: G, secret: G::Scalar):
    point == base * secret

pub interface Responses:
    def response<G: Group>(nonce: G::Scalar, challenge: G::Scalar,
                           secret: G::Scalar) -> G::Scalar

pub module Standard: Responses:
    def response<H: Group>(nonce: H::Scalar, challenge: H::Scalar,
                           secret: H::Scalar) -> H::Scalar:
        nonce + challenge * secret

pub protocol Schnorr<G: Group, R: Responses> roles(P, V)(
    base: G @(P, V);
    point: G @(P, V);
    secret: G::Scalar @P;
    nonces: Random<G::Scalar> @P;
    challenges: Random<G::Scalar> @V
) -> (accepted: bool @V):
    nonce <- nonces.draw()
    #[site(commitment)]
    commitment <- send base * nonce to V
    #[site(challenge)]
    challenge <- challenges.draw()
    #[site(delivery)]
    received <- send challenge to P
    value = R::response<G>(nonce, received, secret)
    #[site(response)]
    response <- send value to V
    return base * response == commitment + point * challenge

spec for Schnorr:
    requires base@P == base@V
    requires point@P == point@V
    requires point@P == base@P * secret
    target knowledge: DLog(base@V, point@V, secret) accept accepted
    ensures accepted
    ensures equation: point@V == base@V * secret
    security:
        completeness: formal::completeness(target.knowledge)
        knowledge: formal::knowledge(target.knowledge, challenge = site challenge)

pub spec Honest for Schnorr:
    security:
        completeness: formal::completeness(target.knowledge)

entry def Run(inputs: Schnorr<Curve, Standard>::Inputs):
    result <- Schnorr<Curve, Standard>::run(inputs)
    return result
