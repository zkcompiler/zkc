module sums

use evaluation::{Pending, affine, pending}

domain F = field("bls12-381.fr")

pub relation Sum<C: Field>(table: [C; 4], claimed: C):
    claimed == table[0] + table[1] + table[2] + table[3]

// The opening consumer is generic in the field at each member application.
// It does not receive the prover's working table in place of the statement.
pub interface Opening:
    local def open<C: Field>(claim: Pending<C>, table: [C; 4]) -> bool effects()
    protocol Open<C: Field> roles(P, V)(
        claim: Pending<C> @V; table: [C; 4] @V
    ) -> bool @V effects()

pub module Revealed: Opening:
    local def open<A: Field>(claim: Pending<A>, table: [A; 4]) -> bool:
        accepted <- evaluation::check(claim, table)
        return accepted
    protocol Open<A: Field> roles(H, R)(
        claim: Pending<A> @R; table: [A; 4] @R
    ) -> bool @R:
        accepted <- open<A>(claim, table)
        return accepted

pub protocol Reduce<C: Field> roles(P, V)(
    table: [C; 4] @P;
    claimed: C @V;
    coins: Random<C> @V
) -> Pending<C> @V:
    pair0 = (table[0] + table[1], table[2] + table[3])
    #[site(round0)]
    received0 <- send pair0 to V
    guard claimed == received0.0 + received0.1
    #[site(coin0)]
    r0 <- coins.draw()
    #[site(delivery0)]
    p0 <- send r0 to P
    pair1 = (affine(table[0], table[2], p0), affine(table[1], table[3], p0))
    current0 = affine(received0.0, received0.1, r0)
    #[site(round1)]
    received1 <- send pair1 to V
    guard current0 == received1.0 + received1.1
    #[site(coin1)]
    r1 <- coins.draw()
    #[site(delivery1)]
    p1 <- send r1 to P
    current1 = affine(received1.0, received1.1, r1)
    claim <- pending([r0, r1], current1)
    return claim

pub protocol Argument<C: Field, O: Opening> roles(P, V)(
    table: [C; 4] @P;
    statement: [C; 4] @V;
    claimed: C @V;
    coins: Random<C> @V
) -> (accepted: bool @V):
    #[site(reduction)]
    claim <- Reduce<C>(table, claimed, coins)
    accepted <- O::Open<C>(claim, statement) @(P, V)
    return accepted

spec for Argument:
    requires table == statement
    requires claimed == statement[0] + statement[1] + statement[2] + statement[3]
    target statement_sum: Sum(statement, claimed) accept accepted
    ensures accepted
    security:
        soundness: formal::soundness(target.statement_sum)

entry def Run(inputs: Argument<F, Revealed>::Inputs):
    result <- Argument<F, Revealed>::run(inputs)
    return result
