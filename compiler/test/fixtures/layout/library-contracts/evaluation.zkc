module evaluation

#[sealed]
#[linear]
pub struct Pending<F: Field>:
    point: [F; 2]
    value: F

pub def affine<F: Field>(left: F, right: F, point: F) -> F:
    (1 - point) * left + point * right

pub local def pending<F: Field>(point: [F; 2], value: F) -> Pending<F>:
    claim <- Pending<F> {point: point, value: value}
    return claim

// The caller chooses the verifier's authoritative table. Consuming the linear
// claim alone is not acceptance; compare its actual point and value.
pub local def check<F: Field>(claim: Pending<F>, table: [F; 4]) -> bool:
    fields <- unpack(claim)
    point = fields.0
    expected = affine(affine(table[0], table[2], point[0]),
                      affine(table[1], table[3], point[0]), point[1])
    return fields.1 == expected
