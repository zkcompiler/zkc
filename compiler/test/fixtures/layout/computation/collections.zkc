module collections
pub type Vector<E: Field> = builtin("vector", E)
pub type Finite<I: Type + Copy + Drop> = builtin("finite", I)
pub view def elements<E: Field>(xs: Vector<E>) -> Finite<E> = domain("elements")
pub view def zip<A: Type + Copy + Drop, B: Type + Copy + Drop>(left: Finite<A>, right: Finite<B>) -> Finite<(A, B)> = domain("zip")
pub view def relay<I: Type + Copy + Drop>(rows: Finite<I>) -> Finite<I>:
    return rows
pub def fold<I: Type + Copy + Drop, S: Type + Copy + Drop>(rows: Finite<I>, initial: S, step: fn(S, item: I) -> S where item_from(item, rows)) -> S = finite("math.fold")
pub local def fold_where<I: Type + Copy + Drop, S: Type + Copy + Drop>(rows: Finite<I>, initial: S, keep: local fn(item: I) -> bool effects(stop) where item_from(item, rows), step: local fn(S, item: I) -> S effects(stop) where item_from(item, rows)) -> S effects(stop) = finite("local.fold_where")
