module m
use zkc::descriptor as ds
domain F = field("koala-bear")
type Vector<E: Field> = builtin("vector", E)
type Matrix<E: Field> = builtin("matrix", E)
type Finite<I: Type + Copy + Drop> = builtin("finite", I)
view def elements<E: Field>(xs: Vector<E>) -> Finite<E> = domain("elements")
view def zip<A: Type + Copy + Drop, B: Type + Copy + Drop>(a: Finite<A>, b: Finite<B>) -> Finite<(A, B)> = domain("zip")
view def product<A: Type + Copy + Drop, B: Type + Copy + Drop>(a: Finite<A>, b: Finite<B>) -> Finite<(A, B)> = domain("product")
view def range(lo: index, hi: index) -> Finite<index> = domain("range")
view def row<E: Field>(matrix: Matrix<E>, i: index) -> Finite<E> = domain("matrix.row")
local def ordered<I: Type + Copy + Drop, S: Type + Copy + Drop>(rows: Finite<I>, initial: S, step: local fn(S, item: I) -> S effects(stop) where item_from(item, rows)) -> S effects(stop) = finite("local.fold")
module Build:
    pub view def step<I: nat>(context: ds::Product<Finite<F>>, state: ds::Sequence<Finite<F>>) -> ds::Sequence<Finite<F>>:
        checked = zip(context.0, context.0)
        return ds::append(state, context.0)
view def guarded(xs: Vector<F>, ys: Vector<F>) -> ds::Product<Finite<F>, ds::Sequence<Finite<F>>>:
    checked = zip(elements(xs), elements(ys))
    generated = ds::fold<Count=3>(member=Build::step, context=(elements(xs),), seed=[])
    return (elements(xs), generated)
pub protocol Demo roles(P)(xs: Vector<F> @P, ys: Vector<F> @P, unrelated: Vector<F> @P, lo: index @P, hi: index @P, initial: F @P) -> F @P:
    ignored = zip(elements(xs), elements(unrelated))
    selected = guarded(ys=ys, xs=xs)
    replaced = ds::replace<Index=1>(selected.1, selected.0)
    fixed = ds::sized<Length=3>(replaced)
    joined = ds::concat(ds::unsized(fixed), [])
    result <- ordered(product(range(lo, hi), joined[1]), initial, fn(state, item) => state + item.1)
    return result
view def row_guarded(matrix: Matrix<F>, i: index, xs: Vector<F>) -> ds::Product<Finite<F>>:
    checked = row(matrix, i)
    return (elements(xs),)
pub protocol Rows roles(P)(matrix: Matrix<F> @P, i: index @P, xs: Vector<F> @P, lo: index @P, hi: index @P, initial: F @P) -> F @P:
    selected = row_guarded(xs=xs, i=i, matrix=matrix)
    result <- ordered(product(range(lo, hi), selected.0), initial, fn(state, item) => state + item.1)
    return result
module Empty:
    pub view def step<I: nat>(context: ds::Product<Finite<(F, F)>>, state: ds::Product<>) -> ds::Product<>:
        checked = zip(context.0, context.0)
        return state
view def zero(xs: Vector<F>, ys: Vector<F>) -> ds::Product<Finite<F>, ds::Product<>>:
    empty = ds::fold<Count=0>(member=Empty::step, context=(zip(elements(xs), elements(ys)),), seed=())
    return (elements(xs), empty)
pub protocol Zero roles(P)(xs: Vector<F> @P, ys: Vector<F> @P, lo: index @P, hi: index @P, initial: F @P) -> F @P:
    selected = zero(ys=ys, xs=xs)
    result <- ordered(product(range(lo, hi), selected.0), initial, fn(state, item) => state + item.1)
    return result
