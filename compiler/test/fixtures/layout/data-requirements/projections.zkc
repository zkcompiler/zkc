domain F = field("bls12-381.fr")
type Array<N: nat> = builtin("field_array", F, N)
def apply<N: nat>(xs: [Array<4>; N], predicate: fn([Array<4>; N]) -> bool) -> bool:
    return predicate(xs)
def same(xs: Array<4>, ys: Array<4>) -> bool where equal_extent(xs, ys):
    return true
def selected<N: nat>(xs: [Array<4>; N]) -> bool where (1 <= N, equal_extent(xs.0, xs.0)):
    return true
interface Selection:
    def selected<N: nat>(xs: [Array<4>; N]) -> bool where (1 <= N, equal_extent(xs.0, xs.0))
module Implementation: Selection:
    def selected<N: nat>(xs: [Array<4>; N]) -> bool where (1 <= N, equal_extent(xs.0, xs.0)):
        return true
def member<M: nat, C: Selection>(xs: [Array<4>; M]) -> bool where 1 <= M:
    return apply(xs, C::selected<M>)
def nested<N: nat>(xs: [Array<4>; N]) -> bool where 1 <= N:
    first = apply(xs, selected<N>)
    return same(xs[0], xs[0])
def literal<N: nat>(xs: [Array<4>; N]) -> bool where 1 <= N:
    return apply(xs, fn(values) => same(values[0], values[0]))
def controls<M: nat>(xs: [Array<4>; M]) -> (bool, bool, bool, bool, bool, bool, bool) where 1 <= M:
    return (selected<M>(xs), apply(xs, fn(values) => selected<M>(values)), apply(xs, selected<M>), apply(xs, selected), member<M, Implementation>(xs), apply(xs, nested<M>), apply(xs, literal<M>))
pub protocol Run roles(P)(xs: Array<4> @P) -> (bool, bool, bool, bool, bool, bool, bool) @P:
    return controls<1>([xs])
entry def Main(inputs: Run::Inputs):
    outputs <- Run::run(inputs)
    return outputs
