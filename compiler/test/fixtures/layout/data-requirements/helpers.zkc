domain F = field("bls12-381.fr")
type Array<N: nat> = builtin("field_array", F, N)
type Finite<I: Type + Copy + Drop> = builtin("finite", I)
view def elements<N: nat>(xs: Array<N>) -> Finite<F> = domain("elements")
view def indices<N: nat>(xs: Array<N>) -> Finite<index> = domain("indices")
def fold<I: Type + Copy + Drop, S: Type + Copy + Drop>(rows: Finite<I>, initial: S, step: fn(S, item: I) -> S where item_from(item, rows)) -> S = finite("math.fold")
def bounded_unit<N: nat>(xs: Array<N>, i: index) -> F where in_bounds(i, xs):
    return 1
def total<N: nat, M: nat>(xs: Array<N>, ys: Array<M>) -> F where equal_extent(xs, ys):
    count = fold(indices(xs), 0, fn(state, i) => state + bounded_unit(ys, i))
    return count + fold(elements(ys), 0, fn(state, value) => state + value)
def same<N: nat, M: nat>(xs: Array<N>, ys: Array<M>) -> bool where equal_extent(xs, ys):
    return true
def same_fixed(xs: Array<2>, ys: Array<2>) -> bool where equal_extent(xs, ys):
    return true
def apply(xs: Array<2>, ys: Array<2>, predicate: fn(Array<2>, Array<2>) -> bool) -> bool:
    return predicate(xs, ys)
