module sample

type Kind = builtin("oracle.table", index, 4)
type Handle = builtin("oracle", Kind)

struct Sources roles(A, B, C):
    pub left: Handle @C -> (A, B)
    pub right: Handle @B -> A

struct Envelope roles(X, Y, Z):
    pub sources: Sources roles(Y, Z, X)
    pub flag: bool @Y
    empty: [Sources roles(X, Y, Z); 0]

protocol Forward roles(P, Q, V)(state: Envelope roles(P, V, Q)) -> Envelope roles(P, V, Q):
    return state

pub protocol Relay roles(V, Q, P)(state: Envelope roles(P, V, Q)) -> Envelope roles(P, V, Q):
    result <- Forward(state) @(P, Q, V)
    return result
