module claims;
domain G=group("bls12-381.g1");
relation DLog<H:Group>(parameter base:H,statement point:H,witness scalar:H::Scalar){
  return point==base*scalar;
}
protocol Schnorr<H:Group> roles(P,V)
  (base:H@(P,V),point:H@(P,V),scalar:H::Scalar@P,
   nonces:Random<H::Scalar>@P,challenges:Random<H::Scalar>@V)
  ->(accepted:bool@V)
  spec{target knowledge=DLog<H>(in.base@V,in.point@V,in.scalar) accept out.accepted;}
{
  let nonce=nonces.draw();
  let commitment=send P->V(base*nonce);
  #[site(challenge)] let challenge=challenges.draw();
  let received=send V->P(challenge);
  let response=send P->V(nonce+received*scalar);
  let accepted@V=base*response==commitment+point*challenge;
  return(accepted=accepted);
}
proof Demo=Schnorr<G>{
  prover P;verifier V;public{base,point};accept accepted;target knowledge;
  construction fiat_shamir("merlin3.bls12-381.fr64be/0", challenges);
}
spec SchnorrClaims for Demo {
  know: knowledge@0(target.knowledge,
    model=models.fiat_shamir@0(level=levels.bytes,statement=statements.fixed,
      oracle=oracles.random@0(construction.provider),queries=2^64),
    accept=out.accepted,stage=executable_bytes,
    guarantee=guarantees.forking@0(challenges=cardinality(G.Scalar),
      cost=prover_runs(2),success=acc*(acc/(Q+1)-1/cardinality(G.Scalar))));
}
verify SchnorrClaims.know=fs.forking@0();
