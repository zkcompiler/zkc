domain F = field("bls12-381.fr")
type Vec = builtin("vector", F)
type K = builtin("oracle.table", F, 16)
type O = builtin("oracle", K)
struct Sources roles(A,B,V):
    pub left: O @A -> V
    pub right: O @B -> V
    pub point: index @V
pub protocol Run roles(P,Q,V)(flag: bool @(P,Q,V), left: Vec @P, right: Vec @Q, point: index @V) -> index @V:
    first <- send left from P to V as oracle<K>
    second <- send right from Q to V as oracle<K>
    sources = Sources {left: first, right: second, point: point}
    result = if flag:
        sources
    else:
        sources
    return result.point
