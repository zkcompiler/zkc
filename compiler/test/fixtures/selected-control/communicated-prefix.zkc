protocol Distribute roles(A,B,C)(flag: bool @A, go: bool @C) -> bool @(A,B,C):
    first <- send flag from A to B
    guard @C go
    second <- send flag from A to C
    return @(A = flag, B = first, C = second)
pub protocol Run roles(P,V,W)(flag: bool @P, go: bool @W) -> bool @(P,V,W):
    common <- Distribute(flag, go) @(P,V,W)
    result = if common:
        true
    else:
        false
    return result
