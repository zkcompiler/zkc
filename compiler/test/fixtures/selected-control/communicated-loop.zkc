domain F = field("bls12-381.fr")
pub protocol Run roles(P,V)(count: index @P, coins: Random<F> @P) -> (bool, F) @(P,V):
    received_count <- send count from P to V
    common_count = @(P = count, V = received_count)
    mut total: F = 0
    mut agreed = true
    for i in 0..common_count roles(P,V) max 4:
        sample <- coins.draw()
        received <- send sample from P to V
        common = @(P = sample, V = received)
        total := total + common
        agreed := if common == common:
            agreed
        else:
            false
    return (agreed, total)
