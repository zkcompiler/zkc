struct Config:
    pub count: index
    pub enabled: bool

protocol Deliver roles(A,B)(cfg: Config @A) -> Config @(A,B):
    received <- send cfg from A to B
    return @(A = cfg, B = received)

def decide(flag: bool) -> bool:
    return !flag

pub protocol Run roles(P,V)(count: index @P, enabled: bool @P) -> bool @(P,V):
    cfg = Config {count: count, enabled: enabled}
    common <- Deliver(cfg) @(P,V)
    mut result = false
    for i in 0..common.count roles(P,V) max 4:
        result := if decide(common.enabled):
            true
        else:
            false
    return result
