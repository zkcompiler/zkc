local def identity(value: bool) -> bool:
    return value
pub protocol Run roles(P,V)(flag: bool @(P,V), value: bool @(P,V)) -> bool @(P,V):
    selected = if true:
        flag
    else:
        p: bool @P <- identity(value)
        v: bool @V <- identity(value)
        @(P = p, V = v)
    result = if selected:
        value
    else:
        value
    return result
