domain F = field("bls12-381.fr")
pub protocol Run roles(P,V)(flag: bool @(P,V), coins: Random<F> @P, other: Random<F> @P) -> F @P:
    alias = coins
    #[site(choice)]
    result = if flag:
        #[site(challenge)]
        value <- coins.draw()
        value
    else:
        #[site(challenge)]
        value <- alias.draw()
        value
    return result
