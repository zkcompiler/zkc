// The claim carried between the two rounds is the remaining partial sum plus one.
module shifted_pairs

use zkc::curves::bls12_381::{Fr}
use zkc::multilinear::{fix_first, evaluate}
use zkc::polynomial::{MvPoly, extension}
use sumcheck<Fr>::{Table, sums}

def boundary<remaining: nat>(m: (Fr, Fr)) -> Fr:
    if remaining == 0 then m.0 + m.1 + 1 else m.0 + m.1

def interpolate<remaining: nat>(m: (Fr, Fr), r: Fr) -> Fr:
    if remaining == 1 then m.0 + (m.1 - m.0) * r + 1 else m.0 + (m.1 - m.0) * r

protocol Reduce roles(P, V)(
    spec p: MvPoly<Fr, n = 2, D = 1>,
    state: Table<2> @P,
    prefix: [Fr; 0] @(P, V),
    claim: Fr @(P, V)
) -> (point: [Fr; 2] @(P, V), value: Fr @(P, V), residual: Table<0> @P):
    mut s = state
    mut running = claim
    for i in 0..2 collect (challenges = challenge):
        round <- send sums(s) to V
        guard @V running == boundary<remaining = 1 - i>(round)
        challenge <- draw Fr from V to P
        s := fix_first(s, challenge)
        running := interpolate<remaining = 1 - i>(round, challenge)
    return (prefix ++ challenges, running, s)

spec for Reduce:
    charge sites.challenge <= 1 / Fr::Order

relation Sum(values: Table<2>, claim: Fr):
    (∑ v ∈ values, v) == claim

pub protocol Check roles(P, V)(values: Table<2> @(P, V), claim: Fr @(P, V)):
    reduced <- Reduce(values, [], claim, spec p = extension(values))
    guard @V reduced.value == evaluate(values, reduced.point)

spec for Check:
    proves @V Sum(values, claim)
