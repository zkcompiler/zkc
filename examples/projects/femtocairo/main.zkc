module example;
use stark::koala_bear::{Base, Extension};
use stark::koala_bear::bundle::{Statement, ThreeTableArgument};
use air::interaction::{LogUp};
use zkc::vector::{Vector};

domain Execution = bundle(asset execution);

// Clean supplies the CPU constraints and witnesses. Indexed program and
// immutable memory tables use the same field-balance reduction as any Bundle.
protocol Execute roles(P,V)
    (witness: [Vector<Base>; 3] @P, statement: Statement @(P,V),
     coins: Random<Extension> @V) -> (accepted: bool @V) {
  let statementP @P = statement;
  let statementV @V = statement;
  let accepted = ThreeTableArgument<Execution,LogUp<Extension>,5,7,8,8>(witness,
    statementP, statementV, 5, 8, 8, 2, coins);
  return accepted;
}

proof Proof = Execute {
  prover P;
  verifier V;
  public { statement };
  accept accepted;
  construction fiat_shamir("merlin3.koala-bear.ext8-binomial3.rejection31le/0", coins);
}
