module example;
use ethereum::eip4844::{Commit, Prove, Challenge, PointEvaluation};
use ethereum::eip4844::{PointOpening, Point, BlobOpening, Blob, BlobBatch, Batch};

// The polynomial-commitment functions of EIP-4844 as Entries.
entry fn BlobToCommitment(inputs: Commit::Inputs) {
  return Commit::run(inputs);
}
entry fn ComputeKzgProof(inputs: Prove::Inputs) {
  return Prove::run(inputs);
}
entry fn ComputeChallenge(inputs: Challenge::Inputs) {
  return Challenge::run(inputs);
}
entry fn PointEvaluationPrecompile(inputs: PointEvaluation::Inputs) {
  return PointEvaluation::run(inputs);
}

proof KzgProof = PointOpening {
  prover P;
  verifier V;
  public { commitment, z, y };
  accept accepted;
  construction Point;
}
proof BlobProof = BlobOpening {
  prover P;
  verifier V;
  public { blob, commitment };
  accept accepted;
  construction Blob;
}
proof BlobBatchProof = BlobBatch<64> {
  prover P;
  verifier V;
  public { blobs, commitments, count };
  accept accepted;
  construction Batch<64>;
}
