module example;
use fri::{Vector, LowDegree};
domain E = field("koala-bear.ext8-binomial3");
domain Rows = commitment("rows.merkle-keccak256.koala-bear.ext8-binomial3/0");
protocol Fri roles(P,V)(word: Vector<E> @P, shift: E @(P,V), round_count: index @(P,V),
    query_count: index @(P,V), coins: Random<E> @V)
    -> (accepted: bool @V) {
  let (accepted, _, _, _) = LowDegree<Rows,5,0,3,8>(word, shift, shift, round_count, query_count, coins);
  return (accepted = accepted);
}
entry Run = Fri;
entry Proof = Fri {
  prover P;
  verifier V;
  public { shift, round_count, query_count };
  accept accepted;
  construction fiat_shamir("merlin3.koala-bear.ext8-binomial3.rejection31le/0") {
    derive coins;
  }
}
