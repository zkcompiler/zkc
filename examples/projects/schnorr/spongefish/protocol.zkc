module statement;
use zkc::bytes::{Bytes};
use schnorr::{Schnorr};
use spongefish::bls12_381::{G};

pub protocol Session roles(P,V)
    (tag: Bytes @(P,V), session: Bytes @(P,V), base: G @(P,V), point: G @(P,V),
     scalar: G::Scalar @P, nonces: Random<G::Scalar> @P,
     challenges: Random<G::Scalar> @V) -> (accepted: bool @V) {
  #[site(proof)] let accepted = Schnorr<G>(base, point, scalar, nonces, challenges);
  return accepted;
}
