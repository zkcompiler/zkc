module example;
use schnorr::{Schnorr};
domain G = group("bls12-381.g1");

entry Proof = Schnorr<G> {
  prover P;
  verifier V;
  public { base, point };
  accept accepted;
  target knowledge;
  construction fiat_shamir("merlin3.bls12-381.fr64be/1") {
    derive challenges;
  }
}
entry Interactive = Schnorr<G>;
