module imported_air;
domain Base = field("koala-bear");
domain Extension = field("koala-bear.ext8-binomial3");
type Vector<F: Field> = builtin("vector", F);

// Both kernels fix the arena exported from the adapter's recurrence AIR. The
// captured contents give the arena its canonical identity, which the compiled
// package carries. Which value each arena input receives is decided by the
// adapter's closed view, which prepares the assignments. This source does not
// check them.
domain Export = ring(asset export);

fn row_values<F: Field>(assignments: Vector<F>, rows: index) -> Vector<F> {
  return kernel<F>("ring.rows", assignments, rows; Export);
}
fn coefficient_values<F: Field>(coefficients: Vector<F>, width: index) -> Vector<F> {
  return kernel<F>("ring.coefficients", coefficients, width; Export);
}
fn all_zero<F: Field>(values: Vector<F>) -> bool {
  let zero: F = 0;
  let zeros = kernel<F>("vector.fill", zero, kernel<F>("vector.length", values));
  return kernel<F>("vector.equal", values, zeros);
}

// Row-major assignments give row-major residuals, one column per assertion.
// `satisfied` states only that every residual of these assignments is zero.
protocol Rows roles(Evaluator)
    (assignments: Vector<Base> @Evaluator, rows: index @Evaluator)
    -> (residuals: Vector<Base> @Evaluator, satisfied: bool @Evaluator) {
  local Evaluator let residuals = row_values(assignments, rows);
  local Evaluator let satisfied = all_zero(residuals);
  return (residuals = residuals, satisfied = satisfied);
}
// Slot-major coefficients give output-major residual polynomials.
protocol Coefficients roles(Evaluator)
    (coefficients: Vector<Base> @Evaluator, width: index @Evaluator)
    -> (residuals: Vector<Base> @Evaluator) {
  local Evaluator let residuals = coefficient_values(coefficients, width);
  return (residuals = residuals);
}
// One Ext8 assignment per evaluation point; the arena's KoalaBear inputs are
// interpreted in Ext8.
protocol Points roles(Evaluator)
    (assignments: Vector<Extension> @Evaluator, points: index @Evaluator)
    -> (residuals: Vector<Extension> @Evaluator) {
  local Evaluator let residuals = row_values(assignments, points);
  return (residuals = residuals);
}
entry RowResiduals = Rows;
entry CoefficientResiduals = Coefficients;
entry PointResiduals = Points;
