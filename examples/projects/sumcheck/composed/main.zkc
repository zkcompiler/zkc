module example;
use sums::{TwoSums};
domain F = field("bls12-381.fr");

proof Proof = TwoSums<F,4> {
  prover P;
  verifier V;
  public { left, right, left_sum, right_sum, rounds };
  accept accepted;
  construction fiat_shamir("merlin3.bls12-381.fr64be/0", challenges);
}
entry fn Interactive(inputs: TwoSums<F,4>::Inputs) {
  return TwoSums<F,4>::run(inputs);
}

// Partial reductions are reusable protocols. Their pending residual must be
// consumed by a caller before returning through an Entry.

spec ProofClaims for Proof {
  ideal_sound: soundness@0(target.public_sums,
    model=models.fiat_shamir@0(level=levels.ideal,statement=statements.adaptive,
      oracle=oracles.random@0(construction.provider),queries=Q,budget_symbol=Q,
      validator_cost=8/cardinality(F),application=application),
    accept=out.accepted,stage=compiled_ideal,error=(Q+8)/cardinality(F));
  charged: soundness@0(target.public_sums,
    model=models.fiat_shamir@0(level=levels.ideal,statement=statements.adaptive,
      oracle=oracles.random@0(construction.provider),queries=Q,budget_symbol=Q,
      validator_cost=8/cardinality(F),application=application),
    accept=out.accepted,stage=compiled_ideal,
    charge=[per_site(sites.left.challenge,1/cardinality(F)),
      per_site(sites.right.challenge,1/cardinality(F))]);
}
verify ProofClaims.ideal_sound=fs.keyed_soundness@0();
verify ProofClaims.charged=fs.keyed_charged@0();
