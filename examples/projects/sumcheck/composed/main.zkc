module example;
use sums::{TwoSums};
domain F = field("bls12-381.fr");

proof Proof = TwoSums<F,4> {
  prover P;
  verifier V;
  public { left, right, left_sum, right_sum, rounds };
  accept accepted;
  construction fiat_shamir("merlin3.bls12-381.fr64be/0", challenges);
}
run Interactive(inputs: TwoSums<F,4>::Inputs) {
  return TwoSums<F,4>::run(inputs);
}

// Inspect the reusable round result without claiming proof acceptance.
run Reduction(inputs: sums::Reduction<F,4>::Inputs) {
  return sums::Reduction<F,4>::run(inputs);
}
