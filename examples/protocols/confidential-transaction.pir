fn RangeResponsesAlgorithm<F: domain Field>(
  l0: Vector<F::Element>,
  sl: Vector<F::Element>,
  r0: Vector<F::Element>,
  r1: Vector<F::Element>,
  z_weights: Vector<F::Element>,
  blinding: Vector<F::Element>,
  alpha: F::Element,
  rho: F::Element,
