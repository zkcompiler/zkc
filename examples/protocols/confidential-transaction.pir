  let xr1 = zkc::algebra::vector_scale::<F>(r1, x);
  let l = zkc::algebra::vector_add::<F>(l0, xsl);
  let r = zkc::algebra::vector_add::<F>(r0, xr1);
  let tx = zkc::algebra::vector_dot::<F>(l, r);
  let x2 = zkc::algebra::mul::<F>(x, x);
  let xtau1 = zkc::algebra::mul::<F>(x, tau1);
  let x2tau2 = zkc::algebra::mul::<F>(x2, tau2);
  let value_blindings = zkc::algebra::vector_dot::<F>(z_weights, blinding);
  let poly_blindings = zkc::algebra::add::<F>(xtau1, x2tau2);
  let tau = zkc::algebra::add::<F>(poly_blindings, value_blindings);
  let xrho = zkc::algebra::mul::<F>(x, rho);
  let mu = zkc::algebra::add::<F>(alpha, xrho);
  return (l, r, tx, tau, mu);
