    let first = curve::add::<G>(t1b, tau1b);
    let t2b = curve::scale::<G>(base, t2);
    let tau2b = curve::scale::<G>(blind, tau2);
    let second = curve::add::<G>(t2b, tau2b);
    return (first, second);
  }

  fn RangeResponsesAlgorithm<F: domain Field>(
    l0: Vector<F::Element>,
    sl: Vector<F::Element>,
    r0: Vector<F::Element>,
    r1: Vector<F::Element>,
    z_weights: Vector<F::Element>,
    blinding: Vector<F::Element>,
    alpha: F::Element,
    rho: F::Element,
    tau1: F::Element,
    tau2: F::Element,
    x: F::Element
  ) -> (Vector<F::Element>, Vector<F::Element>, F::Element, F::Element, F::Element) requires (
    Field(F)
  ) {
    let xsl = vector::scale::<F>(sl, x);
    let xr1 = vector::scale::<F>(r1, x);
    let l = vector::add::<F>(l0, xsl);
    let r = vector::add::<F>(r0, xr1);
    let tx = vector::dot::<F>(l, r);
    let x2 = field::mul::<F>(x, x);
    let xtau1 = field::mul::<F>(x, tau1);
    let x2tau2 = field::mul::<F>(x2, tau2);
    let value_blindings = vector::dot::<F>(z_weights, blinding);
    let poly_blindings = field::add::<F>(xtau1, x2tau2);
    let tau = field::add::<F>(poly_blindings, value_blindings);
    let xrho = field::mul::<F>(x, rho);
    let mu = field::add::<F>(alpha, xrho);
    return (l, r, tx, tau, mu);
  }

  fn CheckRangeEquationAlgorithm<G: domain Group>(
    commitments: Vector<G::Element>,
    base: G::Element,
    blind: G::Element,
    t1: G::Element,
    t2: G::Element,
    y: G::Scalar::Element,
    z: G::Scalar::Element,
    x: G::Scalar::Element,
    tx: G::Scalar::Element,
    tau: G::Scalar::Element
  ) -> (bool) requires (ScalarAction(G), Field(G::Scalar)) {
    let two = field::constant::<G::Scalar>() attributes ("2");
    let ys = vector::powers::<G::Scalar>(y) attributes ("16");
    let sum_y = vector::sum::<G::Scalar>(ys);
    let twos = vector::powers::<G::Scalar>(two) attributes ("8");
    let sum_two = vector::sum::<G::Scalar>(twos);
    let zs = vector::powers::<G::Scalar>(z) attributes ("5");
    let delta_zs = vector::gather::<G::Scalar>(zs) attributes ("3", "4");
    let sum_z = vector::sum::<G::Scalar>(delta_zs);
    let z_weights = vector::gather::<G::Scalar>(zs) attributes ("2", "3");
    let z2 = field::mul::<G::Scalar>(z, z);
    let z_minus_z2 = field::sub::<G::Scalar>(z, z2);
    let delta_left = field::mul::<G::Scalar>(z_minus_z2, sum_y);
    let delta_right = field::mul::<G::Scalar>(sum_z, sum_two);
    // Finite power sums: y=1 remains valid, with no inverse of y-1.
    let delta = field::sub::<G::Scalar>(delta_left, delta_right);
    let values = curve::msm::<G>(z_weights, commitments);
    let delta_b = curve::scale::<G>(base, delta);
    let xt1 = curve::scale::<G>(t1, x);
    let x2 = field::mul::<G::Scalar>(x, x);
    let x2t2 = curve::scale::<G>(t2, x2);
    let rhs0 = curve::add::<G>(values, delta_b);
    let rhs1 = curve::add::<G>(rhs0, xt1);
    let rhs = curve::add::<G>(rhs1, x2t2);
    let txb = curve::scale::<G>(base, tx);
    let taub = curve::scale::<G>(blind, tau);
    let lhs = curve::add::<G>(txb, taub);
    let range_ok = curve::equal::<G>(lhs, rhs);
    control::require(range_ok);
    return (range_ok);
  }

  fn RangeParentAlgorithm<G: domain Group>(
    a: G::Element,
    s: G::Element,
    g: Vector<G::Element>,
    h: Vector<G::Element>,
    base: G::Element,
    blind: G::Element,
    y: G::Scalar::Element,
    z: G::Scalar::Element,
    x: G::Scalar::Element,
    w: G::Scalar::Element,
    tx: G::Scalar::Element,
    mu: G::Scalar::Element
  ) -> (G::Element, G::Element, Vector<G::Scalar::Element>) requires (
    ScalarAction(G),
    Field(G::Scalar)
  ) {
    let two = field::constant::<G::Scalar>() attributes ("2");
    let inverse_y = field::inverse::<G::Scalar>(y);
    let factors = vector::powers::<G::Scalar>(inverse_y) attributes ("16");
    let ys = vector::powers::<G::Scalar>(y) attributes ("16");
    let zs = vector::powers::<G::Scalar>(z) attributes ("4");
    let z_weights = vector::gather::<G::Scalar>(zs) attributes ("2", "3");
    let twos = vector::powers::<G::Scalar>(two) attributes ("8");
    let d = vector::kronecker::<G::Scalar>(z_weights, twos);
    let zy = vector::scale::<G::Scalar>(ys, z);
    let h_weights = vector::add::<G::Scalar>(zy, d);
    // This parent contraction is an actual single-use scale_each -> msm pair.
    let h_prime = curve::scale_each::<G>(factors, h);
    let h_term = curve::msm::<G>(h_weights, h_prime);
    let negative_z = field::neg::<G::Scalar>(z);
    let g_weights = vector::splat::<G::Scalar>(negative_z) attributes ("16");
    let g_term = curve::msm::<G>(g_weights, g);
    let xs = curve::scale::<G>(s, x);
    let negative_mu = field::neg::<G::Scalar>(mu);
    let mu_term = curve::scale::<G>(blind, negative_mu);
    let q = curve::scale::<G>(base, w);
    let txq = curve::scale::<G>(q, tx);
    let p0 = curve::add::<G>(a, xs);
    let p1 = curve::add::<G>(p0, g_term);
    let p2 = curve::add::<G>(p1, h_term);
    let p3 = curve::add::<G>(p2, mu_term);
    let parent = curve::add::<G>(p3, txq);
    return (parent, q, factors);
  }

  fn PrepareIPAAlgorithm<G: domain Group>(
    a: Vector<G::Scalar::Element>,
    b: Vector<G::Scalar::Element>,
    g: Vector<G::Element>,
    h: Vector<G::Element>,
    factors: Vector<G::Scalar::Element>,
    q: G::Element,
    parent: G::Element
  ) -> (Vector<G::Element>) requires (ScalarAction(G), Field(G::Scalar)) {
    // Materialize actual prover bases. This result escapes to recursive folds.
    let h_prime = curve::scale_each::<G>(factors, h);
    let a_g = curve::msm::<G>(a, g);
    let b_h = curve::msm::<G>(b, h_prime);
    let ab = vector::dot::<G::Scalar>(a, b);
    let ab_q = curve::scale::<G>(q, ab);
    let vectors = curve::add::<G>(a_g, b_h);
    let expected = curve::add::<G>(vectors, ab_q);
    let ok = curve::equal::<G>(parent, expected);
    control::require(ok);
    return (h_prime);
  }

  fn IPACrossTermsAlgorithm<G: domain Group>(
    a: Vector<G::Scalar::Element>,
    b: Vector<G::Scalar::Element>,
    g: Vector<G::Element>,
    h: Vector<G::Element>,
    q: G::Element
  ) -> (G::Element, G::Element) requires (ScalarAction(G), Field(G::Scalar)) {
    let (al, ar) = vector::split::<G::Scalar>(a);
    let (bl, br) = vector::split::<G::Scalar>(b);
    let (gl, gr) = curve::split::<G>(g);
    let (hl, hr) = curve::split::<G>(h);
    let al_gr = curve::msm::<G>(al, gr);
    let br_hl = curve::msm::<G>(br, hl);
    let al_br = vector::dot::<G::Scalar>(al, br);
    let lq = curve::scale::<G>(q, al_br);
    let lv = curve::add::<G>(al_gr, br_hl);
    let left = curve::add::<G>(lv, lq);
    let ar_gl = curve::msm::<G>(ar, gl);
    let bl_hr = curve::msm::<G>(bl, hr);
    let ar_bl = vector::dot::<G::Scalar>(ar, bl);
    let rq = curve::scale::<G>(q, ar_bl);
    let rv = curve::add::<G>(ar_gl, bl_hr);
    let right = curve::add::<G>(rv, rq);
    return (left, right);
  }

  fn FoldIPAAlgorithm<G: domain Group>(
    a: Vector<G::Scalar::Element>,
    b: Vector<G::Scalar::Element>,
    g: Vector<G::Element>,
    h: Vector<G::Element>,
    u: G::Scalar::Element
  ) -> (
    Vector<G::Scalar::Element>,
    Vector<G::Scalar::Element>,
    Vector<G::Element>,
    Vector<G::Element>
  ) requires (ScalarAction(G), Field(G::Scalar)) {
    let inverse = field::inverse::<G::Scalar>(u);
    let (al, ar) = vector::split::<G::Scalar>(a);
    let (bl, br) = vector::split::<G::Scalar>(b);
    let (gl, gr) = curve::split::<G>(g);
    let (hl, hr) = curve::split::<G>(h);
    let ual = vector::scale::<G::Scalar>(al, u);
    let iar = vector::scale::<G::Scalar>(ar, inverse);
    let next_a = vector::add::<G::Scalar>(ual, iar);
    let ibl = vector::scale::<G::Scalar>(bl, inverse);
    let ubr = vector::scale::<G::Scalar>(br, u);
    let next_b = vector::add::<G::Scalar>(ibl, ubr);
    let igl = curve::vector_scale::<G>(gl, inverse);
    let ugr = curve::vector_scale::<G>(gr, u);
    let next_g = curve::vector_add::<G>(igl, ugr);
    let uhl = curve::vector_scale::<G>(hl, u);
    let ihr = curve::vector_scale::<G>(hr, inverse);
    let next_h = curve::vector_add::<G>(uhl, ihr);
    return (next_a, next_b, next_g, next_h);
  }

  fn IPAWeightSeedAlgorithm<F: domain Field>() -> (Vector<F::Element>) requires (Field(F)) {
    let one = field::constant::<F>() attributes ("1");
    let seed = vector::splat::<F>(one) attributes ("1");
    return (seed);
  }

  fn FoldPublicIPAAlgorithm<G: domain Group>(
    parent: G::Element,
    left: G::Element,
    right: G::Element,
    u: G::Scalar::Element,
    g_weights: Vector<G::Scalar::Element>,
    h_weights: Vector<G::Scalar::Element>
  ) -> (G::Element, Vector<G::Scalar::Element>, Vector<G::Scalar::Element>) requires (
    ScalarAction(G),
    Field(G::Scalar)
  ) {
    let inverse = field::inverse::<G::Scalar>(u);
    let u2 = field::mul::<G::Scalar>(u, u);
    let i2 = field::mul::<G::Scalar>(inverse, inverse);
    let u2l = curve::scale::<G>(left, u2);
    let i2r = curve::scale::<G>(right, i2);
    let p_left = curve::add::<G>(parent, u2l);
    let next_parent = curve::add::<G>(p_left, i2r);
    let g_pair_empty = vector::empty::<G::Scalar>();
    let g_pair_0 = vector::append::<G::Scalar>(g_pair_empty, inverse);
    let g_pair = vector::append::<G::Scalar>(g_pair_0, u);
    let h_pair_empty = vector::empty::<G::Scalar>();
    let h_pair_0 = vector::append::<G::Scalar>(h_pair_empty, u);
    let h_pair = vector::append::<G::Scalar>(h_pair_0, inverse);
    // Kronecker expands MSB-to-LSB weights in challenge order.
    let next_g = vector::kronecker::<G::Scalar>(g_weights, g_pair);
    let next_h = vector::kronecker::<G::Scalar>(h_weights, h_pair);
    return (next_parent, next_g, next_h);
  }

  fn IPATerminalScalarsAlgorithm<F: domain Field>(
    a: Vector<F::Element>,
    b: Vector<F::Element>
  ) -> (F::Element, F::Element) requires (Field(F)) {
    let a_shape = vector::length_check::<F>(a) attributes ("1");
    control::require(a_shape);
    let b_shape = vector::length_check::<F>(b) attributes ("1");
    control::require(b_shape);
    let a_final = vector::at::<F>(a) attributes ("0");
    let b_final = vector::at::<F>(b) attributes ("0");
    return (a_final, b_final);
  }

  fn CheckIPATerminalAlgorithm<G: domain Group>(
    parent: G::Element,
    q: G::Element,
    g: Vector<G::Element>,
    h: Vector<G::Element>,
    factors: Vector<G::Scalar::Element>,
    g_weights: Vector<G::Scalar::Element>,
    h_weights: Vector<G::Scalar::Element>,
    a: G::Scalar::Element,
    b: G::Scalar::Element
  ) -> (bool) requires (ScalarAction(G), Field(G::Scalar)) {
    let g_shape = vector::length_check::<G::Scalar>(g_weights) attributes ("16");
    control::require(g_shape);
    let h_shape = vector::length_check::<G::Scalar>(h_weights) attributes ("16");
    control::require(h_shape);
    let a_weights = vector::scale::<G::Scalar>(g_weights, a);
    let b_weights = vector::scale::<G::Scalar>(h_weights, b);
    let a_g = curve::msm::<G>(a_weights, g);
    // The SECOND actual verification contraction uses original H and y^-i.
    let h_prime = curve::scale_each::<G>(factors, h);
    let b_h = curve::msm::<G>(b_weights, h_prime);
    let ab = field::mul::<G::Scalar>(a, b);
    let ab_q = curve::scale::<G>(q, ab);
    let vectors = curve::add::<G>(a_g, b_h);
    let rhs = curve::add::<G>(vectors, ab_q);
    // parent already includes every u^2*L + u^-2*R. Never check tx=a*b.
    let ipa_ok = curve::equal::<G>(parent, rhs);
    control::require(ipa_ok);
    return (ipa_ok);
  }

  protocol InnerProductArgument {
    // This concrete profile requires nonidentity cross commitments, as in
    // the selected upstream range profile. Valid zero/sparse IPA relations
    // can be outside this profile; the compiler itself permits identity.
    roles (P, V);
    parameters (rounds);
    inputs (
      P a: Vector<ristretto255.scalar::Element>,
      P b: Vector<ristretto255.scalar::Element>,
      P p_g: Vector<ristretto255.group::Element>,
      P p_h: Vector<ristretto255.group::Element>,
      P p_factors: Vector<ristretto255.scalar::Element>,
      P p_q: ristretto255.group::Element,
      P p_parent: ristretto255.group::Element,
      V g: Vector<ristretto255.group::Element>,
      V h: Vector<ristretto255.group::Element>,
      V factors: Vector<ristretto255.scalar::Element>,
      V q: ristretto255.group::Element,
      V parent: ristretto255.group::Element,
      V coins: Rng<ristretto255.scalar>
    );
    outputs (V bool, V Rng<ristretto255.scalar>);
    local P: let h_prime = PrepareIPA(a, b, p_g, p_h, p_factors, p_q, p_parent);
    local V: let seed = IPAWeightSeed();
    loop [ipa_rounds] rounds carry (
      av = a,
      bv = b,
      gv = p_g,
      hv = h_prime,
      current_parent = parent,
      gw = seed,
      hw = seed,
      random = coins
    ) capture (p_q) -> (a_end, b_end, g_end, h_end, parent_end, gw_end, hw_end, after) {
      local P: let (left, right) = IPACrossTerms(av, bv, gv, hv, p_q);
      local P: CheckProofPoints(left, right);
      message ipa_left: P(left) -> V(received_left);
      message ipa_right: P(right) -> V(received_right);
      local V: CheckProofPoints(received_left, received_right);
      local V: let (u, next_random) = DrawChallenge(random);
      message ipa_challenge: V(u) -> P(p_u);
      local P: let (next_a, next_b, next_g, next_h) = FoldIPA(av, bv, gv, hv, p_u);
      local V: let (next_parent, next_gw, next_hw) = FoldPublicIPA(
        current_parent,
        received_left,
        received_right,
        u,
        gw,
        hw
      );
      yield (next_a, next_b, next_g, next_h, next_parent, next_gw, next_hw, next_random);
    }
    local P: let (a_final, b_final) = IPATerminalScalars(a_end, b_end);
    message ipa_terminal_a: P(a_final) -> V(received_a);
    message ipa_terminal_b: P(b_final) -> V(received_b);
    local V: let accepted = CheckIPATerminal(
      parent_end,
      q,
      g,
      h,
      factors,
      gw_end,
      hw_end,
      received_a,
      received_b
    );
    return (accepted, after);
  }

  protocol AggregatedRange {
    roles (P, V);
    parameters (rounds);
    inputs (
      P values: Vector<ristretto255.scalar::Element>,
      P blinding: Vector<ristretto255.scalar::Element>,
      P bits: Vector<ristretto255.scalar::Element>,
      P entropy: Rng<ristretto255.scalar>,
      P p_g: Vector<ristretto255.group::Element>,
      P p_h: Vector<ristretto255.group::Element>,
      P p_base: ristretto255.group::Element,
      P p_blind: ristretto255.group::Element,
      P p_commitments: Vector<ristretto255.group::Element>,
      P p_context: Vector<ristretto255.scalar::Element>,
      V g: Vector<ristretto255.group::Element>,
      V h: Vector<ristretto255.group::Element>,
      V base: ristretto255.group::Element,
      V blind: ristretto255.group::Element,
      V commitments: Vector<ristretto255.group::Element>,
      V context: Vector<ristretto255.scalar::Element>,
      V coins: Rng<ristretto255.scalar>
    );
    outputs (V bool, V Rng<ristretto255.scalar>, P Rng<ristretto255.scalar>);
    dependencies (ipa: InnerProductArgument(rounds = rounds));
    // Commitment identity is pinned point-by-point in the given public order.
    local P: CheckProofPoints(p_base, p_blind);
    local V: CheckProofPoints(base, blind);
    local P: let value_commitments = ValueCommitments(values, blinding, p_base, p_blind);
    local P: CheckCommitments(value_commitments, p_commitments);
    message ordered_commitments: P(value_commitments) -> V(received_commitments);
    local V: CheckCommitments(received_commitments, commitments);
    local P: let (alpha, rho, sl, sr, after_vectors) = DrawVectorMasks(entropy);
    local P: let (ar, a, s) = RangeCommitments(bits, sl, sr, alpha, rho, p_g, p_h, p_blind);
    local P: CheckProofPoints(a, s);
    message range_a: P(a) -> V(received_a);
    message range_s: P(s) -> V(received_s);
    local V: CheckProofPoints(received_a, received_s);
    local V: let (y, after_y) = DrawChallenge(coins);
    message range_y: V(y) -> P(p_y);
    local P: let inverse_y = InverseNonzero(p_y);
    local V: let (z, after_z) = DrawChallenge(after_y);
    message range_z: V(z) -> P(p_z);
    local P: let inverse_z = InverseNonzero(p_z);
    local P: let (l0, r0, r1, z_weights, t1, t2) = RangePolynomials(bits, ar, sl, sr, p_y, p_z);
    local P: let (tau1, tau2, after_masks) = DrawPolynomialMasks(after_vectors);
    local P: let (first, second) = PolynomialCommitments(t1, t2, tau1, tau2, p_base, p_blind);
    local P: CheckProofPoints(first, second);
    message range_t1: P(first) -> V(received_first);
    message range_t2: P(second) -> V(received_second);
    local V: CheckProofPoints(received_first, received_second);
    local V: let (x, after_x) = DrawChallenge(after_z);
    message range_x: V(x) -> P(p_x);
    local P: let inverse_x = InverseNonzero(p_x);
    local P: let (l, r, tx, tau, mu) = RangeResponses(
      l0,
      sl,
      r0,
      r1,
      z_weights,
      blinding,
      alpha,
      rho,
      tau1,
      tau2,
      p_x
    );
    message range_tx: P(tx) -> V(received_tx);
    message range_tau: P(tau) -> V(received_tau);
    message range_mu: P(mu) -> V(received_mu);
    local V: let (w, after_w) = DrawChallenge(after_x);
    message range_w: V(w) -> P(p_w);
    local P: let inverse_w = InverseNonzero(p_w);
    // The range equation and the IPA equation are separate required checks.
    local V: let range_ok = CheckRangeEquation(
      received_commitments,
      base,
      blind,
      received_first,
      received_second,
      y,
      z,
      x,
      received_tx,
      received_tau
    );
    local P: let (p_parent, p_q, p_factors) = RangeParent(
      a,
      s,
      p_g,
      p_h,
      p_base,
      p_blind,
      p_y,
      p_z,
      p_x,
      p_w,
      tx,
      mu
    );
    local V: let (parent, q, factors) = RangeParent(
      received_a,
      received_s,
      g,
      h,
      base,
      blind,
      y,
      z,
      x,
      w,
      received_tx,
      received_mu
    );
    // No message or entry port can replace the computed validator parent.
    invoke [range_ipa] ipa(
      l,
      r,
      p_g,
      p_h,
      p_factors,
      p_q,
      p_parent,
      g,
      h,
      factors,
      q,
      parent,
      after_w
    ) -> (ipa_ok, after_ipa);
    local V: let accepted = Both(range_ok, ipa_ok);
    return (accepted, after_ipa, after_masks);
  }

  instance ipa: InnerProductArgument {
    parameters (rounds = 4);
    roles (P = P, V = V);
  }

  instance range: AggregatedRange {
    parameters (rounds = 4);
    dependencies (ipa = ipa);
    roles (P = P, V = V);
  }

  configure DrawChallenge = DrawChallengeAlgorithm(F = ristretto255.scalar);
  configure Both = BothAlgorithm();
  configure InverseNonzero = InverseNonzeroAlgorithm(F = ristretto255.scalar);
  configure CheckProofPoints = CheckProofPointsAlgorithm(G = ristretto255.group);
  configure ValueCommitments = ValueCommitmentsAlgorithm(G = ristretto255.group);
  configure CheckCommitments = CheckCommitmentsAlgorithm(G = ristretto255.group);
  configure DrawVectorMasks = DrawVectorMasksAlgorithm(F = ristretto255.scalar);
  configure DrawPolynomialMasks = DrawPolynomialMasksAlgorithm(F = ristretto255.scalar);
  configure RangeCommitments = RangeCommitmentsAlgorithm(G = ristretto255.group);
  configure RangePolynomials = RangePolynomialsAlgorithm(F = ristretto255.scalar);
  configure PolynomialCommitments = PolynomialCommitmentsAlgorithm(G = ristretto255.group);
  configure RangeResponses = RangeResponsesAlgorithm(F = ristretto255.scalar);
  configure CheckRangeEquation = CheckRangeEquationAlgorithm(G = ristretto255.group);
  configure RangeParent = RangeParentAlgorithm(G = ristretto255.group);
  configure PrepareIPA = PrepareIPAAlgorithm(G = ristretto255.group);
  configure IPACrossTerms = IPACrossTermsAlgorithm(G = ristretto255.group);
  configure FoldIPA = FoldIPAAlgorithm(G = ristretto255.group);
  configure IPAWeightSeed = IPAWeightSeedAlgorithm(F = ristretto255.scalar);
  configure FoldPublicIPA = FoldPublicIPAAlgorithm(G = ristretto255.group);
  configure IPATerminalScalars = IPATerminalScalarsAlgorithm(F = ristretto255.scalar);
  configure CheckIPATerminal = CheckIPATerminalAlgorithm(G = ristretto255.group);
  fn BalanceSubjectAlgorithm<G: domain Group>(
    inputs: Vector<G::Element>,
    outputs: Vector<G::Element>,
    base: G::Element,
    fee: G::Scalar::Element
  ) -> (G::Element) requires (ScalarAction(G), Field(G::Scalar)) {
    let one = field::constant::<G::Scalar>() attributes ("1");
    let input_weights = vector::splat::<G::Scalar>(one) attributes ("2");
    let output_weights = vector::splat::<G::Scalar>(one) attributes ("2");
    let incoming = curve::msm::<G>(input_weights, inputs);
    let outgoing = curve::msm::<G>(output_weights, outputs);
    let fee_point = curve::scale::<G>(base, fee);
    let negative_one = field::neg::<G::Scalar>(one);
    let negative_outputs = curve::scale::<G>(outgoing, negative_one);
    let negative_fee = curve::scale::<G>(fee_point, negative_one);
    let difference = curve::add::<G>(incoming, negative_outputs);
    let excess = curve::add::<G>(difference, negative_fee);
    return (excess);
  }

  fn ExcessBlindingAlgorithm<F: domain Field>(
    inputs: Vector<F::Element>,
    outputs: Vector<F::Element>
  ) -> (F::Element) requires (Field(F)) {
    let input_shape = vector::length_check::<F>(inputs) attributes ("2");
    control::require(input_shape);
    let output_shape = vector::length_check::<F>(outputs) attributes ("2");
    control::require(output_shape);
    let incoming = vector::sum::<F>(inputs);
    let outgoing = vector::sum::<F>(outputs);
    let secret = field::sub::<F>(incoming, outgoing);
    return (secret);
  }

  fn SchnorrNonceAlgorithm<G: domain Group>(
    base: G::Element,
    entropy: Rng<G::Scalar>
  ) -> (G::Scalar::Element, G::Element, Rng<G::Scalar>) requires (ScalarAction(G), Field(G::Scalar)) {
    let (nonce, after) = random::draw::<G::Scalar>(entropy);
    let point = curve::scale::<G>(base, nonce);
    return (nonce, point, after);
  }

  fn NonidentityAlgorithm<G: domain Group>(point: G::Element) -> () requires (
    ScalarAction(G),
    Field(G::Scalar)
  ) {
    let ok = curve::nonidentity::<G>(point);
    control::require(ok);
    return ();
  }

  fn SchnorrResponseAlgorithm<F: domain Field>(
    nonce: F::Element,
    secret: F::Element,
    challenge: F::Element
  ) -> (F::Element) requires (Field(F)) {
    let product = field::mul::<F>(challenge, secret);
    let response = field::add::<F>(nonce, product);
    return (response);
  }

  fn SchnorrEquationAlgorithm<G: domain Group>(
    base: G::Element,
    subject: G::Element,
    nonce: G::Element,
    challenge: G::Scalar::Element,
    response: G::Scalar::Element
  ) -> (bool) requires (ScalarAction(G), Field(G::Scalar)) {
    let left = curve::scale::<G>(base, response);
    let weighted = curve::scale::<G>(subject, challenge);
    let right = curve::add::<G>(nonce, weighted);
    let ok = curve::equal::<G>(left, right);
    control::require(ok);
    return (ok);
  }

  fn Owner0Algorithm<G: domain Group>(owners: Vector<G::Element>) -> (G::Element) requires (
    ScalarAction(G),
    Field(G::Scalar)
  ) {
    let owner = curve::at::<G>(owners) attributes ("0");
    let ok = curve::nonidentity::<G>(owner);
    control::require(ok);
    return (owner);
  }

  fn Secret0Algorithm<F: domain Field>(secrets: Vector<F::Element>) -> (F::Element) requires (
    Field(F)
  ) {
    let shape = vector::length_check::<F>(secrets) attributes ("2");
    control::require(shape);
    let secret = vector::at::<F>(secrets) attributes ("0");
    return (secret);
  }

  fn Owner1Algorithm<G: domain Group>(owners: Vector<G::Element>) -> (G::Element) requires (
    ScalarAction(G),
    Field(G::Scalar)
  ) {
    let owner = curve::at::<G>(owners) attributes ("1");
    let ok = curve::nonidentity::<G>(owner);
    control::require(ok);
    return (owner);
  }

  fn Secret1Algorithm<F: domain Field>(secrets: Vector<F::Element>) -> (F::Element) requires (
    Field(F)
  ) {
    let shape = vector::length_check::<F>(secrets) attributes ("2");
    control::require(shape);
    let secret = vector::at::<F>(secrets) attributes ("1");
    return (secret);
  }

  protocol SchnorrKnowledge {
    roles (P, V);
    inputs (
      P secret: ristretto255.scalar::Element,
      P p_base: ristretto255.group::Element,
      P entropy: Rng<ristretto255.scalar>,
      V base: ristretto255.group::Element,
      V subject: ristretto255.group::Element,
      V coins: Rng<ristretto255.scalar>
    );
    outputs (V bool, V Rng<ristretto255.scalar>, P Rng<ristretto255.scalar>);
    local P: let (nonce, point, after_entropy) = SchnorrNonce(p_base, entropy);
    local P: Nonidentity(point);
    message schnorr_nonce: P(point) -> V(received_nonce);
    local V: Nonidentity(received_nonce);
    local V: let (challenge, after_coins) = DrawChallenge(coins);
    message schnorr_challenge: V(challenge) -> P(received_challenge);
    local P: let response = SchnorrResponse(nonce, secret, received_challenge);
    message schnorr_response: P(response) -> V(received_response);
    local V: let accepted = SchnorrEquation(
      base,
      subject,
      received_nonce,
      challenge,
      received_response
    );
    return (accepted, after_coins, after_entropy);
  }

  // Every nested invocation inherits the constructor's complete publicRoot.
  // Host admission fixes generators, ledger membership, distinct IDs and integer bounds.
  protocol ConfidentialTransaction {
    roles (P, V);
    parameters (rounds);
    inputs (
      P p_g: Vector<ristretto255.group::Element>,
      P p_h: Vector<ristretto255.group::Element>,
      P p_base: ristretto255.group::Element,
      P p_blind: ristretto255.group::Element,
      P p_commitments: Vector<ristretto255.group::Element>,
      P p_context: Vector<ristretto255.scalar::Element>,
      P p_input_commitments: Vector<ristretto255.group::Element>,
      P p_owners: Vector<ristretto255.group::Element>,
      P p_input_ids: Vector<ristretto255.scalar::Element>,
      P p_fee: ristretto255.scalar::Element,
      V g: Vector<ristretto255.group::Element>,
      V h: Vector<ristretto255.group::Element>,
      V base: ristretto255.group::Element,
      V blind: ristretto255.group::Element,
      V commitments: Vector<ristretto255.group::Element>,
      V context: Vector<ristretto255.scalar::Element>,
      V input_commitments: Vector<ristretto255.group::Element>,
      V owners: Vector<ristretto255.group::Element>,
      V input_ids: Vector<ristretto255.scalar::Element>,
      V fee: ristretto255.scalar::Element,
      P values: Vector<ristretto255.scalar::Element>,
      P blinding: Vector<ristretto255.scalar::Element>,
      P bits: Vector<ristretto255.scalar::Element>,
      P input_blinding: Vector<ristretto255.scalar::Element>,
      P secrets: Vector<ristretto255.scalar::Element>,
      P entropy: Rng<ristretto255.scalar>,
      V coins: Rng<ristretto255.scalar>
    );
    outputs (V bool, V Rng<ristretto255.scalar>, P Rng<ristretto255.scalar>);
    dependencies (
      range: AggregatedRange(rounds = rounds),
      balance: SchnorrKnowledge(),
      auth0: SchnorrKnowledge(),
      auth1: SchnorrKnowledge()
    );
    invoke [output_ranges] range(
      values,
      blinding,
      bits,
      entropy,
      p_g,
      p_h,
      p_base,
      p_blind,
      p_commitments,
      p_context,
      g,
      h,
      base,
      blind,
      commitments,
      context,
      coins
    ) -> (range_ok, after_range_coins, after_range_entropy);
    local P: let excess_secret = ExcessBlinding(input_blinding, blinding);
    local V: let excess_subject = BalanceSubject(input_commitments, commitments, base, fee);
    invoke [balance_knowledge] balance(
      excess_secret,
      p_blind,
      after_range_entropy,
      blind,
      excess_subject,
      after_range_coins
    ) -> (balance_ok, balance_coins, balance_entropy);
    local V: let range_balance_ok = Both(range_ok, balance_ok);
    local P: let secret0 = Secret0(secrets);
    local V: let owner0 = Owner0(owners);
    invoke [authorize_input_0] auth0(
      secret0,
      p_base,
      balance_entropy,
      base,
      owner0,
      balance_coins
    ) -> (auth0_ok, auth0_coins, auth0_entropy);
    local V: let accepted0 = Both(range_balance_ok, auth0_ok);
    local P: let secret1 = Secret1(secrets);
    local V: let owner1 = Owner1(owners);
    invoke [authorize_input_1] auth1(
      secret1,
      p_base,
      auth0_entropy,
      base,
      owner1,
      auth0_coins
    ) -> (auth1_ok, auth1_coins, auth1_entropy);
    local V: let accepted1 = Both(accepted0, auth1_ok);
    return (accepted1, auth1_coins, auth1_entropy);
  }

  instance balance: SchnorrKnowledge {
    roles (P = P, V = V);
  }

  instance auth0: SchnorrKnowledge {
    roles (P = P, V = V);
  }

  instance auth1: SchnorrKnowledge {
    roles (P = P, V = V);
  }

  instance transaction: ConfidentialTransaction {
    parameters (rounds = 4);
    dependencies (range = range, balance = balance, auth0 = auth0, auth1 = auth1);
    roles (P = P, V = V);
  }

  entry main = transaction;
  configure BalanceSubject = BalanceSubjectAlgorithm(G = ristretto255.group);
  configure ExcessBlinding = ExcessBlindingAlgorithm(F = ristretto255.scalar);
  configure SchnorrNonce = SchnorrNonceAlgorithm(G = ristretto255.group);
  configure Nonidentity = NonidentityAlgorithm(G = ristretto255.group);
  configure SchnorrResponse = SchnorrResponseAlgorithm(F = ristretto255.scalar);
  configure SchnorrEquation = SchnorrEquationAlgorithm(G = ristretto255.group);
  configure Owner0 = Owner0Algorithm(G = ristretto255.group);
  configure Secret0 = Secret0Algorithm(F = ristretto255.scalar);
  configure Owner1 = Owner1Algorithm(G = ristretto255.group);
  configure Secret1 = Secret1Algorithm(F = ristretto255.scalar);
}
