fn CheckCommitmentsAlgorithm<G: domain Group>(
  actual: Vector<G::Element>,
  expected: Vector<G::Element>
) -> () requires (ScalarAction(G), Field(G::Scalar)) {
  let one = zkc::algebra::constant::<G::Scalar>() attributes ("1");
  let weights = zkc::algebra::vector_splat::<G::Scalar>(one) attributes ("2");
  // MSM checks exact group-vector length; curve.at alone would miss a suffix.
  let actual_sum = zkc::curve::msm::<G>(weights, actual);
  let expected_sum = zkc::curve::msm::<G>(weights, expected);
  let sum_ok = zkc::curve::equal::<G>(actual_sum, expected_sum);
  zkc::core::require(sum_ok);
  let actual0 = zkc::curve::at::<G>(actual) attributes ("0");
  let expected0 = zkc::curve::at::<G>(expected) attributes ("0");
  let ok0 = zkc::curve::equal::<G>(actual0, expected0);
  zkc::core::require(ok0);
  let actual1 = zkc::curve::at::<G>(actual) attributes ("1");
  let expected1 = zkc::curve::at::<G>(expected) attributes ("1");
  let ok1 = zkc::curve::equal::<G>(actual1, expected1);
  zkc::core::require(ok1);
  return ();
}
fn DrawVectorMasksAlgorithm<F: domain Field>(
  coins: Rng<F>
) -> (F::Element, F::Element, Vector<F::Element>, Vector<F::Element>, Rng<F>) requires (Field(F)) {
  // Global advancing tape: alpha, rho, sL[0..N), sR[0..N).
  let (alpha, after_alpha) = zkc::random::draw::<F>(coins);
  let (rho, after_rho) = zkc::random::draw::<F>(after_alpha);
  let (sl, after_sl) = zkc::random::vector::<F>(after_rho) attributes ("16");
  let (sr, after_sr) = zkc::random::vector::<F>(after_sl) attributes ("16");
  return (alpha, rho, sl, sr, after_sr);
}
