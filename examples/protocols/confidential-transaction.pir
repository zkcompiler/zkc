  let z_weights = zkc::algebra::vector_gather::<F>(zs) attributes ("2", "3");
  let twos = zkc::algebra::vector_powers::<F>(two) attributes ("8");
  // Party-major i=j*n+b: d_i = z^(j+2)*2^b.
