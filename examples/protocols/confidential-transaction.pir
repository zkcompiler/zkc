module {
  fn DrawChallengeAlgorithm<F: domain Field>(coins: Rng<F>) -> (F::Element, Rng<F>) requires (
    Field(F)
  ) {
    [draw] let (value, after) = random::draw::<F>(coins);
    // field.inverse rejects zero at this source position; there is no retry.
    let inverse = field::inverse::<F>(value);
    return (value, after);
  }

  fn BothAlgorithm<>(a: bool, b: bool) -> (bool) {
    let ok = bool::and(a, b);
    return (ok);
  }

  fn InverseNonzeroAlgorithm<F: domain Field>(x: F::Element) -> (F::Element) requires (Field(F)) {
    // Rejection is at this operation, without hidden resampling.
    let inverse = field::inverse::<F>(x);
    return (inverse);
  }

  fn CheckProofPointsAlgorithm<G: domain Group>(a: G::Element, b: G::Element) -> () requires (
    ScalarAction(G),
    Field(G::Scalar)
  ) {
    let a_ok = curve::nonidentity::<G>(a);
    control::require(a_ok);
    let b_ok = curve::nonidentity::<G>(b);
    control::require(b_ok);
    return ();
  }

  fn ValueCommitmentsAlgorithm<G: domain Group>(
    values: Vector<G::Scalar::Element>,
    blinding: Vector<G::Scalar::Element>,
    base: G::Element,
    blind: G::Element
  ) -> (Vector<G::Element>) requires (ScalarAction(G), Field(G::Scalar)) {
    let values_shape = vector::length_check::<G::Scalar>(values) attributes ("2");
    control::require(values_shape);
    let blinding_shape = vector::length_check::<G::Scalar>(blinding) attributes ("2");
    control::require(blinding_shape);
    let empty = curve::empty::<G>();
    let v0 = vector::at::<G::Scalar>(values) attributes ("0");
    let gamma0 = vector::at::<G::Scalar>(blinding) attributes ("0");
    let value_point0 = curve::scale::<G>(base, v0);
    let blind_point0 = curve::scale::<G>(blind, gamma0);
    let commitment0 = curve::add::<G>(value_point0, blind_point0);
    let ordered0 = curve::append::<G>(empty, commitment0);
    let v1 = vector::at::<G::Scalar>(values) attributes ("1");
    let gamma1 = vector::at::<G::Scalar>(blinding) attributes ("1");
    let value_point1 = curve::scale::<G>(base, v1);
    let blind_point1 = curve::scale::<G>(blind, gamma1);
    let commitment1 = curve::add::<G>(value_point1, blind_point1);
    let ordered1 = curve::append::<G>(ordered0, commitment1);
    return (ordered1);
  }

  fn CheckCommitmentsAlgorithm<G: domain Group>(
    actual: Vector<G::Element>,
    expected: Vector<G::Element>
  ) -> () requires (ScalarAction(G), Field(G::Scalar)) {
    let one = field::constant::<G::Scalar>() attributes ("1");
    let weights = vector::splat::<G::Scalar>(one) attributes ("2");
    // MSM checks exact group-vector length; curve.at alone would miss a suffix.
    let actual_sum = curve::msm::<G>(weights, actual);
    let expected_sum = curve::msm::<G>(weights, expected);
    let sum_ok = curve::equal::<G>(actual_sum, expected_sum);
    control::require(sum_ok);
    let actual0 = curve::at::<G>(actual) attributes ("0");
    let expected0 = curve::at::<G>(expected) attributes ("0");
    let ok0 = curve::equal::<G>(actual0, expected0);
    control::require(ok0);
    let actual1 = curve::at::<G>(actual) attributes ("1");
    let expected1 = curve::at::<G>(expected) attributes ("1");
    let ok1 = curve::equal::<G>(actual1, expected1);
    control::require(ok1);
    return ();
  }

  fn DrawVectorMasksAlgorithm<F: domain Field>(
    coins: Rng<F>
  ) -> (F::Element, F::Element, Vector<F::Element>, Vector<F::Element>, Rng<F>) requires (Field(F)) {
    // Global advancing tape: alpha, rho, sL[0..N), sR[0..N).
    let (alpha, after_alpha) = random::draw::<F>(coins);
    let (rho, after_rho) = random::draw::<F>(after_alpha);
    let (sl, after_sl) = random::vector::<F>(after_rho) attributes ("16");
    let (sr, after_sr) = random::vector::<F>(after_sl) attributes ("16");
    return (alpha, rho, sl, sr, after_sr);
  }

  fn DrawPolynomialMasksAlgorithm<F: domain Field>(
    coins: Rng<F>
  ) -> (F::Element, F::Element, Rng<F>) requires (Field(F)) {
    let (tau1, after_tau1) = random::draw::<F>(coins);
    let (tau2, after_tau2) = random::draw::<F>(after_tau1);
    return (tau1, tau2, after_tau2);
  }

  fn RangeCommitmentsAlgorithm<G: domain Group>(
    al: Vector<G::Scalar::Element>,
    sl: Vector<G::Scalar::Element>,
    sr: Vector<G::Scalar::Element>,
    alpha: G::Scalar::Element,
    rho: G::Scalar::Element,
    g: Vector<G::Element>,
    h: Vector<G::Element>,
    blind: G::Element
  ) -> (Vector<G::Scalar::Element>, G::Element, G::Element) requires (
    ScalarAction(G),
    Field(G::Scalar)
  ) {
    let one = field::constant::<G::Scalar>() attributes ("1");
    let ones = vector::splat::<G::Scalar>(one) attributes ("16");
    let ar = vector::sub::<G::Scalar>(al, ones);
    let alg = curve::msm::<G>(al, g);
    let arh = curve::msm::<G>(ar, h);
    let ab = curve::scale::<G>(blind, alpha);
    let a_vectors = curve::add::<G>(alg, arh);
    let a = curve::add::<G>(a_vectors, ab);
    let slg = curve::msm::<G>(sl, g);
    let srh = curve::msm::<G>(sr, h);
    let rb = curve::scale::<G>(blind, rho);
    let s_vectors = curve::add::<G>(slg, srh);
    let s = curve::add::<G>(s_vectors, rb);
    return (ar, a, s);
  }

  fn RangePolynomialsAlgorithm<F: domain Field>(
    al: Vector<F::Element>,
    ar: Vector<F::Element>,
    sl: Vector<F::Element>,
    sr: Vector<F::Element>,
    y: F::Element,
    z: F::Element
  ) -> (
    Vector<F::Element>,
    Vector<F::Element>,
    Vector<F::Element>,
    Vector<F::Element>,
    F::Element,
    F::Element
  ) requires (Field(F)) {
    let two = field::constant::<F>() attributes ("2");
    let ys = vector::powers::<F>(y) attributes ("16");
    let zs = vector::powers::<F>(z) attributes ("4");
    let z_weights = vector::gather::<F>(zs) attributes ("2", "3");
    let twos = vector::powers::<F>(two) attributes ("8");
    // Party-major i=j*n+b: d_i = z^(j+2)*2^b.
    let d = vector::kronecker::<F>(z_weights, twos);
    let z_vector = vector::splat::<F>(z) attributes ("16");
    let l0 = vector::sub::<F>(al, z_vector);
    let ar_z = vector::add::<F>(ar, z_vector);
    let y_ar_z = vector::mul::<F>(ys, ar_z);
    let r0 = vector::add::<F>(y_ar_z, d);
    let r1 = vector::mul::<F>(ys, sr);
    let t1a = vector::dot::<F>(sl, r0);
    let t1b = vector::dot::<F>(l0, r1);
    let t1 = field::add::<F>(t1a, t1b);
    let t2 = vector::dot::<F>(sl, r1);
    return (l0, r0, r1, z_weights, t1, t2);
  }

  fn PolynomialCommitmentsAlgorithm<G: domain Group>(
    t1: G::Scalar::Element,
    t2: G::Scalar::Element,
    tau1: G::Scalar::Element,
    tau2: G::Scalar::Element,
    base: G::Element,
