fn FoldProductAlgorithm<F: domain Field>(
  a: Table<F>,
  b: Table<F>,
  r: F::Element
) -> (Table<F>, Table<F>) requires (Field(F)) {
  // Use the existing table abstraction for logical MSB folding.
  let at = zkc::poly::r#fold::<F>(a, r);
  let bt = zkc::poly::r#fold::<F>(b, r);
  return (at, bt);
}
fn CheckMatrixTerminalAlgorithm<F: domain Field>(
  a: Vector<F::Element>,
  b: Vector<F::Element>,
  c: Vector<F::Element>,
  r: Point<F>,
  s: Point<F>,
  alpha: F::Element,
  beta: F::Element,
  gamma: F::Element,
  value: F::Element,
  claim: F::Element
) -> (bool) requires (Field(F)) {
  // Independently contract the SAME public matrices in the forward direction.
  let rw = zkc::poly::equality_weights::<F>(r);
  let sw = zkc::poly::equality_weights::<F>(s);
  let av = zkc::algebra::vector_matvec::<F>(a, sw) attributes ("32", "32", "0");
  let bv = zkc::algebra::vector_matvec::<F>(b, sw) attributes ("32", "32", "0");
  let cv = zkc::algebra::vector_matvec::<F>(c, sw) attributes ("32", "32", "0");
  let ars = zkc::algebra::vector_dot::<F>(rw, av);
  let brs = zkc::algebra::vector_dot::<F>(rw, bv);
  let crs = zkc::algebra::vector_dot::<F>(rw, cv);
  let aa = zkc::algebra::mul::<F>(alpha, ars);
  let bb = zkc::algebra::mul::<F>(beta, brs);
  let cc = zkc::algebra::mul::<F>(gamma, crs);
  let ab = zkc::algebra::add::<F>(aa, bb);
  let matrix_value = zkc::algebra::add::<F>(ab, cc);
  let expected = zkc::algebra::mul::<F>(matrix_value, value);
  let ok = zkc::algebra::equal::<F>(claim, expected);
  zkc::core::require(ok);
  return (ok);
}
protocol RandomPoint {
  roles (P, V);
  parameters (rounds);
  inputs (V coins: Rng<"bls12-381.fr">);
  outputs (P Point<"bls12-381.fr">, V Point<"bls12-381.fr">, V Rng<"bls12-381.fr">);
  local P: let pp = EmptyPoint();
  local V: let vp = EmptyPoint();
  loop [coordinates] rounds carry (p = pp, v = vp, random = coins) -> (p_end, v_end, after) {
    local V: let (r, next_random) = DrawChallenge(random);
    message coordinate: V(r) -> P(pr);
    local P: let next_p = AppendPoint(p, pr);
    local V: let next_v = AppendPoint(v, r);
    yield (next_p, next_v, next_random);
  }
  return (p_end, v_end, after);
}
