  ) {
    let ok = pcs::equal::<C>(root, expected);
    control::require(ok);
    return ();
  }

  fn OnePointAlgorithm<F: domain Field>() -> (Point<F>) requires (Field(F)) {
    let zero = field::constant::<F>() attributes ("0");
    let one = field::constant::<F>() attributes ("1");
    let p0 = poly::empty_point::<F>();
    let p1 = poly::append_point::<F>(p0, one);
    let p2 = poly::append_point::<F>(p1, one);
    let p3 = poly::append_point::<F>(p2, zero);
    let p4 = poly::append_point::<F>(p3, zero);
    let p5 = poly::append_point::<F>(p4, one);
    return (p5);
  }

  fn CheckOneAlgorithm<F: domain Field>(value: F::Element) -> () requires (Field(F)) {
    let one = field::constant::<F>() attributes ("1");
    let ok = field::equal::<F>(value, one);
    control::require(ok);
