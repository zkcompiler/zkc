  fn OuterEqualityAlgorithm<F: domain Field>(tau: Point<F>) -> (Vector<F::Element>) requires (
    Field(F)
  ) {
    let equality = poly::equality_weights::<F>(tau);
    return (equality);
  }

  fn ZeroClaimAlgorithm<F: domain Field>() -> (F::Element) requires (Field(F)) {
    let zero = field::constant::<F>() attributes ("0");
    return (zero);
  }

  fn CubicRoundAlgorithm<F: domain Field>(
    e: Vector<F::Element>,
    a: Vector<F::Element>,
    b: Vector<F::Element>,
    c: Vector<F::Element>
  ) -> (Polynomial<F>) requires (Field(F)) {
    // Sum the coefficients of (eL+X*de)*((aL+X*da)*(bL+X*db)-(cL+X*dc)).
    let (el, er) = vector::split::<F>(e);
    let (al, ar) = vector::split::<F>(a);
    let (bl, br) = vector::split::<F>(b);
    let (cl, cr) = vector::split::<F>(c);
    let de = vector::sub::<F>(er, el);
    let da = vector::sub::<F>(ar, al);
    let db = vector::sub::<F>(br, bl);
    let dc = vector::sub::<F>(cr, cl);
    let ab = vector::mul::<F>(al, bl);
    let p0 = vector::sub::<F>(ab, cl);
    let adb = vector::mul::<F>(al, db);
    let dab = vector::mul::<F>(da, bl);
    let cross = vector::add::<F>(adb, dab);
    let p1 = vector::sub::<F>(cross, dc);
    let q0 = vector::dot::<F>(el, p0);
    let q1_left = vector::dot::<F>(el, p1);
    let q1_right = vector::dot::<F>(de, p0);
    let q1 = field::add::<F>(q1_left, q1_right);
    // Reuse the quadratic product in both highest coefficients.
    let dadb = vector::mul::<F>(da, db);
    let q2_left = vector::dot::<F>(el, dadb);
    let q2_right = vector::dot::<F>(de, p1);
    let q2 = field::add::<F>(q2_left, q2_right);
    let q3 = vector::dot::<F>(de, dadb);
    let coefficients_empty = vector::empty::<F>();
    let coefficients_0 = vector::append::<F>(coefficients_empty, q0);
    let coefficients_1 = vector::append::<F>(coefficients_0, q1);
    let coefficients_2 = vector::append::<F>(coefficients_1, q2);
    let coefficients = vector::append::<F>(coefficients_2, q3);
    let q = poly::from_coefficients::<F>(coefficients);
    return (q);
  }

  fn CheckCubicBoundaryAlgorithm<F: domain Field>(q: Polynomial<F>, claim: F::Element) -> () requires (
    Field(F)
  ) {
    // A received polynomial is not degree bounded by its type. Check before drawing.
    let degree_ok = poly::degree_check::<F>(q) attributes ("3");
    control::require(degree_ok);
    let sum = poly::univariate_boundary::<F>(q);
    let claim_ok = field::equal::<F>(sum, claim);
    control::require(claim_ok);
    return ();
  }

  fn EvaluateCubicAlgorithm<F: domain Field>(q: Polynomial<F>, r: F::Element) -> (F::Element) requires (
    Field(F)
  ) {
    let value = poly::univariate_evaluate::<F>(q, r);
    return (value);
  }

  fn FoldOuterAlgorithm<F: domain Field>(
    e: Vector<F::Element>,
    a: Vector<F::Element>,
    b: Vector<F::Element>,
    c: Vector<F::Element>,
    r: F::Element
  ) -> (Vector<F::Element>, Vector<F::Element>, Vector<F::Element>, Vector<F::Element>) requires (
    Field(F)
  ) {
    let (el, er) = vector::split::<F>(e);
    let ed = vector::sub::<F>(er, el);
    let escaled = vector::scale::<F>(ed, r);
    let enext = vector::add::<F>(el, escaled);
    let (al, ar) = vector::split::<F>(a);
    let ad = vector::sub::<F>(ar, al);
    let ascaled = vector::scale::<F>(ad, r);
    let anext = vector::add::<F>(al, ascaled);
    let (bl, br) = vector::split::<F>(b);
    let bd = vector::sub::<F>(br, bl);
    let bscaled = vector::scale::<F>(bd, r);
    let bnext = vector::add::<F>(bl, bscaled);
    let (cl, cr) = vector::split::<F>(c);
    let cd = vector::sub::<F>(cr, cl);
    let cscaled = vector::scale::<F>(cd, r);
    let cnext = vector::add::<F>(cl, cscaled);
    return (enext, anext, bnext, cnext);
  }

  fn OuterValuesAlgorithm<F: domain Field>(
    a: Vector<F::Element>,
    b: Vector<F::Element>,
    c: Vector<F::Element>
  ) -> (F::Element, F::Element, F::Element) requires (Field(F)) {
    let a_shape = vector::length_check::<F>(a) attributes ("1");
    control::require(a_shape);
    let ar = vector::at::<F>(a) attributes ("0");
    let b_shape = vector::length_check::<F>(b) attributes ("1");
    control::require(b_shape);
    let br = vector::at::<F>(b) attributes ("0");
    let c_shape = vector::length_check::<F>(c) attributes ("1");
    control::require(c_shape);
    let cr = vector::at::<F>(c) attributes ("0");
    return (ar, br, cr);
  }

  fn CheckOuterTerminalAlgorithm<F: domain Field>(
    tau: Point<F>,
    r: Point<F>,
    a: F::Element,
    b: F::Element,
    c: F::Element,
    claim: F::Element
  ) -> () requires (Field(F)) {
    let tau_weights = poly::equality_weights::<F>(tau);
    let r_weights = poly::equality_weights::<F>(r);
    let equality = vector::dot::<F>(tau_weights, r_weights);
    let ab = field::mul::<F>(a, b);
    let residual = field::sub::<F>(ab, c);
    let expected = field::mul::<F>(equality, residual);
    let ok = field::equal::<F>(claim, expected);
    control::require(ok);
    return ();
  }

  fn MixClaimAlgorithm<F: domain Field>(
    a: F::Element,
    b: F::Element,
    c: F::Element,
    alpha: F::Element,
    beta: F::Element,
    gamma: F::Element
  ) -> (F::Element) requires (Field(F)) {
    let aa = field::mul::<F>(alpha, a);
    let bb = field::mul::<F>(beta, b);
    let cc = field::mul::<F>(gamma, c);
    let ab = field::add::<F>(aa, bb);
    let claim = field::add::<F>(ab, cc);
    return (claim);
  }

  fn MatrixContractionAlgorithm<F: domain Field>(
    a: Vector<F::Element>,
    b: Vector<F::Element>,
    c: Vector<F::Element>,
    r: Point<F>,
    alpha: F::Element,
    beta: F::Element,
    gamma: F::Element
  ) -> (Table<F>) requires (Field(F)) {
    let weights = poly::equality_weights::<F>(r);
    let ar = vector::matvec::<F>(a, weights) attributes ("32", "32", "1");
    let br = vector::matvec::<F>(b, weights) attributes ("32", "32", "1");
    let cr = vector::matvec::<F>(c, weights) attributes ("32", "32", "1");
    let aa = vector::scale::<F>(ar, alpha);
    let bb = vector::scale::<F>(br, beta);
    let cc = vector::scale::<F>(cr, gamma);
    let ab = vector::add::<F>(aa, bb);
    let mixed = vector::add::<F>(ab, cc);
    let table = vector::to_table::<F>(mixed);
    return (table);
  }

  fn ProductRoundAlgorithm<F: domain Field>(a: Table<F>, b: Table<F>) -> (Round<F>) requires (
    Field(F)
  ) {
    // The existing round type carries the bound two, unlike polynomial.
    let q = poly::product_round::<F>(a, b);
    return (q);
  }

  fn CheckQuadraticBoundaryAlgorithm<F: domain Field>(q: Round<F>, claim: F::Element) -> () requires (
    Field(F)
  ) {
    let sum = poly::boundary::<F>(q);
    let ok = field::equal::<F>(sum, claim);
    control::require(ok);
    return ();
  }

  fn EvaluateQuadraticAlgorithm<F: domain Field>(q: Round<F>, r: F::Element) -> (F::Element) requires (
    Field(F)
  ) {
    let value = poly::round_evaluate::<F>(q, r);
    return (value);
  }

  fn FoldProductAlgorithm<F: domain Field>(
    a: Table<F>,
    b: Table<F>,
    r: F::Element
  ) -> (Table<F>, Table<F>) requires (Field(F)) {
    // Use the existing table abstraction for logical MSB folding.
    let at = poly::fold::<F>(a, r);
    let bt = poly::fold::<F>(b, r);
    return (at, bt);
  }

  fn CheckMatrixTerminalAlgorithm<F: domain Field>(
    a: Vector<F::Element>,
    b: Vector<F::Element>,
    c: Vector<F::Element>,
    r: Point<F>,
    s: Point<F>,
    alpha: F::Element,
    beta: F::Element,
    gamma: F::Element,
    value: F::Element,
    claim: F::Element
  ) -> (bool) requires (Field(F)) {
    // Independently contract the SAME public matrices in the forward direction.
    let rw = poly::equality_weights::<F>(r);
    let sw = poly::equality_weights::<F>(s);
    let av = vector::matvec::<F>(a, sw) attributes ("32", "32", "0");
    let bv = vector::matvec::<F>(b, sw) attributes ("32", "32", "0");
    let cv = vector::matvec::<F>(c, sw) attributes ("32", "32", "0");
    let ars = vector::dot::<F>(rw, av);
    let brs = vector::dot::<F>(rw, bv);
    let crs = vector::dot::<F>(rw, cv);
    let aa = field::mul::<F>(alpha, ars);
    let bb = field::mul::<F>(beta, brs);
    let cc = field::mul::<F>(gamma, crs);
    let ab = field::add::<F>(aa, bb);
    let matrix_value = field::add::<F>(ab, cc);
    let expected = field::mul::<F>(matrix_value, value);
    let ok = field::equal::<F>(claim, expected);
    control::require(ok);
    return (ok);
  }

  protocol RandomPoint {
    roles (P, V);
    parameters (rounds);
    inputs (V coins: Rng<bls12-381.fr>);
    outputs (P Point<bls12-381.fr>, V Point<bls12-381.fr>, V Rng<bls12-381.fr>);
    local P: let pp = EmptyPoint();
    local V: let vp = EmptyPoint();
    loop [coordinates] rounds carry (p = pp, v = vp, random = coins) -> (p_end, v_end, after) {
      local V: let (r, next_random) = DrawChallenge(random);
      message coordinate: V(r) -> P(pr);
      local P: let next_p = AppendPoint(p, pr);
      local V: let next_v = AppendPoint(v, r);
      yield (next_p, next_v, next_random);
    }
    return (p_end, v_end, after);
  }

  protocol OriginalOpening {
    roles (P, V);
    inputs (
      P original: OpeningState<"multilinear.kzg.bls12-381/1">,
      P p_point: Point<bls12-381.fr>,
      V vk: VerifierKey<"multilinear.kzg.bls12-381/1">,
      V root: Commitment<"multilinear.kzg.bls12-381/1">,
      V v_point: Point<bls12-381.fr>
    );
    outputs (V bls12-381.fr::Element);
    local P: let (value, proof) = OpenOriginal(original, p_point);
    message evaluation: P(value) -> V(received_value);
    message original_opening: P(proof) -> V(received_proof);
    local V: let checked = CheckOpening(vk, root, v_point, received_value, received_proof);
    return (checked);
  }

  protocol CubicSumcheck {
    roles (P, V);
    parameters (rounds);
    inputs (
      P e: Vector<bls12-381.fr::Element>,
      P a: Vector<bls12-381.fr::Element>,
      P b: Vector<bls12-381.fr::Element>,
      P c: Vector<bls12-381.fr::Element>,
      V claim: bls12-381.fr::Element,
      V coins: Rng<bls12-381.fr>
    );
    outputs (
      P Point<bls12-381.fr>,
      V Point<bls12-381.fr>,
      P bls12-381.fr::Element,
      P bls12-381.fr::Element,
      P bls12-381.fr::Element,
      V bls12-381.fr::Element,
      V Rng<bls12-381.fr>
    );
    local P: let pp = EmptyPoint();
    local V: let vp = EmptyPoint();
    loop [outer_rounds] rounds carry (
      eq = e,
      av = a,
      bv = b,
      cv = c,
      p = pp,
      v = vp,
      current = claim,
      random = coins
    ) -> (e_end, a_end, b_end, c_end, p_end, v_end, claim_end, coins_end) {
      local P: let q = CubicRound(eq, av, bv, cv);
      message cubic_coefficients: P(q) -> V(received_q);
      local V: CheckCubicBoundary(received_q, current);
      local V: let (r, next_random) = DrawChallenge(random);
      local V: let next_claim = EvaluateCubic(received_q, r);
      message coordinate: V(r) -> P(pr);
      local P: let (next_e, next_a, next_b, next_c) = FoldOuter(eq, av, bv, cv, pr);
      local P: let next_p = AppendPoint(p, pr);
      local V: let next_v = AppendPoint(v, r);
      yield (next_e, next_a, next_b, next_c, next_p, next_v, next_claim, next_random);
    }
    local P: let (ar, br, cr) = OuterValues(a_end, b_end, c_end);
    return (p_end, v_end, ar, br, cr, claim_end, coins_end);
  }

  protocol ProductSumcheck {
    roles (P, V);
    parameters (rounds);
    inputs (
      P a: Table<bls12-381.fr>,
      P b: Table<bls12-381.fr>,
      V claim: bls12-381.fr::Element,
      V coins: Rng<bls12-381.fr>
    );
    outputs (
      P Point<bls12-381.fr>,
      V Point<bls12-381.fr>,
      V bls12-381.fr::Element,
      V Rng<bls12-381.fr>
    );
    local P: let pp = EmptyPoint();
    local V: let vp = EmptyPoint();
    loop [inner_rounds] rounds carry (
      av = a,
      bv = b,
      p = pp,
      v = vp,
      current = claim,
      random = coins
    ) -> (a_end, b_end, p_end, v_end, claim_end, coins_end) {
      local P: let q = ProductRound(av, bv);
      message quadratic_coefficients: P(q) -> V(received_q);
      local V: CheckQuadraticBoundary(received_q, current);
      local V: let (r, next_random) = DrawChallenge(random);
      local V: let next_claim = EvaluateQuadratic(received_q, r);
      message coordinate: V(r) -> P(pr);
      local P: let (next_a, next_b) = FoldProduct(av, bv, pr);
      local P: let next_p = AppendPoint(p, pr);
      local V: let next_v = AppendPoint(v, r);
      yield (next_a, next_b, next_p, next_v, next_claim, next_random);
    }
    return (p_end, v_end, claim_end, coins_end);
  }

  protocol ArithmeticTrace {
    roles (P, V);
    parameters (rounds);
    inputs (
      P pk: ProverKey<"multilinear.kzg.bls12-381/1">,
      P z: Vector<bls12-381.fr::Element>,
      P p_a: Vector<bls12-381.fr::Element>,
      P p_b: Vector<bls12-381.fr::Element>,
      P p_c: Vector<bls12-381.fr::Element>,
      P p_initial: bls12-381.fr::Element,
      P p_final: bls12-381.fr::Element,
      P p_context: Vector<bls12-381.fr::Element>,
      V vk: VerifierKey<"multilinear.kzg.bls12-381/1">,
      V expected_root: Commitment<"multilinear.kzg.bls12-381/1">,
      V a: Vector<bls12-381.fr::Element>,
      V b: Vector<bls12-381.fr::Element>,
      V c: Vector<bls12-381.fr::Element>,
      V initial: bls12-381.fr::Element,
      V final: bls12-381.fr::Element,
      V context: Vector<bls12-381.fr::Element>,
      V coins: Rng<bls12-381.fr>
    );
    outputs (V bool, V Rng<bls12-381.fr>);
    dependencies (
      tau: RandomPoint(rounds = rounds),
      outer: CubicSumcheck(rounds = rounds),
      inner: ProductSumcheck(rounds = rounds),
      opening: OriginalOpening()
    );
    local P: CheckPublicMatrices(p_a, p_b, p_c, p_initial, p_final);
    local V: CheckPublicMatrices(a, b, c, initial, final);
    local P: let (az, bz, cz, original_table) = TraceProducts(p_a, p_b, p_c, z);
    local P: let (root, original) = CommitOriginal(pk, original_table);
    message original_commitment: P(root) -> V(received_root);
    local V: CheckRoot(received_root, expected_root);
    local P: let one_p = OnePoint();
    local V: let one_v = OnePoint();
    // This opening is required even though the matrix has one*one=one.
    invoke [pin_one] opening(original, one_p, vk, received_root, one_v) -> (one_value);
    local V: CheckOne(one_value);
    invoke [draw_tau] tau(coins) -> (p_tau, v_tau, after_tau);
    local P: let equality = OuterEquality(p_tau);
    local V: let zero = ZeroClaim();
    invoke [outer_sumcheck] outer(
      equality,
      az,
      bz,
      cz,
      zero,
      after_tau
    ) -> (p_r, v_r, ar, br, cr, outer_claim, after_outer);
    message outer_a: P(ar) -> V(received_ar);
    message outer_b: P(br) -> V(received_br);
    message outer_c: P(cr) -> V(received_cr);
    local V: CheckOuterTerminal(v_tau, v_r, received_ar, received_br, received_cr, outer_claim);
    // Three fresh draws AFTER all outer values, never powers of one draw.
    local V: let (alpha, after_alpha) = DrawChallenge(after_outer);
    message batch_alpha: V(alpha) -> P(p_alpha);
    local V: let (beta, after_beta) = DrawChallenge(after_alpha);
    message batch_beta: V(beta) -> P(p_beta);
    local V: let (gamma, after_gamma) = DrawChallenge(after_beta);
    message batch_gamma: V(gamma) -> P(p_gamma);
    local V: let mixed_claim = MixClaim(received_ar, received_br, received_cr, alpha, beta, gamma);
    local P: let matrix_table = MatrixContraction(p_a, p_b, p_c, p_r, p_alpha, p_beta, p_gamma);
    invoke [inner_sumcheck] inner(
      matrix_table,
      original_table,
      mixed_claim,
      after_gamma
    ) -> (p_s, v_s, inner_claim, after_inner);
    invoke [open_original] opening(original, p_s, vk, received_root, v_s) -> (original_value);
    local V: let accepted = CheckMatrixTerminal(
      a,
      b,
      c,
      v_r,
      v_s,
      alpha,
      beta,
      gamma,
      original_value,
      inner_claim
    );
    return (accepted, after_inner);
  }

  instance tau: RandomPoint {
    parameters (rounds = 5);
    roles (P = P, V = V);
  }

  instance outer: CubicSumcheck {
    parameters (rounds = 5);
    roles (P = P, V = V);
  }

  instance inner: ProductSumcheck {
    parameters (rounds = 5);
    roles (P = P, V = V);
  }

  instance opening: OriginalOpening {
    roles (P = P, V = V);
  }

  instance trace: ArithmeticTrace {
    parameters (rounds = 5);
    dependencies (tau = tau, outer = outer, inner = inner, opening = opening);
    roles (P = P, V = V);
  }

  entry main = trace;
  configure DrawChallenge = DrawChallengeAlgorithm(F = bls12-381.fr);
  configure EmptyPoint = EmptyPointAlgorithm(F = bls12-381.fr);
