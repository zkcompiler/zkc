  fn DrawChallengeAlgorithm<F: domain Field>(coins: Rng<F>) -> (F::Element, Rng<F>) requires (
    Field(F)
  ) {
    [draw] let (value, after) = random::draw::<F>(coins);
    return (value, after);
  }

  fn EmptyPointAlgorithm<F: domain Field>() -> (Point<F>) requires (Field(F)) {
    let p = poly::empty_point::<F>();
    return (p);
  }

  fn AppendPointAlgorithm<F: domain Field>(p: Point<F>, r: F::Element) -> (Point<F>) requires (
    Field(F)
  ) {
    let next = poly::append_point::<F>(p, r);
    return (next);
  }

  fn CheckPublicMatricesAlgorithm<F: domain Field>(
    a: Vector<F::Element>,
    b: Vector<F::Element>,
    c: Vector<F::Element>,
    initial: F::Element,
    final: F::Element
  ) -> () requires (Field(F)) {
    // The application pins all entries to its intended relation. These checks
    // connect the two boundary coefficients to explicit statement scalars.
    let a_shape = vector::length_check::<F>(a) attributes ("1024");
    control::require(a_shape);
    let b_shape = vector::length_check::<F>(b) attributes ("1024");
    control::require(b_shape);
    let c_shape = vector::length_check::<F>(c) attributes ("1024");
    control::require(c_shape);
    let negative_initial = field::neg::<F>(initial);
    let negative_final = field::neg::<F>(final);
    let entry_initial = vector::at::<F>(a) attributes ("281");
    let entry_final = vector::at::<F>(a) attributes ("313");
    let initial_ok = field::equal::<F>(entry_initial, negative_initial);
    control::require(initial_ok);
    let final_ok = field::equal::<F>(entry_final, negative_final);
    control::require(final_ok);
    return ();
  }

  fn TraceProductsAlgorithm<F: domain Field>(
    a: Vector<F::Element>,
    b: Vector<F::Element>,
    c: Vector<F::Element>,
    z: Vector<F::Element>
  ) -> (Vector<F::Element>, Vector<F::Element>, Vector<F::Element>, Table<F>) requires (Field(F)) {
    let az = vector::matvec::<F>(a, z) attributes ("32", "32", "0");
    let bz = vector::matvec::<F>(b, z) attributes ("32", "32", "0");
    let cz = vector::matvec::<F>(c, z) attributes ("32", "32", "0");
    let original = vector::to_table::<F>(z);
    return (az, bz, cz, original);
  }

  fn CommitOriginalAlgorithm<C: domain Commitment>(
