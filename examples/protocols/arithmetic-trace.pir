  let ar = zkc::algebra::vector_at::<F>(a) attributes ("0");
  let b_shape = zkc::algebra::vector_length_check::<F>(b) attributes ("1");
  zkc::core::require(b_shape);
  let br = zkc::algebra::vector_at::<F>(b) attributes ("0");
  let c_shape = zkc::algebra::vector_length_check::<F>(c) attributes ("1");
  zkc::core::require(c_shape);
  let cr = zkc::algebra::vector_at::<F>(c) attributes ("0");
  return (ar, br, cr);
}
fn CheckOuterTerminalAlgorithm<F: domain Field>(
  tau: Point<F>,
  r: Point<F>,
  a: F::Element,
  b: F::Element,
  c: F::Element,
  claim: F::Element
) -> () requires (Field(F)) {
  let tau_weights = zkc::poly::equality_weights::<F>(tau);
  let r_weights = zkc::poly::equality_weights::<F>(r);
  let equality = zkc::algebra::vector_dot::<F>(tau_weights, r_weights);
  let ab = zkc::algebra::mul::<F>(a, b);
  let residual = zkc::algebra::sub::<F>(ab, c);
  let expected = zkc::algebra::mul::<F>(equality, residual);
  let ok = zkc::algebra::equal::<F>(claim, expected);
  zkc::core::require(ok);
  return ();
}
fn MixClaimAlgorithm<F: domain Field>(
  a: F::Element,
  b: F::Element,
  c: F::Element,
  alpha: F::Element,
  beta: F::Element,
  gamma: F::Element
) -> (F::Element) requires (Field(F)) {
  let aa = zkc::algebra::mul::<F>(alpha, a);
  let bb = zkc::algebra::mul::<F>(beta, b);
  let cc = zkc::algebra::mul::<F>(gamma, c);
  let ab = zkc::algebra::add::<F>(aa, bb);
  let claim = zkc::algebra::add::<F>(ab, cc);
  return (claim);
}
fn MatrixContractionAlgorithm<F: domain Field>(
  a: Vector<F::Element>,
  b: Vector<F::Element>,
  c: Vector<F::Element>,
  r: Point<F>,
  alpha: F::Element,
  beta: F::Element,
  gamma: F::Element
) -> (Table<F>) requires (Field(F)) {
  let weights = zkc::poly::equality_weights::<F>(r);
  let ar = zkc::algebra::vector_matvec::<F>(a, weights) attributes ("32", "32", "1");
  let br = zkc::algebra::vector_matvec::<F>(b, weights) attributes ("32", "32", "1");
  let cr = zkc::algebra::vector_matvec::<F>(c, weights) attributes ("32", "32", "1");
  let aa = zkc::algebra::vector_scale::<F>(ar, alpha);
  let bb = zkc::algebra::vector_scale::<F>(br, beta);
  let cc = zkc::algebra::vector_scale::<F>(cr, gamma);
  let ab = zkc::algebra::vector_add::<F>(aa, bb);
  let mixed = zkc::algebra::vector_add::<F>(ab, cc);
  let table = zkc::algebra::vector_to_table::<F>(mixed);
  return (table);
}
fn ProductRoundAlgorithm<F: domain Field>(a: Table<F>, b: Table<F>) -> (Round<F>) requires (
  Field(F)
