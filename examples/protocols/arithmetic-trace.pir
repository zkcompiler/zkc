  zkc::core::require(b_shape);
  let c_shape = zkc::algebra::vector_length_check::<F>(c) attributes ("1024");
  zkc::core::require(c_shape);
  let negative_initial = zkc::algebra::neg::<F>(initial);
  let negative_final = zkc::algebra::neg::<F>(final);
  let entry_initial = zkc::algebra::vector_at::<F>(a) attributes ("281");
  let entry_final = zkc::algebra::vector_at::<F>(a) attributes ("313");
  let initial_ok = zkc::algebra::equal::<F>(entry_initial, negative_initial);
  zkc::core::require(initial_ok);
  let final_ok = zkc::algebra::equal::<F>(entry_final, negative_final);
  zkc::core::require(final_ok);
  return ();
}
