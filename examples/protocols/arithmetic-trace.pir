  local P: let (value, proof) = OpenOriginal(original, p_point);
  message evaluation: P(value) -> V(received_value);
  message original_opening: P(proof) -> V(received_proof);
  local V: let checked = CheckOpening(vk, root, v_point, received_value, received_proof);
  return (checked);
}
protocol CubicSumcheck {
  roles (P, V);
  parameters (rounds);
  inputs (
    P e: Vector<"bls12-381.fr"::Element>,
    P a: Vector<"bls12-381.fr"::Element>,
    P b: Vector<"bls12-381.fr"::Element>,
    P c: Vector<"bls12-381.fr"::Element>,
    V claim: "bls12-381.fr"::Element,
    V coins: Rng<"bls12-381.fr">
  );
  outputs (
    P Point<"bls12-381.fr">,
    V Point<"bls12-381.fr">,
    P "bls12-381.fr"::Element,
    P "bls12-381.fr"::Element,
    P "bls12-381.fr"::Element,
    V "bls12-381.fr"::Element,
    V Rng<"bls12-381.fr">
  );
  local P: let pp = EmptyPoint();
  local V: let vp = EmptyPoint();
  loop [outer_rounds] rounds carry (
    eq = e,
    av = a,
    bv = b,
    cv = c,
    p = pp,
    v = vp,
    current = claim,
    random = coins
  ) -> (e_end, a_end, b_end, c_end, p_end, v_end, claim_end, coins_end) {
    local P: let q = CubicRound(eq, av, bv, cv);
    message cubic_coefficients: P(q) -> V(received_q);
    local V: CheckCubicBoundary(received_q, current);
    local V: let (r, next_random) = DrawChallenge(random);
    local V: let next_claim = EvaluateCubic(received_q, r);
    message coordinate: V(r) -> P(pr);
    local P: let (next_e, next_a, next_b, next_c) = FoldOuter(eq, av, bv, cv, pr);
    local P: let next_p = AppendPoint(p, pr);
    local V: let next_v = AppendPoint(v, r);
    yield (next_e, next_a, next_b, next_c, next_p, next_v, next_claim, next_random);
  }
  local P: let (ar, br, cr) = OuterValues(a_end, b_end, c_end);
  return (p_end, v_end, ar, br, cr, claim_end, coins_end);
}
protocol ProductSumcheck {
  roles (P, V);
  parameters (rounds);
  inputs (
    P a: Table<"bls12-381.fr">,
    P b: Table<"bls12-381.fr">,
    V claim: "bls12-381.fr"::Element,
    V coins: Rng<"bls12-381.fr">
  );
  outputs (
    P Point<"bls12-381.fr">,
    V Point<"bls12-381.fr">,
    V "bls12-381.fr"::Element,
    V Rng<"bls12-381.fr">
  );
  local P: let pp = EmptyPoint();
  local V: let vp = EmptyPoint();
  loop [inner_rounds] rounds carry (
    av = a,
    bv = b,
    p = pp,
    v = vp,
    current = claim,
    random = coins
  ) -> (a_end, b_end, p_end, v_end, claim_end, coins_end) {
    local P: let q = ProductRound(av, bv);
    message quadratic_coefficients: P(q) -> V(received_q);
    local V: CheckQuadraticBoundary(received_q, current);
    local V: let (r, next_random) = DrawChallenge(random);
    local V: let next_claim = EvaluateQuadratic(received_q, r);
    message coordinate: V(r) -> P(pr);
    local P: let (next_a, next_b) = FoldProduct(av, bv, pr);
    local P: let next_p = AppendPoint(p, pr);
    local V: let next_v = AppendPoint(v, r);
    yield (next_a, next_b, next_p, next_v, next_claim, next_random);
  }
  return (p_end, v_end, claim_end, coins_end);
}
protocol ArithmeticTrace {
  roles (P, V);
  parameters (rounds);
  inputs (
    P pk: ProverKey<"multilinear.kzg.bls12-381/1">,
    P z: Vector<"bls12-381.fr"::Element>,
    P p_a: Vector<"bls12-381.fr"::Element>,
    P p_b: Vector<"bls12-381.fr"::Element>,
    P p_c: Vector<"bls12-381.fr"::Element>,
    P p_initial: "bls12-381.fr"::Element,
    P p_final: "bls12-381.fr"::Element,
    P p_context: Vector<"bls12-381.fr"::Element>,
    V vk: VerifierKey<"multilinear.kzg.bls12-381/1">,
    V expected_root: Commitment<"multilinear.kzg.bls12-381/1">,
    V a: Vector<"bls12-381.fr"::Element>,
    V b: Vector<"bls12-381.fr"::Element>,
    V c: Vector<"bls12-381.fr"::Element>,
    V initial: "bls12-381.fr"::Element,
    V final: "bls12-381.fr"::Element,
    V context: Vector<"bls12-381.fr"::Element>,
    V coins: Rng<"bls12-381.fr">
  );
  outputs (V bool, V Rng<"bls12-381.fr">);
  dependencies (
    tau: RandomPoint(rounds = rounds),
    outer: CubicSumcheck(rounds = rounds),
    inner: ProductSumcheck(rounds = rounds),
    opening: OriginalOpening()
  );
  local P: CheckPublicMatrices(p_a, p_b, p_c, p_initial, p_final);
  local V: CheckPublicMatrices(a, b, c, initial, final);
  local P: let (az, bz, cz, original_table) = TraceProducts(p_a, p_b, p_c, z);
  local P: let (root, original) = CommitOriginal(pk, original_table);
  message original_commitment: P(root) -> V(received_root);
  local V: CheckRoot(received_root, expected_root);
  local P: let one_p = OnePoint();
  local V: let one_v = OnePoint();
  // This opening is required even though the matrix has one*one=one.
  invoke [pin_one] opening(original, one_p, vk, received_root, one_v) -> (one_value);
  local V: CheckOne(one_value);
  invoke [draw_tau] tau(coins) -> (p_tau, v_tau, after_tau);
  local P: let equality = OuterEquality(p_tau);
  local V: let zero = ZeroClaim();
  invoke [outer_sumcheck] outer(
    equality,
    az,
    bz,
    cz,
    zero,
    after_tau
  ) -> (p_r, v_r, ar, br, cr, outer_claim, after_outer);
  message outer_a: P(ar) -> V(received_ar);
  message outer_b: P(br) -> V(received_br);
  message outer_c: P(cr) -> V(received_cr);
  local V: CheckOuterTerminal(v_tau, v_r, received_ar, received_br, received_cr, outer_claim);
  // Three fresh draws AFTER all outer values, never powers of one draw.
  local V: let (alpha, after_alpha) = DrawChallenge(after_outer);
  message batch_alpha: V(alpha) -> P(p_alpha);
  local V: let (beta, after_beta) = DrawChallenge(after_alpha);
  message batch_beta: V(beta) -> P(p_beta);
  local V: let (gamma, after_gamma) = DrawChallenge(after_beta);
  message batch_gamma: V(gamma) -> P(p_gamma);
  local V: let mixed_claim = MixClaim(received_ar, received_br, received_cr, alpha, beta, gamma);
  local P: let matrix_table = MatrixContraction(p_a, p_b, p_c, p_r, p_alpha, p_beta, p_gamma);
  invoke [inner_sumcheck] inner(
    matrix_table,
    original_table,
    mixed_claim,
    after_gamma
  ) -> (p_s, v_s, inner_claim, after_inner);
  invoke [open_original] opening(original, p_s, vk, received_root, v_s) -> (original_value);
  local V: let accepted = CheckMatrixTerminal(
    a,
    b,
    c,
    v_r,
    v_s,
    alpha,
    beta,
    gamma,
    original_value,
    inner_claim
  );
  return (accepted, after_inner);
}
instance tau: RandomPoint {
  parameters (rounds = 5);
  roles (P = P, V = V);
}
instance outer: CubicSumcheck {
  parameters (rounds = 5);
  roles (P = P, V = V);
}
instance inner: ProductSumcheck {
  parameters (rounds = 5);
  roles (P = P, V = V);
}
instance opening: OriginalOpening {
  roles (P = P, V = V);
}
instance trace: ArithmeticTrace {
  parameters (rounds = 5);
  dependencies (tau = tau, outer = outer, inner = inner, opening = opening);
  roles (P = P, V = V);
}
entry main = trace;
