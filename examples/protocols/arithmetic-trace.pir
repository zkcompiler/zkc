fn CubicRoundAlgorithm<F: domain Field>(
  e: Vector<F::Element>,
  a: Vector<F::Element>,
  b: Vector<F::Element>,
  c: Vector<F::Element>
) -> (Polynomial<F>) requires (Field(F)) {
  // Sum the coefficients of (eL+X*de)*((aL+X*da)*(bL+X*db)-(cL+X*dc)).
  let (el, er) = zkc::algebra::vector_split::<F>(e);
  let (al, ar) = zkc::algebra::vector_split::<F>(a);
  let (bl, br) = zkc::algebra::vector_split::<F>(b);
  let (cl, cr) = zkc::algebra::vector_split::<F>(c);
  let de = zkc::algebra::vector_sub::<F>(er, el);
  let da = zkc::algebra::vector_sub::<F>(ar, al);
  let db = zkc::algebra::vector_sub::<F>(br, bl);
  let dc = zkc::algebra::vector_sub::<F>(cr, cl);
  let ab = zkc::algebra::vector_mul::<F>(al, bl);
  let p0 = zkc::algebra::vector_sub::<F>(ab, cl);
  let adb = zkc::algebra::vector_mul::<F>(al, db);
  let dab = zkc::algebra::vector_mul::<F>(da, bl);
  let cross = zkc::algebra::vector_add::<F>(adb, dab);
  let p1 = zkc::algebra::vector_sub::<F>(cross, dc);
  let q0 = zkc::algebra::vector_dot::<F>(el, p0);
  let q1_left = zkc::algebra::vector_dot::<F>(el, p1);
  let q1_right = zkc::algebra::vector_dot::<F>(de, p0);
  let q1 = zkc::algebra::add::<F>(q1_left, q1_right);
  // Reuse the quadratic product in both highest coefficients.
  let dadb = zkc::algebra::vector_mul::<F>(da, db);
  let q2_left = zkc::algebra::vector_dot::<F>(el, dadb);
  let q2_right = zkc::algebra::vector_dot::<F>(de, p1);
  let q2 = zkc::algebra::add::<F>(q2_left, q2_right);
  let q3 = zkc::algebra::vector_dot::<F>(de, dadb);
  let coefficients_empty = zkc::algebra::vector_empty::<F>();
  let coefficients_0 = zkc::algebra::vector_append::<F>(coefficients_empty, q0);
  let coefficients_1 = zkc::algebra::vector_append::<F>(coefficients_0, q1);
  let coefficients_2 = zkc::algebra::vector_append::<F>(coefficients_1, q2);
  let coefficients = zkc::algebra::vector_append::<F>(coefficients_2, q3);
  let q = zkc::poly::from_coefficients::<F>(coefficients);
  return (q);
}
fn CheckCubicBoundaryAlgorithm<F: domain Field>(q: Polynomial<F>, claim: F::Element) -> () requires (
  Field(F)
) {
  // A received polynomial is not degree bounded by its type. Check before drawing.
