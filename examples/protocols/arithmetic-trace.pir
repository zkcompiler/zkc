fn FoldOuterAlgorithm<F: domain Field>(
  e: Vector<F::Element>,
  a: Vector<F::Element>,
  b: Vector<F::Element>,
  c: Vector<F::Element>,
  r: F::Element
) -> (Vector<F::Element>, Vector<F::Element>, Vector<F::Element>, Vector<F::Element>) requires (
  Field(F)
) {
  let (el, er) = zkc::algebra::vector_split::<F>(e);
  let ed = zkc::algebra::vector_sub::<F>(er, el);
  let escaled = zkc::algebra::vector_scale::<F>(ed, r);
  let enext = zkc::algebra::vector_add::<F>(el, escaled);
  let (al, ar) = zkc::algebra::vector_split::<F>(a);
  let ad = zkc::algebra::vector_sub::<F>(ar, al);
  let ascaled = zkc::algebra::vector_scale::<F>(ad, r);
  let anext = zkc::algebra::vector_add::<F>(al, ascaled);
  let (bl, br) = zkc::algebra::vector_split::<F>(b);
  let bd = zkc::algebra::vector_sub::<F>(br, bl);
  let bscaled = zkc::algebra::vector_scale::<F>(bd, r);
  let bnext = zkc::algebra::vector_add::<F>(bl, bscaled);
  let (cl, cr) = zkc::algebra::vector_split::<F>(c);
  let cd = zkc::algebra::vector_sub::<F>(cr, cl);
  let cscaled = zkc::algebra::vector_scale::<F>(cd, r);
  let cnext = zkc::algebra::vector_add::<F>(cl, cscaled);
  return (enext, anext, bnext, cnext);
}
fn OuterValuesAlgorithm<F: domain Field>(
  a: Vector<F::Element>,
  b: Vector<F::Element>,
  c: Vector<F::Element>
) -> (F::Element, F::Element, F::Element) requires (Field(F)) {
  let a_shape = zkc::algebra::vector_length_check::<F>(a) attributes ("1");
