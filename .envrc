# Optional direnv integration; plain `nix develop` remains supported.
if ! has nix_direnv_version; then
  log_error "Install nix-direnv and enable its direnv integration, or use nix develop."
  return 1
fi
watch_file flake.nix flake.lock nix/*.nix nix/checks/*.nix
watch_file rust-toolchain.toml pyproject.toml uv.lock
nix_direnv_disallow_fallback
use flake
