{
  "format": "zkc.evm-target-validation-cases/0",
  "cases": [
    {"name": "unknown declaration field", "rule": "keys",
     "edits": [{"op": "set", "path": ["extra"], "value": 1}]},
    {"name": "missing declaration field", "rule": "keys",
     "edits": [{"op": "delete", "path": ["reverts"]}]},
    {"name": "other format", "rule": "format",
     "edits": [{"op": "set", "path": ["format"], "value": "zkc.evm-target/1"}]},
    {"name": "unknown fork field", "rule": "keys",
     "edits": [{"op": "set", "path": ["forks", 0, "gas"], "value": 1}]},
    {"name": "unknown optimizer detail", "rule": "keys",
     "edits": [{"op": "set", "path": ["solc", "optimizer", "details", "inliner"], "value": true}]},
    {"name": "duplicate fork", "rule": "fork",
     "edits": [{"op": "duplicate", "path": ["forks", 0]}]},
    {"name": "fork name with an uppercase letter", "rule": "fork",
     "edits": [{"op": "set", "path": ["forks", 1, "name"], "value": "Prague"}]},
    {"name": "two forks with one engine", "rule": "fork",
     "edits": [{"op": "set", "path": ["forks", 1, "hardfork"], "value": "Cancun"}]},
    {"name": "empty runtime code ceiling", "rule": "fork",
     "edits": [{"op": "set", "path": ["forks", 0, "runtime_code_bytes"], "value": 0}]},
    {"name": "zero transaction gas cap", "rule": "fork",
     "edits": [{"op": "set", "path": ["forks", 0, "transaction_gas_cap"], "value": 0}]},
    {"name": "missing default fork", "rule": "default-fork",
     "edits": [{"op": "set", "path": ["default_fork"], "value": "unknown"}]},
    {"name": "fork without MCOPY", "rule": "rules",
     "edits": [{"op": "set", "path": ["forks", 0, "rules"], "value": ["EIP-170", "EIP-2565", "EIP-3860"]}]},
    {"name": "repeated fork rule", "rule": "rules",
     "edits": [{"op": "append", "path": ["forks", 0, "rules"], "value": "EIP-170"}]},
    {"name": "malformed fork rule", "rule": "rules",
     "edits": [{"op": "append", "path": ["forks", 0, "rules"], "value": "eip-7623"}]},
    {"name": "selector differing from the signature's Keccak-256", "rule": "selector",
     "edits": [{"op": "set", "path": ["abi", "selector"], "value": "a488e1e5"}]},
    {"name": "selector not in lowercase hexadecimal", "rule": "selector",
     "edits": [{"op": "set", "path": ["abi", "selector"], "value": "A488E1E4"}]},
    {"name": "ABI inputs differing from the signature", "rule": "abi",
     "edits": [{"op": "set", "path": ["abi", "json", 0, "inputs", 2, "type"], "value": "bytes32"}]},
    {"name": "ABI naming another function", "rule": "abi",
     "edits": [{"op": "set", "path": ["abi", "json", 0, "name"], "value": "check"}]},
    {"name": "solc version without its commit", "rule": "solc",
     "edits": [{"op": "set", "path": ["solc", "version"], "value": "0.8.38"}]},
    {"name": "optimizer switch that is not a Boolean", "rule": "solc",
     "edits": [{"op": "set", "path": ["solc", "optimizer", "enabled"], "value": 1}]},
    {"name": "missing validation gas", "rule": "keys",
     "edits": [{"op": "delete", "path": ["validation_gas"]}]},
    {"name": "zero validation gas", "rule": "validation-gas",
     "edits": [{"op": "set", "path": ["validation_gas"], "value": 0}]},
    {"name": "Boolean validation gas", "rule": "validation-gas",
     "edits": [{"op": "set", "path": ["validation_gas"], "value": true}]},
    {"name": "missing validation gas maximum", "rule": "keys",
     "edits": [{"op": "delete", "path": ["validation_gas_maximum"]}]},
    {"name": "zero validation gas maximum", "rule": "validation-gas",
     "edits": [{"op": "set", "path": ["validation_gas_maximum"], "value": 0}]},
    {"name": "validation gas above its maximum", "rule": "validation-gas",
     "edits": [{"op": "set", "path": ["validation_gas"], "value": 100000001}]},
    {"name": "transaction gas cap above the validation gas maximum", "rule": "validation-gas",
     "edits": [{"op": "set", "path": ["forks", 1, "transaction_gas_cap"], "value": 100000001}]},
    {"name": "minimum above maximum", "rule": "limit",
     "edits": [{"op": "set", "path": ["limits", 0, "minimum"], "value": 11}]},
    {"name": "zero minimum", "rule": "limit",
     "edits": [{"op": "set", "path": ["limits", 0, "minimum"], "value": 0}]},
    {"name": "Boolean maximum", "rule": "limit",
     "edits": [{"op": "set", "path": ["limits", 0, "maximum"], "value": true}]},
    {"name": "duplicate limit", "rule": "limit",
     "edits": [{"op": "duplicate", "path": ["limits", 0]}]},
    {"name": "repeated revert tag", "rule": "revert",
     "edits": [{"op": "set", "path": ["reverts", 1, "tag"], "value": "ZKCD"}]},
    {"name": "revert tag of three bytes", "rule": "revert",
     "edits": [{"op": "set", "path": ["reverts", 0, "tag"], "value": "ZKC"}]}
  ]
}
