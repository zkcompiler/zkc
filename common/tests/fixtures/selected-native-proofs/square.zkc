module selected;
domain F=field("bls12-381.fr");

// The witness is deliberately disclosed: this is an execution fixture.
protocol Square roles(P,V)(choice:bool@(P,V),rounds:index@(P,V),
    public:F@(P,V),enabled:bool@(P,V),finish:bool@(P,V),
    secret:F@P,challenges:Random<F>@V)->(ok:bool@V){
  let mut total:F@P=0;
  let mut expected:F@V=0;
  let mut accepted@V=true;
  // SELECTED_BEGIN
  #[site(choose)] if choice roles(P,V) {
    // ROUND_BEGIN
    #[site(commitment)] let first=send P->V((secret,secret));
    require @P(enabled);
    require @V(enabled);
    #[site(challenge)] let challenge=challenges.draw();
    #[site(delivery)] let actual=send V->P(challenge);
    total=total+secret*secret;
    expected=expected+public;
    #[site(response)] let last=send P->V((total+actual,secret));
    accepted=accepted && first.0*first.1==public &&
      last.0==expected+challenge && last.1==first.1;
    // ROUND_END
  } else {
    // DORMANT
  }
  // SELECTED_END
  #[site(tally)] let tally=send P->V((total,total));
  return accepted && tally.0==expected && tally.1==expected;
}
proof Demo=Square{prover P;verifier V;public{choice,rounds,public,enabled,finish};
  accept ok;construction fiat_shamir("merlin3.bls12-381.fr64be/0",challenges);}
