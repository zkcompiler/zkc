module lookup_denominators;
use air::interaction::{gated_denominator};
use zkc::vector as vec;
use zkc::finite_math as total;

domain Base = field("koala-bear");
domain Extension = field("koala-bear.ext8-binomial3");

math fn collect_vector<I: Type + Copy + Drop, E: Field>(
    rows: domain<I>, body: math fn(item: I) -> E where item_from(item, rows)
) -> vec::Vector<E> = finite("math.collect.vector");

math fn read_at<E: Field>(values: vec::Vector<E>, position: index) -> E
    where in_bounds(position, values) {
  return vec::at(values, position);
}

math fn shifted_row<E: Field>(gamma: E, values: vec::Vector<E>, position: index)
    -> (E, E) where in_bounds(position, values) {
  return (gamma, read_at(values, position));
}

math fn denominator_at<E: Field>(gate: E, position: index,
                                 fingerprints: vec::Vector<E>, gamma: E) -> E
    where in_bounds(position, fingerprints) {
  let row = shifted_row(gamma, fingerprints, position);
  return gated_denominator(gate, row.0, row.1);
}

math fn multiply_at<E: Field>(values: vec::Vector<E>, state: E,
                              position: index) -> E
    where in_bounds(position, values) {
  return state * read_at(values, position);
}

math fn denominator_product<E: Field>(fingerprints: vec::Vector<E>, gamma: E,
                                      gate: E, initial: E) -> E {
  let denominators = collect_vector(vec::indices(fingerprints),
    fn(position) => denominator_at(gate, position, fingerprints, gamma));
  return total::fold(vec::indices(denominators), initial,
    fn(state, position) => multiply_at(denominators, state, position));
}

pub protocol Products<E: Field> roles(P)(fingerprints: vec::Vector<E> @P,
    gamma: E @P, other_gamma: E @P, gate: E @P, initial: E @P)
    -> (product: E @P, other_product: E @P) {
  return (product = denominator_product(fingerprints, gamma, gate, initial),
          other_product = denominator_product(fingerprints, other_gamma, gate, initial));
}
entry fn Demo(inputs: Products<Base>::Inputs) { return Products<Base>::run(inputs); }
entry fn ExtensionDemo(inputs: Products<Extension>::Inputs) { return Products<Extension>::run(inputs); }
