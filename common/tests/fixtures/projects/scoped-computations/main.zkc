module example;
use callbacks as computation;
use zkc::vector as vec;

domain Fr = field("koala-bear");

interface Transform<F: Field> {
  fn adjust(value: F) -> F effects();
  fn run(value: F, body: fn(F) -> F effects(stop)) -> F effects(stop);
}

module Increment<F: Field>: Transform<F> {
  fn adjust(value: F) -> F effects() { return value + 1; }
  fn run(value: F, body: fn(F) -> F effects(stop)) -> F effects(stop) {
    return computation::forward(value, fn(x) => body(adjust(x)));
  }
}

fn through<F: Field, C: Transform<F>>(
  value: F, body: fn(F) -> F effects(stop)
) -> F effects(stop) {
  return C::run(value, body);
}

struct Parameters<F: Field> {
  pub shift: F,
  pub table: vec::Vector<F>
}

protocol Compute roles(P, V)(
  shared: Fr @(P, V), parameters: Parameters<Fr> @P, position: index @P
) -> (result: Fr @P) {
  let result = through<Fr, Increment<Fr>>(
    shared,
    fn(x) => computation::forward(
      x, fn(y) => vec::get(parameters.table, position) + y + parameters.shift
    )
  );
  return result;
}

run Demo(inputs: Compute::Inputs) { return Compute::run(inputs); }
