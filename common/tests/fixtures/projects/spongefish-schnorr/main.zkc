module example;
use spongefish::bls12_381::schnorr::{Schnorr};
domain G = group("bls12-381.g1");

construction ExternalWire for Schnorr {
  base authored;
  format RawBytes;
}

proof Proof = Schnorr {
  prover P;
  verifier V;
  public { tag, session, base, point };
  accept accepted;
  construction ExternalWire;
}
