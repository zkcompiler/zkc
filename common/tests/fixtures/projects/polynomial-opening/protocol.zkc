module evaluation;
use zkc::vector as vector;
use zkc::indices as indices;
use zkc::oracle as oracle;
use zkc::opening as opening;
use zkc::coset as coset;
use zkc::scalar::{power};
use fri::{Direct, ScalarLowDegree};

// One polynomial-opening composition. The quotient has degree < 4; the
// original polynomial therefore has degree <= 4. Parameters are for tests.
pub protocol Open<C: Commitment> roles(P,V)
    (word: vector::Vector<C::ValueField> @P,
     shift: C::ValueField @(P,V), point: C::ValueField @(P,V),
    value: C::ValueField @(P,V), coins: Random<C::ValueField> @V)
    -> (accepted: bool @V) {
  require @P !(power(point, 32) == power(shift, 32));
  require @V !(power(point, 32) == power(shift, 32));
  let tree @P = oracle::commit<C>(word, 1);
  let root = send P -> V(tree.0);
  let columns @P = opening::same_rotation(1, 0);
  let claimP @P = vector::fill(value, 1);
  let geometryP @P = coset::coset_domain(shift, 32);
  let inputP @P = opening::bind_openings(geometryP, 1, 8, point,
    zkc::opening_claims::checked(columns.0, columns.1, claimP));
  let reduced @P = opening::deep_columns(coset::column_batch(geometryP, 1, word), inputP,
    opening::vector_accumulator(geometryP, 1, vector::fill<C::ValueField>(0, 32), 1));
  let rounds: index @(P,V) = 2;
  let queries: index @(P,V) = 8;
  let (ok, positionsP, positionsV, valuesV) =
    ScalarLowDegree<Direct<C::ValueField>,5,0,2,8>(opening::vector_values(reduced), shift, shift, rounds, queries, coins);
  require @V ok;
  let columnsV @V = opening::same_rotation(1, 0);
  let claimV @V = vector::fill(value, 1);
  let geometryV @V = coset::coset_domain(shift, 32);
  let inputV @V = opening::bind_openings(geometryV, 1, 8, point,
    zkc::opening_claims::checked(columnsV.0, columnsV.1, claimV));
  for query in 0..queries roles(P,V) max 8 {
    let row @P = oracle::open<C>(tree.1, indices::get(positionsP, query));
    let received = send P -> V(row.0);
    let path = send P -> V(row.1);
    let position @V = indices::get(positionsV, query);
    require @V oracle::check<C>(root, 1, 32, position, received, path);
    let expected @V = opening::deep_row(opening::query_row(geometryV, 1, position, received),
      inputV, opening::scalar_accumulator(geometryV, position, 1, 0, 1));
    require @V opening::scalar_value(expected) == vector::get(valuesV, query);
  }
  return true;
}
