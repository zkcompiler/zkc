module example;
use zkc::vector::{Vector, indexing []};
use zkc::matrix::{Matrix};
use zkc::finite as finite;
use zkc::finite_math as total;
use zkc::finite_domain as domains;

domain F = field("koala-bear");
struct Row { pub value: F, pub enabled: bool }

math fn energy(xs: Vector<F>) -> F {
  return total::sum(zkc::vector::indices(xs), fn(i) =>
    xs[i] * xs[i]);
}

math fn matrix_sum(matrix: Matrix<F>) -> F {
  return total::sum(zkc::matrix::row_indices(matrix), fn(i) =>
    total::sum(zkc::matrix::row_values(matrix, i), fn(value) => value));
}

fn selected(xs: Vector<F>) -> F {
  let rows = finite::collect(xs, fn(value) => Row{value: value, enabled: !(value == 0)});
  return finite::sum_where(rows, fn(record) => record.enabled, fn(record) => record.value);
}

protocol Compute roles(P)(xs: Vector<F> @P, ys: Vector<F> @P,
                           matrix: Matrix<F> @P)
  -> (dot: F @P, square_sum: F @P, selected_sum: F @P, matrix_total: F @P) {
  let dot @P = finite::sum(domains::zip(xs, ys), fn((x, y)) => x * y);
  return (dot = dot, square_sum = energy(xs), selected_sum = selected(xs),
          matrix_total = matrix_sum(matrix));
}
run Demo = Compute;

// A scalar demand contracts only the selected row. A collection demand can
// contract all rows once; an empty row domain never enters its inner fold.
fn all_rows(matrix: Matrix<F>, xs: Vector<F>, seed: F) -> Vector<F> {
  return zkc::vector::collect(zkc::matrix::row_indices(matrix), fn(row) =>
    finite::fold(domains::zip(zkc::matrix::row_values(matrix, row), xs), seed,
                 fn(sum, (a, b)) => sum + a * b));
}

protocol MatrixProducts roles(P)(matrix: Matrix<F> @P, xs: Vector<F> @P,
                                 row: index @P, seed: F @P)
  -> (selected: F @P, rows: Vector<F> @P) {
  let row_result @P = zkc::matrix::row_dot(matrix, xs, row);
  return (selected = row_result, rows = all_rows(matrix, xs, seed));
}
run MatrixDemo = MatrixProducts;
