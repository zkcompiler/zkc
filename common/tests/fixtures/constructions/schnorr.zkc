module sample;
use zkc::bytes::{Bytes};
domain G=group("bls12-381.g1");
use spongefish::bls12_381::{Provider};
protocol Fixed roles(P,V)
    (tag:Bytes@(P,V),session:Bytes@(P,V),base:G@(P,V),point:G@(P,V),
     scalar:G::Scalar@P,nonce:G::Scalar@P,challenges:Random<G::Scalar>@V)->(accepted:bool@V) {
  #[site(commitment)] let commitment=send P->V(base*nonce);
  #[site(challenge)] let challenge=challenges.draw();
  #[site(delivery)] let actual=send V->P(challenge);
  #[site(response)] let response=send P->V(nonce+actual*scalar);
  return base*response==commitment+point*challenge;
}
construction Derived for Fixed {
  transcript Provider;replace challenges;
  on start(t,tag,session,base,point){return Provider::start(t,tag,session,base,point);}
  on message commitment(t,value){return Provider::point(t,value);}
  on query challenge(t){return Provider::draw(t);}
  on message delivery(t,value){return t;}
  on message response(t,value){return Provider::scalar(t,value);}
}
proof Demo=Fixed {prover P;verifier V;public{tag,session,base,point};accept accepted;construction Derived;}
