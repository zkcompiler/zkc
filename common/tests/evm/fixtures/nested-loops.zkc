module nested_loops;
domain F = field("bls12-381.fr");

protocol Check roles(P,V)(value:F@(P,V),outer:index@(P,V),inner:index@(P,V))
  ->(accepted:bool@V) {
  let mut accepted @V = true;
  for _ in 0..outer roles(P,V) max 3 {
    for _ in 0..inner roles(P,V) max 3 {
      let actual=send P->V(value);
      accepted=accepted&&actual==value;
    }
  }
  return accepted;
}

proof Proof=Check {
  prover P; verifier V; public{value,outer,inner};
  accept accepted; construction authored;
}
