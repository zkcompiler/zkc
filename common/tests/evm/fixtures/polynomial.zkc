module polynomial;
domain F = field("koala-bear.ext4-binomial3");
type Vector<E: Field> = builtin("vector", E);
type Polynomial<E: Field> = builtin("polynomial", E);
fn normalized(values: Vector<F>) -> Polynomial<F> {
  return kernel<F>("poly.from_coefficients", values);
}
fn evaluate(value: Polynomial<F>, coordinate: F) -> F {
  return kernel<F>("poly.univariate_evaluate", value, coordinate);
}
fn root(size: index) -> F = primitive("poly.domain_root");
fn point(shift: F, size: index, position: index) -> F = primitive("poly.domain_point");
fn select(flag: bool, left: index, right: index) -> index = primitive("index.select");
protocol Check roles(P,V)(coefficients: Vector<F> @P, shift: F @V, size: index @V,
    position: index @V, flag: bool @V, expected_root: F @V, expected: F @V)
    -> (accepted: bool @V) {
  let received = send P -> V(coefficients);
  let value @V = normalized(received);
  let generator @V = root(size);
  let coordinate @V = point(shift, size, select(flag, position, 0));
  let actual @V = evaluate(value, coordinate);
  return (accepted = generator == expected_root && actual == expected);
}
proof Proof = Check {
  prover P; verifier V;
  public { shift, size, position, flag, expected_root, expected };
  accept accepted;
  construction authored;
}
