# A corrupted final coefficient in the tail wire must grade rejected:
# the second coefficient's bytes sit right after the last fold root.
# RUN: %python -c "import sys; w=bytearray(bytes.fromhex(open(sys.argv[1]).read())); w[128] ^= 1; open(sys.argv[2],'w').write(w.hex())" %t/f.wire.hex %t/f.bad.hex
# RUN: not cargo run --locked --quiet --manifest-path %zkc-replay-manifest --bin grade -- %t/f.verifier.json %t/f.froot.txt %t/f.bad.hex | FileCheck %s --check-prefix=GRADEBAD

# RUNNER: upstream verify: accepted the runner's proof at the pinned revision
# GRADE: upstream grade: accepted the decoded wire at the pinned revision
# GRADEBAD: upstream grade: rejected
