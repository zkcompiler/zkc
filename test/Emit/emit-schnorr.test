# REQUIRES: cargo
# The verifier emitter's first subject (docs/spec/carrier.md §6.2): the
# projected Schnorr verifier document becomes a standalone Rust crate, and
# the crate replays the committed golden vectors — the same file the
# reference executor replays in schnorr-exec.test, so equality is the
# differential gate between the emitted program and the reference
# semantics. The emitter recomputes both identities from the document
# bytes; both are diffed against the C++ implementation's own reading
# here, not trusted from a sidecar.

# RUN: rm -rf %t && mkdir -p %t
# RUN: zkc-opt %pir-seal-full %pir-project-full %S/../Encoding/schnorr.mlir -o %t/verifier.mlir
# RUN: zkc-translate --oir-canonical %t/verifier.mlir -o %t/verifier.json
# RUN: zkc-translate --oir-id %t/verifier.mlir -o %t/artifact.id
# RUN: zkc-translate --oir-semantic-id %t/verifier.mlir -o %t/semantic.id

# RUN: cargo run --locked --quiet --manifest-path %zkc-emit-manifest -p zkc-emit -- --doc %t/verifier.json --binding %zkc-emit-bindings/toy.json --rt-path %zkc-rt-dir --vectors %S/../Oir/Inputs/schnorr-exec-vectors.json --out %t/crate > %t/emit.out

# The emitter's recomputed identities equal the carrier's own.
# RUN: grep "artifact id:" %t/emit.out | sed 's/artifact id: //' > %t/emit-artifact.id
# RUN: diff %t/emit-artifact.id %t/artifact.id
# RUN: grep "semantic id:" %t/emit.out | sed 's/semantic id: //' > %t/emit-semantic.id
# RUN: diff %t/emit-semantic.id %t/semantic.id

# The emitted crate carries its own conformance suite: the golden
# vectors (accept and every reject class), plus the identity binding.
# RUN: cargo test --quiet --manifest-path %t/crate/Cargo.toml

# Byte determinism: a second emission is the identical crate.
# RUN: cargo run --locked --quiet --manifest-path %zkc-emit-manifest -p zkc-emit -- --doc %t/verifier.json --binding %zkc-emit-bindings/toy.json --rt-path %zkc-rt-dir --vectors %S/../Oir/Inputs/schnorr-exec-vectors.json --out %t/crate2 > /dev/null
# RUN: diff %t/crate/Cargo.toml %t/crate2/Cargo.toml
# RUN: diff %t/crate/src/lib.rs %t/crate2/src/lib.rs
# RUN: diff %t/crate/tests/conformance.rs %t/crate2/tests/conformance.rs
# RUN: diff %t/crate/README.md %t/crate2/README.md

# A supplier gap refuses at emit time, naming the class — the E400
# family's emit-time form, so the emitted crate never carries a
# "cannot judge" arm.
# RUN: sed 's/"scalar"/"scalar_absent"/' %zkc-emit-bindings/toy.json > %t/broken-binding.json
# RUN: not cargo run --locked --quiet --manifest-path %zkc-emit-manifest -p zkc-emit -- --doc %t/verifier.json --binding %t/broken-binding.json --rt-path %zkc-rt-dir --out %t/refused2 2>&1 | FileCheck --check-prefix=GAP %s
# GAP: codec class 'scalar' has no implementation in binding

# The emitter walk's characterization gate (the register's DEF-11): the
# emitted sources for this shape are pinned by digest, so a refactor of
# the walk is checked to have preserved every byte it emits, and an
# intended emitter change re-mints the pin deliberately. Cargo.toml is
# excluded because it embeds the local rt path.
# RUN: cd %t/crate && sha256sum src/lib.rs tests/conformance.rs > %t/src.sha256
# RUN: diff %t/src.sha256 %S/Inputs/schnorr-crate-src.sha256
