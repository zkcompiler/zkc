# The counted attachment vocabulary, refused where mis-declared: a
# value_identity_vector must cite a counted challenge dependency whose
# count equals its target segment's, and a value_identity_list must
# carry exactly one selector per target element. The value-faithful
# family's own vocabulary is the positive control.

# RUN: rm -rf %t && mkdir -p %t
# RUN: zkc-family %S/../Oir/Inputs/plonky3-fri-vf.json --emit-vocabulary=%t/vocab.json --emit-spine=%t/spine.mlir
# RUN: zkc-registry-lint %t/vocab.json > /dev/null

# A scalar dependency in the vector attachment's source cannot carry a
# counted segment.
# RUN: %python -c "import json,sys; d=json.load(open(sys.argv[1])); a=d['reduction_contracts']['fri']['checks']['merkle']['attachments']; a[1]['source']['role']='zeta'; json.dump(d, open(sys.argv[2],'w'))" %t/vocab.json %t/scalar-source.json
# RUN: not zkc-registry-lint %t/scalar-source.json 2>&1 | FileCheck %s --check-prefix=SCALAR
# SCALAR: value_identity_vector requires a counted dependency or message source whose count equals the target segment's

# A list one selector short of its segment leaves an element unbound.
# RUN: %python -c "import json,sys; d=json.load(open(sys.argv[1])); a=d['reduction_contracts']['fri']['checks']['consistency']['attachments']; next(x for x in a if x['kind']=='value_identity_list' and x['target_role']=='betas')['source']['items'].pop(); json.dump(d, open(sys.argv[2],'w'))" %t/vocab.json %t/short-list.json
# RUN: not zkc-registry-lint %t/short-list.json 2>&1 | FileCheck %s --check-prefix=SHORT
# SHORT: value_identity_list length must equal the target segment's count
