# A hole contract's parameter bindings, followed from the authored route to
# the supplier that receives them.
#
# Both production hole contracts declare no parameters, so until this test the
# whole binding path was represented and unrun: projection could drop the
# semantic half, admission could accept a binding that named nothing, and the
# supplier could be handed an empty list, with the suite green throughout. The
# contract here has one static parameter and one semantic one and is otherwise
# the sigma commit.
# REQUIRES: uv

# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/parameterized_vocabulary.py %zkc-registry-dir/protocol-vocabulary.json %t/vocabulary.json
# RUN: zkc-opt -pir-seal='protocol-vocabulary=%t/vocabulary.json construction-profile-registry=%zkc-registry-dir/construction-profiles.json' %S/Inputs/parameterized-route.mlir -o %t/sealed.mlir
# RUN: zkc-opt -pir-project='endpoint-kind=prover_skeleton protocol-vocabulary=%t/vocabulary.json construction-profile-registry=%zkc-registry-dir/construction-profiles.json' %t/sealed.mlir -o %t/prover.mlir

# Both bindings reach the endpoint, each in its contract's own name order.
# RUN: FileCheck %s --check-prefix=PROJECTED < %t/prover.mlir
# PROJECTED: oir.hole_call "commit"
# PROJECTED-SAME: params ["batched"]
# PROJECTED-SAME: semantic ["sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"]

# The endpoint carries them, so the reference twin encodes the same document.
# RUN: zkc-translate --oir-canonical %t/prover.mlir -o %t/oir.zkc
# RUN: grep -q '"batched"' %t/oir.zkc
# RUN: grep -q '"sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"' %t/oir.zkc

# What the supplier is actually handed. The reporting supplier fills nothing
# and states its arguments, so this reads the end of the transport rather than
# inferring it from a successful run.
# RUN: not zkc-test-opt "-test-hole-parameter-transport=witness=00000000000000050000000000000007 statement=y=1024" %t/prover.mlir -o /dev/null 2>&1 | FileCheck %s --check-prefix=SUPPLIED
# SUPPLIED: received static [batched] semantic [sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae]

# --------------------------------------------------------------------------
# Source-free admission re-establishes each binding from the artifact and the
# cited contract alone. Every mutation restamps the stored identity, so what
# refuses is admission and never the identity gate.
# --------------------------------------------------------------------------

# A dropped semantic binding: the count no longer matches the contract's.
# RUN: sed 's/ semantic \[[^]]*\]//' %t/prover.mlir > %t/dropped.raw
# RUN: zkc-translate --oir-id %t/dropped.raw -o %t/dropped.id
# RUN: %python %S/Inputs/rewrite-oir-id.py %t/dropped.raw %t/dropped.mlir %t/dropped.id
# RUN: not zkc-run %t/dropped.mlir --protocol-vocabulary=%t/vocabulary.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json --prove "w=00000000000000050000000000000007" --statement "y=1024" 2>&1 | FileCheck %s --check-prefix=DROPPED
# DROPPED: [zkc-E238] hole_call 'commit' carries 0 semantic parameter(s), the cited contract declares 1

# A semantic binding that is not a content reference names nothing a supplier
# could hold, whatever else it might mean.
# RUN: sed -E 's/(semantic \[")sha256:[0-9a-f]+/\1the-usual-one/' %t/prover.mlir > %t/unnamed.raw
# RUN: zkc-translate --oir-id %t/unnamed.raw -o %t/unnamed.id
# RUN: %python %S/Inputs/rewrite-oir-id.py %t/unnamed.raw %t/unnamed.mlir %t/unnamed.id
# RUN: not zkc-run %t/unnamed.mlir --protocol-vocabulary=%t/vocabulary.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json --prove "w=00000000000000050000000000000007" --statement "y=1024" 2>&1 | FileCheck %s --check-prefix=UNNAMED
# UNNAMED: [zkc-E238] hole_call 'commit' semantic parameter 'reference_string' must be a sha256 content reference, got 'the-usual-one'

# An empty static binding supplies no value, which the sealing check refuses
# and this boundary must refuse again — it has no sealing behind it.
# RUN: sed 's/params \["batched"\]/params [""]/' %t/prover.mlir > %t/empty.raw
# RUN: zkc-translate --oir-id %t/empty.raw -o %t/empty.id
# RUN: %python %S/Inputs/rewrite-oir-id.py %t/empty.raw %t/empty.mlir %t/empty.id
# RUN: not zkc-run %t/empty.mlir --protocol-vocabulary=%t/vocabulary.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json --prove "w=00000000000000050000000000000007" --statement "y=1024" 2>&1 | FileCheck %s --check-prefix=EMPTY
# EMPTY: [zkc-E238] hole_call 'commit' static parameter 'mode' must be a non-empty printable binding

# A route that omits a declared binding never reaches an endpoint at all: the
# earliest owner is the sealing check, and projection refuses in its own right.
# RUN: sed 's/, params = {mode = "batched", reference_string = "sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"}//' %S/Inputs/parameterized-route.mlir > %t/unrouted.mlir
# RUN: not zkc-opt -pir-seal='protocol-vocabulary=%t/vocabulary.json construction-profile-registry=%zkc-registry-dir/construction-profiles.json' %t/unrouted.mlir -o /dev/null 2>&1 | FileCheck %s --check-prefix=UNROUTED
# UNROUTED: [zkc-E223] route instance 'commit' must supply exactly 2 declared static and semantic parameter(s)
