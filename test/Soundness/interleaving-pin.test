# RUN:   --request=%S/Inputs/interleaved-a-request.json -o=/dev/null %t/sealed.mlirbc \
# RUN:   2>&1 | FileCheck %s
# CHECK: interleaved reduction bodies 'opa' and 'opb' are both non-central
