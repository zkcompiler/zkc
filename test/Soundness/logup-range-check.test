# COMPILED: artifact judgment
# COMPILED-NOT: belongs to no transformer

# The structural half of the derivation, on both implementations. The bounds
# themselves are C++-only; the shared surface is the plan the two legs walk
# to reach them.
# RUN: %if uv %{ zkc-derive --signature=%zkc-registry-dir/soundness-signature.json \
# RUN:   --protocol-vocabulary=%zkc-registry-dir/protocol-vocabulary.json \
# RUN:   --construction-profile-registry=%zkc-registry-dir/construction-profiles.json \
# RUN:   --request=%t/rc.req.json --skeleton -o=%t/zkc.skeleton.json %t/rc.mlirbc %}
