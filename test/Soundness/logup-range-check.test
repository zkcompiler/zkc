# The first rule that reads two committed arities, and the first family whose
# table the statement fixes.
#
# A lookup's soundness error grows in the sizes of both columns, and the two
# are different numbers: a range check is a small table with many queries.
# Reading one arity for the whole reduction could only ever price the equal
# case, so the projection selects by message role and the contract's roles are
# what say which commitment is which.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: zkc-seal %S/../Encoding/logup-range-check.mlir %zkc-seal-full -o %t/rc.artifacts > /dev/null
# RUN: %python %S/../SemanticClosure/lib/artifact_handoff.py stage %t/rc.artifacts %t/rc.mlirbc
# RUN: %python %S/../Evidence/Inputs/retarget_request.py %S/Inputs/logup-range-check-request.json %t/rc.artifacts %t/rc.req.json
# RUN: zkc-derive --signature=%zkc-registry-dir/soundness-signature.json \
# RUN:   --protocol-vocabulary=%zkc-registry-dir/protocol-vocabulary.json \
# RUN:   --construction-profile-registry=%zkc-registry-dir/construction-profiles.json \
# RUN:   --request=%t/rc.req.json -o=%t/rc.out.json %t/rc.mlirbc
# RUN: FileCheck %s --check-prefix=BOUND < %t/rc.out.json

# What the judgment rests on and does not establish. The declared arity is
# carried rather than grounded, because no arrangement of transcript events
# separates an honest declaration from a consistent understatement; for a
# preprocessed table that obligation is owed to the anchor's preimage and for
# a committed column to its binding route.
# BOUND: "zkc.hyp.commitment_binds_declared_arity"

# Two hundred and fifty-six table entries and a thousand and twenty-four
# looked-up values. Clearing denominators at the sampled point leaves a
# polynomial in which every term omits one of the table + lookups linear
# factors, so the degree — and the count of points a false inclusion can hide
# at — is one less than their sum (Haböck, ePrint 2022/1530, Lemma 5 with
# Schwartz-Zippel). The number is asserted exactly: an off-by-one here is a
# bound that claims more than the theorem gives.
# BOUND: "constant": "1279/2305843009213693951"

# The honest prover's own failure set, priced on its own track. It is the
# points where a denominator vanishes — at most one per table entry and one
# per looked-up value — so it is counted as a set and comes out one larger
# than the soundness bound over the same two numbers. The asymmetry is real
# and both numbers are pinned so neither can drift onto the other.
# RUN: %python %S/../Evidence/Inputs/retarget_request.py %S/Inputs/logup-range-check-completeness-request.json %t/rc.artifacts %t/rc.comp.json
# RUN: zkc-derive --signature=%zkc-registry-dir/soundness-signature.json \
# RUN:   --protocol-vocabulary=%zkc-registry-dir/protocol-vocabulary.json \
# RUN:   --construction-profile-registry=%zkc-registry-dir/construction-profiles.json \
# RUN:   --request=%t/rc.comp.json -o=%t/rc.comp.out.json %t/rc.mlirbc
# RUN: FileCheck %s --check-prefix=COMPLETE < %t/rc.comp.out.json
# COMPLETE: "track": "completeness"
# COMPLETE: "constant": "1280/2305843009213693951"

# The multiplicity column is indexed by the table, so a declaration that
# disagrees with the table's is not the object the lemma quantifies over.
# This is the structural condition of the rule: where the artifact does fix a
# relation between two declared arities, the rule checks it.
# RUN: %python -c "import json,sys; d=json.load(open(sys.argv[1])); d['value_profiles']['logup_multiplicities']['arity_log2']=7; json.dump(d, open(sys.argv[2],'w'))" %zkc-registry-dir/protocol-vocabulary.json %t/mult.vocab.json
