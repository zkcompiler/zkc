# RUN: %python %S/../SemanticClosure/lib/artifact_handoff.py stage %t/untied.artifacts %t/untied.mlirbc
# RUN: zkc-opt -pir-seal='protocol-vocabulary=%t/untied.vocab.json construction-profile-registry=%zkc-registry-dir/construction-profiles.json' %S/../Encoding/logup-range-check.mlir -o %t/untied.sealed.mlir
# RUN: %python -c "import json,re,sys; digest=re.search(r'logup_range_check = \"(sha256:[0-9a-f]+)\"', open(sys.argv[1]).read()).group(1); s=json.load(open(sys.argv[2])); [v['anchor']['ref'].__setitem__('source_revision', digest) for v in s['bindings'].values() if v.get('anchor',{}).get('ref',{}).get('id')=='logup_range_check']; json.dump(s, open(sys.argv[3],'w'))" %t/untied.sealed.mlir %zkc-registry-dir/soundness-signature.json %t/untied.sig.json
