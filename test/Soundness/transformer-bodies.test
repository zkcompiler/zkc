# RUN:   --construction-profile-registry=%zkc-registry-dir/construction-profiles.json \
# RUN:   %t/chain.mlirbc | grep "transformer body" > %t/chain.bodies
# RUN: FileCheck %s --check-prefix=CHAIN < %t/chain.bodies
# CHAIN-COUNT-3: transformer body: {{.*}} non-central
