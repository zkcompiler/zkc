// The family frontend emits one complete ProtocolVocabulary, an exact
// protocol vocabulary derived from an admitted base, and one honest analysis
// artifact. It never manufactures policy authorization or a terminal rule:
// the resulting claim is an explicit residual until that rule is researched.
//
// RUN: zkc-family %S/Inputs/frik2.json --emit-vocabulary=%t.k2.vocab.json --emit-spine=%t.k2.mlir
// RUN: zkc-family %S/Inputs/frik2.json --emit-vocabulary=%t.k2b.vocab.json --emit-spine=%t.k2b.mlir
// RUN: diff %t.k2.vocab.json %t.k2b.vocab.json
// RUN: diff %t.k2.mlir %t.k2b.mlir
// RUN: zkc-registry-lint %t.k2.vocab.json | FileCheck --check-prefix=LINT %s
// RUN: FileCheck --check-prefix=K2-VOCAB %s < %t.k2.vocab.json
// RUN: FileCheck --check-prefix=K2-SPINE %s < %t.k2.mlir
// RUN: rm -rf %t.k2.artifacts
// RUN: zkc-seal %t.k2.mlir --protocol-vocabulary=%t.k2.vocab.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json -o %t.k2.artifacts
//
// LINT: "reduction_contracts"
// LINT: "registry":"zkc.protocol_vocabulary"
// Which sections the emitted document carries, not the order it
// happens to write them in: the digests are taken over the canonical
// form, so key order in this file reaches nothing and asserting it
// would hold the writer to a spelling rather than to content.
// K2-VOCAB-DAG: "registry": "zkc.protocol_vocabulary"
// K2-VOCAB-DAG: "opaque_relation"
// K2-VOCAB-DAG: "predicate_specs": {}
// K2-VOCAB-DAG: "zkc.check.rs-equality"
// K2-VOCAB-DAG: "reduction_contracts"
// K2-VOCAB-DAG: "fri"
// K2-VOCAB-DAG: "terminal_rules": {}
// K2-SPINE: pir.protocol "frik2"
// K2-SPINE-SAME: policy "analysis_only_artifact"
// K2-SPINE: pir.check "consistency" contract "zkc.check.rs-equality"
// K2-SPINE: pir.reduce "fri" contract "fri"
// K2-SPINE-SAME: checks {consistency = "consistency"}
// K2-SPINE-SAME: anchors [{statement = "sha256:a8e0d4fd1cf2805185daf6d0f9234b21b842fefde3503dfd74d6919a109cdb47"}]
// K2-SPINE: pir.material_bind
// K2-SPINE: pir.residual
// K2-SPINE-SAME: route "fri-terminal-not-modeled"

// General k is data, not a code path.  A k=3 description deterministically
// grows the contract and carrier by one fold round and still seals under its
// generated vocabulary and exact theorem revision.
// RUN: zkc-family %S/Inputs/frik3.json --emit-vocabulary=%t.k3.vocab.json --emit-spine=%t.k3.mlir
// RUN: rm -rf %t.k3.artifacts
// RUN: zkc-seal %t.k3.mlir --protocol-vocabulary=%t.k3.vocab.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json -o %t.k3.artifacts
// RUN: FileCheck --check-prefix=K3 %s < %t.k3.mlir
// K3: "fold3"
// K3: deps(%fold1, %fold2, %fold3, %query

// The same construction extrapolates to a depth that has no hand-written
// fixture; the judged path, not the generator, remains the authority.
// RUN: zkc-family %S/Inputs/frik5.json --emit-vocabulary=%t.k5.vocab.json --emit-spine=%t.k5.mlir
// RUN: rm -rf %t.k5.artifacts
// RUN: zkc-seal %t.k5.mlir --protocol-vocabulary=%t.k5.vocab.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json -o %t.k5.artifacts
// RUN: FileCheck --check-prefix=K5 %s < %t.k5.mlir
// K5: "fold5"
// K5: deps(%fold1, %fold2, %fold3, %fold4, %fold5, %query

// The supported FRI analyses share the same frontend and unified vocabulary
// shape.  These are generation and seal probes: the bound belongs to a
// soundness rule, derived after the seal.
