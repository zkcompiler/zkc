// RUN: rm -rf %t.u.artifacts
// RUN: zkc-seal %t.u.mlir --protocol-vocabulary=%t.u.vocab.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json -o %t.u.artifacts
// RUN: zkc-family %S/Inputs/frigrind.json --emit-vocabulary=%t.g.vocab.json --emit-spine=%t.g.mlir
// RUN: rm -rf %t.g.artifacts
