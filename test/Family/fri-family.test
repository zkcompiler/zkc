// A protocol carries no theorem citation, so the Fiat-Shamir path is chosen by
// a derivation rather than declared here. The generated spine is therefore the
// same shape whichever conclusion a later plan derives about it.
// RUN: zkc-family %S/Inputs/frifs.json --emit-vocabulary=%t.fs.vocab.json --emit-spine=%t.fs.mlir
// RUN: rm -rf %t.fs.artifacts
// RUN: zkc-seal %t.fs.mlir --protocol-vocabulary=%t.fs.vocab.json --construction-profile-registry=%zkc-registry-dir/construction-profiles.json -o %t.fs.artifacts
// RUN: FileCheck --check-prefix=FS %s < %t.fs.mlir
// FS: pir.reduce "frij" contract "fri"

// Input admission is closed and fail-closed.
// RUN: not zkc-family %S/Inputs/bad-family.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=BADFAM %s
// RUN: not zkc-family %S/Inputs/bad-k.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=BADK %s
// RUN: not zkc-family %S/Inputs/bad-unknown-key.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=UNKNOWN %s
// RUN: not zkc-family %S/Inputs/bad-johnson.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=JOHNSON %s
// RUN: not zkc-family %S/Inputs/bad-field.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=FIELD %s
// RUN: not zkc-family %S/Inputs/bad-rate.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=RATE %s
// RUN: not zkc-family %S/Inputs/bad-embed.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=EMBED %s
// RUN: not zkc-family %S/Inputs/bad-m.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=M %s
// RUN: not zkc-family %S/Inputs/bad-ell.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=ELL %s
// RUN: not zkc-family %S/Inputs/bad-blowup.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=BLOWUP %s
// RUN: not zkc-family %S/Inputs/bad-final-len.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=FINLEN %s
// RUN: not zkc-family %S/Inputs/bad-blowup-equation.json --emit-vocabulary=%t.x.json --emit-spine=%t.x.mlir 2>&1 | FileCheck --check-prefix=SHAPE %s
// BADFAM: unknown family 'stir'
// BADK: 'k' must be a positive integer
// UNKNOWN: unknown field 'rate'
// JOHNSON: needs the 'johnson' block
// FIELD: 'field' must be a decimal integer string
// RATE: 'query_log2' must equal k + log_blowup + log_final_poly_len with log_blowup at least 1
// EMBED: query space 2^query_log2 must embed in 'field'
// M: 'johnson.m' must be an integer of at least 3
// ELL: 'ell' must be an integer from 2 through 2^20
// BLOWUP: 'log_blowup' must be a positive integer
// FINLEN: 'log_final_poly_len' must be an integer from 0 through 20
// SHAPE: 'query_log2' must equal k + log_blowup + log_final_poly_len

