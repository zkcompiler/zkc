# RUN: zkc-opt '-pir-seal=protocol-vocabulary=%t/friquarter.json construction-profile-registry=%zkc-registry-dir/construction-profiles.json' %t/friquarter.mlir | grep -oE 'id "[0-9a-f]{64}"' | head -1 | diff %S/Expected/friquarter.identity -

