# The pin is not vacuous: the same instance with one parameter moved
# emits a different vocabulary and seals to a different identity, so a
# diff against these files means what it says.
# RUN: %python -c "import json,sys; d=json.load(open(sys.argv[1])); d['grinding_bits']=d['grinding_bits']+1; json.dump(d, open(sys.argv[2],'w'))" %S/../Oir/Inputs/plonky3-fri-vf.json %t/moved.json
# RUN: zkc-family %t/moved.json --emit-vocabulary=%t/moved.vocab.json --emit-spine=%t/moved.mlir
# RUN: zkc-opt '-pir-seal=protocol-vocabulary=%t/moved.vocab.json construction-profile-registry=%zkc-registry-dir/construction-profiles.json' %t/moved.mlir | grep -oE 'id "[0-9a-f]{64}"' | head -1 | not diff %S/Expected/plonky3-fri-vf.identity -
