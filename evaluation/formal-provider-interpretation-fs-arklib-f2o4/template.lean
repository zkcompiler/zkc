import SchnorrArkLib
import ArkLib.OracleReduction.FiatShamir.Basic

open OracleComp OracleSpec ProtocolSpec

namespace ZkcArkLibFiatShamirInterpretation

open ZkcArkLibInterpretation

local instance z3Compatible : VCVCompatible Z3 where
  type_decidableEq' := inferInstance

theorem challengeIndexOne (i : protocolSpec.ChallengeIdx) :
    i.val.val = 1 := by
  rcases i with ⟨j, hj⟩
  fin_cases j
  · contradiction
  · rfl
  · contradiction

local instance challengeCompatible :
    (i : protocolSpec.ChallengeIdx) → VCVCompatible (protocolSpec.Challenge i) :=
  fun ⟨j, hj⟩ => by
    have hj1 := challengeIndexOne ⟨j, hj⟩
    have hjfin : j = (1 : Fin 3) := Fin.ext hj1
    subst j
    simpa [protocolSpec] using z3Compatible

def transformedReduction (nonce : Z3) :=
  Reduction.fiatShamir (reduction nonce)

structure QueryPoint where
  round : Nat
  statement : Nat
  commitment : Nat
  answer : Nat
deriving Repr

def finiteTableLookup (statement commitment : Nat) : Option Nat :=
  match statement, commitment with
__TABLE_CASES__
  | _, _ => none

def commitmentAtChallenge
    (q : (fsChallengeOracle Z3 protocolSpec).Domain) : Z3 := by
  rcases q with ⟨⟨j, hj⟩, statement, messages⟩
  have hj1 := challengeIndexOne ⟨j, hj⟩
  have hjfin : j = (1 : Fin 3) := Fin.ext hj1
  subst j
  let commitment := messages ⟨⟨0, Nat.zero_lt_succ 0⟩, rfl⟩
  change Z3 at commitment
  exact commitment

def tableImpl : QueryImpl ([]ₒ + fsChallengeOracle Z3 protocolSpec)
    (StateM (List QueryPoint)) :=
  fun query => by
    match query with
    | Sum.inl i => exact nomatch i
    | Sum.inr q =>
      rcases q with ⟨⟨j, hj⟩, statement, messages⟩
      have hj1 := challengeIndexOne ⟨j, hj⟩
      have hjfin : j = (1 : Fin 3) := Fin.ext hj1
      subst j
      let commitment : Z3 := by
        let value := messages ⟨⟨0, Nat.zero_lt_succ 0⟩, rfl⟩
        change Z3 at value
        exact value
      change StateM (List QueryPoint) Z3
      let answer := finiteTableLookup statement.val commitment.val
      match answer with
      | some value =>
          exact do
            modify (fun log => log ++ [⟨1, statement.val, commitment.val, value⟩])
            return (value : Z3)
      | none => exact panic! "finite table lookup outside admitted domain"

def executeProver (statement witness nonce : Z3) :=
  let transformed := transformedReduction nonce
  let state := transformed.prover.input (statement, witness)
  (simulateQ tableImpl (transformed.prover.sendMessage ⟨0, rfl⟩ state)).run []

def proofTranscript
    (proof : (i : protocolSpec.MessageIdx) → protocolSpec.Message i) :
    FullTranscript
      ⟨!v[.P_to_V], !v[(i : protocolSpec.MessageIdx) → protocolSpec.Message i]⟩ :=
  fun | ⟨0, _⟩ => proof

def executeVerifier (statement : Z3)
    (proof : (i : protocolSpec.MessageIdx) → protocolSpec.Message i) :=
  let transformed := transformedReduction 0
  (simulateQ tableImpl
    (transformed.verifier.verify statement (proofTranscript proof)).run).run []

def commitmentOf
    (proof : (i : protocolSpec.MessageIdx) → protocolSpec.Message i) : Z3 := by
  simpa [protocolSpec] using proof ⟨0, rfl⟩

def responseOf
    (proof : (i : protocolSpec.MessageIdx) → protocolSpec.Message i) : Z3 := by
  simpa [protocolSpec] using proof ⟨2, rfl⟩

def suppliedProof (commitment response : Z3) :
    (i : protocolSpec.MessageIdx) → protocolSpec.Message i :=
  fun i => by
    change Z3
    exact if i.val.val = 0 then commitment else response

def bit (value : Bool) : Nat := if value then 1 else 0

def emitHonestRows : IO Unit := do
  for statement in List.range 3 do
    for witness in List.range 3 do
      for nonce in List.range 3 do
        let proverResult := executeProver statement witness nonce
        let proof := proverResult.1.1
        let verifierResult := executeVerifier statement proof
        match proverResult.2, verifierResult.2 with
        | [p], [v] =>
          IO.println s!"HONEST\t{statement}\t{witness}\t{nonce}\t{(commitmentOf proof).val}\t{(responseOf proof).val}\t{bit verifierResult.1.isSome}\t{p.round}\t{p.statement}\t{p.commitment}\t{p.answer}\t{v.round}\t{v.statement}\t{v.commitment}\t{v.answer}"
        | _, _ => IO.println "HONEST-QUERY-COUNT-FAILURE"

def emitVerifierRows : IO Unit := do
  for statement in List.range 3 do
    for commitment in List.range 3 do
      for response in List.range 3 do
        let proof := suppliedProof commitment response
        let verifierResult := executeVerifier statement proof
        match verifierResult.2 with
        | [v] =>
          IO.println s!"VERIFIER\t{statement}\t{commitment}\t{response}\t{bit verifierResult.1.isSome}\t{v.round}\t{v.statement}\t{v.commitment}\t{v.answer}"
        | _ => IO.println "VERIFIER-QUERY-COUNT-FAILURE"

#eval emitHonestRows
#eval emitVerifierRows

#print axioms transformedReduction
#print axioms tableImpl
#print axioms executeProver
#print axioms executeVerifier

end ZkcArkLibFiatShamirInterpretation
