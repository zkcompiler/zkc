module conformance::match_duplicate_alternative

enum Choice:
    Left(nat)
    Right(bool)
def f(v:Choice) -> nat:
    mut result = 0
    match v:
        case Choice::Left(n):
            result := n
        case Choice::Right(b):
            result := if b then 1 else 0
        case Choice::Right(other):
            result := 0
    return result
