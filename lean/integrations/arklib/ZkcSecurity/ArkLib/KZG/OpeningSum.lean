module

public import Zkc.Protocols.OpeningSum
public import ArkLib.Commitments.Functional.KZG.Binding
-- ArkLib's correctness statement exposes the representation of `ofFn`.
import all CompPoly.Univariate.Basic

@[expose] public section

/-! Concrete KZG opening checks in a composed typed verifier.

The reduction uses ArkLib's actual commitment, opening, pairing verifier and
two-opening algebra. It states an advantage for a particular reduced adversary;
it does not assume the unrestricted `tSdhAssumption` convenience predicate.
The security experiment registers the polynomial behind the commitment. This
is not extraction of a polynomial from an arbitrary malicious commitment.
-/

namespace ZkcSecurity.ArkLib.KZG.OpeningSum
open Zkc.Protocols.OpeningSum
open OracleComp OracleSpec
open scoped NNReal ENNReal

variable {p : ℕ} [Fact (Nat.Prime p)]
variable {G₁ : Type} [Group G₁] [PrimeOrderWith G₁ p] {g₁ : G₁}
variable {G₂ : Type} [Group G₂] [PrimeOrderWith G₂ p] {g₂ : G₂}
variable {Gₜ : Type} [Group Gₜ] [PrimeOrderWith Gₜ p] [DecidableEq Gₜ]
variable [Module (ZMod p) (Additive G₁)] [Module (ZMod p) (Additive G₂)]
  [Module (ZMod p) (Additive Gₜ)]
variable (pairing : Additive G₁ →ₗ[ZMod p] Additive G₂ →ₗ[ZMod p] Additive Gₜ)
variable {n : ℕ}

def check (srs : Vector G₂ 2) : Check (ZMod p) G₁ G₁ := fun commitment point opening =>
  _root_.KZG.verifyOpening (g₁ := g₁) (g₂ := g₂) pairing srs commitment opening.proof point opening.value

def evaluate (coefficients : Fin (n + 1) → ZMod p) (point : ZMod p) : ZMod p :=
  (CompPoly.CPolynomial.ofFn coefficients).eval point

def extractOpening (srs : Vector G₁ (n + 1)) (coefficients : Fin (n + 1) → ZMod p)
    (point : ZMod p) (opening : Opening (ZMod p) G₁) : ZMod p × G₁ :=
  (-point, (_root_.KZG.generateOpening srs coefficients point / opening.proof) ^
    (1 / (opening.value - evaluate coefficients point)).val)

/-- A false accepted opening and the honest opening of the registered polynomial
give a concrete t-SDH solution, with no probability or hardness assumption. -/
theorem false_opening_extract (hg₁ : g₁ ≠ 1) (hpair : pairing g₁ g₂ ≠ 0)
    (secret : ZMod p) (coefficients : Fin (n + 1) → ZMod p)
    (point : ZMod p) (opening : Opening (ZMod p) G₁)
    (accepted : check (g₁ := g₁) (g₂ := g₂) pairing
      (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret).2
      (_root_.KZG.commit (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret).1 coefficients)
      point opening = true)
    (wrong : opening.value ≠ evaluate coefficients point) :
    Groups.tSdhCondition (g₁ := g₁)
      (secret, extractOpening (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret).1
        coefficients point opening) := by
  apply _root_.KZG.CommitmentScheme.t_sdh_cond_of_two_valid_openings
    (pairing := pairing) secret point (evaluate coefficients point) opening.value
    (_root_.KZG.commit (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret).1 coefficients)
    (_root_.KZG.generateOpening
      (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret).1 coefficients point)
    opening.proof (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret)
    rfl wrong.symm hg₁ hpair
  · exact _root_.KZG.correctness pairing PrimeOrderWith.hCard n secret coefficients point
  · exact accepted

structure Submission (p : ℕ) (G₁ : Type) (n : ℕ) where
  coefficients : Fin (n + 1) → ZMod p
  first : ZMod p
  second : ZMod p
  claim : ZMod p
  left : Opening (ZMod p) G₁
  right : Opening (ZMod p) G₁

def statement (srs : Vector G₁ (n + 1)) (submission : Submission p G₁ n) : Statement (ZMod p) G₁ :=
  ⟨_root_.KZG.commit srs submission.coefficients, submission.first, submission.second, submission.claim⟩

def extraction (srs : Vector G₁ (n + 1)) (submission : Submission p G₁ n) : ZMod p × G₁ :=
  if submission.left.value = evaluate submission.coefficients submission.first then
    extractOpening srs submission.coefficients submission.second submission.right
  else extractOpening srs submission.coefficients submission.first submission.left

def sourceExecution (srs : Vector G₁ (n + 1) × Vector G₂ 2) (submission : Submission p G₁ n) :=
  (program.denote (meaning (check (g₁ := g₁) (g₂ := g₂) pairing srs.2))
    (environment (statement srs.1 submission))).run (replay submission.left submission.right) 0

def falseClaim (submission : Submission p G₁ n) : Prop :=
  submission.claim ≠ evaluate submission.coefficients submission.first +
    evaluate submission.coefficients submission.second

/-- Honest openings are generated by ArkLib's concrete polynomial division and
commitment operations. The verifier receives only the commitment and openings. -/
def honestSubmission (srs : Vector G₁ (n + 1)) (coefficients : Fin (n + 1) → ZMod p)
    (first second : ZMod p) : Submission p G₁ n where
  coefficients := coefficients
  first := first
  second := second
  claim := evaluate coefficients first + evaluate coefficients second
  left := ⟨evaluate coefficients first, _root_.KZG.generateOpening srs coefficients first⟩
  right := ⟨evaluate coefficients second, _root_.KZG.generateOpening srs coefficients second⟩

theorem honest_source_accepts (secret : ZMod p) (coefficients : Fin (n + 1) → ZMod p)
    (first second : ZMod p) :
    (sourceExecution (g₁ := g₁) (g₂ := g₂) pairing
      (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret)
      (honestSubmission (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret).1
        coefficients first second)).outcome = PIR.Outcome.returned true := by
  apply (contract_accepted (source_contract _) _ _ _).mpr
  exact ⟨_root_.KZG.correctness pairing PrimeOrderWith.hCard n secret coefficients first,
    _root_.KZG.correctness pairing PrimeOrderWith.hCard n secret coefficients second, rfl⟩

/-- The actual typed verifier, rather than an assumed opening specification,
is the accepting subject of the algebraic reduction. -/
theorem source_false_extract (hg₁ : g₁ ≠ 1) (hpair : pairing g₁ g₂ ≠ 0)
    (secret : ZMod p) (submission : Submission p G₁ n)
    (accepted : (sourceExecution (g₁ := g₁) (g₂ := g₂) pairing
      (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret) submission).outcome =
        PIR.Outcome.returned true)
    (wrong : falseClaim submission) :
    Groups.tSdhCondition (g₁ := g₁)
      (secret, extraction (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret).1 submission) := by
  have passes := (contract_accepted (source_contract _) _ _ _).mp accepted
  have bad := accepted_false_implies_bad _ (evaluate submission.coefficients) _ _ _ passes wrong
  unfold extraction
  split
  · rename_i first
    have second := bad.2.resolve_left (not_not.mpr first)
    exact false_opening_extract pairing hg₁ hpair secret submission.coefficients submission.second
      submission.right second.1 second.2
  · rename_i first
    exact false_opening_extract pairing hg₁ hpair secret submission.coefficients submission.first
      submission.left bad.1 first

/-- The public SRS is the adversary's only setup input. The registered polynomial
and both openings may depend on it and on all of the adversary's random work. -/
abbrev Adversary (p : ℕ) (G₁ G₂ : Type) (n : ℕ) :=
  Vector G₁ (n + 1) × Vector G₂ 2 →
    StateT unifSpec.QueryCache ProbComp (Submission p G₁ n)

def game (adversary : Adversary p G₁ G₂ n) : ProbComp (ZMod p × Submission p G₁ n) := do
  let secret ← Groups.sampleNonzeroZMod (p := p)
  let result ← (adversary (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n secret)).run' ∅
  pure (secret, result)

/-- This reduction executes the same adversary once, then constructs one honest
opening and an algebraic t-SDH candidate. It receives no trapdoor. -/
def reduction (adversary : Adversary p G₁ G₂ n) :
    Groups.tSdhAdversary n (G₁ := G₁) (G₂ := G₂) (p := p) := fun srs => do
  let submission ← adversary srs
  pure (some (extraction srs.1 submission))

omit [PrimeOrderWith G₂ p] [Module (ZMod p) (Additive G₁)]
  [Module (ZMod p) (Additive G₂)] in
theorem reduction_event (adversary : Adversary p G₁ G₂ n) :
    Groups.tSdhExperiment (g₁ := g₁) (g₂ := g₂) n (reduction adversary) =
      Pr{let result ← game (g₁ := g₁) (g₂ := g₂) adversary}[
        Groups.tSdhCondition (g₁ := g₁)
          (result.1, extraction (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n result.1).1 result.2)] := by
  simp only [Groups.tSdhExperiment, Groups.tSdhGame, reduction, OptionT.prEvent_mk,
    game, StateT.run'_eq, StateT.run_bind, StateT.run_pure, map_eq_bind_pure_comp,
    bind_assoc, pure_bind]
  rfl

/-- Actual composed source false acceptance is bounded by the concrete reduced
adversary's advantage. No global or unrestricted hardness assumption is used. -/
theorem source_advantage (hg₁ : g₁ ≠ 1) (hpair : pairing g₁ g₂ ≠ 0)
    (adversary : Adversary p G₁ G₂ n) :
    Pr{let result ← game (g₁ := g₁) (g₂ := g₂) adversary}[
      (sourceExecution (g₁ := g₁) (g₂ := g₂) pairing
        (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n result.1) result.2).outcome =
          PIR.Outcome.returned true ∧ falseClaim result.2] ≤
      Groups.tSdhExperiment (g₁ := g₁) (g₂ := g₂) n (reduction adversary) := by
  rw [reduction_event]
  apply prEvent_mono
  rintro ⟨secret, submission⟩ ⟨accepted, wrong⟩
  exact source_false_extract pairing hg₁ hpair secret submission accepted wrong

/-- A concrete computational application supplies a bound for this reduction,
with its own admissibility/cost argument. It need not bound all Lean functions. -/
theorem source_soundness (hg₁ : g₁ ≠ 1) (hpair : pairing g₁ g₂ ≠ 0)
    (adversary : Adversary p G₁ G₂ n) (error : ENNReal)
    (hardness : Groups.tSdhExperiment (g₁ := g₁) (g₂ := g₂) n (reduction adversary) ≤ error) :
    Pr{let result ← game (g₁ := g₁) (g₂ := g₂) adversary}[
      (sourceExecution (g₁ := g₁) (g₂ := g₂) pairing
        (Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n result.1) result.2).outcome =
          PIR.Outcome.returned true ∧ falseClaim result.2] ≤ error :=
  (source_advantage pairing hg₁ hpair adversary).trans hardness

/-- A different source, helper layout or local arithmetic implementation reuses
the same reduction after proving the common open-process contract. The security
consumer has no source-syntax pattern test. -/
theorem contract_advantage (hg₁ : g₁ ≠ 1) (hpair : pairing g₁ g₂ ≠ 0)
    (verifier : (Vector G₁ (n + 1) × Vector G₂ 2) →
      Statement (ZMod p) G₁ → PIR.Proc (interface (ZMod p) G₁ G₁) Bool)
    (contract : ∀ srs, VerifierContract (check (g₁ := g₁) (g₂ := g₂) pairing srs.2) (verifier srs))
    (adversary : Adversary p G₁ G₂ n) :
    Pr{let result ← game (g₁ := g₁) (g₂ := g₂) adversary}[
      let srs := Groups.PowerSrs.generate (g₁ := g₁) (g₂ := g₂) n result.1
      ((verifier srs (statement srs.1 result.2)).run (replay result.2.left result.2.right) 0).outcome =
        PIR.Outcome.returned true ∧ falseClaim result.2] ≤
      Groups.tSdhExperiment (g₁ := g₁) (g₂ := g₂) n (reduction adversary) := by
  apply le_trans (le_of_eq ?_) (source_advantage pairing hg₁ hpair adversary)
  apply prEvent_congr
  intro result
  dsimp only
  rw [contract _ _]
  simp only [sourceExecution, program_denote]
  rfl

end ZkcSecurity.ArkLib.KZG.OpeningSum
