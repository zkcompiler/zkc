run_cmd do
  for name in [`ZkcSecurity.Examples.SchnorrConstructedData.admitted, `ZkcSecurity.Examples.SchnorrConstructedData.full_denotation, `ZkcSecurity.Examples.SchnorrConstructedData.projected_denotation] do
    let _ ← Lean.getConstInfo name
    for axiomName in ← Lean.collectAxioms name do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains axiomName do
        throwError "constructed realization uses unexpected axiom: {axiomName}"
  Lean.logInfo "CONSTRUCTED-REALIZATION-PASS"
