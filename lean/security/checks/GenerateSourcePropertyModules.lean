import ZkcSecurityExamples.Sumcheck.SourcePairGoals
import ZkcSecurityExamples.Sumcheck.SourcePublicGoals
import ZkcSecurityTools.SourceProperties.Assembly

/-! A bounded client of the existing goal, identity and stub tools. The six
signatures live only in the goal modules. This printer imports no companion or
consumer and emits ordinary Lean source for subsequent kernel checking. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
open Lean Meta Elab Command Term ZkcTools.Companions ZkcSecurity.Tools.SourceProperties
open ZkcExamples.Structured.SumcheckSourceSelections

run_cmd do
  let mut sources : List (String × String) := []
  for (family, properties) in [
      ("Pair", [("small", "honest-pair", true, false), ("two", "honest-pair", true, true)]),
      ("Public", [("small_no", "public-rejection", false, false),
        ("two_no", "public-rejection", false, true),
        ("small_cost", "public-cost", true, false), ("two_cost", "public-cost", true, true)])] do
    let modulePrefix := "ZkcSecurityExamples.Sumcheck.Source" ++ family
    let namespacePrefix := "ZkcSecurity.Realizations.Sumcheck.Source" ++ family ++ "Installations"
    let imports := "module\n\npublic import " ++ modulePrefix ++ "Goals\n"
    let mut source := imports ++ "public import " ++ modulePrefix ++ "Companions\n" ++
      "public meta import ZkcSecurityTools.SourceProperties.Assembly\n\n" ++
      "/-! Generated by checks/GenerateSourcePropertyModules.lean. Edit the fixed\n" ++
      "signature in Source" ++ family ++ "Goals or the mathematics in Source" ++ family ++ "Companions. -/\n" ++
      "@[expose] public section\nset_option autoImplicit false\nset_option maxHeartbeats 2000000\n" ++
      "-- Preserve named premises in generated full types, even when lookup does not use their names.\n" ++
      "set_option linter.unusedVariables false\n\n"
    let mut stubs : Array Stub := #[]
    for (name, label, proof, two) in properties do
      let declaration := (namespacePrefix ++ "." ++ name).toName
      let goal := (namespacePrefix ++ "." ++ name ++ "_goal").toName
      let companion := (namespacePrefix ++ ".Companions." ++ name).toName
      let program ← if two then `(term| source .twoSums) else `(term| source .small)
      let (header, identity) ← liftTermElabM do
        let expression ← elabTerm program (some (mkConst ``Zkc.Source.Structured.Program))
        return (← goalHeader goal declaration proof,
          (← sourceIdentity expression).implementationKey label)
      source := source ++ header ++
        "  source_property for (ZkcExamples.Structured.SumcheckSourceSelections.source ." ++
        (if two then "twoSums" else "small") ++ ") :\n    " ++ goal.toString ++
        " with " ++ reprStr label ++ " companions []\n\n#print axioms " ++ declaration.toString ++ "\n\n"
      let stub : Stub := {
        identity := identity
        declaration := companion
        goal := goal
        kind := if proof then .proof else .value }
      stubs := stubs.push stub
    sources := sources ++ [(modulePrefix ++ "Installations", source)]
    let .ok scaffold := appendStubs
      (imports ++ "public meta import ZkcTools.Companions.Report\n\npublic section\n") stubs
      | throwError "invalid generated source-property scaffolding"
    sources := sources ++ [("CompanionStubs.Source" ++ family ++ "Companions", scaffold)]
  elabCommand (← `(def $(mkIdent `generatedSources) : List (String × String) := $(quote sources)))

def main (args : List String) : IO Unit := do
  let [directory] := args | throw (IO.userError "expected output directory")
  for (name, source) in generatedSources do
    let path := System.FilePath.mk directory / (name.replace "." "/" ++ ".lean")
    IO.FS.createDirAll path.parent.get!
    -- Scaffolding is initial author input. Regeneration must not overwrite it.
    if name.startsWith "CompanionStubs." && (← path.pathExists) then continue
    IO.FS.writeFile path (source.trimAsciiEnd.toString ++ "\n")
    IO.println s!"generated {name}"
