local instance : DecidableEq (Domain.Event carriers) := Classical.decEq _
local instance : ∀ event : Domain.Event carriers, SampleableType (Domain.Raw event) := rawSampleable blsModulus

def budget : Nat := 2
noncomputable def price : ENNReal := 1 / (Fintype.card Scalar : ENNReal)
def priceBound : Claims.Bound := .div (.constant 1) (Fintype.card Scalar : ℚ≥0)
theorem priceBound_value (queries : Nat) : priceBound.value queries = price := by
  simp only [priceBound, Bound.value, ennreal_nnrat_one, ennreal_nnrat_natural, price]

noncomputable def rejectedInputs (input0 : List Scalar) (input1 : Scalar) (input2 : Nat)
    (falseStatement : validatorSubject.FalseStatement (statement input0 input1 input2))
    (initial : Domain.History carriers) :
    Zkc.Obligations.Derivation (Nominal.interface (G := Group) field) (boundedEscape (fun _ _ => price))
      (fun _ result => validatorCompiled.acceptance result ≠ some true) initial
      (ZkcSecurity.Examples.Generated.Components.SmallSumcheckValidatorView.presented input0 input1 input2 initial) := by
  derive_component_rejection [CompiledValidator.run_rejecting field ZkcSecurity.Examples.Generated.Components.SmallSumcheckRounds.round0.schedule (fun _ _ => price) (TableComponent.PrimeField.conditionalWithFrame blsModulus field (CompiledValidator.frameUpdate (F := Scalar) (G := Group) field)) input0]
    unfolding [ZkcSecurity.Examples.Generated.Components.SmallSumcheckValidatorView.presented]
    finishing (first
      | (exfalso
         apply falseStatement
         refine ⟨fun _ _ => none, ?_⟩
         prove_retained_target [Scalar, Group] reading (validator_application_read input0 input1 input2 _)
           evaluating ZkcSecurity.Examples.Components.SmallSumcheck.Formula.equation solving prove_table_capacity)
      | (change some _ ≠ some true
         simp (disch := tauto) only [ValidatorHelpers.terminal_rejects_at, Bool.false_and, Bool.and_false]
         decide))

theorem inputCosts (input0 : List Scalar) (input1 : Scalar) (input2 : Nat) (initial : Domain.History carriers) :
    Typed.ChargedCostBound (Nominal.interface (G := Group) field) (fun _ _ => price)
      (ZkcSecurity.Examples.Generated.Components.SmallSumcheckValidatorView.presented input0 input1 input2 initial) initial (budget • price) := by
  unfold budget
  derive_component_cost [CompiledValidator.run_cost _ _ (fun _ _ => price) price (fun _ _ => le_rfl)]
    unfolding [ZkcSecurity.Examples.Generated.Components.SmallSumcheckValidatorView.presented]

def presented (statement : Statement) : Domain.History carriers →
    PIR.Process (Nominal.signature Scalar field) (Domain.Result carriers) :=
  TypedABI.apply (Value := model.Value) (types := validatorArtifacts.publics)
    (ZkcSecurity.Examples.Generated.Components.SmallSumcheckValidatorView.presented (F := Scalar) (G := Group)) statement

theorem bridge (statement : Statement) (initial : Domain.History carriers) :
    DomainReduction.Bridge (Nominal.interface (G := Group) field) (fun _ _ => True) initial
      (Domain.participant model validatorCompiled.imported.program validatorCompiled.selection.context
        validatorArtifacts.participant ((Domain.encodeValues statement).getD [] ++
          [.transcript validatorCompiled.selection.context.suite initial]))
      (presented statement initial) := by
  bind_subject_abi using ZkcSecurity.Examples.Generated.Components.SmallSumcheckValidatorView.bridge

noncomputable def installation : Claims.CompiledSoundness.Installation validatorSubject :=
  Claims.CompiledSoundness.Installation.typed (Nominal.signature Scalar field)
    (Nominal.interface (G := Group) field) (by rfl) presented bridge

noncomputable def rejected (statement : Statement)
    (falseStatement : validatorSubject.FalseStatement statement) (initial : Domain.History carriers) :
    Zkc.Obligations.Derivation installation.absorb (boundedEscape (fun _ _ => price))
      (fun _ result => validatorCompiled.acceptance result ≠ some true) initial (presented statement initial) := by
  bind_subject_abi using rejectedInputs

theorem costs (statement : Statement) (initial : Domain.History carriers) :
    Typed.ChargedCostBound installation.absorb (fun _ _ => price)
      (presented statement initial) initial (budget • price) := by
  bind_subject_abi using inputCosts

def capabilities := blsCapabilities original (by decide +kernel)

def schedule : Claims.Domain.ChargeSchedule validatorSubject :=
  Claims.CompiledSoundness.uniformSchedule validatorSubject priceBound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)

theorem schedule_prices (queries : Nat) : ∀ entry ∈ schedule.entries, entry.2.value queries = price := by
  intro entry member
  exact (Claims.CompiledSoundness.uniformSchedule_prices priceBound _ _ _ queries entry member).trans
    (priceBound_value queries)

noncomputable def reductionExport (queries : Nat) :
    Claims.Domain.ChargedExport validatorSubject schedule queries (budget • price) :=
  Claims.CompiledSoundness.assembled installation price (budget • price) rejected costs
    schedule queries (schedule_prices queries)

theorem adaptive (application : String) (queries : Nat)
    (prover : OracleComp (TranscriptOracle.DomainSpec carriers) (Statement × Domain.Proof carriers))
    (bounded : IsTotalQueryBound prover queries) :
    Claims.CompiledSoundness.probability validatorSubject application prover ≤
      ((queries : ENNReal) + budget) / (Fintype.card Scalar : ENNReal) :=
  Claims.CompiledSoundness.adaptive_fraction (Fintype.card Scalar) budget
    (reductionExport queries) (schedule_prices queries) application prover bounded

