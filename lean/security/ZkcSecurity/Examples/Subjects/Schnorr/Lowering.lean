module

public import ZkcSecurity.Examples.Subjects.Schnorr.Artifacts
public import ZkcExamples.Executable.SchnorrProof

@[expose] public section

/-! Generated byte-lowering evidence. Regenerate with `lean/bridges/subject.py --write`. Static admission and actual byte-to-Domain transport are separate checked obligations. -/

namespace ZkcSecurity.Examples.Subjects.Schnorr
open ZkcSecurity.Endpoint

variable {F G : Type} [Field F] [DecidableEq F] [AddCommGroup G] [Module F G] [DecidableEq G]

/-- The exact admitted program and its actual byte-to-Domain transport. -/
def lowering : LoweringEvidence artifacts compiled F G where
  validator := ZkcExamples.Executable.SchnorrProof.validator
  program := rfl
  lowered := ZkcExamples.Executable.SchnorrProof.lowered
  accepted := ZkcExamples.Executable.SchnorrProof.accepted
  prepared := ZkcExamples.Executable.SchnorrProof.prepared
  sorted := ZkcExamples.Executable.SchnorrProof.helpersSorted
  admits statement := by
    match statement with
    | .cons value0 (.cons value1 .nil) => exact ZkcExamples.Executable.SchnorrProof.admitted value0 value1
  pruning challenge codec budget binding statement initial bytes := by
    match statement with
    | .cons value0 (.cons value1 .nil) => exact ZkcExamples.Executable.SchnorrProof.domain_prunes challenge codec budget binding value0 value1 initial bytes

end ZkcSecurity.Examples.Subjects.Schnorr
