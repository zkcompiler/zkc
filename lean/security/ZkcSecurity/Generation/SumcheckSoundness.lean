module

public import ZkcSecurity.Generation.SumcheckCompleteness
public import ZkcSecurity.Generation.SumcheckInputs

@[expose] public section

/-! Assemble complete adversarial roots from retained pair metadata and selected
mathematical formula laws. Public table candidates come from producer def-use;
the source target, all-reply derivation, exact bridge and cost are then proved.
No author supplies source offsets, round budgets, table selectors, tuple glue
or root-specific rejection scripts. Unsupported dependencies stay unresolved.
-/
set_option autoImplicit false
namespace ZkcSecurity.Generation.SumcheckSoundness
open Zkc.Source Zkc.Source.Structured Zkc.Construction

structure Output where
  moduleName : String
  subjectModule : String
  roundsModule : String
  validatorViewModule : String
  abiModule : String
  mathematicsModule : String
  formulaLaw : String
  fieldType : String
  groupType : String
  modulus : String
  sampling : String
  capabilities : String

structure Input where
  metadata : SubjectABI.Metadata
  producer : Participant
  validator : Participant
  output : Output

def source (input : Input) : Except String String := do
  let { metadata, producer, validator, output } := input
  let rounds ← RoundDescriptors.discover producer validator
  let tables ← SumcheckInputs.propose metadata producer validator
  let targetPositions ← metadata.targetPositions
  if !targetPositions.all metadata.publicPositions.contains then
    throw "soundness-assembly-private-target-requires-residual-contract"
  let publicTypes ← SubjectABI.atPositions metadata.types metadata.publicPositions
  if validator.inputs != publicTypes.map ValueSort.data ++ [.transcript metadata.suite] then
    throw "soundness-assembly-validator-interface-mismatch"
  let publicNames := metadata.publicPositions.map SubjectABI.inputName
  let binders := String.join ((publicTypes.zip publicNames).map fun (ty, name) =>
    " (" ++ name ++ " : " ++ SumcheckCompleteness.carrier ty ++ ")")
  let arguments := " ".intercalate publicNames
  let budget := toString ((rounds.map (·.validator.maximum)).sum)
  let view := output.validatorViewModule
  let subject := output.subjectModule
  let imports := [view, output.roundsModule, output.abiModule, output.mathematicsModule,
    "ZkcSecurity.Families.Sumcheck.TableComponentPrimeField",
    "ZkcSecurity.Families.Sumcheck.CompiledValidatorSoundness",
    "ZkcSecurity.Claims.CompiledSoundness"]
  let tools := ["ComponentDerivation", "ComponentCost", "TableCapacity", "TargetEvaluation"]
  let mut text := "module\n\n" ++ String.join (imports.map fun name => "public import " ++ name ++ "\n") ++
    String.join (tools.map fun name => "public meta import ZkcSecurity.Tools." ++ name ++ "\n") ++
    "\n@[expose] public section\nnoncomputable section\n\n" ++
    "/-! Generated by Generation.SumcheckSoundness from the admitted pair.\n" ++
    "Reference proposals are unchecked hints; every resulting bridge, target,\n" ++
    "rejection derivation and cost is checked. Regenerate; do not hand edit. -/\n" ++
    "set_option autoImplicit false\nset_option backward.isDefEq.respectTransparency false\n" ++
    "set_option maxRecDepth 50000\nset_option maxHeartbeats 8000000\n" ++
    "set_option linter.unusedSimpArgs false\nnamespace " ++ output.moduleName ++ "\n" ++
    "open OracleComp OracleSpec\n" ++
    "open Zkc.Source Zkc.Source.Structured Zkc.Construction Zkc.Claims\n" ++
    "open ZkcSecurity.Claims ZkcSecurity.FiatShamir ZkcSecurity.Obligations\n" ++
    "open ZkcSecurity.Families.Sumcheck ZkcSecurity.Families.Sumcheck.TableComponent\n" ++
    "open ZkcSecurity.Examples.Components ZkcSecurity.Domains.PrimeField\n" ++
    "open " ++ subject ++ "\nopen " ++ output.abiModule ++ "\n\n" ++
    "abbrev Scalar := " ++ output.fieldType ++ "\nabbrev Group := " ++ output.groupType ++ "\n" ++
    "abbrev model := subject.domainModel\nabbrev carriers := model.toCarriers\n" ++
    "abbrev field := " ++ view ++ ".field\nabbrev Statement := validatorArtifacts.Statement model\n" ++
    "local instance : DecidableEq (Domain.Event carriers) := Classical.decEq _\n" ++
    "local instance : ∀ event : Domain.Event carriers, SampleableType (Domain.Raw event) := " ++ output.sampling ++ "\n\n" ++
    "def budget : Nat := " ++ budget ++ "\n" ++
    "noncomputable def price : ENNReal := 1 / (Fintype.card Scalar : ENNReal)\n" ++
    "def priceBound : Claims.Bound := .div (.constant 1) (Fintype.card Scalar : ℚ≥0)\n" ++
    "theorem priceBound_value (queries : Nat) : priceBound.value queries = price := by\n" ++
    "  simp only [priceBound, Bound.value, ennreal_nnrat_one, ennreal_nnrat_natural, price]\n\n" ++
    "noncomputable def rejectedInputs" ++ binders ++ "\n" ++
    "    (falseStatement : validatorSubject.FalseStatement (statement " ++ arguments ++ "))\n" ++
    "    (initial : Domain.History carriers) :\n" ++
    "    Zkc.Obligations.Derivation (Nominal.interface (G := Group) field) (boundedEscape (fun _ _ => price))\n" ++
    "      (fun _ result => validatorCompiled.acceptance result ≠ some true) initial\n" ++
    "      (" ++ view ++ ".presented " ++ arguments ++ " initial) := by\n"
  let sampling := "(TableComponent.PrimeField.conditionalWithFrame " ++ output.modulus ++
    " field (CompiledValidator.frameUpdate (F := Scalar) (G := Group) field))"
  let leaves := (tables.zipIdx).map fun (position, index) =>
    "CompiledValidator.run_rejecting field " ++ output.roundsModule ++ ".round" ++ toString index ++
      ".schedule (fun _ _ => price) " ++ sampling ++ " " ++ SubjectABI.inputName position
  text := text ++ "  derive_component_rejection [" ++ ",\n    ".intercalate leaves ++ "]\n" ++
    "    unfolding [" ++ view ++ ".presented]\n" ++
    "    finishing (first\n      | (exfalso\n         apply falseStatement\n" ++
    "         refine ⟨fun _ _ => none, ?_⟩\n" ++
    "         prove_retained_target [Scalar, Group] reading (validator_application_read " ++ arguments ++ " _)\n" ++
    "           evaluating " ++ output.formulaLaw ++ " solving prove_table_capacity)\n" ++
    "      | (change some _ ≠ some true\n" ++
    "         simp (disch := tauto) only [SumcheckValidatorHelpers.terminal_rejects_at, Bool.false_and, Bool.and_false]\n" ++
    "         decide))\n\n" ++
    "theorem inputCosts" ++ binders ++ " (initial : Domain.History carriers) :\n" ++
    "    Typed.ChargedCostBound (Nominal.interface (G := Group) field) (fun _ _ => price)\n" ++
    "      (" ++ view ++ ".presented " ++ arguments ++ " initial) initial (budget • price) := by\n" ++
    "  unfold budget\n" ++
    "  derive_component_cost [CompiledValidator.run_cost _ _ (fun _ _ => price) price (fun _ _ => le_rfl)]\n" ++
    "    unfolding [" ++ view ++ ".presented]\n\n" ++
    "def presented (statement : Statement) : Domain.History carriers →\n" ++
    "    PIR.Process (Nominal.signature Scalar field) (Domain.Result carriers) :=\n" ++
    "  TypedABI.apply (Value := model.Value) (types := validatorArtifacts.publics)\n" ++
    "    (" ++ view ++ ".presented (F := Scalar) (G := Group)) statement\n\n" ++
    "theorem bridge (statement : Statement) (initial : Domain.History carriers) :\n" ++
    "    DomainReduction.Bridge (Nominal.interface (G := Group) field) (fun _ _ => True) initial\n" ++
    "      (Domain.participant model validatorCompiled.imported.program validatorCompiled.selection.context\n" ++
    "        validatorArtifacts.participant ((Domain.encodeValues statement).getD [] ++\n" ++
    "          [.transcript validatorCompiled.selection.context.suite initial]))\n" ++
    "      (presented statement initial) := by\n" ++
    "  bind_subject_abi using " ++ view ++ ".bridge\n\n" ++
    "noncomputable def installation : Claims.CompiledSoundness.Installation validatorSubject :=\n" ++
    "  Claims.CompiledSoundness.Installation.typed (Nominal.signature Scalar field)\n" ++
    "    (Nominal.interface (G := Group) field) (by rfl) presented bridge\n\n" ++
    "noncomputable def rejected (statement : Statement)\n" ++
    "    (falseStatement : validatorSubject.FalseStatement statement) (initial : Domain.History carriers) :\n" ++
    "    Zkc.Obligations.Derivation installation.absorb (boundedEscape (fun _ _ => price))\n" ++
    "      (fun _ result => validatorCompiled.acceptance result ≠ some true) initial (presented statement initial) := by\n" ++
    "  bind_subject_abi using rejectedInputs\n\n" ++
    "theorem costs (statement : Statement) (initial : Domain.History carriers) :\n" ++
    "    Typed.ChargedCostBound installation.absorb (fun _ _ => price)\n" ++
    "      (presented statement initial) initial (budget • price) := by\n" ++
    "  bind_subject_abi using inputCosts\n\n" ++
    "def capabilities := " ++ output.capabilities ++ "\n\n" ++
    "def schedule : Claims.Domain.ChargeSchedule validatorSubject :=\n" ++
    "  Claims.CompiledSoundness.uniformSchedule validatorSubject priceBound\n" ++
    "    (by decide +kernel) (by decide +kernel) (by decide +kernel)\n\n" ++
    "theorem schedule_prices (queries : Nat) : ∀ entry ∈ schedule.entries, entry.2.value queries = price := by\n" ++
    "  intro entry member\n" ++
    "  exact (Claims.CompiledSoundness.uniformSchedule_prices priceBound _ _ _ queries entry member).trans\n" ++
    "    (priceBound_value queries)\n\n" ++
    "noncomputable def reductionExport (queries : Nat) :\n" ++
    "    Claims.Domain.ChargedExport validatorSubject schedule queries (budget • price) :=\n" ++
    "  Claims.CompiledSoundness.assembled installation price (budget • price) rejected costs\n" ++
    "    schedule queries (schedule_prices queries)\n\n" ++
    "theorem adaptive (application : String) (queries : Nat)\n" ++
    "    (prover : OracleComp (TranscriptOracle.DomainSpec carriers) (Statement × Domain.Proof carriers))\n" ++
    "    (bounded : IsTotalQueryBound prover queries) :\n" ++
    "    Claims.CompiledSoundness.probability validatorSubject application prover ≤\n" ++
    "      ((queries : ENNReal) + budget) / (Fintype.card Scalar : ENNReal) :=\n" ++
    "  Claims.CompiledSoundness.adaptive_fraction (Fintype.card Scalar) budget\n" ++
    "    (reductionExport queries) (schedule_prices queries) application prover bounded\n\n" ++
    "theorem scalar_meaning (selected : Model) (adaptiveForm : selected.form = .adaptive) :\n" ++
    "    Claims.Domain.Soundness capabilities validatorSubject selected\n" ++
    "      (fun queries => ((queries : ENNReal) + budget) / (Fintype.card Scalar : ENNReal)) :=\n" ++
    "  Claims.CompiledSoundness.scalar_meaning (model := model) (art := validatorArtifacts)\n" ++
    "    (subject := validatorSubject) capabilities schedule (Fintype.card Scalar) budget\n" ++
    "    reductionExport schedule_prices selected adaptiveForm\n\n" ++
    "theorem charged_meaning (selected : Model) (adaptiveForm : selected.form = .adaptive)\n" ++
    "    (validatorCost : ∀ queries, selected.validatorCost.value queries = budget • price) :\n" ++
    "    Claims.Domain.SoundnessArguments.meaning capabilities\n" ++
    "      (⟨selected, .charged schedule⟩ : Claims.Domain.SoundnessArguments validatorSubject) :=\n" ++
    "  Claims.CompiledSoundness.charged_meaning (model := model) (art := validatorArtifacts)\n" ++
    "    (subject := validatorSubject) capabilities schedule (budget • price)\n" ++
    "    reductionExport selected adaptiveForm validatorCost\n\nend " ++ output.moduleName ++ "\n"
  pure text

end ZkcSecurity.Generation.SumcheckSoundness
