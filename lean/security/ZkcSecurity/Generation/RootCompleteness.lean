module

public import ZkcSecurity.Generation.SubjectABI

@[expose] public section

/-! Family-neutral honest-root assembly. Installed extensions supply their
mathematical method, helper laws and proof body. Source-indexed input elimination,
actual pair selection and canonical endpoint assembly are
shared. This printer establishes nothing until its generated module is checked. -/
set_option autoImplicit false
namespace ZkcSecurity.Generation.RootCompleteness
open Zkc.Source.Structured

structure Output where
  moduleName : String
  subjectModule : String
  producerModule : String
  validatorModule : String
  abiModule : String
/-- An installed method selects an existing proof relation and its canonical
consumer; the consumer's proposition is independently fixed by Claims. -/
structure Method where
  imports : List String
  metaImports : List String := []
  opens : List String := []
  description : String
  relation : String := "Readback"
  adapter : String := "Readback.perfect_abi"
  nonvacuityLaw : String
  body : String
  declarations : String := ""

def source (metadata : SubjectABI.Metadata) (output : Output) (method : Method) :
    Except String String := do
  let allNames := SubjectABI.names metadata.types
  let subject := output.subjectModule
  let imports := [subject, output.producerModule, output.validatorModule, output.abiModule] ++ method.imports
  let mut text := "module\n\n" ++ String.join (imports.eraseDups.map ("public import " ++ · ++ "\n")) ++
    String.join (method.metaImports.eraseDups.map ("public meta import " ++ · ++ "\n")) ++
    "\n@[expose] public section\nnoncomputable section\n\n" ++
    "/-! Generated by the shared Generation.RootCompleteness shell.\n" ++ method.description ++
    "\nSource ABI, whole-pair equations and the canonical endpoint are kernel\nchecked. Regenerate; do not hand edit. -/\n" ++
    "set_option autoImplicit false\nset_option backward.isDefEq.respectTransparency false\n" ++
    "set_option maxRecDepth 20000\nset_option maxHeartbeats 8000000\n" ++
    "set_option linter.unusedSimpArgs false\n" ++
    "namespace " ++ output.moduleName ++ "\n" ++
    "open Zkc.Source Zkc.Source.Structured Zkc.Construction\n" ++
    "open ZkcSecurity.Claims.HonestPair ZkcSecurity.FiatShamir\n" ++
    String.join (method.opens.map ("open " ++ · ++ "\n")) ++
    "open " ++ subject ++ " (subject)\nopen " ++ output.abiModule ++ "\n\n" ++
    method.declarations ++
    "theorem readback (values : Data) (related : subject.Relation (abi.pack values))\n" ++
    "    (honest : subject.HonestInput (abi.pack values)) :\n" ++
    "    " ++ method.relation ++ "\n" ++
    "      (fun _ result => Domain.acceptanceAt subject.selection.position result.values = some true)\n" ++
    "      (Domain.participant subject.domainModel " ++ subject ++ ".imported.program\n" ++
    "        subject.selection.context " ++ subject ++ ".selected.artifacts.producer (abi.producer values))\n" ++
    "      (Domain.participant subject.domainModel " ++ subject ++ ".imported.program\n" ++
    "        subject.selection.context " ++ subject ++ ".selected.artifacts.validator (abi.validator values)) := by\n" ++
    "  obtain " ++ (if allNames.isEmpty then "rfl" else
      "⟨" ++ ", ".intercalate (allNames ++ ["rfl"]) ++ "⟩") ++ " := data_surjective values\n"
  text := text ++ method.body ++
    "\ntheorem compiled_ideal_complete : CanonicalCompleteness subject 0 :=\n  " ++
    method.adapter ++ " subject abi " ++ method.nonvacuityLaw ++ " readback\n\n" ++
    "end " ++ output.moduleName ++ "\n"
  pure text

end ZkcSecurity.Generation.RootCompleteness
