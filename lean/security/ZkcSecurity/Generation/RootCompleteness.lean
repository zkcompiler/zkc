module

public import ZkcSecurity.Generation.SubjectABI
public import ZkcTools.StructuredSource.Root

@[expose] public section

/-! Family-neutral honest-root assembly. Installed extensions supply their
mathematical method, helper laws and proof body. Source-indexed input elimination,
actual pair selection and canonical endpoint assembly are
shared. This printer establishes nothing until its generated module is checked. -/
set_option autoImplicit false
namespace ZkcSecurity.Generation.RootCompleteness
open Zkc.Source.Structured

/-- The theorem bound and request syntax are selected together. Their agreement
is checked by the canonical claim consumer, not by a second evaluator here. -/
structure Error where
  bound : String
  expression : String

def Error.zero : Error := ⟨"0", ".natural 0"⟩

/-- Select an endpoint for an existing indexed Subject. That Subject already
associates the admitted source, actual pair, model and target; its ABI supplies
typed input elimination. Family metadata has no place in this selection. -/
structure Selection where
  moduleName : String
  subjectModule : String
  error : Error

/-- Both installed proof routes end at this independently fixed proposition. -/
def theoremSource (selection : Selection) (proof : String) : String :=
  "theorem compiled_ideal_complete : CanonicalCompleteness " ++
    selection.subjectModule ++ ".subject (" ++ selection.error.bound ++ ") :=\n  " ++ proof ++ "\n\n"

/-- Consume an installed quantitative theorem about the actual selected pair.
The sampling instance is the one selected for that Subject, as on the readback
route. In particular, this does not assert perfect completeness. -/
def directSource (selection : Selection) (proofModule proofName sampling : String)
    (opens : List String := []) : String :=
  "module\n\npublic import " ++ proofModule ++ "\npublic import " ++ selection.subjectModule ++
    "\npublic import ZkcSecurity.Claims.Completeness\n\n@[expose] public section\n\n" ++
    "/-! Generated by Generation.RootCompleteness. The selected theorem is\n" ++
    "checked against the fixed Subject and explicit completeness bound. -/\n" ++
    "set_option autoImplicit false\nnoncomputable section\nnamespace " ++ selection.moduleName ++
    "\nopen ZkcSecurity.Claims.HonestPair\nopen Zkc.Source.Structured Zkc.Construction\n" ++
    String.join (opens.map ("open " ++ · ++ "\n")) ++
    "\nlocal instance : ∀ event : Domain.Event " ++ selection.subjectModule ++ ".subject.domainModel.toCarriers,\n" ++
    "    SampleableType (Domain.Raw event) := " ++ sampling ++ "\n\n" ++
    theoremSource selection proofName ++ "end " ++ selection.moduleName ++ "\n"

structure Request where
  capabilities : String
  normalization : List String := []
  theoremNormalization : List String := []

/-- Endpoint and receipt cannot silently choose different proof modules or
default bounds. Claims still owns resolution and the full experiment. -/
def claimsOutput (selection : Selection) (request : Request) :
    ZkcTools.StructuredSource.Root.FixedCompletenessOutput where
  moduleName := selection.subjectModule ++ "CompletenessClaims"
  subjectModule := selection.subjectModule
  subjectNamespace := selection.subjectModule
  proofModule := selection.moduleName
  proofName := selection.moduleName ++ ".compiled_ideal_complete"
  errorExpression := selection.error.expression
  capabilitiesExpression := request.capabilities
  normalization := request.normalization
  theoremNormalization := request.theoremNormalization

def claimsSource (selection : Selection) (request : Request) : String :=
  ZkcTools.StructuredSource.Root.fixedCompletenessSource (claimsOutput selection request)

structure Output where
  moduleName : String
  subjectModule : String
  producerModule : String
  validatorModule : String
  abiModule : String

def Output.selection (output : Output) (error : Error) : Selection :=
  ⟨output.moduleName, output.subjectModule, error⟩
/-- An installed method selects an existing proof relation and its canonical
consumer; the consumer's proposition is independently fixed by Claims. -/
structure Method where
  imports : List String
  metaImports : List String := []
  opens : List String := []
  description : String
  error : Error := .zero
  relation : String := "Readback"
  adapter : String := "Readback.perfect_abi"
  nonvacuityLaw : String
  body : String
  declarations : String := ""

def source (metadata : SubjectABI.Metadata) (output : Output) (method : Method) :
    Except String String := do
  let allNames := SubjectABI.names metadata.types
  let subject := output.subjectModule
  let imports := [subject, output.producerModule, output.validatorModule, output.abiModule] ++ method.imports
  let mut text := "module\n\n" ++ String.join (imports.eraseDups.map ("public import " ++ · ++ "\n")) ++
    String.join (method.metaImports.eraseDups.map ("public meta import " ++ · ++ "\n")) ++
    "\n@[expose] public section\nnoncomputable section\n\n" ++
    "/-! Generated by the shared Generation.RootCompleteness shell.\n" ++ method.description ++
    "\nSource ABI, whole-pair equations and the canonical endpoint are kernel\nchecked. Regenerate; do not hand edit. -/\n" ++
    "set_option autoImplicit false\nset_option backward.isDefEq.respectTransparency false\n" ++
    "set_option maxRecDepth 20000\nset_option maxHeartbeats 8000000\n" ++
    "set_option linter.unusedSimpArgs false\n" ++
    "namespace " ++ output.moduleName ++ "\n" ++
    "open Zkc.Source Zkc.Source.Structured Zkc.Construction\n" ++
    "open ZkcSecurity.Claims.HonestPair ZkcSecurity.FiatShamir\n" ++
    String.join (method.opens.map ("open " ++ · ++ "\n")) ++
    "open " ++ subject ++ " (subject)\nopen " ++ output.abiModule ++ "\n\n" ++
    method.declarations ++
    "theorem readback (values : Data) (related : subject.Relation (abi.pack values))\n" ++
    "    (honest : subject.HonestInput (abi.pack values)) :\n" ++
    "    " ++ method.relation ++ "\n" ++
    "      (fun _ result => Domain.acceptanceAt subject.selection.position result.values = some true)\n" ++
    "      (Domain.participant subject.domainModel " ++ subject ++ ".imported.program\n" ++
    "        subject.selection.context " ++ subject ++ ".selected.artifacts.producer (abi.producer values))\n" ++
    "      (Domain.participant subject.domainModel " ++ subject ++ ".imported.program\n" ++
    "        subject.selection.context " ++ subject ++ ".selected.artifacts.validator (abi.validator values)) := by\n" ++
    "  obtain " ++ (if allNames.isEmpty then "rfl" else
      "⟨" ++ ", ".intercalate (allNames ++ ["rfl"]) ++ "⟩") ++ " := data_surjective values\n"
  text := text ++ method.body ++
    "\n" ++ theoremSource (output.selection method.error)
      (method.adapter ++ " subject abi " ++ method.nonvacuityLaw ++ " readback") ++
    "end " ++ output.moduleName ++ "\n"
  pure text

end ZkcSecurity.Generation.RootCompleteness
