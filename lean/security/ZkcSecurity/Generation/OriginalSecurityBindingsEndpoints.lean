module

public import ZkcSecurity.Generation.OriginalSecurityBindingsSource

@[expose] public section
set_option autoImplicit false
namespace ZkcSecurity.Generation.OriginalSecurityBindings
open Zkc.Source Zkc.Source.Structured Zkc.Construction
open ZkcTools.StructuredSource.Presentation

def endpointFields (program : Program) (binding : Binding) (output : Output) : Except String (List (String × String)) := do
  let parameters := (← params program binding.publicPositions).replace "List F" "List Scalar" |>.replace ": F" ": Scalar"
  let publicValues ← SubjectABI.rawEnvironment program.payload.entry.inputs binding.publicPositions
  let values := (sourceValues program binding false false).replace "some handle" "some 0"
  return [("MODULE", output.moduleName), ("S", output.moduleName ++ ".Sources"),
    ("B", output.artifactModule), ("V", output.artifactModule ++ "ValidatorRoot"),
    ("P", output.artifactModule ++ "ProducerRoot"), ("SUBJECT", output.subjectModule),
    ("ABI", output.abiModule), ("FORMULA", output.formulaNamespace),
    ("PARAMS", parameters), ("ARGS", args binding.publicPositions), ("VALUES", values),
    ("PUBLIC", publicValues), ("FIELD", output.fieldType), ("GROUP", output.groupType),
    ("BOOLEAN", toString binding.booleanRef), ("TRANSCRIPT", toString binding.transcriptRef),
    ("PRODUCERREF", toString binding.producerRef), ("PRODUCERARITY", toString binding.producerArity),
    ("MAX", toString binding.maximum), ("BUDGET", toString (binding.maximum * binding.calls.length)),
    ("SAMPLING", output.sampling), ("MODULUS", output.modulus), ("CAPABILITIES", output.capabilities)]

def installationBindings (program : Program) (binding : Binding) (output : Output) : Except String String := do
  let fields ← endpointFields program binding output
  return preamble output ".Installation" [output.moduleName ++ ".Sources", output.abiModule,
    "ZkcSecurity.FiatShamir.LosslessPresentationClaims"] ++ render fields "open %SUBJECT%\nopen %ABI%\nabbrev Scalar := %FIELD%\nabbrev Group := %GROUP%\nabbrev carriers := uniformCarriers Scalar Group\nabbrev Statement := validatorArtifacts.Statement model\n\ndef publicInputs %PARAMS% : Domain.Environment carriers := %PUBLIC%\n\ntheorem public_input_association %PARAMS% : publicInputs %ARGS% =\n    (Domain.encodeValues (statement %ARGS%)).getD [] := by kernel_rfl\n\ntheorem validator_returned : %V%.artifact.returned = [%BOOLEAN%, %TRANSCRIPT%] := by kernel_rfl\n\ntheorem selected_program : validatorCompiled.imported.program = %B%.program :=\n  Zkc.Verification.Imported.unique _ _\ntheorem selected_context : validatorCompiled.selection.context = %B%.context := by decide +kernel\ntheorem selected_artifact : validatorArtifacts.participant = %V%.artifact := by kernel_rfl\n\ndef sourceInputs %PARAMS% (history : Domain.History carriers) :=\n  Original.participant (ringModel Scalar Group) %B%.program (%B%.routing 0) 1 %VALUES% ⟨[], history⟩\nabbrev presentedInputs := %S%.presented (F := Scalar) (G := Group)\n\ndef bridgeInputs %PARAMS% (history : Domain.History carriers) :\n    Original.Bridge (Nominal.interface (G := Group) \"bls12-381.fr\") closedPost history\n      (sourceInputs %ARGS% history)\n      (Domain.participant model validatorCompiled.imported.program validatorCompiled.selection.context\n        validatorArtifacts.participant (publicInputs %ARGS% ++ [.transcript validatorCompiled.selection.context.suite history]))\n      (presentedInputs %ARGS% history)\n      (%V%.RootReturns %B%.context %BOOLEAN% %TRANSCRIPT%)\n      (fun _ frame => Zkc.Construction.ArtifactBinding.Captures (%V%.inputs %ARGS% history) frame) := by\n  rw [selected_context, selected_artifact, selected_program]\n  exact ⟨%S%.bridge %ARGS% 0 history, %V%.validator %ARGS% 0 history⟩\n\ndef source (statement : Statement) :=\n  TypedABI.apply (Value := model.Value) (types := validatorArtifacts.publics) sourceInputs statement\ndef presented (statement : Statement) :=\n  TypedABI.apply (Value := model.Value) (types := validatorArtifacts.publics) presentedInputs statement\n\ndef installation : Original.Claims.Installation validatorSubject where\n  result := Result (F := Scalar) (G := Group)\n  signature := Nominal.signature Scalar \"bls12-381.fr\"\n  absorb := Nominal.interface (G := Group) \"bls12-381.fr\"\n  inputs statement := (Domain.encodeValues statement).getD []\n  encoded statement := Domain.encodeValues_getD statement (by rfl)\n  source := source\n  presented := presented\n  Post := closedPost\n  returns := %V%.RootReturns %B%.context %BOOLEAN% %TRANSCRIPT%\n  live statement history _ frame := Zkc.Construction.ArtifactBinding.Captures\n    ((Domain.encodeValues statement).getD [] ++ [.transcript validatorCompiled.selection.context.suite history]) frame\n  acceptance := acceptance\n  bridge := by bind_subject_abi using bridgeInputs\n  agrees := root_acceptance validatorCompiled %B%.context %BOOLEAN% %TRANSCRIPT% rfl\n\nend %MODULE%.Installation\n"

def soundnessBindings (program : Program) (binding : Binding) (output : Output) : Except String String := do
  let mut fields ← endpointFields program binding output
  let rejection := if binding.conjunction.isSome then "twoRoots_rejected" else "root_rejected"
  let assumptions := if binding.conjunction.isSome then
    "  intro ⟨⟨bounded0, shape0, equal0⟩, ⟨bounded1, shape1, equal1⟩⟩\n"
    else "  intro bounded0 shape0 equal0\n"
  let cost := (if binding.conjunction.isSome then "twoRoots_cost" else "root_cost") ++
    " price (fun _ _ => le_rfl) " ++ toString binding.maximum ++ " " ++
    String.intercalate " " (binding.calls.map fun call => output.moduleName ++ ".Sources.schedule" ++ toString call.occurrence) ++ " " ++
    args (binding.calls.map (·.raw) ++ binding.calls.map (·.claim)) ++ " " ++ input binding.count ++ " ⟨[], initial⟩ initial"
  let equations := String.intercalate ", " (binding.calls.map fun call => "equal" ++ toString call.occurrence)
  fields := fields ++ [("REJECTION", rejection), ("ASSUMPTIONS", assumptions), ("COST", cost), ("EQUATIONS", equations)]
  return preamble output ".Soundness" ["ZkcSecurity.Families.Sumcheck.TableComponentPrimeField", output.moduleName ++ ".Installation", output.formulaNamespace.toName.getPrefix.toString ++ "Formula"] ++ render fields "open Zkc.Claims OracleComp OracleSpec\nopen ZkcSecurity.Claims ZkcSecurity.Obligations ZkcSecurity.Domains.PrimeField\nopen %SUBJECT%\nopen %ABI%\nopen %MODULE%.Installation\nabbrev Scalar := %FIELD%\nabbrev Group := %GROUP%\nabbrev carriers := uniformCarriers Scalar Group\nabbrev Statement := validatorArtifacts.Statement model\nlocal instance : DecidableEq (Domain.Event carriers) := Classical.decEq _\nlocal instance : ∀ event : Domain.Event carriers, SampleableType (Domain.Raw event) := %SAMPLING%\n\ndef budget : Nat := %BUDGET%\ndef price : ENNReal := 1 / (Fintype.card Scalar : ENNReal)\n\n/-- The formula is an explicit mathematical selection. This implication is\nchecked against the unchanged retained target, separately from the ABI. -/\ndef rejectedInputs %PARAMS%\n    (falseStatement : validatorSubject.FalseStatement (statement %ARGS%))\n    (initial : Domain.History carriers) :\n    Zkc.Obligations.Derivation (Nominal.interface (G := Group) \"bls12-381.fr\")\n      (boundedEscape (fun _ _ => price)) (fun _ result => acceptance result ≠ some true) initial\n      (presentedInputs %ARGS% initial) := by\n  apply %REJECTION%\n    (PrimeField.conditionalWithFrame %MODULUS% \"bls12-381.fr\"\n      (TableComponent.Execution.frameUpdate (F := Scalar) (G := Group) \"bls12-381.fr\"))\n%ASSUMPTIONS%  apply falseStatement\n  refine ⟨fun _ _ => none, ?_⟩\n  prove_retained_target [Scalar, Group] reading (validator_application_read %ARGS% _)\n    evaluating %FORMULA%.equation solving (first | assumption | simp [%EQUATIONS%])\n\ntheorem inputCosts %PARAMS% (initial : Domain.History carriers) :\n    Typed.ChargedCostBound (Nominal.interface (G := Group) \"bls12-381.fr\") (fun _ _ => price)\n      (presentedInputs %ARGS% initial) initial (budget • price) :=\n  %COST%\n\ndef rejected (statement : Statement) (falseStatement : validatorSubject.FalseStatement statement)\n    (initial : Domain.History carriers) :\n    Zkc.Obligations.Derivation installation.absorb (boundedEscape (fun _ _ => price))\n      (fun _ result => installation.acceptance result ≠ some true) initial\n      (installation.presented statement initial) := by bind_subject_abi using rejectedInputs\n\ntheorem costs (statement : Statement) (initial : Domain.History carriers) :\n    Typed.ChargedCostBound installation.absorb (fun _ _ => price)\n      (installation.presented statement initial) initial (budget • price) := by bind_subject_abi using inputCosts\n\ndef capabilities := %CAPABILITIES%\ndef priceBound : Claims.Bound := .div (.constant 1) (Fintype.card Scalar : ℚ≥0)\ntheorem priceBound_value (queries : Nat) : priceBound.value queries = price := by\n  simp only [priceBound, Bound.value, ennreal_nnrat_one, ennreal_nnrat_natural, price]\ndef schedule : Claims.Domain.ChargeSchedule validatorSubject :=\n  Claims.CompiledSoundness.uniformSchedule validatorSubject priceBound\n    (by decide +kernel) (by decide +kernel)\ntheorem schedule_prices (queries : Nat) : ∀ entry ∈ schedule.entries, entry.2.value queries = price := by\n  intro entry member\n  exact (Claims.CompiledSoundness.uniformSchedule_prices priceBound _ _ queries entry member).trans (priceBound_value queries)\n\ndef reductionExport (queries : Nat) :\n    Claims.Domain.ChargedExport validatorSubject schedule queries (budget • price) :=\n  installation.losslessChargedExport (Nominal.lossless \"bls12-381.fr\") schedule queries (budget • price)\n    (by rw [Claims.CompiledSoundness.charge_constant schedule queries price (by decide +kernel) (schedule_prices queries)]; exact rejected)\n    (by rw [Claims.CompiledSoundness.charge_constant schedule queries price (by decide +kernel) (schedule_prices queries)]; exact costs)\n\n/-- The installed degree-one method owns its cost and scalar conversion. -/\ndef validatorCost (_queries : Nat) : ENNReal := budget • price\ndef scalarBound : Nat → ENNReal := fun queries =>\n  ((queries : ENNReal) + budget) / (Fintype.card Scalar : ENNReal)\ntheorem scalar_bound (queries : Nat) :\n    (queries : ENNReal) * schedule.maximum queries + validatorCost queries ≤ scalarBound queries := by\n  rw [Claims.CompiledSoundness.maximum_constant schedule queries price (by decide +kernel) (schedule_prices queries)]\n  simp only [validatorCost, scalarBound, price, nsmul_eq_mul, div_eq_mul_inv, one_mul, add_mul]\n  exact le_rfl\n\ntheorem scalar_meaning (selected : Model) (adaptiveForm : selected.form = .adaptive) :\n    Claims.Domain.Soundness capabilities validatorSubject selected\n      (fun queries => scalarBound queries) :=\n  Claims.CompiledSoundness.scalar_meaning (model := model) (art := validatorArtifacts)\n    (subject := validatorSubject) capabilities schedule validatorCost scalarBound\n    reductionExport scalar_bound selected adaptiveForm\n\ntheorem charged_meaning (selected : Model) (adaptiveForm : selected.form = .adaptive)\n    (costLaw : ∀ queries, selected.validatorCost.value queries = validatorCost queries) :\n    Claims.Domain.SoundnessArguments.meaning capabilities\n      (⟨selected, .charged schedule⟩ : Claims.Domain.SoundnessArguments validatorSubject) :=\n  Claims.CompiledSoundness.charged_meaning (model := model) (art := validatorArtifacts)\n    (subject := validatorSubject) capabilities schedule validatorCost\n    reductionExport selected adaptiveForm costLaw\n\nend %MODULE%.Soundness\n"

end ZkcSecurity.Generation.OriginalSecurityBindings
