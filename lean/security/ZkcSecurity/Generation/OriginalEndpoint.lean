module

public import ZkcSecurity.Generation.SubjectABI

@[expose] public section

/-! Adversarial endpoint generation for installed original-source laws. Structural
metadata comes from the admitted ABI and artifact. The selected full-result
export remains a checked proof input, not inferred evidence.
The upstream structural bindings are generated from admitted source and the
actual artifact; registered formula mathematics stays authored. -/
set_option autoImplicit false
namespace ZkcSecurity.Generation.OriginalEndpoint
open Zkc.Source Zkc.Source.Structured Zkc.Construction

mutual
  /-- A conservative syntactic challenge budget, including nested bounded
  loops. Its use in an endpoint must agree with the installed checked law. -/
  def maximumCharges : List Zkc.Construction.Instruction → Nat
    | [] => 0
    | instruction :: rest => instructionCharges instruction + maximumCharges rest
  def instructionCharges : Zkc.Construction.Instruction → Nat
    | ⟨.loop _ maximum _, _, _, body⟩ => maximum * maximumCharges body
    | ⟨.challenge _ _ _, _, _, body⟩ => 1 + maximumCharges body
    | ⟨_, _, _, body⟩ => maximumCharges body
end

structure Output where
  moduleName : String
  subjectModule : String
  fieldType : String
  groupType : String
  sampling : String
  capabilities : String
  soundnessNamespace : String

def soundnessSource (metadata : SubjectABI.Metadata) (validator : Participant)
    (output : Output) : Except String String := do
  let targets ← metadata.targetPositions
  unless targets.all metadata.publicPositions.contains do
    throw "original-endpoint-private-target-requires-residual-contract"
  let publics ← SubjectABI.atPositions metadata.types metadata.publicPositions
  unless validator.inputs == publics.map ValueSort.data ++ [.transcript metadata.suite] do
    throw "original-endpoint-validator-interface-mismatch"
  let budget := maximumCharges validator.instructions
  if budget == 0 then throw "original-endpoint-no-challenges"
  let law := output.soundnessNamespace
  return "module\n\n" ++
    "public import " ++ output.soundnessNamespace ++ "\n" ++
    "public import " ++ output.subjectModule ++ "\n\n" ++
    "@[expose] public section\nnoncomputable section\n\n" ++
    "/-! Generated by Generation.OriginalEndpoint. The installed original-source\n" ++
    "law supplies the full ordinary ChargedExport for every typed statement.\n" ++
    "Budgets and sites come from the admitted artifact and subject.\n" ++
    "The upstream source and installation equations are generated and checked. -/\n" ++
    "set_option autoImplicit false\nset_option maxRecDepth 50000\n" ++
    "set_option maxHeartbeats 8000000\n" ++
    "namespace " ++ output.moduleName ++ "\n" ++
    "open OracleComp OracleSpec\nopen Zkc.Source Zkc.Source.Structured Zkc.Construction\n" ++
    "open ZkcSecurity.Claims ZkcSecurity.FiatShamir ZkcSecurity.Obligations\n" ++
    "open ZkcSecurity.Domains.PrimeField\nopen " ++ output.subjectModule ++ "\n\n" ++
    "abbrev Scalar := " ++ output.fieldType ++ "\nabbrev Group := " ++ output.groupType ++ "\n" ++
    "abbrev model := subject.domainModel\nabbrev carriers := model.toCarriers\n" ++
    "abbrev Statement := validatorArtifacts.Statement model\n" ++
    "local instance : DecidableEq (Domain.Event carriers) := Classical.decEq _\n" ++
    "local instance : ∀ event : Domain.Event carriers, SampleableType (Domain.Raw event) := " ++ output.sampling ++ "\n\n" ++
    "def budget : Nat := " ++ toString budget ++ "\n" ++
    "def price : ENNReal := 1 / (Fintype.card Scalar : ENNReal)\n" ++
    "def priceBound : Claims.Bound := .div (.constant 1) (Fintype.card Scalar : ℚ≥0)\n" ++
    "theorem priceBound_value (queries : Nat) : priceBound.value queries = price := by\n" ++
    "  simp only [priceBound, Bound.value, ennreal_nnrat_one, ennreal_nnrat_natural, price]\n\n" ++
    "def capabilities := " ++ output.capabilities ++ "\n\n" ++
    "def schedule : Claims.Domain.ChargeSchedule validatorSubject :=\n" ++
    "  Claims.CompiledSoundness.uniformSchedule validatorSubject priceBound\n" ++
    "    (by decide +kernel) (by decide +kernel) (by decide +kernel)\n\n" ++
    "theorem schedule_prices (queries : Nat) :\n" ++
    "    ∀ entry ∈ schedule.entries, entry.2.value queries = price := by\n" ++
    "  intro entry member\n" ++
    "  exact (Claims.CompiledSoundness.uniformSchedule_prices priceBound _ _ _ queries entry member).trans\n" ++
    "    (priceBound_value queries)\n\n" ++
    "def reductionExport (queries : Nat) :\n" ++
    "    Claims.Domain.ChargedExport validatorSubject schedule queries (budget • price) :=\n" ++
    "  " ++ law ++ ".reductionExport queries\n\n" ++
    "theorem adaptive (application : String) (queries : Nat)\n" ++
    "    (prover : OracleComp (TranscriptOracle.DomainSpec carriers) (Statement × Domain.Proof carriers))\n" ++
    "    (bounded : IsTotalQueryBound prover queries) :\n" ++
    "    Claims.CompiledSoundness.probability validatorSubject application prover ≤\n" ++
    "      ((queries : ENNReal) + budget) / (Fintype.card Scalar : ENNReal) :=\n" ++
    "  Claims.CompiledSoundness.adaptive_fraction (Fintype.card Scalar) budget\n" ++
    "    (reductionExport queries) (schedule_prices queries) application prover bounded\n\n" ++
    "theorem scalar_meaning (selected : Model) (adaptiveForm : selected.form = .adaptive) :\n" ++
    "    Claims.Domain.Soundness capabilities validatorSubject selected\n" ++
    "      (fun queries => ((queries : ENNReal) + budget) / (Fintype.card Scalar : ENNReal)) :=\n" ++
    "  Claims.CompiledSoundness.scalar_meaning (model := model) (art := validatorArtifacts)\n" ++
    "    (subject := validatorSubject) capabilities schedule (Fintype.card Scalar) budget\n" ++
    "    reductionExport schedule_prices selected adaptiveForm\n\n" ++
    "theorem charged_meaning (selected : Model) (adaptiveForm : selected.form = .adaptive)\n" ++
    "    (validatorCost : ∀ queries, selected.validatorCost.value queries = budget • price) :\n" ++
    "    Claims.Domain.SoundnessArguments.meaning capabilities\n" ++
    "      (⟨selected, .charged schedule⟩ : Claims.Domain.SoundnessArguments validatorSubject) :=\n" ++
    "  Claims.CompiledSoundness.charged_meaning (model := model) (art := validatorArtifacts)\n" ++
    "    (subject := validatorSubject) capabilities schedule (budget • price)\n" ++
    "    reductionExport selected adaptiveForm validatorCost\n\nend " ++ output.moduleName ++ "\n"

end ZkcSecurity.Generation.OriginalEndpoint
