import Lean.Elab.Command
import Zkc.Tests.Core.Files
import Zkc.Core.Link
import Zkc.Core.Package
import Zkc.Tools.Core.PrintLinked
import Zkc.Tests.Core.Reflexivity

/-! Printed links, generated by the check that needs them.

`core-tool literal` prints the links of a package as Lean source, and the kernel checks
them when that source is elaborated. The printed source is output of the tool and is not
kept in the repository. `printed_package Name from file "<package.json>"` runs, inside
Lean, what the tool command runs with the setting `parts=0` (every other setting at its
default): the reader, `elaborateWritten` and the printer. `in pieces of n` after the path sets
the number of instructions of a piece of a long body, so that the pieces of a body whose
iterations are written out can be its iterations. It then elaborates the printed
declarations in the namespace that the tool's file would open, under the options and the
`open` of the tool's file header, inside a section that ends with them.

The modules the printed file imports are imported here. -/

set_option autoImplicit false

open Lean Elab Command

namespace Zkc.Core.Printed

/-- The declarations of a printed package, in the order of the file the tool writes when
the definitions are not divided over parts. -/
def declarations (source : PrintLinked.Source) : Array String :=
  let definitions := source.functions ++ source.protocols
  source.prelude ++ (definitions.flatMap (·.units)).flatMap id ++
    definitions.flatMap (·.closing) ++ source.assembly

/-- The printed file without its imports, inside a section. -/
def text (namespaceName : String) (source : PrintLinked.Source) : String :=
  "section\nset_option autoImplicit false\nset_option maxRecDepth 1000000\n" ++
    "open Zkc.Source Zkc.Core Zkc.Core.Raw\n" ++ s!"namespace {namespaceName}\n\n" ++
    String.join ((declarations source).toList.map (· ++ "\n\n")) ++
    s!"end {namespaceName}\nend\n"

/-- Parse and elaborate the commands of a source text, one after another. -/
def elaborateText (name : String) (source : String) : CommandElabM Unit := do
  let input := Parser.mkInputContext source s!"<printed {name}>"
  let mut state : Parser.ModuleParserState := {}
  repeat
    let scope ← getScope
    let context : Parser.ParserModuleContext :=
      { env := ← getEnv, options := scope.opts, currNamespace := scope.currNamespace,
        openDecls := scope.openDecls }
    let (command, next, messages) := Parser.parseCommand input context state {}
    state := next
    if messages.hasErrors then
      for message in messages.toList do
        logMessage message
      throwError "the printed source of {name} does not parse"
    if Parser.isTerminalCommand command then
      break
    elabCommand command

/-- Print the links of a typed package with its raw package and elaborate them. A long body
is printed in pieces of the given number of instructions. -/
def elaboratePrinted (name : Lean.Name) (typed : Typed) (raw : Raw.Package)
    (piece : Nat := ({} : PrintLinked.Options).piece) : CommandElabM Unit :=
  let source := PrintLinked.printPackage { parts := 0, piece } typed raw
  elaborateText name.toString (text name.toString source)

syntax (name := printedPackage)
  "printed_package " ident " from " &"file " str (" in " &"pieces " &"of " num)? : command

elab_rules : command
  | `(printed_package $name:ident from file $path:str $[in pieces of $piece:num]?) => do
      let source ← IO.FS.readFile (← liftCoreM (packagePath path.getString))
      let raw ← match Raw.parsePackage source with
        | .ok raw => pure raw
        | .error message => throwError "refused package: {message}"
      let typed ← match elaborateWritten raw with
        | .ok typed => pure typed
        | .error refusal => throwError "refused package: {repr refusal}"
      match piece with
      | some piece => elaboratePrinted name.getId typed raw piece.getNat
      | none => elaboratePrinted name.getId typed raw

end Zkc.Core.Printed
