module

public import Lean
public import Lean.Meta.Constructions.CtorIdx

@[expose] public section

/-! Recognition of Lean-generated native constructor indices. This is tied to the pinned
compiler, not an extensible allowlist. Any mismatch or Meta error fails closed. Matching
expressions establishes the generated form, not the correctness of the native compiler or
runtime. The logical definition is still subject to the audit's independent kernel replay. -/

set_option autoImplicit false
namespace Zkc.Tools.Audit
open Lean Meta

/-- Recognize the exact two definitions generated by Lean 4.36 for a constructor index.
This classifies compiler-generated native code; it does not prove the native compiler correct. -/
def isConstructorIndexImplementation (env : Environment) (name implementation : Name) : IO Bool := do
  try
    let (recognized, _, _) ← (do
      let some info := isCtorIdxCore? (← getEnv) name | return false
      if info.numCtors == 1 || implementation != Name.str name "_impl" then return false
      if Compiler.LCNF.isRuntimeBuiltinType info.name then return false
      let .defnInfo source ← getConstInfo name | return false
      let .defnInfo native ← getConstInfo implementation | return false
      if source.safety != .safe || native.safety != .unsafe then return false
      if source.levelParams != info.levelParams || native.levelParams != info.levelParams then
        return false
      if source.type != native.type then return false
      if isExtern env name || isExtern env implementation then return false
      if (Compiler.getImplementedBy? env implementation).isSome then return false
      let us := info.levelParams.map mkLevelParam
      let (expectedType, expectedValue) ← forallBoundedTelescope info.type (info.numParams + info.numIndices) fun xs _ =>
        withImplicitBinderInfos xs do
          let params : Array Expr := xs[:info.numParams]
          let indices : Array Expr := xs[info.numParams:]
          let indType := mkAppN (mkConst info.name us) xs
          let value ← withLocalDeclD `x indType fun x => do
            let motive ← mkLambdaFVars (indices.push x) (mkConst ``Nat)
            let mut value := mkConst (mkCasesOnName info.name) (Level.one :: us)
            value := mkAppN value params
            value := mkApp value motive
            value := mkAppN value indices
            value := mkApp value x
            for ctor in info.ctors do
              let ctorInfo ← getConstInfoCtor ctor
              let ctorType ← instantiateForall ctorInfo.type params
              let alt ← forallBoundedTelescope ctorType ctorInfo.numFields fun ys _ =>
                mkLambdaFVars ys (mkRawNatLit ctorInfo.cidx)
              value := mkApp value alt
            return ← mkLambdaFVars #[x] value
          let expectedType ← mkForallFVars xs (← mkArrow indType (mkConst ``Nat))
          return (expectedType, ← mkLambdaFVars xs value)
      if source.type != expectedType || source.value != expectedValue then return false
      let expectedNative ← forallTelescope source.type fun args _ => do
        if args.isEmpty then throwError "constructor index has no argument"
        let discr := args[args.size - 1]!
        let indType ← inferType discr
        let body := mkApp2 (mkConst ``getObjTagNat [← getLevel indType]) indType discr
        mkLambdaFVars args body
      return native.value == expectedNative : MetaM Bool).toIO
        { fileName := "<constructor-index-audit>", fileMap := default } { env }
    return recognized
  catch _ => return false

end Zkc.Tools.Audit
