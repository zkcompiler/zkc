module example;
use sums::{TwoSums};
domain F = field("bls12-381.fr");

proof Proof = TwoSums<F,4> {
  prover P;
  verifier V;
  public { left, right, left_sum, right_sum, rounds };
  accept accepted;
  construction fiat_shamir("merlin3.bls12-381.fr64be/0", challenges);
}
entry fn Interactive(inputs: TwoSums<F,4>::Inputs) {
  return TwoSums<F,4>::run(inputs);
}

// Partial reductions are reusable protocols. Their pending residual must be
// consumed by a caller before returning through an Entry.
