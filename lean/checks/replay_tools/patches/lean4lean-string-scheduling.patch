+/-- Install implicit literal dependencies before traversing ordinary dependencies.
+`pending` means scheduled, not installed; a prerequisite still pending here is a cycle.
+The readiness flag is set only after both declarations have passed normal kernel checking. -/
+partial def replayStringPrimitives : M Unit := do
+  for name in [``Char.ofNat, ``String.ofList] do
+    if ((← get).env.constants.find? name).isNone then
+      if (← get).pending.contains name then
+        throw <| IO.userError s!"Cyclic string literal prerequisite: {name}"
+      unless (← get).remaining.contains name do
+        throw <| IO.userError s!"Unavailable string literal prerequisite: {name}"
+      replayConstant name
+      unless ((← get).env.constants.find? name).isSome do
+        throw <| IO.userError s!"String literal prerequisite not installed: {name}"
+  modify fun s => { s with hasStrings := true }
+
 end
 
