module

public import ZkcTools.StructuredSource.Constructed
public import Zkc.Construction.DomainProducer

@[expose] public section

/-! Common syntax printing for source/artifact root connections. The selection
contains declaration names only. Source-owned input coordinates determine
internal capability labels. It contains no
process equation, family theorem, proof script or protocol-specific layout.
Generated roots are checked by the shared finite connection engine. Security
packages may consume them without changing this probability-free frontend. -/
set_option autoImplicit false
namespace ZkcTools.ConstructionBindings.Generate
open Lean Zkc.Construction

/-- Source admission and capability associations retain their existing owners.
The exported validator supplies its checked context, without a separate
authored context declaration. The generated RootCertificates check semantic
correspondence to actual artifact instructions; they do not replace artifact-envelope admission. -/
structure Selection where
  sourceModule : Name
  program : Name

/-- A soundness-only client may select one role; an honest-pair client selects
both. The validator artifact fixes the shared exported context; producer-only
selections are refused rather than given a guessed context. -/
structure ParticipantSelection where
  mode : Domain.Mode
  artifactModule : Name
  artifact : Name
  viewModule : Name

structure Output where
  moduleName : Name
  participants : List ParticipantSelection

def roleName : Domain.Mode → String
  | .producer => "producer"
  | .validator => "validator"

/-- Print one role through the same engine and complete fixed return relation. -/
def roleSource (label : String) (mode : Domain.Mode) (viewModule : Name) : String :=
  let modeName := roleName mode
  "def " ++ label ++ "Routing : Original.Routing :=\n" ++
  "  ConnectionRootRoutes.routing program.snapshot context ." ++ modeName ++ " capabilities\n" ++
  "    " ++ label ++ "Artifact (by decide +kernel)\n\n" ++
  "def " ++ label ++ " : RootCertificate program " ++ label ++ "Routing context." ++ modeName ++
  " " ++ label ++ "Artifact := by\n" ++
  "  derive_root_connection_with_library\n" ++
  "    target (fun model => " ++ viewModule.toString ++ ".body model program context)\n" ++
  "    correspondence (fun model => " ++ viewModule.toString ++ ".body_eq model program context)\n" ++
  "    services capabilities library sourceLibrary\n\n" ++
  "def " ++ label ++ "Facts := " ++ label ++ ".facts\n\n" ++
  "theorem " ++ label ++ "Connected : SourceConnection.Connected program " ++ label ++
    "Routing context." ++ modeName ++ " " ++ label ++ ".inputs.abi " ++ label ++ "Artifact :=\n" ++
  "  SourceConnection.ofRootCertificate " ++ label ++ " (by rfl)\n\n"

/-- One declaration selection feeds every requested role. Mathematical claims
and source-output selection stay with their own property consumers. -/
def source (selection : Selection) (output : Output) : Except String String := do
  unless !output.participants.isEmpty do throw "connection-output-empty"
  unless (output.participants.map (roleName ∘ (·.mode))).Nodup do
    throw "connection-output-duplicate-role"
  let some validator := output.participants.find? (fun participant =>
    match participant.mode with | .validator => true | .producer => false)
    | throw "connection-validator-context-required"
  let imports := ([`ZkcTools.ConstructionBindings.Root, `Zkc.Construction.ConnectionRootRoutes,
    `Zkc.Construction.ConnectionRouteCoverageRoot, `Zkc.Construction.ConnectionCertificateAdmission,
    selection.sourceModule] ++ output.participants.map (·.viewModule)).eraseDups
  let header := "module\n\n" ++ String.join (imports.map fun name =>
    "public import " ++ name.toString ++ "\n") ++ "\n@[expose] public section\n\n" ++
    "/-! Generated by ZkcTools.ConstructionBindings.Generate. Regenerate; do not hand edit.\n" ++
    "Selected roles use the same admitted source and the shared finite connection theorem.\n" ++
    "This is correspondence evidence; property meanings and proofs are separate. -/\n" ++
    "set_option autoImplicit false\nset_option maxRecDepth 50000\n" ++
    "set_option maxHeartbeats 16000000\nnoncomputable section\n" ++
    "namespace " ++ output.moduleName.toString ++ "\n" ++
    "open Zkc.Source Zkc.Source.Structured Zkc.Construction ConnectionRoot\n" ++
    "open ZkcTools.ConstructionBindings\n\n" ++
    "abbrev program := " ++ selection.program.toString ++ "\n" ++
    "def context : Context :=\n" ++
    "  (exportContext program.snapshot " ++ validator.viewModule.toString ++
      ".artifact).get (by decide +kernel)\n\n" ++
    "def sourceLibrary : ConnectionLibrary.Bundle program.payload := by\n" ++
    "  derive_connection_library roles [" ++ String.intercalate ", "
      (output.participants.map fun participant => "context." ++ roleName participant.mode) ++ "]\n\n" ++
    "def capabilities : List (Nat × Nat) := ConnectionRootInputs.serviceCapabilities program.payload.entry.inputs\n\n"
  let roles := String.join (output.participants.map fun participant =>
    let label := roleName participant.mode
    "abbrev " ++ label ++ "Artifact := " ++ participant.viewModule.toString ++ ".artifact\n\n" ++
    roleSource label participant.mode participant.viewModule)
  return header ++ roles ++ "end " ++ output.moduleName.toString ++ "\n"

/-- Use the existing constructed-view printer; no second artifact walker is
introduced by connection generation. Each supplied artifact's generated terms
are checked against its named declaration in the destination module. -/
def bundle (selection : Selection) (moduleName : Name)
    (participants : List (ParticipantSelection × Participant)) : Except String (List (Name × String)) := do
  let connection ← source selection ⟨moduleName, participants.map Prod.fst⟩
  let views ← participants.mapM fun (selected, artifact) => do
    let view ← ZkcTools.StructuredSource.Constructed.source artifact
      ⟨selected.viewModule.toString, selected.artifactModule.toString, selected.artifact.toString⟩
    return (selected.viewModule, view)
  return views ++ [(moduleName, connection)]

/-- Core and security catalogues select declarations; this common writer owns
file placement and refuses every invalid selection before writing that file. -/
def write (directory : System.FilePath) (selections : List (Selection × Output)) : IO Unit := do
  for (selection, output) in selections do
    let .ok text := source selection output
      | throw (IO.userError s!"connection selection refused: {output.moduleName}")
    let path := directory / (output.moduleName.toString.replace "." "/" ++ ".lean")
    IO.FS.createDirAll path.parent.get!
    IO.FS.writeFile path text

end ZkcTools.ConstructionBindings.Generate
