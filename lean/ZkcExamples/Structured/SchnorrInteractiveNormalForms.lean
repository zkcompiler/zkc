module

public import ZkcExamples.Structured.SchnorrInteractive
public import Zkc.Source.Structured.ReplyScript
public import Zkc.Source.Structured.ContractExecution
public import Zkc.Source.Structured.ContractElaboration
public import Zkc.Source.Structured.ContractObligations
public import Mathlib.Algebra.Field.Basic
public import Mathlib.Algebra.Module.Defs

@[expose] public section

/-! Participant normal forms, generated by `lean/bridges/structured/normal_forms.py`
from `lean/bridges/structured/normal-forms/schnorr-interactive.toml` and the retained unit
`lean/bridges/structured/fixtures/schnorr-interactive.json`.
Regenerate after the unit or the request changes; do not edit by hand. Every
definition and equation below is checked by the kernel. -/
namespace ZkcExamples.Structured.SchnorrInteractiveNormalForms
open Zkc.Source Zkc.Source.Structured SchnorrInteractive

set_option smartUnfolding false
/-! Action sites of the root, named from their source labels. -/
def nonceSite : String := "s0"
def commitmentSite : String := "label_636f6d6d69746d656e74_0"
def challengeSite : String := "label_6368616c6c656e6765"
def deliverySite : String := "label_64656c6976657279_0"
def responseSite : String := "label_726573706f6e7365_0"

variable {F G : Type} [Field F] [DecidableEq F] [AddCommGroup G] [Module F G] [DecidableEq G]

/-- The prover's own inputs, in port order; the others are absent. -/
def proverInputs (base key : G) (witness : F) (nonces : Nat) :
    Values (Component (assignment F G)) program.payload.entry.inputs :=
  .cons (some base) (.cons (some key) (.cons (some witness) (.cons (some nonces) (.cons none .nil))))

/-- The prover's normal form: its ordered actions and its returned tuple. -/
def proverProcess (base : G) (witness : F) (nonces : Nat) :
    PIR.Process (participantInterface F G)
      (Values (Component (assignment F G)) program.payload.entry.outputs) :=
  .call (.query nonceSite scalarDomain (.cons nonces .nil)) fun (nonce : F) =>
  .call (.send (ty := .group groupDomain) commitmentSite 1 (nonce • base)) fun _ =>
  .call (.receive (.field scalarDomain) deliverySite 1) fun (delivery : F) =>
  .call (.send (ty := .field scalarDomain) responseSite 1 (nonce + (delivery * witness))) fun _ =>
  .done (.cons none .nil)

theorem prover_process (base key : G) (witness : F) (nonces : Nat) :
    program.participant F G 0 (proverInputs base key witness nonces) =
      proverProcess base witness nonces := by
  kernel_rfl

/-- The replies of one prover run: received values by type and site, and
drawn values by site. Other requests are refused. -/
def proverReplies (nonce delivery : F) : ReplyScript F G where
  receive
    | .field _, site => if site = deliverySite then some delivery else none
    | _, _ => none
  draw site := if site = nonceSite then some nonce else none

/-- The prover's run on those replies: its outcome and its ordered actions. -/
theorem prover_run (base key : G) (witness : F) (nonces : Nat) (nonce delivery : F) :
    (proverReplies nonce delivery).run (program.participant F G 0 (proverInputs base key witness nonces)) =
      ⟨.returned (.cons none .nil), (),
        [.query nonceSite scalarDomain (.cons nonces .nil),
         .send (ty := .group groupDomain) commitmentSite 1 (nonce • base),
         .receive (.field scalarDomain) deliverySite 1,
         .send (ty := .field scalarDomain) responseSite 1 (nonce + (delivery * witness))]⟩ := by
  rw [prover_process]
  rfl

/-- The verifier's own inputs, in port order; the others are absent. -/
def verifierInputs (base key : G) (challenges : Nat) :
    Values (Component (assignment F G)) program.payload.entry.inputs :=
  .cons (some base) (.cons (some key) (.cons none (.cons none (.cons (some challenges) .nil))))

/-- The verifier's normal form: its ordered actions and its returned tuple. -/
def verifierProcess (base key : G) (challenges : Nat) :
    PIR.Process (participantInterface F G)
      (Values (Component (assignment F G)) program.payload.entry.outputs) :=
  .call (.receive (.group groupDomain) commitmentSite 0) fun (commitment : G) =>
  .call (.query challengeSite scalarDomain (.cons challenges .nil)) fun (challenge : F) =>
  .call (.send (ty := .field scalarDomain) deliverySite 0 challenge) fun _ =>
  .call (.receive (.field scalarDomain) responseSite 0) fun (response : F) =>
  .done (.cons (some (decide (response • base = commitment + (challenge • key)))) .nil)

theorem verifier_process (base key : G) (challenges : Nat) :
    program.participant F G 1 (verifierInputs base key challenges) =
      verifierProcess base key challenges := by
  kernel_rfl

/-- The replies of one verifier run: received values by type and site, and
drawn values by site. Other requests are refused. -/
def verifierReplies (commitment : G) (challenge response : F) : ReplyScript F G where
  receive
    | .group _, site => if site = commitmentSite then some commitment else none
    | .field _, site => if site = responseSite then some response else none
    | _, _ => none
  draw site := if site = challengeSite then some challenge else none

/-- The verifier's run on those replies: its outcome and its ordered actions. -/
theorem verifier_run (base key : G) (challenges : Nat) (commitment : G) (challenge response : F) :
    (verifierReplies commitment challenge response).run (program.participant F G 1 (verifierInputs base key challenges)) =
      ⟨.returned (.cons (some (decide (response • base = commitment + (challenge • key)))) .nil), (),
        [.receive (.group groupDomain) commitmentSite 0,
         .query challengeSite scalarDomain (.cons challenges .nil),
         .send (ty := .field scalarDomain) deliverySite 0 challenge,
         .receive (.field scalarDomain) responseSite 0]⟩ := by
  rw [verifier_process]
  rfl

/-! The selected contract clause: its relation binding, the formula's process and
the decision observed at the deciding role. -/
def owner : ContractBinding imported := by bind_contract

def clauseIndex : Fin owner.contract.clauses.length := owner.namedClause "knowledge"

def clause : ContractClause := owner.clause clauseIndex

theorem owner_is_entry : owner.protocol = program.payload.entry := rfl

def application : ApplicationBinding owner clause.subject := by bind_contract

def baseSelector : BoundarySelector owner.protocol.signature (.group groupDomain) :=
  application.selectors.get .here

def keySelector : BoundarySelector owner.protocol.signature (.group groupDomain) :=
  application.selectors.get (.there .here)

def witnessSelector : BoundarySelector owner.protocol.signature (.field scalarDomain) :=
  application.selectors.get (.there (.there .here))

def decisionSelector : BoundarySelector owner.protocol.signature .boolean :=
  ⟨.output .here, ⟨1, by decide +kernel⟩, by decide +kernel⟩

theorem exact_clause : clause.kind = .target ∧ clause.name = "knowledge" ∧
    clause.residual = none ∧ clause.decision = some decisionSelector.erase := by
  decide +kernel

theorem all_clauses : owner.contract.clauses = [clause] := rfl

def formulaBinding : FormulaBinding imported application.relation := by bind_contract

theorem no_formula_preconditions : formulaBinding.preconditions = [] := rfl



/-- The relation's arguments, in its declared order. -/
def arguments (base key : G) (witness : F) :
    Values (assignment F G) formulaBinding.definition.inputs :=
  .cons base (.cons key (.cons witness .nil))

/-- The target holds when the retained formula returns `true`. -/
def Relation (base key : G) (witness : F) : Prop :=
  formulaBinding.process (arguments base key witness) =
    .done (.cons true .nil)

theorem formula_process (base key : G) (witness : F) :
    formulaBinding.process (arguments base key witness) =
      .done (.cons (decide (key = witness • base)) .nil) := by
  rfl

theorem relation_iff (base key : G) (witness : F) :
    Relation base key witness ↔ key = witness • base := by
  unfold Relation
  rw [formula_process]
  change (PIR.Process.done (I := closedInterface) (.cons (decide (key = witness • base)) .nil :
    Values (assignment F G) [.boolean]) = .done (.cons true .nil)) ↔ _
  simp
  all_goals change (decide (key = witness • base)) = true ↔ key = witness • base
  all_goals simp

/-- Every retained relation uses its formula or captured body. -/
def environment : RelationEnvironment imported F G :=
  RegisteredRelations.formulaOnly (by decide +kernel)

def target : InterpretedApplication owner clause.subject F G environment where
  binding := application
  interpretation := .formula formulaBinding rfl (fun _ => True)
    (fun args => args.get (.there .here) = args.get (.there (.there .here)) • args.get .here)
    inferInstance

theorem target_formula_law : (target (F := F) (G := G)).interpretation.FormulaLaw := by
  intro args _
  cases args with | cons base args =>
  cases args with | cons key args =>
  cases args with | cons witness args =>
  cases args
  rfl

def rootInvocation : InvocationCoordinate := ⟨0, []⟩

/-- Parameter and witness values, keyed by the actual typed selectors. -/
def assignments (base : G) (witness : F) :
    LogicalAssignments (assignment F G) owner rootInvocation where
  parameters type selector := match type with
    | .group _ => if selector.erase = baseSelector.erase then some base else none
    | _ => none
  witnesses type selector := match type with
    | .field _ => if selector.erase = witnessSelector.erase then some witness else none
    | _ => none

/-- Only the verifier's own inputs and its actual returned tuple are projected. -/
def observedBoundary (base key : G) (challenges : Nat) (commitment : G) (challenge response : F) : ContractBoundaryValues owner F G :=
  BoundaryValuation.ofOutcome 1 (verifierInputs base key challenges)
    ((verifierReplies commitment challenge response).run
      (program.participant F G 1 (verifierInputs base key challenges))).outcome

/-- The selected decision is the verifier's actual returned value. -/
theorem observed_accepts_iff (base key : G) (challenges : Nat) (commitment : G) (challenge response : F) :
    decisionSelector.read {} (observedBoundary base key challenges commitment challenge response) = some true ↔
      response • base = commitment + (challenge • key) := by
  change (some (decide (response • base = commitment + (challenge • key))) = some true) ↔ _
  simp

theorem observed_read (base key : G) (challenges : Nat) (witness : F) (commitment : G) (challenge response : F) :
    application.read {} (observedBoundary base key challenges commitment challenge response) (assignments base witness) =
      some (arguments base key witness) := by
  rfl

theorem observed_target_iff (base key : G) (challenges : Nat) (witness : F) (commitment : G) (challenge response : F) :
    (target (F := F) (G := G)).Holds {} (observedBoundary base key challenges commitment challenge response) (assignments base witness) ↔
      Relation base key witness := by
  change (∃ args, application.read {} _ _ = some args ∧
    formulaBinding.invokeRelation args = .done (.cons true .nil)) ↔ _
  constructor
  · rintro ⟨args, read, truth⟩
    rw [observed_read] at read
    cases Option.some.inj read
    exact truth
  · intro truth
    exact ⟨_, observed_read .., truth⟩

end ZkcExamples.Structured.SchnorrInteractiveNormalForms
