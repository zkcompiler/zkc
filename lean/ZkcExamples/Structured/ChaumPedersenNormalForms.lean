set_option smartUnfolding false
/-! Action sites of the root, named from their source labels. -/
def nonceSite : String := "s0"
def firstCommitmentSite : String := "label_66697273745f636f6d6d69746d656e74_0"
def secondCommitmentSite : String := "label_7365636f6e645f636f6d6d69746d656e74_0"
def challengeSite : String := "label_6368616c6c656e6765"
def deliverySite : String := "label_64656c6976657279_0"
def responseSite : String := "label_726573706f6e7365_0"

variable {F G : Type} [Field F] [DecidableEq F] [AddCommGroup G] [Module F G] [DecidableEq G]

/-- The prover's own inputs, in port order; the others are absent. -/
def proverInputs (firstBase firstKey secondBase secondKey : G) (witness : F) (nonces : Nat) :
    Values (Component (assignment F G)) program.payload.entry.inputs :=
  .cons (some firstBase) (.cons (some firstKey) (.cons (some secondBase) (.cons (some secondKey) (.cons (some witness) (.cons (some nonces) (.cons none .nil))))))

/-- The prover's normal form: its ordered actions and its returned tuple. -/
def proverProcess (firstBase secondBase : G) (witness : F) (nonces : Nat) :
    PIR.Proc (participantInterface F G)
      (Values (Component (assignment F G)) program.payload.entry.outputs) :=
  .call (.query nonceSite scalarDomain (.cons nonces .nil)) fun (nonce : F) =>
  .call (.send (ty := .group groupDomain) firstCommitmentSite 1 (nonce • firstBase)) fun _ =>
  .call (.send (ty := .group groupDomain) secondCommitmentSite 1 (nonce • secondBase)) fun _ =>
  .call (.receive (.field scalarDomain) deliverySite 1) fun (delivery : F) =>
  .call (.send (ty := .field scalarDomain) responseSite 1 (nonce + (delivery * witness))) fun _ =>
  .done (.cons none .nil)

/-- The prover's inputs as the normalizer reads them: held inputs are present. -/
def proverPattern : NormalForm.InputPattern program.payload.entry.inputs :=
  .cons .present (.cons .present (.cons .present (.cons .present (.cons .present (.cons .present (.cons .absent .nil))))))

/-- The prover's form, printed from the compiled normalizer; the kernel checks it. -/
noncomputable def proverForm : NormalForm.Form [] proverPattern.scope program.payload.entry.outputs :=
  .query "s0" "bls12-381.fr" (.cons (.var (.there (.there (.there (.there (.there .here)))))) .nil) <|
  .send (.group "bls12-381.g1") "label_66697273745f636f6d6d69746d656e74_0" 1 (.calc (.groupScale "bls12-381.g1" "bls12-381.fr") rfl (.cons (.var (.there .here)) (.cons (.var .here) .nil)) .here) <|
  .send (.group "bls12-381.g1") "label_7365636f6e645f636f6d6d69746d656e74_0" 1 (.calc (.groupScale "bls12-381.g1" "bls12-381.fr") rfl (.cons (.var (.there (.there (.there .here)))) (.cons (.var .here) .nil)) .here) <|
  .receive (.field "bls12-381.fr") "label_64656c6976657279_0" 1 <|
  .send (.field "bls12-381.fr") "label_726573706f6e7365_0" 1 (.calc (.fieldAdd "bls12-381.fr") rfl (.cons (.var (.there .here)) (.cons (.calc (.fieldMultiply "bls12-381.fr") rfl (.cons (.var .here) (.cons (.var (.there (.there (.there (.there (.there (.there .here))))))) .nil)) .here) .nil)) .here) <|
  .done (.cons .absent .nil)

theorem prover_normalized :
    NormalForm.normalize {} ChaumPedersenBodies.interactiveBody 0 2 proverPattern = .ok proverForm := by
  kernel_rfl

/-- The form's process between the output masks is the readable process. -/
theorem prover_presentation (tables : NormalForm.Tables (ringModel F G)) (firstBase firstKey secondBase secondKey : G) (witness : F) (nonces : Nat) :
    (proverForm.denote (ringModel F G) tables ⟨fun entry => entry.elim0⟩ {}
        (.cons firstBase (.cons firstKey (.cons secondBase (.cons secondKey (.cons witness (.cons nonces .nil))))))).bind
        (fun out => .done (maskValues 0 program.payload.entry.outputScopes out)) =
      proverProcess firstBase secondBase witness nonces := by
  kernel_rfl

theorem prover_process (firstBase firstKey secondBase secondKey : G) (witness : F) (nonces : Nat) :
    program.participant F G 0 (proverInputs firstBase firstKey secondBase secondKey witness nonces) =
      proverProcess firstBase secondBase witness nonces :=
  (NormalForm.participant_sound_uniform program ChaumPedersenBodies.interactiveBody entry_raw {} 0 2
    proverPattern proverForm prover_normalized ⟨fun entry => entry.elim0⟩
    (.cons firstBase (.cons firstKey (.cons secondBase (.cons secondKey (.cons witness (.cons nonces .nil)))))) _ (by kernel_rfl) (fun entry => entry.elim0)).trans
    (prover_presentation _ firstBase firstKey secondBase secondKey witness nonces)

/-- The replies of one prover run: received values by type and site, and
drawn values by site. Other requests are refused. -/
def proverReplies (nonce delivery : F) : ReplyScript F G where
  receive
    | .field _, site => if site = deliverySite then some delivery else none
    | _, _ => none
  draw site := if site = nonceSite then some nonce else none

/-- The prover's run on those replies: its outcome and its ordered actions. -/
theorem prover_run (firstBase firstKey secondBase secondKey : G) (witness : F) (nonces : Nat) (nonce delivery : F) :
    (proverReplies nonce delivery).run (program.participant F G 0 (proverInputs firstBase firstKey secondBase secondKey witness nonces)) =
      ⟨.returned (.cons none .nil), (),
        [.query nonceSite scalarDomain (.cons nonces .nil),
         .send (ty := .group groupDomain) firstCommitmentSite 1 (nonce • firstBase),
         .send (ty := .group groupDomain) secondCommitmentSite 1 (nonce • secondBase),
         .receive (.field scalarDomain) deliverySite 1,
         .send (ty := .field scalarDomain) responseSite 1 (nonce + (delivery * witness))]⟩ := by
  rw [prover_process]
  rfl

/-- The verifier's own inputs, in port order; the others are absent. -/
def verifierInputs (firstBase firstKey secondBase secondKey : G) (challenges : Nat) :
    Values (Component (assignment F G)) program.payload.entry.inputs :=
  .cons (some firstBase) (.cons (some firstKey) (.cons (some secondBase) (.cons (some secondKey) (.cons none (.cons none (.cons (some challenges) .nil))))))

/-- The verifier's normal form: its ordered actions and its returned tuple. -/
def verifierProcess (firstBase firstKey secondBase secondKey : G) (challenges : Nat) :
    PIR.Proc (participantInterface F G)
      (Values (Component (assignment F G)) program.payload.entry.outputs) :=
  .call (.receive (.group groupDomain) firstCommitmentSite 0) fun (firstCommitment : G) =>
  .call (.receive (.group groupDomain) secondCommitmentSite 0) fun (secondCommitment : G) =>
  .call (.query challengeSite scalarDomain (.cons challenges .nil)) fun (challenge : F) =>
  .call (.send (ty := .field scalarDomain) deliverySite 0 challenge) fun _ =>
  .call (.receive (.field scalarDomain) responseSite 0) fun (response : F) =>
  .done (.cons (some ((decide (response • firstBase = firstCommitment + (challenge • firstKey))) && (decide (response • secondBase = secondCommitment + (challenge • secondKey))))) .nil)

/-- The verifier's inputs as the normalizer reads them: held inputs are present. -/
def verifierPattern : NormalForm.InputPattern program.payload.entry.inputs :=
  .cons .present (.cons .present (.cons .present (.cons .present (.cons .absent (.cons .absent (.cons .present .nil))))))

/-- The verifier's form, printed from the compiled normalizer; the kernel checks it. -/
noncomputable def verifierForm : NormalForm.Form [] verifierPattern.scope program.payload.entry.outputs :=
  .receive (.group "bls12-381.g1") "label_66697273745f636f6d6d69746d656e74_0" 0 <|
  .receive (.group "bls12-381.g1") "label_7365636f6e645f636f6d6d69746d656e74_0" 0 <|
  .query "label_6368616c6c656e6765" "bls12-381.fr" (.cons (.var (.there (.there (.there (.there (.there (.there .here))))))) .nil) <|
  .send (.field "bls12-381.fr") "label_64656c6976657279_0" 0 (.var .here) <|
  .receive (.field "bls12-381.fr") "label_726573706f6e7365_0" 0 <|
  .done (.cons (.present (.calc .booleanAnd rfl (.cons (.calc (.groupEqual "bls12-381.g1") rfl (.cons (.calc (.groupScale "bls12-381.g1" "bls12-381.fr") rfl (.cons (.var (.there (.there (.there (.there .here))))) (.cons (.var .here) .nil)) .here) (.cons (.calc (.groupAdd "bls12-381.g1") rfl (.cons (.var (.there (.there (.there .here)))) (.cons (.calc (.groupScale "bls12-381.g1" "bls12-381.fr") rfl (.cons (.var (.there (.there (.there (.there (.there .here)))))) (.cons (.var (.there .here)) .nil)) .here) .nil)) .here) .nil)) .here) (.cons (.calc (.groupEqual "bls12-381.g1") rfl (.cons (.calc (.groupScale "bls12-381.g1" "bls12-381.fr") rfl (.cons (.var (.there (.there (.there (.there (.there (.there .here))))))) (.cons (.var .here) .nil)) .here) (.cons (.calc (.groupAdd "bls12-381.g1") rfl (.cons (.var (.there (.there .here))) (.cons (.calc (.groupScale "bls12-381.g1" "bls12-381.fr") rfl (.cons (.var (.there (.there (.there (.there (.there (.there (.there .here)))))))) (.cons (.var (.there .here)) .nil)) .here) .nil)) .here) .nil)) .here) .nil)) .here)) .nil)

theorem verifier_normalized :
    NormalForm.normalize {} ChaumPedersenBodies.interactiveBody 1 2 verifierPattern = .ok verifierForm := by
  kernel_rfl

/-- The form's process between the output masks is the readable process. -/
theorem verifier_presentation (tables : NormalForm.Tables (ringModel F G)) (firstBase firstKey secondBase secondKey : G) (challenges : Nat) :
    (verifierForm.denote (ringModel F G) tables ⟨fun entry => entry.elim0⟩ {}
        (.cons firstBase (.cons firstKey (.cons secondBase (.cons secondKey (.cons challenges .nil)))))).bind
        (fun out => .done (maskValues 1 program.payload.entry.outputScopes out)) =
      verifierProcess firstBase firstKey secondBase secondKey challenges := by
  kernel_rfl

theorem verifier_process (firstBase firstKey secondBase secondKey : G) (challenges : Nat) :
    program.participant F G 1 (verifierInputs firstBase firstKey secondBase secondKey challenges) =
      verifierProcess firstBase firstKey secondBase secondKey challenges :=
  (NormalForm.participant_sound_uniform program ChaumPedersenBodies.interactiveBody entry_raw {} 1 2
    verifierPattern verifierForm verifier_normalized ⟨fun entry => entry.elim0⟩
    (.cons firstBase (.cons firstKey (.cons secondBase (.cons secondKey (.cons challenges .nil))))) _ (by kernel_rfl) (fun entry => entry.elim0)).trans
    (verifier_presentation _ firstBase firstKey secondBase secondKey challenges)

/-- The replies of one verifier run: received values by type and site, and
drawn values by site. Other requests are refused. -/
def verifierReplies (firstCommitment secondCommitment : G) (challenge response : F) : ReplyScript F G where
  receive
    | .group _, site => if site = firstCommitmentSite then some firstCommitment else if site = secondCommitmentSite then some secondCommitment else none
    | .field _, site => if site = responseSite then some response else none
    | _, _ => none
  draw site := if site = challengeSite then some challenge else none

/-- The verifier's run on those replies: its outcome and its ordered actions. -/
theorem verifier_run (firstBase firstKey secondBase secondKey : G) (challenges : Nat) (firstCommitment secondCommitment : G) (challenge response : F) :
    (verifierReplies firstCommitment secondCommitment challenge response).run (program.participant F G 1 (verifierInputs firstBase firstKey secondBase secondKey challenges)) =
      ⟨.returned (.cons (some ((decide (response • firstBase = firstCommitment + (challenge • firstKey))) && (decide (response • secondBase = secondCommitment + (challenge • secondKey))))) .nil), (),
        [.receive (.group groupDomain) firstCommitmentSite 0,
         .receive (.group groupDomain) secondCommitmentSite 0,
         .query challengeSite scalarDomain (.cons challenges .nil),
         .send (ty := .field scalarDomain) deliverySite 0 challenge,
         .receive (.field scalarDomain) responseSite 0]⟩ := by
  rw [verifier_process]
  rfl

/-! The selected contract clause: its relation binding, the formula's process and
the decision observed at the deciding role. -/
def owner : ContractBinding imported := by bind_contract

def clauseIndex : Fin owner.contract.clauses.length := owner.namedClause "knowledge"

def clause : ContractClause := owner.clause clauseIndex

theorem owner_is_entry : owner.protocol = program.payload.entry := rfl

def application : ApplicationBinding owner clause.subject := by bind_contract

def firstBaseSelector : BoundarySelector owner.protocol.signature (.group groupDomain) :=
  application.selectors.get .here

def firstKeySelector : BoundarySelector owner.protocol.signature (.group groupDomain) :=
  application.selectors.get (.there .here)

def secondBaseSelector : BoundarySelector owner.protocol.signature (.group groupDomain) :=
  application.selectors.get (.there (.there .here))

def secondKeySelector : BoundarySelector owner.protocol.signature (.group groupDomain) :=
  application.selectors.get (.there (.there (.there .here)))

def witnessSelector : BoundarySelector owner.protocol.signature (.field scalarDomain) :=
  application.selectors.get (.there (.there (.there (.there .here))))

def decisionSelector : BoundarySelector owner.protocol.signature .boolean :=
  ⟨.output .here, ⟨1, by decide +kernel⟩, by decide +kernel⟩

theorem exact_clause : clause.kind = .target ∧ clause.name = "knowledge" ∧
    clause.residual = none ∧ clause.decision = some decisionSelector.erase := by
  decide +kernel

theorem all_clauses : owner.contract.clauses = [clause] := rfl

def formulaBinding : FormulaBinding imported application.relation := by bind_contract

theorem no_formula_preconditions : formulaBinding.preconditions = [] := rfl



/-- The relation's arguments, in its declared order. -/
def arguments (firstBase firstKey secondBase secondKey : G) (witness : F) :
    Values (assignment F G) formulaBinding.definition.inputs :=
  .cons firstBase (.cons firstKey (.cons secondBase (.cons secondKey (.cons witness .nil))))

/-- The target holds when the retained formula returns `true`. -/
def Relation (firstBase firstKey secondBase secondKey : G) (witness : F) : Prop :=
  formulaBinding.process (arguments firstBase firstKey secondBase secondKey witness) =
    .done (.cons true .nil)

theorem formula_process (firstBase firstKey secondBase secondKey : G) (witness : F) :
    formulaBinding.process (arguments firstBase firstKey secondBase secondKey witness) =
      .done (.cons ((decide (firstKey = witness • firstBase)) && (decide (secondKey = witness • secondBase))) .nil) := by
  rfl

theorem relation_iff (firstBase firstKey secondBase secondKey : G) (witness : F) :
    Relation firstBase firstKey secondBase secondKey witness ↔ firstKey = witness • firstBase ∧ secondKey = witness • secondBase := by
  unfold Relation
  rw [formula_process]
  change (PIR.Proc.done (I := closedInterface) (.cons ((decide (firstKey = witness • firstBase)) && (decide (secondKey = witness • secondBase))) .nil :
    Values (assignment F G) [.boolean]) = .done (.cons true .nil)) ↔ _
  simp

/-- The subject's only relation is this formula. -/
def environment : RelationEnvironment imported F G where
  meanings index args := by
    have same : index = application.relation.index := by
      apply Fin.ext
      have bound : index.val < 1 := index.isLt
      change index.val = 0
      omega
    subst index
    exact Relation (args.get .here) (args.get (.there .here)) (args.get (.there (.there .here))) (args.get (.there (.there (.there .here)))) (args.get (.there (.there (.there (.there .here)))))

def target : InterpretedApplication owner clause.subject F G environment where
  binding := application
  interpretation := .formula formulaBinding rfl (fun _ => True)
    (fun args => args.get (.there .here) = args.get (.there (.there (.there (.there .here)))) • args.get .here ∧ args.get (.there (.there (.there .here))) = args.get (.there (.there (.there (.there .here)))) • args.get (.there (.there .here)))
    inferInstance

theorem target_formula_law : (target (F := F) (G := G)).interpretation.FormulaLaw := by
  intro args _
  cases args with | cons firstBase args =>
  cases args with | cons firstKey args =>
  cases args with | cons secondBase args =>
  cases args with | cons secondKey args =>
  cases args with | cons witness args =>
  cases args
  simp only [Bool.decide_and]
  rfl

def rootInvocation : InvocationCoordinate := ⟨0, []⟩

/-- Parameter and witness values, keyed by the actual typed selectors. -/
def assignments (firstBase secondBase : G) (witness : F) :
    LogicalAssignments (assignment F G) owner rootInvocation where
  parameters type selector := match type with
    | .group _ => if selector.erase = firstBaseSelector.erase then some firstBase else if selector.erase = secondBaseSelector.erase then some secondBase else none
    | _ => none
  witnesses type selector := match type with
    | .field _ => if selector.erase = witnessSelector.erase then some witness else none
    | _ => none

/-- Only the verifier's own inputs and its actual returned tuple are projected. -/
def observedBoundary (firstBase firstKey secondBase secondKey : G) (challenges : Nat) (firstCommitment secondCommitment : G) (challenge response : F) : ContractBoundaryValues owner F G :=
  BoundaryValuation.ofOutcome 1 (verifierInputs firstBase firstKey secondBase secondKey challenges)
    ((verifierReplies firstCommitment secondCommitment challenge response).run
      (program.participant F G 1 (verifierInputs firstBase firstKey secondBase secondKey challenges))).outcome

/-- The selected decision is the verifier's actual returned value. -/
theorem observed_accepts_iff (firstBase firstKey secondBase secondKey : G) (challenges : Nat) (firstCommitment secondCommitment : G) (challenge response : F) :
    decisionSelector.read {} (observedBoundary firstBase firstKey secondBase secondKey challenges firstCommitment secondCommitment challenge response) = some true ↔
      response • firstBase = firstCommitment + (challenge • firstKey) ∧ response • secondBase = secondCommitment + (challenge • secondKey) := by
  change (some ((decide (response • firstBase = firstCommitment + (challenge • firstKey))) && (decide (response • secondBase = secondCommitment + (challenge • secondKey)))) = some true) ↔ _
  simp

theorem observed_read (firstBase firstKey secondBase secondKey : G) (challenges : Nat) (witness : F) (firstCommitment secondCommitment : G) (challenge response : F) :
    application.read {} (observedBoundary firstBase firstKey secondBase secondKey challenges firstCommitment secondCommitment challenge response) (assignments firstBase secondBase witness) =
      some (arguments firstBase firstKey secondBase secondKey witness) := by
  rfl

theorem observed_target_iff (firstBase firstKey secondBase secondKey : G) (challenges : Nat) (witness : F) (firstCommitment secondCommitment : G) (challenge response : F) :
    (target (F := F) (G := G)).Holds {} (observedBoundary firstBase firstKey secondBase secondKey challenges firstCommitment secondCommitment challenge response) (assignments firstBase secondBase witness) ↔
      Relation firstBase firstKey secondBase secondKey witness := by
  change (∃ args, application.read {} _ _ = some args ∧
    formulaBinding.invokeRelation args = .done (.cons true .nil)) ↔ _
  constructor
  · rintro ⟨args, read, truth⟩
    rw [observed_read] at read
    cases Option.some.inj read
    exact truth
  · intro truth
    exact ⟨_, observed_read .., truth⟩

