  · change Participant.owned (ctx.roles 0) (ctx.roles 1) (invoke (plainHelpers (F := F) (G := G) GkrSourceViews.unit).closed GkrSourceBodies.emptyHelper) .nil = _
    rw [Participant.owned_other _ _ separate]
    rfl
  refine (Region.denote_letOp_done m (.mark "s6") _ _ _ _ .nil rfl).trans ?_
  refine (Region.denote_letOp_values m (.repeat (repeatSpec 4) "s6") _ _ _ _).trans ?_
  change (denoteRepeat (repeatSpec 4) ctx (ctx.roles 0) rounds (.cons add (.cons mul (.cons left (.cons right (.cons (some (emptyResults.get .here)) (.cons none (.cons none .nil)))))) : Values (Component (assignment F G)) [.vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"])
    (.cons none .nil : Values (Component (assignment F G)) [.service "random.bls12-381.fr/0"]) (roundFn ctx (ctx.roles 0))).bind _ = _
  congr 1
  funext state
  cases state with | cons slot0 state =>
    cases state with | cons slot1 state =>
      cases state with | cons slot2 state =>
        cases state with | cons slot3 state =>
          cases state with | cons slot4 state =>
            cases state with | cons slot5 state =>
              cases state with | cons slot6 state =>
                cases state
                rfl

set_option linter.unusedSimpArgs false in
omit [CommRing F] [AddCommGroup G] [Module F G] [DecidableEq F] [DecidableEq G] in
/-- The returned components kept at role 0; the others are masked away. -/
theorem proverRounds_outputs (ctx : ProtocolContext) (separate : ctx.roles 1 ≠ ctx.roles 0)
    (values : Values (Component (assignment F G)) [.vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"]) :
    maskValues (ctx.roles 0) (ctx.mapScopes [[0], [0], [0], [0], [0], [1], [1]]) values =
      .cons (values.get .here) (.cons (values.get (.there .here)) (.cons (values.get (.there (.there .here))) (.cons (values.get (.there (.there (.there .here)))) (.cons (values.get (.there (.there (.there (.there .here))))) (.cons none (.cons none .nil)))))) := by
  cases values with | cons value0 values =>
    cases values with | cons value1 values =>
      cases values with | cons value2 values =>
        cases values with | cons value3 values =>
          cases values with | cons value4 values =>
            cases values with | cons value5 values =>
              cases values with | cons value6 values =>
                cases values
                simp [maskValues, ProtocolContext.mapScopes, ProtocolContext.enter, roleSubstitution,
                  Participant.restrict, separate, Ne.symm separate, Values.get]

set_option linter.unusedSimpArgs false in
/-- The proverRounds's invocation at any caller context: the input masks, the normal form of
the body and the output masks, with this unit's protocol table. -/
theorem proverRounds_invoke
    (ctx : ProtocolContext) (self : Nat) (role : self = ctx.roles 0)
    (separate : ctx.roles 1 ≠ self)
    (add mul left right : Option (List F)) (rounds : Option Nat) (input4 : Option F) (input6 : Option Nat) :
    invokeProtocol (GkrSourceViews.unit.plainProtocolTable F G) GkrSourceBodies.roundsSignature ctx self
      (.cons add (.cons mul (.cons left (.cons right (.cons input4 (.cons rounds (.cons input6 .nil))))))) =
      (proverRoundsProcess ctx add mul left right rounds).bind (fun out => .done (.cons (out.get .here) (.cons (out.get (.there .here)) (.cons (out.get (.there (.there .here))) (.cons (out.get (.there (.there (.there .here)))) (.cons (out.get (.there (.there (.there (.there .here))))) (.cons none (.cons none .nil)))))))) := by
  refine (rounds_view ctx self _ (.cons add (.cons mul (.cons left (.cons right (.cons none (.cons rounds (.cons none .nil))))))) ?_).trans ?_
  · subst self
    iterate 8 unfold maskValues
    simp [ProtocolContext.mapScopes, Participant.restrict, separate, Ne.symm separate]
  subst self
  refine (congrArg (fun process => PIR.Proc.bind process _)
    (proverRounds_process (add := add) (mul := mul) (left := left) (right := right) (rounds := rounds) (ctx := ctx) (self := ctx.roles 0) (role := rfl)
      (separate := separate) )).trans ?_
  apply congrArg (PIR.Proc.bind _)
  funext out
  exact congrArg PIR.Proc.done (proverRounds_outputs ctx separate out)

