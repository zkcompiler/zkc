/-- The verifier's normal form of one body run: its ordered actions, the values it
computes, guards as conditionals and missing inputs as stops. -/
def verifierProcess (ctx : ProtocolContext) (service : Option Nat) (point : Option (List F)) (claim : Option F) :
    PIR.Proc (participantInterface F G) ((Option (List F)) × (Option F)) :=
  .call (.receive (.field scalarDomain) (round0Site ctx) (ctx.roles 0)) fun (round0 : F) =>
  .call (.receive (.field scalarDomain) (round1Site ctx) (ctx.roles 0)) fun (round1 : F) =>
  .call (.receive (.field scalarDomain) (round2Site ctx) (ctx.roles 0)) fun (round2 : F) =>
  match claim with
  | none =>
    .halt .incomplete
  | some claim =>
    if claim = ((round0 + round0) + round1) + round2 then
      match service with
      | none =>
        .halt .incomplete
      | some service =>
        .call (.query (challengeSite ctx) scalarDomain (.cons service .nil)) fun (challenge : F) =>
        .call (.send (ty := .field scalarDomain) (deliverySite ctx) (ctx.roles 0) challenge) fun _ =>
        match point with
        | none =>
          .halt .incomplete
        | some point =>
          (invoke (plainHelpers (F := F) (G := G) GkrSourceViews.unit).closed GkrSourceBodies.appendHelper (.cons point (.cons challenge .nil) : Values (assignment F G) [.vector "bls12-381.fr", .field "bls12-381.fr"])).bind fun (appendResults : Values (assignment F G) [.vector "bls12-381.fr"]) =>
          .done (some (appendResults.get .here), some (round0 + (challenge * (round1 + (challenge * round2)))))
    else
      .halt .reject

