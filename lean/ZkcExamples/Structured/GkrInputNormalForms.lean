public import ZkcExamples.Structured.NormalFormSteps
public import ZkcExamples.Structured.SumcheckVerifierHelpers
public import Zkc.Source.Structured.NormalForm.Presentation

@[expose] public section

/-! The actual terminal GKR input check and its participant normal form, generated by `lean/bridges/structured/normal_forms.py`
from `lean/bridges/structured/normal-forms/gkr-input.toml` and the retained unit
`lean/bridges/structured/fixtures/gkr-source.json`.
Regenerate after the unit or the request changes; do not edit by hand. Every
definition and equation below is checked by the kernel. -/
namespace ZkcExamples.Structured.GkrInputNormalForms
open Zkc.Source Zkc.Source.Structured SumcheckVerifierHelpers

abbrev inputInputs : List Ty :=
  [.vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"]

abbrev inputOutputs : List Ty :=
  [.boolean]

/-- The whole body, every repeat through its named callback. -/
def inputBody : Region protocolDialect [.vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"]
    [.boolean] :=
  .letOp (.mark "s0") .nil .nil <|
  .letOp (.localCall GkrSourceBodies.sourceHelper84Helper rfl 0 "s0") (.cons .here (.cons (.there .here) (.cons (.there (.there .here)) .nil))) .nil <|
  .ret (.cons .here .nil)

/-- The admitted `sourceProtocol80` declaration is this body. -/
theorem inputBody_raw : GkrSourceViews.sourceProtocol80Definition.raw =
    inputBody.erase := by
  refine GkrSourceViews.sourceProtocol80_raw.trans ?_
  unfold inputBody
  rfl

variable {F G : Type} [CommRing F] [AddCommGroup G] [Module F G]
  [DecidableEq F] [DecidableEq G]

private abbrev one {ty : Ty} (value : Option (assignment F G ty)) :
    Values (Component (assignment F G)) [ty] := .cons value .nil

/-- The typed body's process at one participant, with this unit's tables. -/
def inputFn (ctx : ProtocolContext) (self : Nat) :
    RegionFunction (Component (assignment F G)) (participantInterface F G)
      ([.vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"], [.boolean]) :=
  fun args => inputBody.denote
    (participantMeaningWith (.silent _) (participantActions F G) (plainHelpers (F := F) (G := G) GkrSourceViews.unit) self (GkrSourceViews.unit.plainProtocolTable F G) ctx) args.get

/-- The verifier's normal form of the whole body. -/
def verifierProcess (values point : Option (List F)) (claim : Option F) :
    PIR.Process (participantInterface F G)
      (Values (Component (assignment F G)) [.boolean]) :=
  match values with
  | none =>
    .halt .incomplete
  | some values =>
    match point with
    | none =>
      .halt .incomplete
    | some point =>
      match claim with
      | none =>
        .halt .incomplete
      | some claim =>
        (invoke (plainHelpers (F := F) (G := G) GkrSourceViews.unit).closed GkrSourceBodies.sourceHelper84Helper (.cons values (.cons point (.cons claim .nil)) : Values (assignment F G) [.vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"])).bind fun (sourceHelper84Results : Values (assignment F G) [.boolean]) =>
        .done (.cons (some (sourceHelper84Results.get .here)) .nil : Values (Component (assignment F G)) [.boolean])

/-- The verifier's laws as the normalizer reads them, keyed by helper. -/
def verifierSignature : NormalForm.Signature :=
  ⟨[], true, false, [], []⟩

/-- The results the verifier's laws present, from the request's templates. -/
def verifierResults : NormalForm.LawResults (ringModel F G) verifierSignature.laws :=
  ⟨fun entry => entry.elim0⟩

/-- The verifier's inputs as the normalizer reads them. -/
def verifierPattern : NormalForm.InputPattern [.vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"] :=
  .cons .optional (.cons .optional (.cons .optional .nil))

/-- The verifier's form, printed from the compiled normalizer; the kernel checks it. -/
noncomputable def verifierForm : NormalForm.Form verifierSignature.laws verifierSignature.callees verifierPattern.scope [.boolean] :=
  .split (.input .here)
    (
      .halt .incomplete)
    (
      .split (.input (.there (.there .here)))
        (
          .halt .incomplete)
        (
          .split (.input (.there (.there (.there (.there .here)))))
            (
              .halt .incomplete)
            (
              .strict GkrSourceBodies.sourceHelper84Helper (.cons (.var (.there (.there .here))) (.cons (.var (.there .here)) (.cons (.var .here) .nil))) <|
              .done (.cons (.present (.result .here .here)) .nil))))

theorem verifier_normalized :
    NormalForm.normalize verifierSignature inputBody 0 1 verifierPattern = .ok verifierForm := by
  kernel_rfl

theorem verifier_lawsMatch : verifierForm.CallsMatch := by
  kernel_rfl

theorem verifier_environment (values point : Option (List F)) (claim : Option F) :
    verifierPattern.environment (ringModel F G) (.cons values (.cons point (.cons claim .nil))) =
      (.cons values (.cons point (.cons claim .nil)) : Values (Component (assignment F G)) [.vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"]) := by
  kernel_rfl

/-- The form's process is the readable process. -/
theorem verifier_presentation (ctx : ProtocolContext)
    (values point : Option (List F)) (claim : Option F) :
    verifierForm.denote (ringModel F G) (plainHelpers (F := F) (G := G) GkrSourceViews.unit).toOn verifierResults ctx
        (NormalForm.Runs.uniform (plainHelpers (F := F) (G := G) GkrSourceViews.unit) (GkrSourceViews.unit.plainProtocolTable F G) ctx (ctx.roles 0)) (NormalForm.noCallees _)
        (.cons values (.cons point (.cons claim .nil))) =
      verifierProcess values point claim := by
  kernel_rfl

/-- The verifier's laws hold at its inputs, by the admitted helpers' laws. -/
theorem verifier_laws (values point : Option (List F)) (claim : Option F) :
    NormalForm.LawsHold (plainHelpers (F := F) (G := G) GkrSourceViews.unit).toOn verifierResults
      (.cons values (.cons point (.cons claim .nil)) : Values (Component (assignment F G)) [.vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"]) :=
  fun entry => entry.elim0

/-- The process equation of `verifierProcess`, an instance of the normalizer's soundness. -/
theorem verifier_process
    (ctx : ProtocolContext) (self : Nat) (role : self = ctx.roles 0)
    (values point : Option (List F)) (claim : Option F) :
    inputFn (F := F) (G := G) ctx self
      (.cons values (.cons point (.cons claim .nil))) =
      verifierProcess values point claim := by
  subst self
  exact (NormalForm.sound_uniform verifierSignature inputBody 0 1 verifierPattern
    verifierForm (verifier_normalized ) (verifier_lawsMatch ) ctx (NormalForm.RosterDistinct.only ctx)
    (plainHelpers (F := F) (G := G) GkrSourceViews.unit) (GkrSourceViews.unit.plainProtocolTable F G) verifierResults (NormalForm.noCallees _) (.cons values (.cons point (.cons claim .nil))) _
    (verifier_environment values point claim) (verifier_laws values point claim) (NormalForm.noCallees_hold _ _)).trans
    (verifier_presentation ctx values point claim)

end ZkcExamples.Structured.GkrInputNormalForms
