/-- The prover's own inputs, in port order; the others are absent. -/
def proverInputs (firstBase secondBase point : G) (firstScalar secondScalar : F) (nonces : Nat) :
    Values (Component (assignment F G)) program.payload.entry.inputs :=
  .cons (some firstBase) (.cons (some secondBase) (.cons (some point) (.cons (some firstScalar) (.cons (some secondScalar) (.cons (some nonces) (.cons none .nil))))))

/-- The prover's normal form: its ordered actions and its returned tuple. -/
def proverProcess (firstBase secondBase : G) (firstScalar secondScalar : F) (nonces : Nat) :
    PIR.Proc (participantInterface F G)
      (Values (Component (assignment F G)) program.payload.entry.outputs) :=
  .call (.query firstNonceSite scalarDomain (.cons nonces .nil)) fun (firstNonce : F) =>
  .call (.query secondNonceSite scalarDomain (.cons nonces .nil)) fun (secondNonce : F) =>
  .call (.send (ty := .group groupDomain) commitmentSite 1 ((firstNonce • firstBase) + (secondNonce • secondBase))) fun _ =>
  .call (.receive (.field scalarDomain) deliverySite 1) fun (delivery : F) =>
  .call (.send (ty := .field scalarDomain) firstResponseSite 1 (firstNonce + (delivery * firstScalar))) fun _ =>
  .call (.send (ty := .field scalarDomain) secondResponseSite 1 (secondNonce + (delivery * secondScalar))) fun _ =>
  .done (.cons none .nil)

/-- The prover's inputs as the normalizer reads them: held inputs are present. -/
def proverPattern : NormalForm.InputPattern program.payload.entry.inputs :=
  .cons .present (.cons .present (.cons .present (.cons .present (.cons .present (.cons .present (.cons .absent .nil))))))

