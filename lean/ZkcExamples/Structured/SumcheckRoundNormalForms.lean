/-- Masking the carried state to its declared scopes keeps the verifier's components. -/
theorem verifierState_masked (ctx : ProtocolContext) (self : Nat) (role : self = ctx.roles 1)
    (point : Option (List F)) (claim : Option F) :
    maskValues self (ctx.mapScopes [[0], [0], [0], [0], [1], [1]]) (verifierState (F := F) (G := G) point claim) =
      verifierState point claim := by
  subst self
  unfold verifierState
  iterate 7 unfold maskValues
  simp [ProtocolContext.mapScopes, Participant.restrict]

/-- The verifier's normal form of one body run: its ordered actions, the values it
computes, guards as conditionals and missing inputs as stops. -/
def verifierProcess (ctx : ProtocolContext) (service : Option Nat) (point : Option (List F)) (claim : Option F) :
    PIR.Proc (participantInterface F G) ((Option (List F)) × (Option F)) :=
  .call (.receive (.field scalarDomain) (round0Site ctx) (ctx.roles 0)) fun (round0 : F) =>
  .call (.receive (.field scalarDomain) (round1Site ctx) (ctx.roles 0)) fun (round1 : F) =>
  match claim with
  | none =>
    .halt .incomplete
  | some claim =>
    if claim = round0 + round1 then
      match service with
      | none =>
        .halt .incomplete
      | some service =>
        .call (.query (challengeSite ctx) scalarDomain (.cons service .nil)) fun (challenge : F) =>
        .call (.send (ty := .field scalarDomain) (deliverySite ctx) (ctx.roles 0) challenge) fun _ =>
        match point with
        | none =>
          .halt .incomplete
        | some point =>
          .done (some (point ++ [challenge]), some (((1 - challenge) * round0) + (challenge * round1)))
    else
      .halt .reject

