/-- The typed body's process at one participant, with this unit's tables. -/
def roundFn (U : UnitPayload) (ctx : ProtocolContext) (self : Nat) :
    RegionFunction (Component (assignment F G)) (participantInterface F G)
      ([.index, .vector "bls12-381.fr", .index, .index, .vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr", .service "random.bls12-381.fr/0"], [.vector "bls12-381.fr", .index, .index, .vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"]) :=
  fun args => SumcheckVerifierBodies.roundBody.denote
    (participantMeaningWith (.silent _) (participantActions F G) (plainHelpers U) self (U.plainProtocolTable F G) ctx) args.get

/-- The verifier's components of the carried state; the other slots are absent. -/
def verifierState (point : Option (List F)) (claim : Option F) :
    Values (Component (assignment F G)) [.vector "bls12-381.fr", .index, .index, .vector "bls12-381.fr", .vector "bls12-381.fr", .field "bls12-381.fr"] :=
  .cons none (.cons none (.cons none (.cons none (.cons point (.cons claim .nil)))))

