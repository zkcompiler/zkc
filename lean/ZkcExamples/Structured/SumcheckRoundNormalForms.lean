    PIR.Process (participantInterface F G) ((Option (List F)) × (Option F)) :=
  .call (.receive (.field scalarDomain) (round0Site ctx) (ctx.roles 0)) fun (round0 : F) =>
  .call (.receive (.field scalarDomain) (round1Site ctx) (ctx.roles 0)) fun (round1 : F) =>
  match claim with
  | none =>
    .halt .incomplete
  | some claim =>
    if claim = round0 + round1 then
      match service with
      | none =>
        .halt .incomplete
      | some service =>
        .call (.query (challengeSite ctx) scalarDomain (.cons service .nil)) fun (challenge : F) =>
        .call (.send (ty := .field scalarDomain) (deliverySite ctx) (ctx.roles 0) challenge) fun _ =>
        match point with
        | none =>
          .halt .incomplete
        | some point =>
          .done (some (point ++ [challenge]), some (((1 - challenge) * round0) + (challenge * round1)))
    else
      .halt .reject

