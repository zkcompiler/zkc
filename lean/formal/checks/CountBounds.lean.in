import CountBoundRoots
import Count

open Zkc.Core Zkc.Subject ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess
open StandardInterpretation (model draws covers)
open Count Count.Witness
open CountBoundRoots (requested)
open scoped ENNReal NNRat

namespace CountBounds

-- Authors can unfold the cap-based predicates down to their named rejection and recurse
-- on the input and witness telescopes under their published names.
example (h : Goal.Claim model written'goal0 draws) : Goal.Claim model written'goal0 draws := by
  unfold Goal.Claim Goal.ClaimOf Goal.Rejected at h
  exact h

example (h : Goal.Witnessed model written'goal0 draws) : Goal.Witnessed model written'goal0 draws := by
  unfold Goal.Witnessed Goal.Rejected at h
  exact h

example := @Goal.Internal.inputs.eq_1
example := @Goal.Internal.witnesses.eq_2

private theorem loose_total : looseCaps.total = requested := by
  rw [CapTable.total, loose_budget]
  rfl

private def editDraw (edit : DrawCap → DrawCap) : CapTable :=
  let use := looseCaps.uses[0]'(by decide)
  ⟨[.flat use.definition [edit (use.draws[0]'(by decide))] []]⟩

example : editDraw id = looseCaps := rfl
example : editDraw (fun draw ↦ { draw with key := ⟨5⟩ }) = misplaced := rfl

run_cmd Lean.Elab.Command.liftCoreM CountBoundRoots.checkRoots

end CountBounds
