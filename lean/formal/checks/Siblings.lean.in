namespace Siblings
open Zkc.Core ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess OracleComp ProbComp
open StandardInterpretation (F G D large)
open scoped ScalarField ENNReal NNRat
noncomputable section
private theorem exists_other {α : Type} [Fintype α] [DecidableEq α] (a b : α)
    (many : 2 < Fintype.card α) : ∃ x, x ≠ a ∧ x ≠ b := by
  by_contra! none
  have cover : (Finset.univ : Finset α) ⊆ {a, b} := by
    intro x _
    by_cases h : x = a
    · simp [h]
    · simp [none x h]
  exact many.not_ge (by simpa using (Finset.card_le_card cover).trans Finset.card_le_two)

theorem zero_judged : zeroJudged := by
  claim_intro
  obtain ⟨w, h0, hx⟩ := exists_other (0 : F) input_x
    (lt_of_lt_of_le (by decide : 2 < Zkc.Vocabulary.Field.bls12381Fr.order) large)
  have bfalse : input_b = false := by
    cases hb : input_b
    · rfl
    · have yes : functionResult (t := .bool) (fnMeaning StandardInterpretation.model installed zeroMember (.cons true (.cons input_x (.cons w .nil)))) = some true := by
        apply functionResult_of_judged
        walk
        simp_all
      have h := rejected w trivial
      rw [hb, yes] at h
      simp at h
  subst input_b
  walk
theorem zero_checked : zeroClaim := zero_claim_of_judged zero_judged

theorem zero_met : zeroWitnessed := by
  apply zero_witnessed_of false trivial (0 : F) trivial
  repeat intro
  apply functionResult_of_judged
  walk
#print axioms zero_checked
#print axioms zero_met
end
end Siblings
