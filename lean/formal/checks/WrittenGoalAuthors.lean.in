import AuthorEquality

open Zkc.Core ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess OracleComp ProbComp
open StandardInterpretation (model served)
open scoped NNRat ENNReal

namespace AuthorClient
open AuthorEquality in
theorem noEqualityReceipt : ¬ equalityWitnessed := by
  rintro ⟨_, _, value, _, _, rejected⟩
  have no := rejected (witness0 := value) trivial
  have yes : functionResult (t := .bool) (fnMeaning model installed equalityMember
      (.cons value (.cons value .nil))) = some true := by cases value <;> kernel_rfl
  exact Bool.noConfusion (Option.some.inj (yes.symm.trans no))

end AuthorClient
