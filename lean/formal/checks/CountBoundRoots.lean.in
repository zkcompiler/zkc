import Count.Stated
import ZkcFormal.Written.Soundness
import Lean

section

open Zkc.Subject ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess
open StandardInterpretation (model draws covers served)
open Count
open scoped ENNReal

namespace CountBoundRoots

/-- The downstream reader fixes its own rational instance before reading a proof. -/
noncomputable def requested : ℝ≥0∞ := toProbability (3 / 8)

def installed := Soundness.Installed model written'decision0 draws requested
def admitted := Soundness.AdmittedBound model written'decision0 draws requested
def result := Soundness.Result model written'decision0 draws covers requested
def witnessed := Soundness.Witnessed model written'decision0 draws

theorem witnessOf : type_of% (Soundness.witnessed_of model written'decision0 draws served) :=
  Soundness.witnessed_of model written'decision0 draws served

namespace Control

noncomputable def twin := written'decision0
def redirected := Soundness.Installed model twin draws requested
def sibling := Soundness.Installed model written'decision1 draws requested
def projected := Soundness.Installed model written'goal0.decision draws requested
def fromFees := Soundness.Installed model written'decision0 draws looseCaps.total

private theorem retain {P Q : Prop} (_ : P) (q : Q) : Q := q

/-- Only the value of this proof refers to a counted receipt. -/
private theorem boolean : written'decision0.relation.header.outs = [.bool] :=
  retain loose_counted written'decision0.boolean

noncomputable def withProof : Decision written'root := { written'decision0 with boolean }
def throughProof := Soundness.Installed model withProof draws requested

/-- The same public telescope can conceal a call to a fee-dependent helper. -/
theorem borrowed : type_of% witnessOf := loose_witnessed_of

/-- Conversely, a fee-dependent presentation can accompany a clean proof value. -/
theorem feePresentation : type_of% loose_witnessed_of := witnessOf

example : redirected = CountBoundRoots.installed := rfl
example : projected = CountBoundRoots.installed := rfl
example : throughProof = CountBoundRoots.installed := rfl
example : fromFees = CountBoundRoots.installed := by
  have same : looseCaps.total = requested := by rw [CapTable.total, loose_budget]; rfl
  exact congrArg (Soundness.Installed model written'decision0 draws) same

-- The issued decision still occurs inside the replacement, and its installed bound
-- is definitionally equal to the original. Its source clause has moved.
noncomputable def written'decision0 : Decision Count.written'root :=
  { Count.written'decision0 with place := 1 }
def relocated := Soundness.Installed model written'decision0 draws requested
example : written'decision0.place ≠ Count.written'decision0.place := by decide +kernel
example : relocated = CountBoundRoots.installed := rfl

def covers : type_of% StandardInterpretation.covers := fun _ _ _ ↦ true
def uncheckedCoverage := Soundness.Result model Count.written'decision0 draws covers requested

end Control
end CountBoundRoots
end

-- Read the bound and the issued clause independently of the names opened by the fixture.
example : CountBoundRoots.requested = ZkcFormal.ProbabilisticProcess.toProbability (3 / 8) := rfl
example : Count.written'decision0.place = 0 := rfl

open Lean Elab Command

/-- Include theorem and opaque values, proof arguments, and the types of every dependency. -/
private def reachable (roots : List Name) : CoreM NameSet := do
  let mut pending := roots
  let mut seen : NameSet := {}
  while let n :: rest := pending do
    pending := rest
    unless seen.contains n do
      seen := seen.insert n
      let decl ← getConstInfo n
      pending := decl.getUsedConstantsAsSet.toList ++ pending
  return seen

private def forbidden : List Name :=
  [``Zkc.Subject.CapTable, ``Zkc.Subject.UseCaps, ``Zkc.Subject.Cap, ``Zkc.Subject.DrawCap,
   ``Zkc.Subject.CallCap, ``Zkc.Subject.DrawCharge, ``Zkc.Subject.GoalFields,
   ``Zkc.Subject.WrittenGoal, ``Zkc.Subject.WrittenSubject, ``ZkcFormal.Written.Goal.Judged,
   ``ZkcFormal.ProbabilisticProcess.paysWithin, ``Count.written'caps0, ``Count.written'fields0,
   ``Count.written'goal0, ``Count.written'subject, ``Count.written'decision1, ``Count.loose_counted,
   ``Count.loose_claim_of_judged, ``Count.loose_witnessed_of]

private def clean (root : Name) (seen : NameSet) : CoreM Unit := do
  let leaks := forbidden.filter seen.contains
  unless leaks.isEmpty do throwError "{root} depends on {leaks}"

private def requireNames (root : Name) (seen : NameSet) (required : List Name) : CoreM Unit := do
  for n in required do
    unless seen.contains n do throwError "{root} should reach {n}"

/-- Check the unreduced application. Graph membership cannot identify an operand. -/
private def checkOperands (root owner : Name) (extra : List Name)
    : CoreM (Except (List Nat) Unit) := do
  let some body := (← getConstInfo root).value? (allowOpaque := true)
    | throwError "missing body of {root}"
  let args := [``ZkcFormal.Written.Standard, ``ZkcFormal.Written.StandardInterpretation.model,
    ``Count.subjectPackage, ``Count.written'root, ``Count.written'decision0,
    ``ZkcFormal.Written.StandardInterpretation.draws] ++ extra
  unless body.isAppOfArity owner args.length do
    throwError "{root} should apply {owner} to {args.length} arguments"
  let mismatches := args.zipIdx.filterMap fun (expected, index) =>
    if (body.getArg! index).isConstOf expected then none else some index
  return if mismatches.isEmpty then .ok () else .error mismatches

private def expectWrongOperand (root owner : Name) (extra : List Name) (index : Nat) : CoreM Unit := do
  match ← checkOperands root owner extra with
  | .ok () => throwError "accepted the replacement operand of {root}"
  | .error slots => unless slots == [index] do throwError "{root}: wrong operands {slots}, expected [{index}]"

/-- Check the trusted roots here and again as imported declarations in the submitting reader. -/
def CountBoundRoots.checkRoots : CoreM Unit := do
  let installed := ``ZkcFormal.Written.Soundness.Installed
  let result := ``ZkcFormal.Written.Soundness.Result
  let magnitude := ``CountBoundRoots.requested
  let some value := (← getConstInfo magnitude).value? | throwError "missing body of {magnitude}"
  unless value.isAppOfArity ``ZkcFormal.ProbabilisticProcess.toProbability 1 do
    throwError "{magnitude} should apply toProbability to the requested magnitude"

  let bound := [magnitude]
  let covered := ``ZkcFormal.Written.StandardInterpretation.covers :: bound
  for owner in [``ZkcFormal.Written.Soundness.Rejected, ``ZkcFormal.Written.Soundness.BoundOf,
      installed, ``ZkcFormal.Written.Soundness.AdmittedBound, result,
      ``ZkcFormal.Written.Soundness.Witnessed, ``ZkcFormal.Written.Soundness.witnessed_of,
      ``ZkcFormal.Written.Soundness.installed_iff_admitted, ``ZkcFormal.Written.Soundness.installed_mono] do
    unless (← getConstInfo owner).hasValue (allowOpaque := true) do
      throwError "missing body of public owner {owner}"
    clean owner (← reachable [owner])

  for (root, owner, extra) in [
      (``CountBoundRoots.installed, installed, bound),
      (``CountBoundRoots.admitted, ``ZkcFormal.Written.Soundness.AdmittedBound, bound),
      (``CountBoundRoots.result, result, covered),
      (``CountBoundRoots.witnessed, ``ZkcFormal.Written.Soundness.Witnessed, []),
      (``CountBoundRoots.witnessOf, ``ZkcFormal.Written.Soundness.witnessed_of,
        [``ZkcFormal.Written.StandardInterpretation.served])] do
    if let .error slots ← checkOperands root owner extra then
      throwError "{root}: wrong operands {slots}"
    let seen ← reachable [root]
    clean root seen
    requireNames root seen [``Count.written'decision0, ``Count.written'root, ``Count.subjectPackage,
      ``Count.written'fn3, ``Count.found'root, ``Count.found'fn3]
    unless seen.contains magnitude == extra.contains magnitude do
      throwError "{root}: unexpected dependence on the requested bound"

  -- Each shadow must fail the same operand comparison at its own slot.
  expectWrongOperand ``CountBoundRoots.Control.relocated installed bound 4
  expectWrongOperand ``CountBoundRoots.Control.uncheckedCoverage result covered 6

  -- On the twin all graph requirements pass. Only the physical decision slot distinguishes it.
  for (root, index, leaks) in [
      (``CountBoundRoots.Control.redirected, 4, []),
      (``CountBoundRoots.Control.sibling, 4, [``Count.written'decision1]),
      (``CountBoundRoots.Control.projected, 4,
        [``Count.written'goal0, ``Count.written'fields0, ``Count.written'caps0]),
      (``CountBoundRoots.Control.throughProof, 4, [``Count.loose_counted, ``Count.written'caps0]),
      (``CountBoundRoots.Control.fromFees, 6, [``Count.written'caps0])] do
    expectWrongOperand root installed bound index
    let seen ← reachable [root]
    if leaks.isEmpty then
      clean root seen
      requireNames root seen [``Count.written'decision0, ``CountBoundRoots.requested]
    else
      requireNames root seen leaks
      unless leaks.all forbidden.contains do throwError "unexpected control declarations {leaks}"

  let field := ``CountBoundRoots.Control.boolean
  clean field (← reachable (← getConstInfo field).type.getUsedConstants.toList)
  requireNames field (← reachable [field]) [``Count.loose_counted, ``Count.written'caps0]

  let presentation := ``CountBoundRoots.Control.feePresentation
  let decl ← getConstInfo presentation
  let some proof := decl.value? (allowOpaque := true) | throwError "missing proof of {presentation}"
  clean presentation (← reachable proof.getUsedConstants.toList)
  requireNames presentation (← reachable [presentation]) [``Count.written'caps0]

  let helper := ``CountBoundRoots.Control.borrowed
  clean helper (← reachable (← getConstInfo helper).type.getUsedConstants.toList)
  requireNames helper (← reachable [helper]) [``Count.loose_witnessed_of, ``Count.written'caps0]

run_cmd liftCoreM CountBoundRoots.checkRoots
