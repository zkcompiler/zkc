noncomputable section

/-- The relation of the goal returns the claim. -/
theorem guessing_relation {F G : Type} (D : StandardModel.Data F G) [DecidableEq F]
    [DecidableEq G] (claim : Bool) :
    functionResult (t := .bool)
      (fnMeaning (StandardModel.model D) installed guessingMember (.cons claim .nil)) =
        some claim := by
  kernel_rfl

/-- **The hypotheses of the claim are met**: at the source field, on the false claim,
with the service of the laws. -/
theorem guessing_witnessed : guessingWitnessed :=
  guessing_witnessed_of false trivial
    (guessing_relation StandardInterpretation.D false)

end
