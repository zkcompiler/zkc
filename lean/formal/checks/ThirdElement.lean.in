namespace ThirdElement
open Zkc.Core ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess OracleComp ProbComp
open StandardInterpretation (F G D large)
open scoped ScalarField ENNReal NNRat
noncomputable section
theorem sound_judged : soundJudged := by
  claim_intro
  let w : F := 2
  have bfalse : input_b = false := by
    cases e : input_b
    · rfl
    · have ev : functionResult (t := .bool) (fnMeaning StandardInterpretation.model installed soundMember (.cons true (.cons w .nil))) =
          some true := by
        apply functionResult_of_judged
        walk
        decide
      have reject := rejected w trivial
      rw [e, ev] at reject
      simp at reject
  subst input_b
  walk
  walk_free as unused
  walk
theorem field_claim : soundClaim := sound_claim_of_judged sound_judged

theorem hypotheses_met : soundWitnessed := by
  apply sound_witnessed_of false trivial
  repeat intro
  apply functionResult_of_judged
  walk
#print axioms sound_judged
#print axioms field_claim
#print axioms hypotheses_met
end
end ThirdElement
