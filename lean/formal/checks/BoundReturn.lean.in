theorem rejectedFalse : rejectedFalseStatement := by
  change functionResult (t := .bool) (fnMeaning model installed looseMember (.cons false .nil)) =
    some false
  kernel_rfl

private noncomputable abbrev service := serveLaws model draws

private theorem conforms : service.Conforms samplers (Permitted model) :=
  ⟨serveLaws_follows _ _, serveLaws_permitted _ _ (ArithmeticModel.draws_permitted F G)⟩

theorem met : metStatement :=
  Soundness.witnessed_of model written'decision0 draws ⟨Unit, service, ⟨()⟩, conforms⟩
    false trivial rejectedFalse
