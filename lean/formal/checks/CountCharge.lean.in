/-!
The verifier of `Count<8>` within the charges of its two goals.

Before this text the check writes the printed package of the root and what it read from the
source: the key of the root (`rootKey`, with `rootHeader`, `rootNames`, `rootBody` and
`calleeProgram`, the program before the root), the roles (`verifierRole`, `proverRole`), and
for each goal the value of its proof argument and its charge on the draw (`looseTolerance`,
`looseCharge`, `strictTolerance`, `strictCharge`).

One thing is bound here by hand: the relation. The source says
`NearZero(xs): (∑ i ∈ 0..n, if xs[i] == 0 then 0 else 1) <= e`, and a table is outside it when
more than `e` of its entries are not zero: `e < xs.countP (· ≠ D.zero)`. The check compares the
line of the source with the line it was read from, and no theorem here says that the two mean
the same.
-/

open Zkc.Formal Zkc.Formal.ProbabilisticProcess Zkc.Formal.Written OracleComp ProbComp
open Zkc.Frontend.Written (DrawCharge)
open scoped NNRat ENNReal

noncomputable section

/-- The charge of `loose` is the bound at its tolerance: of eight positions, all but
`tolerance + 1` can be zero in a table outside the relation. -/
theorem loose_exact : ceiling looseCharge = ((7 - looseTolerance : ℕ) : ℚ≥0) / (8 : ℕ) := by
  norm_num [ceiling, looseCharge, looseTolerance]

/-- The charge of `strict` is the bound at its tolerance. -/
theorem strict_exact : ceiling strictCharge = ((7 - strictTolerance : ℕ) : ℚ≥0) / (8 : ℕ) := by
  norm_num [ceiling, strictCharge, strictTolerance]

-- The verifier's program, in the kernel's normal form.
kernel_normal verifier :
    Term (roleDialect V calleeProgram.headers verifierRole) (Ctx.empty.extend rootNames) rootHeader.outs :=
  project verifierRole rootBody

section
variable {F G : Type} (D : StandardModel.Data F G) [DecidableEq F] [DecidableEq G]

/-- The model of the standard rows over a field and a group. -/
abbrev model : Model V := StandardModel.model D

/-- What the verifier holds when the run starts: the table. -/
def inputs (xs : List F) : HList (RV (model D) verifierRole) rootHeader.ins := .cons xs .nil

/-- A draw of a position at an occurrence: the verifier's coin, which the prover hears. -/
def coinAt (at_ : Occurrence) : InputPort V :=
  .own (.coin (.uniform (.fin 8))) [proverRole] at_ (.fin 8)

/-- The draw of the position in a run that starts at `path`. -/
abbrev coin (path : List Frame) : InputPort V := coinAt ⟨path, ⟨0⟩⟩

/-- The fees of a charge in a run of the root: the position is drawn uniformly, and each fee is
within what the charge allows the effect that pays it. -/
abbrev fees (charge : DrawCharge) (path : List Frame) :=
  paysWithin (portSamplers (model D) (coin path) (drawPosition 7))
    (allowance (model D) charge rootKey path)

/-- The verifier's process, as the walk reads it. -/
abbrev walked (path : List Frame) (xs : List F) :=
  verifier.denote (roleSem (model D) verifierRole (Defs.fnTable _ calleeProgram.defs)
    (Defs.rTable _ calleeProgram.defs)) path (Env.empty.extend rootNames (inputs D xs))

/-- The verifier is judged never to return on a table outside the relation, within the budget of
a charge of the root on the draw whose ceiling covers the bound: the fee of the draw pays for the
positions at which the table is zero. -/
theorem walked_within (path : List Frame) (xs : List F) (tolerance : ℕ) (charge : DrawCharge)
    (length : xs.length = 8) (far : tolerance < xs.countP (· ≠ D.zero))
    (owned : charge.owner = rootKey) (site : charge.draws = [([], ⟨0⟩)])
    (covers : ((7 - tolerance : ℕ) : ℚ≥0) / (8 : ℕ) ≤ ceiling charge) :
    (walked D path xs).interpret (.charged (Permitted (model D)) (fees D charge path))
      (fun _ _ => False) (fun _ _ => True) (budget charge) := by
  walk_step
  refine ⟨ceiling charge, fun z : ℕ => xs[z]? = some D.zero, ?_,
    ⟨Or.inr ⟨drawPosition 7, portSamplers_at _ (coin path) _, ?_⟩, ?_⟩, fun z allowedZ kept => ?_⟩
  · simp [budget, site]
  · rw [prEvent_drawPosition_entry xs 7 length]
    refine le_trans ?_ (toProbability_mono covers)
    rw [toProbability_natCast_div _ 8 (by norm_num)]
    have all := count_add_countP_ne xs D.zero
    have few : xs.count D.zero ≤ 7 - tolerance := by omega
    have counted : (xs.count D.zero : ℝ≥0∞) ≤ ((7 - tolerance : ℕ) : ℝ≥0∞) := by exact_mod_cast few
    have eight : ((7 : ℕ) : ℝ≥0∞) + 1 = ((8 : ℕ) : ℝ≥0∞) := by norm_num
    rw [eight]
    exact ENNReal.div_le_div_right counted _
  · simp [allowance, occurrenceOf, owned, site, ROp.occurrence]
  walk_step
  walk_step
  walk_step
  · trivial
  · walk_step
    walk_step
    walk_step
    · trivial
    · walk_step
      -- what the walk has said of the run that returns
      guard_hyp at2 :~ xs[z]? = some x3
      guard_hyp h4 : x4 = decide (x3 ≠ D.zero)
      guard_hyp h5 : x5 = !x4
      guard_hyp at5 : x5 = true
      subst h5 h4
      have zero : x3 = D.zero := by simpa using at5
      exact kept (at2.trans (congrArg some zero))

/-- What every judgment of the verifier that lets no run return pays for: a fee at the coin, for
every position at which the table is zero. -/
theorem walked_excludes (allowed : ∀ op, (RSig (model D)).Reply op → Prop)
    (pays : (op : ROp (model D)) → ℚ≥0 → ((RSig (model D)).Reply op → Prop) → Prop)
    (path : List Frame) (xs : List F) (within : ℚ≥0)
    (judged : (walked D path xs).interpret (.charged allowed pays) (fun _ _ => False)
      (fun _ _ => True) within) :
    ∃ fee excluded, fee ≤ within ∧ pays ((coin path).operation (model D)) fee excluded ∧
      ∀ z : ℕ, allowed ((coin path).operation (model D)) z → xs[z]? = some D.zero → excluded z := by
  walk_step at judged
  obtain ⟨fee, excluded, least, paid, rest⟩ := judged
  refine ⟨fee, excluded, least, paid, fun z allowedZ zero => ?_⟩
  by_contra kept
  have after := rest z allowedZ kept
  clear rest
  walk_step at after
  walk_step at after
  walk_step at after
  · exact absurd (at2.symm.trans zero) (by simp)
  · walk_step at after
    walk_step at after
    walk_step at after
    · subst h5 h4
      have same : x3 = D.zero := Option.some.inj (at2.symm.trans zero)
      simp [same] at at5
    · walk_step at after
      exact after

/-- The verifier's process in a run of the installed program is the process that the walk
reads. -/
theorem meaning_walked (path : List Frame) (xs : List F) :
    roleMeaning (model D) installed (Member.head : Member installed.headers.protocols rootHeader)
      verifierRole path (inputs D xs) = walked D path xs := by
  kernel_rfl

/-- The first instruction of a program, under another key. -/
def withFirstKey {dialect : Dialect} {Γ : Ctx dialect.Ty} {outs : List dialect.Ty} (key : Key) :
    Term dialect Γ outs → Term dialect Γ outs
  | .step _ instruction names rest => .step key instruction names rest
  | .ret exit => .ret exit

/-- The walk reads an instruction whose key is no literal: with the draw at any key, every
judgment of the verifier pays a fee at that draw. -/
theorem walk_reads_any_key (key : Key) (allowed : ∀ op, (RSig (model D)).Reply op → Prop)
    (pays : (op : ROp (model D)) → ℚ≥0 → ((RSig (model D)).Reply op → Prop) → Prop)
    (path : List Frame) (xs : List F) (within : ℚ≥0)
    (judged : ((withFirstKey key verifier).denote
        (roleSem (model D) verifierRole (Defs.fnTable _ calleeProgram.defs)
          (Defs.rTable _ calleeProgram.defs)) path
        (Env.empty.extend rootNames (inputs D xs))).interpret
      (.charged allowed pays) (fun _ _ => False) (fun _ _ => True) within) :
    ∃ fee excluded, fee ≤ within ∧
      pays ((coinAt ⟨path, key⟩).operation (model D)) fee excluded := by
  walk_step at judged
  obtain ⟨fee, excluded, least, paid, _⟩ := judged
  exact ⟨fee, excluded, least, paid⟩

end

/-- What holds of the root of the installed program holds of the root of every admitted
program. -/
theorem at_root {a : Admitted V} (admitted : admit stored association = .ok a)
    (P : (p : Typed V) → Member p.headers.protocols rootHeader → Prop)
    (holds : P installed Member.head) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧ P a.program root := by
  have same := readback admitted
  generalize a.program = p at same
  subst same
  exact ⟨Member.head, by kernel_rfl, holds⟩

section
variable {F G : Type} (D : StandardModel.Data F G) [DecidableEq F] [DecidableEq G]

/-- **Within the charge.** In every admitted program, on a table of eight entries of which more
than `tolerance` are not zero, the verifier is judged never to return within the budget of a
charge of the root on the draw of the position whose ceiling is at least `(7 - tolerance) / 8`,
each fee within what the charge allows the effect that pays it. -/
theorem judged_within (charge : DrawCharge) (tolerance : ℕ)
    (owned : charge.owner = rootKey) (site : charge.draws = [([], ⟨0⟩)])
    (covers : ((7 - tolerance : ℕ) : ℚ≥0) / (8 : ℕ) ≤ ceiling charge)
    {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) (xs : List F) (length : xs.length = 8)
    (far : tolerance < xs.countP (· ≠ D.zero)) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      (roleMeaning (model D) a.program root verifierRole path (inputs D xs)).interpret
        (.charged (Permitted (model D)) (fees D charge path)) (fun _ _ => False)
        (fun _ _ => True) (budget charge) :=
  at_root admitted
    (fun p root => (roleMeaning (model D) p root verifierRole path (inputs D xs)).interpret
      (.charged (Permitted (model D)) (fees D charge path)) (fun _ _ => False)
      (fun _ _ => True) (budget charge))
    (by
      rw [meaning_walked]
      exact walked_within D path xs tolerance charge length far owned site covers)

/-- **The probability.** Against every service that draws the position uniformly and answers
only what is permitted, the simulation of the verifier by the service's handler returns with
probability at most the total of the charge. A service is any handler of the verifier's effects
with a state (`handlerOf_serviceOf`). -/
theorem returns_within (charge : DrawCharge) (tolerance : ℕ)
    (owned : charge.owner = rootKey) (site : charge.draws = [([], ⟨0⟩)])
    (covers : ((7 - tolerance : ℕ) : ℚ≥0) / (8 : ℕ) ≤ ceiling charge)
    (positive : 0 < charge.denominator)
    {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) (xs : List F) (length : xs.length = 8)
    (far : tolerance < xs.countP (· ≠ D.zero))
    {σ : Type} (service : Service (RSig (model D)) σ)
    (follows : service.Follows (portSamplers (model D) (coin path) (drawPosition 7)))
    (permitted : ∀ op s reply t, (some reply, t) ∈ support (service op s) →
      Permitted (model D) op reply) (s : σ) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      Pr{let out ← (simulateQ (handlerOf service) (embed
          (roleMeaning (model D) a.program root verifierRole path (inputs D xs)))).run.run s}[
        ∃ results, out.1 = some (.inl results)] ≤ total charge := by
  obtain ⟨root, found, judged⟩ :=
    judged_within D charge tolerance owned site covers admitted path xs length far
  refine ⟨root, found, ?_⟩
  rw [prEvent_simulation_returns, ← toProbability_budget charge positive]
  exact allowed_bounds_return service _ (allowance (model D) charge rootKey path)
    (Permitted (model D)) permitted follows _ (budget charge) s judged

/-! ## The two goals -/

/-- The goal `loose`: on a table of which more than its tolerance of entries are not zero, the
verifier returns with probability at most the total of its charge. -/
theorem loose_sound {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) (xs : List F) (length : xs.length = 8)
    (far : looseTolerance < xs.countP (· ≠ D.zero))
    {σ : Type} (service : Service (RSig (model D)) σ)
    (follows : service.Follows (portSamplers (model D) (coin path) (drawPosition 7)))
    (permitted : ∀ op s reply t, (some reply, t) ∈ support (service op s) →
      Permitted (model D) op reply) (s : σ) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      Pr{let out ← (simulateQ (handlerOf service) (embed
          (roleMeaning (model D) a.program root verifierRole path (inputs D xs)))).run.run s}[
        ∃ results, out.1 = some (.inl results)] ≤ total looseCharge :=
  returns_within D looseCharge looseTolerance (by decide) (by decide) loose_exact.ge (by decide)
    admitted path xs length far service follows permitted s

/-- The goal `strict`, as `loose`. -/
theorem strict_sound {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) (xs : List F) (length : xs.length = 8)
    (far : strictTolerance < xs.countP (· ≠ D.zero))
    {σ : Type} (service : Service (RSig (model D)) σ)
    (follows : service.Follows (portSamplers (model D) (coin path) (drawPosition 7)))
    (permitted : ∀ op s reply t, (some reply, t) ∈ support (service op s) →
      Permitted (model D) op reply) (s : σ) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      Pr{let out ← (simulateQ (handlerOf service) (embed
          (roleMeaning (model D) a.program root verifierRole path (inputs D xs)))).run.run s}[
        ∃ results, out.1 = some (.inl results)] ≤ total strictCharge :=
  returns_within D strictCharge strictTolerance (by decide) (by decide) strict_exact.ge (by decide)
    admitted path xs length far service follows permitted s

end

/-! ## The hypotheses are met, and the bound is reached -/

namespace Witness
open Zkc.Formal.Written.FiniteModel (data)

/-- A table over the field of two elements, outside the relation at the tolerance of `loose`:
five entries are not zero, three are. -/
def looseTable : List Bool := [true, true, true, true, true, false, false, false]

/-- A table outside the relation at the tolerance of `strict`: two entries are not zero. -/
def strictTable : List Bool := [true, true, false, false, false, false, false, false]

/-- The service of the coin: it draws a position uniformly, and answers nothing else. -/
abbrev service (path : List Frame) : Service (RSig (model data)) Unit :=
  serveAt (model data) (coin path) (drawPosition 7)

/-- A position below eight is what the coin may give. -/
theorem position_permitted (path : List Frame) (z : ℕ) (below : z < 8) :
    Permitted (model data) ((coin path).operation (model data)) z :=
  ⟨below, ⟨[], .fin 8⟩, rfl, rfl, rfl, below⟩

theorem service_permitted (path : List Frame) (op : ROp (model data)) (s : Unit)
    (reply : (RSig (model data)).Reply op) (t : Unit)
    (reached : (some reply, t) ∈ support (service path op s)) : Permitted (model data) op reply :=
  serveAt_permitted _ _ _
    (fun z drawn => position_permitted path z (lt_of_mem_support_drawPosition 7 z drawn))
    op s reply t reached

/-- The probability that the simulation of the verifier of a program returns at a table, against
the service. -/
abbrev returnsAt (p : Typed V) (root : Member p.headers.protocols rootHeader) (path : List Frame)
    (xs : List Bool) : ℝ≥0∞ :=
  Pr{let out ← (simulateQ (handlerOf (service path)) (embed
      (roleMeaning (model data) p root verifierRole path (inputs data xs)))).run.run ()}[
    ∃ results, out.1 = some (.inl results)]

/-- The goal `loose` at its table, with nothing left to assume: the service draws as the
samplers do and answers what is permitted, and the table is outside the relation. -/
theorem loose_at_table {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      returnsAt a.program root path looseTable ≤ total looseCharge :=
  loose_sound data admitted path looseTable rfl (by decide) (service path)
    (serveAt_follows _ _ _) (service_permitted path) ()

/-- The goal `strict` at its table, with nothing left to assume. -/
theorem strict_at_table {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      returnsAt a.program root path strictTable ≤ total strictCharge :=
  strict_sound data admitted path strictTable rfl (by decide) (service path)
    (serveAt_follows _ _ _) (service_permitted path) ()

/-! ### The probability at the tables -/

/-- What follows the draw of a position. -/
abbrev afterDraw (path : List Frame) (xs : List Bool) (z : ℕ) :=
  afterFirst (walked data path xs) z

/-- The verifier begins with the draw. -/
theorem begins (path : List Frame) (xs : List Bool) :
    walked data path xs = .call ((coin path).operation (model data)) (afterDraw path xs) := by
  kernel_rfl

/-- How the run ends in which the position `i` is drawn: the verifier returns when the entry
there is zero, and the guard rejects when it is not. -/
def outcomeAt (path : List Frame) (xs : List Bool) (i : Fin 8) :
    ProbabilisticProcess.Outcome Stop (HList (RV (model data) verifierRole) rootHeader.outs) :=
  if xs[i.val]? = some data.zero then .returned .nil
  else .halted (.declared .reject ⟨path, ⟨5⟩⟩)

/-- When each run ends as `outcomeAt` says, the verifier returns with the probability of the
entries that are zero. -/
theorem returns_exactly (path : List Frame) (xs : List Bool) (length : xs.length = 8)
    (ends : ∀ i : Fin 8,
      run (service path) (afterDraw path xs i.val) () = pure (outcomeAt path xs i, ())) :
    Pr{let out ← run (service path) (walked data path xs) ()}[
        ∃ results, out.1 = .returned results] = (xs.count data.zero : ℝ≥0∞) / ((7 : ℕ) + 1) := by
  rw [begins]
  have drawn := prEvent_run_serveAt (model data) (coin path) ($ᵗ (Fin (7 + 1)))
    (fun i : Fin 8 => (i : ℕ)) (afterDraw path xs) (outcomeAt path xs) ends
    (fun outcome => ∃ results, outcome = .returned results)
  rw [← prEvent_drawPosition_entry xs 7 length, drawPosition, prEvent_map]
  refine drawn.trans (prEvent_congr_of_support _ _ _ fun i _ => ?_)
  unfold outcomeAt
  split
  · exact iff_of_true ⟨_, rfl⟩ ‹_›
  · exact iff_of_false (fun ⟨_, same⟩ => by cases same) ‹_›

/-- A count of zero entries over eight is the total of a charge when it is its budget. -/
theorem count_is_total (charge : DrawCharge) (positive : 0 < charge.denominator) (zeros : ℕ)
    (exact : (zeros : ℚ≥0) / (8 : ℕ) = budget charge) :
    (zeros : ℝ≥0∞) / ((7 : ℕ) + 1) = total charge := by
  have eight : ((7 : ℕ) : ℝ≥0∞) + 1 = ((8 : ℕ) : ℝ≥0∞) := by norm_num
  rw [eight, ← toProbability_natCast_div zeros 8 (by norm_num), exact,
    toProbability_budget charge positive]

theorem loose_ends (path : List Frame) (i : Fin 8) :
    run (service path) (afterDraw path looseTable i.val) () =
      pure (outcomeAt path looseTable i, ()) := by
  fin_cases i <;> kernel_rfl

theorem strict_ends (path : List Frame) (i : Fin 8) :
    run (service path) (afterDraw path strictTable i.val) () =
      pure (outcomeAt path strictTable i, ()) := by
  fin_cases i <;> kernel_rfl

/-- **The bound of `loose` is reached.** At its table the verifier of every admitted program
returns with probability exactly the total of the charge: the bound is not met by a verifier
that never returns, and the charge is not larger than it has to be. -/
theorem loose_attained {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      returnsAt a.program root path looseTable = total looseCharge :=
  at_root admitted (fun p root => returnsAt p root path looseTable = total looseCharge)
    (by
      unfold returnsAt
      rw [prEvent_simulation_returns, meaning_walked,
        returns_exactly path looseTable rfl (loose_ends path)]
      have zeros : looseTable.count data.zero = 3 := by decide
      rw [zeros]
      exact count_is_total looseCharge (by decide) 3 (by norm_num [budget, ceiling, looseCharge]))

/-- **The bound of `strict` is reached.** -/
theorem strict_attained {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      returnsAt a.program root path strictTable = total strictCharge :=
  at_root admitted (fun p root => returnsAt p root path strictTable = total strictCharge)
    (by
      unfold returnsAt
      rw [prEvent_simulation_returns, meaning_walked,
        returns_exactly path strictTable rfl (strict_ends path)]
      have zeros : strictTable.count data.zero = 6 := by decide
      rw [zeros]
      exact count_is_total strictCharge (by decide) 6
        (by norm_num [budget, ceiling, strictCharge]))

/-! ### The fee is paid at the draw of the root -/

/-- A set of positions that has every position at which the table of `loose` is zero has at
least three eighths of the draw. -/
theorem excluded_weighs (path : List Frame) (excluded : ℕ → Prop)
    (zeros : ∀ z : ℕ, Permitted (model data) ((coin path).operation (model data)) z →
      looseTable[z]? = some data.zero → excluded z) :
    3 / 8 ≤ Pr{let z ← drawPosition 7}[excluded z] := by
  have weighs : Pr{let z ← drawPosition 7}[looseTable[z]? = some data.zero] = 3 / 8 := by
    rw [prEvent_drawPosition_entry looseTable 7 rfl]
    have three : looseTable.count data.zero = 3 := by decide
    rw [three]
    norm_num
  rw [← weighs]
  exact prEvent_mono_of_support _ _ _ fun z drawn zero =>
    zeros z (position_permitted path z (lt_of_mem_support_drawPosition 7 z drawn)) zero

/-- A charge that allows the draw nothing judges the verifier at the table at no budget: the
zero fee excludes no position, and the verifier returns at three of them. -/
theorem unallowed_judges_nothing (charge : DrawCharge) (path : List Frame)
    (nothing : allowance (model data) charge rootKey path ((coin path).operation (model data)) = 0)
    {a : Admitted V} (admitted : admit stored association = .ok a) (any : ℚ≥0) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      ¬ (roleMeaning (model data) a.program root verifierRole path
          (inputs data looseTable)).interpret
        (.charged (Permitted (model data)) (fees data charge path)) (fun _ _ => False)
        (fun _ _ => True) any :=
  at_root admitted
    (fun p root => ¬ (roleMeaning (model data) p root verifierRole path
        (inputs data looseTable)).interpret
      (.charged (Permitted (model data)) (fees data charge path)) (fun _ _ => False)
      (fun _ _ => True) any)
    (by
      rw [meaning_walked]
      intro judged
      obtain ⟨fee, excluded, _, ⟨paid, allowed⟩, zeros⟩ :=
        walked_excludes data _ _ path looseTable any judged
      have free : fee = 0 := by simpa [nothing] using allowed
      rcases paid with ⟨_, none⟩ | ⟨draw, has, weight⟩
      · exact none (5 : ℕ) (zeros 5 (position_permitted path 5 (by decide)) rfl)
      · obtain rfl : drawPosition 7 = draw :=
          Option.some.inj ((portSamplers_at (model data) (coin path) (drawPosition 7)).symm.trans has)
        have absurd : (3 : ℝ≥0∞) / 8 ≤ 0 := by
          simpa [free, toProbability] using (excluded_weighs path excluded zeros).trans weight
        simp at absurd)

/-- The charge of `loose`, on the guard and not on the draw. -/
def misplaced : DrawCharge := { looseCharge with draws := [([], ⟨5⟩)] }

/-- The charge of `loose`, of another definition with a draw at the same key. -/
def foreign : DrawCharge := { looseCharge with owner := ⟨rootKey.number + 1⟩ }

/-- **The fee is paid at the draw.** A charge on another instruction judges the verifier at no
budget. -/
theorem misplaced_judges_nothing {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) (any : ℚ≥0) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      ¬ (roleMeaning (model data) a.program root verifierRole path
          (inputs data looseTable)).interpret
        (.charged (Permitted (model data)) (fees data misplaced path)) (fun _ _ => False)
        (fun _ _ => True) any :=
  unallowed_judges_nothing misplaced path
    (by simp [allowance, occurrenceOf, misplaced, looseCharge, ROp.occurrence, coin, coinAt,
      InputPort.operation]) admitted any

/-- **The fee is paid in the definition that owns the charge.** A charge of another definition
judges the verifier at no budget, though it names a draw at the same key. -/
theorem foreign_judges_nothing {a : Admitted V} (admitted : admit stored association = .ok a)
    (path : List Frame) (any : ℚ≥0) :
    ∃ root : Member a.program.headers.protocols rootHeader,
      a.program.findProtocol rootKey = some ⟨rootHeader, root⟩ ∧
      ¬ (roleMeaning (model data) a.program root verifierRole path
          (inputs data looseTable)).interpret
        (.charged (Permitted (model data)) (fees data foreign path)) (fun _ _ => False)
        (fun _ _ => True) any :=
  unallowed_judges_nothing foreign path
    (by simp [allowance, foreign, looseCharge]) admitted any

end Witness
end
