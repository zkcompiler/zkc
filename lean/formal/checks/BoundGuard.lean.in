private theorem relationValue (x : Bool) :
    functionResult (t := .bool) (fnMeaning model installed member'fn0 (.cons x .nil)) = some x := by
  kernel_rfl

/-- On the rejected input the verifier draws and stops: it is judged within a budget of zero
under its own table. -/
theorem withinZero : Fees.JudgedWithin model written'application0 StandardInterpretation.draws written'caps0 0 := by
  intro path x _ rejected
  cases x with
  | true => exact False.elim (rejected (relationValue true))
  | false =>
    have shape : roleMeaning model installed rootMember verifierRole path
        (.cons () (.cons false .nil)) =
        .call (.own (.coin (.uniform (.fin 4))) [0] ⟨path, ⟨0⟩⟩ [] .nil (.fin 4))
          (fun _ ↦ .halt (.declared .reject ⟨path, ⟨1⟩⟩)) := by kernel_rfl
    change Process.interpret (L := ℚ≥0 → Prop) _ _ _ (roleMeaning model installed rootMember verifierRole path
      (.cons () (.cons false .nil))) 0
    rw [shape]
    exact ZkcFormal.Written.charged_free _ _ _ _ _ _ (fun _ _ ↦ True.intro)

/-- The table's budget is one over four: the judgment's budget is its own number, not the table's. -/
theorem belowTable : (0 : NNRat) < written'caps0.budget := by
  decide +kernel

theorem guard_bound.loose.sound : published% written'subject guard_bound.loose sound :=
  guard_bound.loose.sound_of_installed (guard_bound.loose.installed.view_iff.mpr
    (Fees.installed_of_judged model written'application0 StandardInterpretation.draws written'caps0 withinZero
      (by simp [ZkcFormal.ProbabilisticProcess.toProbability])))

theorem guard_bound.loose.met : published% written'subject guard_bound.loose met :=
  guard_bound.loose.met.view_iff.mp ⟨false, trivial, served, fun accepted => by
    have := (relationValue false).symm.trans accepted
    simp at this⟩
