/-!
The verifier of Freivalds' check of a matrix product within the table of caps of its goal.

Before this text the check writes the printed package of what the goal claims (the function
`apply`, the protocol of the scheme, then the relation `Product` of the clause) and, generated
from what the frontend read: the facts (`rootKey` with `rootHeader`, `rootNames`, `rootBody`,
`rootMember` and `calleeProgram`, the program before the root; `verifierRole`, `proverRole`; for
the function that the root calls `applyKey`, `applyHeader`, `applyNames`, `applyBody`,
`applyBefore` and `applyMember`; for the goal `soundCaps`, `soundKey` with `soundHeader`,
`soundNames`, `soundBody`, `soundBefore` and `soundMember`), that the arithmetic model covers
the package (`covered`), where the walks start (`verifierProgram` with `verifier_meaning`,
`apply_meaning`, `sound_meaning`), the transfers `at_root` and `at_sound`, and the propositions
`soundClaim`, `soundGoal`, `soundResult` and `soundWitnessed`, with the judgment that the
method of fees establishes (`soundJudged`), the theorem that the claim follows from it
(`sound_claim_of_judged`) and the theorem that its hypotheses are met at matrices on which the
relation returns false (`sound_witnessed_of`).
After this text it writes the claim `sound_installed` from `sound_judged`, and the theorems of
the propositions that were stated before it: the goal `sound_sound`, the result `sound_result`
with the coverage, and `sound_met` from `sound_witnessed`. This text proves the judgment and
gives the matrices.

Nothing of the statement is written here. The source says
`Product(a, b, c): ∀ i ∈ 0..n, ∀ j ∈ 0..n, (∑ k ∈ 0..n, a[i][k] * b[k][j]) == c[i][j]` and
`apply(m, v) = [∑ k ∈ 0..n, m[i][k] * v[k] for i in 0..n]`; the package has both as functions
at `n = 2`, and `sound_relation` and `apply_law` say what they compute in the terms of
matrices: whether the product of two matrices is a third, and the product of a matrix and a
vector. The verifier draws a vector and compares `apply(a, apply(b, r))` with `apply(c, r)`.
Where the product differs, the vectors on which the comparison holds are zeros of a row of
`A * B - C` that is not zero, which a uniform vector hits with probability at most `1 / |F|`.
-/

noncomputable section

/-! ## Matrices as the values of sequences of sequences -/

section
variable {F : Type}

/-- A matrix as the value of a sequence of sequences: the list of its rows. -/
def rows (M : Matrix (Fin 2) (Fin 2) F) : List (List F) := List.ofFn fun i => List.ofFn (M i)

/-- The row of a matrix at a position: what a read of the rows finds. -/
@[walk_read]
theorem rows_at (M : Matrix (Fin 2) (Fin 2) F) (i : ℕ) (below : i < 2) :
    (rows M)[i]? = some (List.ofFn (M ⟨i, below⟩)) :=
  List.getElem?_ofFn_of_lt _ i below

end

/-! ## What the functions of the package compute -/

section
variable {F G : Type} [Field F] [DecidableEq F] [AddCommGroup G] [Module F G] [DecidableEq G]

variable (F G) in
/-- The arithmetic model over a field and a module over it. -/
abbrev model : Model V := ArithmeticModel.model F G

/-- The type of a square matrix of the source: two sequences of two scalars. -/
abbrev matrixTy : V.Ty := .seq (.seq scalarTy (some 2)) (some 2)

variable (G) in
/-- A valid value of the type of a matrix is the list of the rows of a matrix. -/
theorem rows_of_valid (m : (model F G).Val matrixTy) (valid : (model F G).Valid matrixTy m) :
    ∃ M : Matrix (Fin 2) (Fin 2) F, m = rows M := by
  obtain ⟨row, isRows⟩ := List.exists_ofFn_of_length (m : List (List F)) 2 (valid.2 2 rfl)
  have each : ∀ i, ∃ entries : Fin 2 → F, row i = List.ofFn entries := fun i =>
    List.exists_ofFn_of_length (row i) 2 ((valid.1 (row i) (isRows ▸ (List.mem_ofFn' row (row i)).mpr ⟨i, rfl⟩)).2 2 rfl)
  choose entries isEntries using each
  exact ⟨entries, isRows.trans (congrArg List.ofFn (funext isEntries))⟩

variable (G) in
/-- **What `apply` computes.** On the rows of a matrix and the list of a vector, the function
returns the list of the product of the matrix and the vector. -/
theorem apply_law (m : List (List F)) (v : List F) (M : Matrix (Fin 2) (Fin 2) F) (w : Fin 2 → F)
    (hm : m = rows M) (hv : v = List.ofFn w) :
    fnMeaning (model F G) calleeProgram applyMember (.cons m (.cons v .nil)) =
      .done (.cons (List.ofFn (M.mulVec w)) .nil) := by
  refine done_of_judged ?_
  walk_loop fun i (collected : List F) _ => collected.reverse = (List.ofFn (M.mulVec w)).take i
  case first => rfl
  case step =>
    -- the products of the row `i` with the vector, one coordinate at a time
    walk_loop fun k (products : List F) _ =>
      products.reverse = (List.ofFn fun k => M ⟨i, early_i⟩ k * w k).take k
    case first => rfl
    case step =>
      walk
      refine List.collected_next _ _ _ _ invariant_k
        ((List.getElem?_ofFn_of_lt _ k early_k).trans (congrArg some ?_))
      ring
    case after =>
      walk
      refine List.collected_next _ _ _ _ invariant_i ?_
      rw [List.getElem?_ofFn_of_lt _ i early_i, List.collected_all _ _ 2 (by simp) invariant_k]
      exact congrArg some List.sum_ofFn.symm
  case after =>
    walk
    exact List.collected_all _ _ 2 (by simp) invariant_i

variable (G) in
/-- **What the relation computes.** On the rows of three matrices, the function that the package
has for `Product` returns whether the product of the first two is the third. -/
theorem sound_relation (a b c : List (List F)) (A B C : Matrix (Fin 2) (Fin 2) F)
    (ha : a = rows A) (hb : b = rows B) (hc : c = rows C) :
    functionResult (t := .bool)
        (fnMeaning (model F G) installed soundMember (.cons a (.cons b (.cons c .nil)))) =
      some (decide (A * B = C)) := by
  refine functionResult_of_judged ?_
  walk
  walk_loop fun i (holds : Bool) _ => (holds = true ↔ ∀ p : Fin 2, p.val < i → (A * B) p = C p)
  case first => exact ⟨fun _ p below => absurd below (Nat.not_lt_zero _), fun _ => rfl⟩
  case step =>
    walk
    walk_loop fun j (holds : Bool) _ =>
      (holds = true ↔ ∀ q : Fin 2, q.val < j → (A * B) ⟨i, early_i⟩ q = C ⟨i, early_i⟩ q)
    case first => exact ⟨fun _ q below => absurd below (Nat.not_lt_zero _), fun _ => rfl⟩
    case step =>
      -- the products of the row `i` of `A` with the column `j` of `B`
      walk_loop fun k (products : List F) _ =>
        products.reverse = (List.ofFn fun k => A ⟨i, early_i⟩ k * B k ⟨j, early_j⟩).take k
      case first => rfl
      case step =>
        walk
        refine List.collected_next _ _ _ _ invariant_k
          ((List.getElem?_ofFn_of_lt _ k early_k).trans (congrArg some ?_))
        ring
      case after =>
        walk
        have entry : (A * B) ⟨i, early_i⟩ ⟨j, early_j⟩ =
            (List.ofFn fun k => A ⟨i, early_i⟩ k * B k ⟨j, early_j⟩).sum := by
          rw [Matrix.mul_apply]
          exact List.sum_ofFn.symm
        rw [List.collected_all _ _ 2 (by simp) invariant_k, Bool.and_eq_true, invariant_j,
          decide_eq_true_iff, ← entry]
        exact (Fin.forall_val_lt_succ _ j early_j).symm
    case after =>
      walk
      rw [Bool.and_eq_true, invariant_i, invariant_j, Fin.forall_val_lt_succ _ i early_i]
      exact and_congr Iff.rfl ⟨fun h => funext fun q => h q q.isLt, fun h q _ => congrFun h q⟩
  case after =>
    walk
    rw [Bool.eq_iff_iff, invariant_i, decide_eq_true_iff]
    exact ⟨fun h => Matrix.ext fun p q => congrFun (h p p.isLt) q, fun h p _ => by rw [h]⟩

variable (G) in
/-- Three matrices on whose rows the relation returns false: the product of the first two is not
the third. -/
theorem sound_far (a b c : List (List F)) (A B C : Matrix (Fin 2) (Fin 2) F)
    (ha : a = rows A) (hb : b = rows B) (hc : c = rows C)
    (rejected : functionResult (t := .bool)
      (fnMeaning (model F G) installed soundMember (.cons a (.cons b (.cons c .nil)))) = some false) :
    A * B ≠ C := by
  rw [sound_relation G a b c A B C ha hb hc] at rejected
  simpa using rejected

end

/-! ## The verifier within the caps -/

section
variable {F G : Type} [Field F] [DecidableEq F] [AddCommGroup G] [Module F G] [DecidableEq G]

variable (G) in
/-- What the verifier holds when the run starts: the three matrices. -/
def inputs (a b c : List (List F)) : HList (RV (model F G) verifierRole) rootHeader.ins :=
  .cons a (.cons b (.cons c .nil))

/-- A draw of a vector at an occurrence: the verifier's coin, which the prover hears. -/
def coinAt (at_ : Occurrence) : InputPort V :=
  .own (.coin (.uniform (.seq (.nominal (.field .bls12381Fr)) (some 2)))) [proverRole] at_
    (.seq scalarTy (some 2))

/-- The draw of the vector in a run that starts at `path`. -/
abbrev coin (path : List Frame) : InputPort V := coinAt ⟨path, site_r⟩

variable (G) in
/-- The verifier's process in a run of the installed program. -/
abbrev process (path : List Frame) (a b c : List (List F)) :=
  roleMeaning (model F G) installed rootMember verifierRole path (inputs G a b c)

/-- On matrices whose product is the third, every permitted vector leads the verifier to return,
and none to stop: the bound on the returns of the verifier is not a bound on a verifier that
cannot return. -/
theorem returns_on_product (path : List Frame) (a b c : List (List F))
    (A B C : Matrix (Fin 2) (Fin 2) F) (ha : a = rows A) (hb : b = rows B) (hc : c = rows C)
    (same : A * B = C) :
    (process G path a b c).interpret (.every (Permitted (model F G))) (fun _ => True)
      (fun _ => False) := by
  walk
  intro r allowedR
  have length : (r : List F).length = 2 := allowedR.1.2 2 rfl
  obtain ⟨w, hw⟩ := List.exists_ofFn_of_length (r : List F) 2 length
  walk
  walk_law apply_law G b r B w hb hw
  walk_law apply_law G a _ A (B.mulVec w) ha rfl
  walk_law apply_law G c r C w hc hw
  walk as failed
  have passes : A.mulVec (B.mulVec w) = C.mulVec w := by
    subst same
    exact Matrix.mulVec_mulVec _ _ _
  simp [passes] at failed

/-- What every judgment of the verifier that lets no run return pays for: a fee at the coin, for
every vector on which the check passes. -/
theorem walked_excludes (allowed : ∀ op, (RSig (model F G)).Reply op → Prop)
    (pays : (op : ROp (model F G)) → ℚ≥0 → ((RSig (model F G)).Reply op → Prop) → Prop)
    (path : List Frame) (a b c : List (List F)) (A B C : Matrix (Fin 2) (Fin 2) F)
    (ha : a = rows A) (hb : b = rows B) (hc : c = rows C) (within : ℚ≥0)
    (judged : (process G path a b c).interpret (.charged allowed pays) (fun _ _ => False)
      (fun _ _ => True) within) :
    ∃ fee excluded, fee ≤ within ∧ pays ((coin path).operation (model F G)) fee excluded ∧
      ∀ (r : List F) (w : Fin 2 → F), r = List.ofFn w →
        allowed ((coin path).operation (model F G)) r →
        A.mulVec (B.mulVec w) = C.mulVec w → excluded r := by
  walk at judged
  obtain ⟨fee, excluded, least, paid, rest⟩ := judged
  refine ⟨fee, excluded, least, paid, fun r w hw allowedR passes => ?_⟩
  by_contra kept
  have after := rest r allowedR kept
  clear rest
  walk at after
  walk_law apply_law G b r B w hb hw at after
  walk_law apply_law G a _ A (B.mulVec w) ha rfl at after
  walk_law apply_law G c r C w hc hw at after
  walk as failed at after
  simp [passes] at failed

end

section
variable {F : Type} [Fintype F]

/-- The cap of the draw of the vector in a table of caps: what the root's use allows the draw of
the source's `r`. -/
abbrev drawCap (caps : CapTable) : ℚ≥0 := caps.capFrom caps.root [] site_r

/-- The cap of the draw is within the budget of the goal's table. -/
theorem sound_within : drawCap soundCaps ≤ soundCaps.budget := by decide +kernel

/-- In a field with at least as many elements as the scalar field of the source, what a uniform
scalar pays for is within the cap that the source writes with that order. The kernel reads the
cap from the table. -/
theorem large_covers (large : Zkc.Vocabulary.Field.bls12381Fr.order ≤ Fintype.card F) :
    (1 : ℝ≥0∞) / (Fintype.card F : ℝ≥0∞) ≤ toProbability (drawCap soundCaps) := by
  have exact : drawCap soundCaps =
      ((1 : ℕ) : ℚ≥0) / (Zkc.Vocabulary.Field.bls12381Fr.order : ℕ) := by decide +kernel
  rw [exact, toProbability_natCast_div _ _ (by decide), Nat.cast_one]
  exact ENNReal.div_le_div_left (by exact_mod_cast large) _

end

section
variable {F G : Type} [Field F] [Fintype F] [DecidableEq F] [SampleableType F] [AddCommGroup G]
  [Module F G] [DecidableEq G]

variable (F G) in
/-- The samplers of the statement: at each coin, the sampler of its law in the model. -/
abbrev samplers : Samplers (RSig (model F G)) := lawSamplers (model F G) (ArithmeticModel.draws F G)

variable (F G) in
/-- The fees of a table of caps in a run of the root. -/
abbrev fees (caps : CapTable) (path : List Frame) :=
  paysWithin (samplers F G) (caps.allowance (model F G) path)

/-- The verifier is judged never to return on three matrices whose product differs, within the
budget of a table of caps whose cap of the root's draw is at least `1 / |F|`: the fee of the
draw pays for the vectors on which the check passes, which are zeros of a row of `A * B - C`
that is not zero. The three calls of `apply` are taken by its law. -/
theorem walked_within (path : List Frame) (a b c : List (List F))
    (A B C : Matrix (Fin 2) (Fin 2) F) (ha : a = rows A) (hb : b = rows B) (hc : c = rows C)
    (caps : CapTable) (differ : A * B ≠ C)
    (within : drawCap caps ≤ caps.budget)
    (covers : (1 : ℝ≥0∞) / (Fintype.card F : ℝ≥0∞) ≤ toProbability (drawCap caps)) :
    (process G path a b c).interpret
      (.charged (Permitted (model F G)) (fees F G caps path))
      (fun _ _ => False) (fun _ _ => True) caps.budget := by
  walk_pay (drawCap caps) excluding
    (fun r : List F => ∃ w : Fin 2 → F, r = List.ofFn w ∧ A.mulVec (B.mulVec w) = C.mulVec w)
    as r kept
  case weight =>
    obtain ⟨i, j, nonzero⟩ : ∃ i j, (A * B - C) i j ≠ 0 := by
      by_contra none
      refine differ (sub_eq_zero.mp (Matrix.ext fun i j => ?_))
      by_contra entry
      exact none ⟨i, j, entry⟩
    refine (prEvent_drawVector_le_of_linear_form _ (fun k => (A * B - C) i k) j nonzero ?_).trans covers
    rintro w ⟨w', same, passes⟩
    obtain rfl : w = w' := List.ofFn_injective same
    have row := congrFun passes i
    rw [Matrix.mulVec_mulVec] at row
    have zero : ((A * B - C).mulVec w) i = 0 := by
      rw [Matrix.sub_mulVec, Pi.sub_apply, row, sub_self]
    exact zero
  have length : (r : List F).length = 2 := permitted_r.1.2 2 rfl
  obtain ⟨w, hw⟩ := List.exists_ofFn_of_length (r : List F) 2 length
  walk
  walk_law apply_law G b r B w hb hw
  walk_law apply_law G a _ A (B.mulVec w) ha rfl
  walk_law apply_law G c r C w hc hw
  walk as passed
  exact kept ⟨w, hw, List.ofFn_injective (of_decide_eq_true passed)⟩

omit [Fintype F] in
/-- On every three matrices, the zero vector is a reply that the service of the laws can give
and on which the verifier returns. -/
theorem returns_possible (path : List Frame) (a b c : List (List F))
    (A B C : Matrix (Fin 2) (Fin 2) F) (ha : a = rows A) (hb : b = rows B) (hc : c = rows C) :
    (process G path a b c).interpret
      (.possible fun op v => (some v, ()) ∈ support
        (serveLaws (model F G) (ArithmeticModel.draws F G) op ()))
      (fun _ => True) (fun _ => False) := by
  walk
  refine ⟨List.ofFn (fun _ : Fin 2 => (0 : F)), ?_, ?_⟩
  · show (some _, ()) ∈ support ((fun answer => (some answer, ())) <$> drawVector F 2)
    simp only [drawVector, support_map, Set.mem_image, Prod.mk.injEq, and_true]
    exact ⟨_, ⟨fun _ => 0, by simp, rfl⟩, rfl⟩
  walk
  walk_law apply_law G b _ B (fun _ => 0) hb rfl
  walk_law apply_law G a _ A (B.mulVec (fun _ => 0)) ha rfl
  walk_law apply_law G c _ C (fun _ => 0) hc rfl
  walk as failed
  have passes : A.mulVec (B.mulVec (fun _ : Fin 2 => (0 : F))) = C.mulVec (fun _ => 0) := by
    have zero : (fun _ : Fin 2 => (0 : F)) = 0 := rfl
    rw [zero, Matrix.mulVec_zero, Matrix.mulVec_zero, Matrix.mulVec_zero]
  simp [passes] at failed

end

/-! ## The goal -/

/-- The judgment of `sound`: the validity of each matrix gives its rows, the relation of the
goal says that the product differs, and the field of the model has at least the order that the
charge is written with. -/
theorem sound_judged : soundJudged := by
  claim_intro
  obtain ⟨A, ha⟩ := rows_of_valid G input_a valid_input_a
  obtain ⟨B, hb⟩ := rows_of_valid G input_b valid_input_b
  obtain ⟨C, hc⟩ := rows_of_valid G input_c valid_input_c
  exact walked_within (F := F) (G := G) path input_a input_b input_c A B C ha hb hc soundCaps
    (sound_far (F := F) G input_a input_b input_c A B C ha hb hc rejected) sound_within
    (large_covers large)


/-! ## The hypotheses are met -/

namespace Witness
open Zkc.Formal.Written.ScalarField

/-- The scalar field of the source: the integers modulo its order, a prime. -/
abbrev Scalars : Type := ScalarField

/-- The scalar field has the order that the charge is written with. -/
theorem large : Zkc.Vocabulary.Field.bls12381Fr.order ≤ Fintype.card Scalars :=
  ScalarField.card.ge

/-- A matrix with one entry that is not zero. -/
def corner : Matrix (Fin 2) (Fin 2) Scalars := fun i j => if i = 0 ∧ j = 0 then 1 else 0

/-- The product of the zero matrices is not the matrix with a corner. -/
theorem zero_mul_ne_corner : (0 : Matrix (Fin 2) (Fin 2) Scalars) * 0 ≠ corner := by
  intro same
  have entry := congrFun (congrFun same 0) 0
  rw [mul_zero] at entry
  exact zero_ne_one entry

/-- The rows of a matrix are a valid value of the type of a matrix. -/
theorem rows_valid (M : Matrix (Fin 2) (Fin 2) Scalars) :
    (model Scalars Scalars).Valid matrixTy (rows M) := by
  refine ⟨fun v mem => ⟨fun _ _ => trivial, fun n size => ?_⟩, fun n size => ?_⟩
  · cases size
    obtain ⟨i, rfl⟩ := (List.mem_ofFn' _ v).mp mem
    exact List.length_ofFn
  · cases size
    exact List.length_ofFn

/-- The zero matrix. -/
abbrev none : Matrix (Fin 2) (Fin 2) Scalars := 0

/-- The relation returns false on the zero matrices and the matrix with a corner. -/
theorem rejected :
    functionResult (t := .bool) (fnMeaning (model Scalars Scalars) installed soundMember
      (.cons (rows none) (.cons (rows none) (.cons (rows corner) .nil)))) = some false :=
  (sound_relation Scalars (rows none) (rows none) (rows corner) none none corner rfl rfl rfl).trans
    (congrArg some (decide_eq_false zero_mul_ne_corner))

/-- **The hypotheses of the claim are met.** Over the scalar field of the source, on the zero
matrices and a matrix with a corner, the relation returns false, the matrices are valid, the
field has the order of the charge, and the service of the laws draws by the samplers and
answers what is permitted: there the verifier returns with probability at most the total of
the goal's table of caps. -/
theorem sound_at_corner (path : List Frame) :
    Pr{let out ← (simulateQ (handlerOf (serveLaws (model Scalars Scalars)
          (ArithmeticModel.draws Scalars Scalars))) (embed
        (roleMeaning (model Scalars Scalars) installed rootMember verifierRole path
          (.cons (rows none) (.cons (rows none) (.cons (rows corner) .nil)))))).run.run ()}[
      ∃ results, out.1 = some (.inl results)] ≤ soundCaps.total :=
  (sound_claim_of_judged sound_judged (F := Scalars) (G := Scalars) path large (rows none) (rows_valid none)
    (rows none) (rows_valid none) (rows corner) (rows_valid corner) rejected).returns
    (serveLaws (model Scalars Scalars) (ArithmeticModel.draws Scalars Scalars))
    ⟨serveLaws_follows _ _,
      serveLaws_permitted _ _ (ArithmeticModel.draws_permitted Scalars Scalars)⟩ ()

/-- **The event of the claim happens at the witness.** Against the service of the laws, the
simulation of the verifier returns with a probability that is not zero: the zero vector is
drawn, and the check passes on it. -/
theorem returns_at_corner (path : List Frame) :
    0 < Pr{let out ← (simulateQ (handlerOf (serveLaws (model Scalars Scalars)
          (ArithmeticModel.draws Scalars Scalars))) (embed
        (roleMeaning (model Scalars Scalars) installed rootMember verifierRole path
          (.cons (rows none) (.cons (rows none) (.cons (rows corner) .nil)))))).run.run ()}[
      ∃ results, out.1 = some (.inl results)] := by
  rw [prEvent_simulation_returns]
  exact returns_pos_of_possible _ _ (returns_possible (G := Scalars) path (rows none) (rows none)
    (rows corner) none none corner rfl rfl rfl)

end Witness

open Zkc.Formal.Written.ScalarField in
/-- **The hypotheses of the claim are met** over the scalar field of the source: the zero
matrices and the matrix with a corner are valid, the relation returns false on them, the field
has the order of the charge, and the service of the laws draws within the samplers and answers
what is permitted. -/
theorem sound_witnessed : soundWitnessed :=
  sound_witnessed_of (F := Witness.Scalars) (G := Witness.Scalars) Witness.large
    (rows Witness.none) (Witness.rows_valid Witness.none) (rows Witness.none)
    (Witness.rows_valid Witness.none) (rows Witness.corner) (Witness.rows_valid Witness.corner)
    Witness.rejected

end
