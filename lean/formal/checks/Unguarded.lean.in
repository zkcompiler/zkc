namespace Unguarded
open Zkc.Core ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess OracleComp ProbComp
open StandardInterpretation (F G D large)
open scoped ScalarField ENNReal NNRat
noncomputable section
private theorem possible_call {M : Model V} (laws : LawDraws M) (op : ROp M)
    {A H : Type} (next : (RSig M).Reply op → Process (RSig M) H A) (done : A → Prop)
    (halt : H → Prop) (has : (lawSamplers M laws op).isSome = true)
    (every : ∀ v, (next v).interpret
      (.possible fun step reply => (some reply, ()) ∈ support (serveLaws M laws step ())) done halt) :
    (Process.call op next).interpret
      (.possible fun step reply => (some reply, ()) ∈ support (serveLaws M laws step ())) done halt := by
  obtain ⟨dist, eq⟩ := Option.isSome_iff_exists.mp has
  obtain ⟨v, hv⟩ := OracleComp.support_nonempty dist
  refine ⟨v, ?_, every v⟩
  change (some v, ()) ∈ support (serveLaws M laws op ())
  rw [serveLaws_at M laws eq, support_map]
  exact ⟨v, hv, rfl⟩
end
end Unguarded
