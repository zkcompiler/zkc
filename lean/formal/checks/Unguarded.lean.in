namespace Unguarded
open Zkc.Core ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess OracleComp ProbComp
open StandardInterpretation (F G D large)
open scoped ScalarField ENNReal NNRat
noncomputable section
private theorem possible_call {M : Model V} (laws : LawDraws M) (op : ROp M)
    {A H : Type} (next : (RSig M).Reply op → Process (RSig M) H A) (done : A → Prop)
    (halt : H → Prop) (has : (lawSamplers M laws op).isSome = true)
    (every : ∀ v, (next v).interpret
      (.possible fun step reply => (some reply, ()) ∈ support (serveLaws M laws step ())) done halt) :
    (Process.call op next).interpret
      (.possible fun step reply => (some reply, ()) ∈ support (serveLaws M laws step ())) done halt := by
  obtain ⟨dist, eq⟩ := Option.isSome_iff_exists.mp has
  obtain ⟨v, hv⟩ := OracleComp.support_nonempty dist
  refine ⟨v, ?_, every v⟩
  change (some v, ()) ∈ support (serveLaws M laws op ())
  rw [serveLaws_at M laws eq, support_map]
  exact ⟨v, hv, rfl⟩

theorem false_at_source : ¬ soundClaim := by
  intro claim
  have rejected (w : F) : functionResult (t := .bool) (fnMeaning StandardInterpretation.model installed soundMember (.cons false (.cons w .nil))) = some false := by
    apply functionResult_of_judged
    walk
  let s := serveLaws StandardInterpretation.model StandardInterpretation.draws
  have bound := claim [] false trivial (fun w _ => rejected w) Unit s
    ⟨serveLaws_follows _ _, serveLaws_permitted _ _ (ArithmeticModel.draws_permitted F G)⟩ ()
  simp only [and_true] at bound
  rw [prEvent_simulation_returns] at bound
  have z : soundCaps.total = 0 := by rw [Zkc.Subject.CapTable.total, sound_budget]; simp [toProbability]
  rw [z] at bound
  obtain h := not_lt_of_ge bound
  apply h
  apply returns_pos_of_possible
  walk
  apply possible_call StandardInterpretation.draws
  · rfl
  · intro v
    walk

#print axioms false_at_source
end
end Unguarded
