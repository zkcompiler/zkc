namespace PointSum
open Zkc.Core ZkcFormal ZkcFormal.Written ZkcFormal.ProbabilisticProcess OracleComp ProbComp
open StandardInterpretation (F G D large)
open scoped ScalarField ENNReal NNRat
noncomputable section
theorem proved : soundJudged := by
  claim_intro
  cases hb : input_b with
  | false => subst input_b; walk
  | true =>
    have yes : functionResult (t := .bool) (fnMeaning StandardInterpretation.model installed soundMember (.cons true (.cons (1 : F) (.cons (0 : F) .nil)))) = some true := by
      apply functionResult_of_judged
      walk
      decide
    have no := rejected (1 : F) (0 : F) trivial trivial
    rw [hb, yes] at no
    contradiction
theorem checked : soundClaim := sound_claim_of_judged proved

theorem hypotheses_met : soundWitnessed := by
  apply sound_witnessed_of false trivial
  repeat intro
  apply functionResult_of_judged
  walk
#print axioms checked
#print axioms hypotheses_met
end
end PointSum
