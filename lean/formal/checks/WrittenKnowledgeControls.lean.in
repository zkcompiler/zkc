@[expose] public section

open Zkc.Core Zkc.Formal.Written Zkc.Formal.Written.FiniteModel

set_option maxRecDepth 4000
set_option maxHeartbeats 1800000

namespace WrittenControls

def statement : model.Val pointTy × model.Val pointTy := (true,true)
def commitment : model.Val pointTy := false
def left : Branch (model.Val scalarTy) := ⟨false,false⟩
def right : Branch (model.Val scalarTy) := ⟨true,true⟩

theorem left_returns : Baseline.accepts model statement [] commitment left :=
  (Baseline.verifier_equation model ops rows statement [] commitment left).2 (by decide)
theorem right_returns : Baseline.accepts model statement [] commitment right :=
  (Baseline.verifier_equation model ops rows statement [] commitment right).2 (by decide)

theorem permitted_fork (b : Branch (model.Val scalarTy)) :
    ∀ e ∈ (Baseline.observed model [] commitment b).map Input.entry, Permitted model e.1 e.2 := by
  apply Zkc.Formal.Written.permitted_fork
  · trivial
  · exact ⟨trivial, ⟨[], scalarTy⟩, rfl, rfl, rfl, trivial⟩
  · trivial

example : ∃ v, (roleMeaning model Baseline.installed (Member.head : Member [Baseline.header] Baseline.header)
    1 [] (.cons true (.cons true (.cons () .nil)))).CanReturn (Permitted model) v :=
  left_returns.canReturn (Permitted model) (permitted_fork left)

example : ∃ v, (roleMeaning model Baseline.installed (Member.head : Member [Baseline.header] Baseline.header)
    1 [] (.cons true (.cons true (.cons () .nil)))).CanReturn (Permitted model) v :=
  right_returns.canReturn (Permitted model) (permitted_fork right)

example : Baseline.extractor ops statement commitment left right = some true ∧
    Baseline.relation ops statement true = some true ∧ left.challenge ≠ right.challenge := by decide

example : Baseline.extractor ops statement commitment left left = none := by decide

example : Baseline.obligation model ops [] := Baseline.certified model ops rows laws []

example {a : Admitted Renamed.V} (admitted : admit Renamed.stored ⟨[],[],[],[],[]⟩ = .ok a) :
    Renamed.admittedObligation model ops a [] :=
  Renamed.of_obligation model ops admitted [] (Baseline.certified model ops rows laws [])

example : Renamed.stored = Baseline.stored := rfl
example : Renamed.obligation model ops [] = Baseline.obligation model ops [] := rfl
example : Simulator.obligation model ops [] = Baseline.obligation model ops [] := rfl
-- The source clause swaps both arguments passed to the relation and extractor.
example : Swapped.relation ops (true,false) false = some false := by decide
example : Swapped.extractor ops (true,false) commitment left right = none := by decide
example : Swapped.extractor ops (false,true) commitment left right = some true := by decide
example : Zero.stored = Baseline.stored := rfl
example : OtherRelation.stored = Baseline.stored := rfl
example : OtherVerifier.stored ≠ Baseline.stored := by decide +kernel

/-- The same pair returns in both source variants. One extractor returns zero and
the other relation rejects the witness that the original extractor returns. -/
theorem wrong_extractor : ¬ Zero.obligation model ops [] := by
  intro claim
  obtain ⟨w, returned, holds⟩ := claim statement commitment left right left_returns right_returns (by decide)
  have eq : (some false : Option Bool) = some w := returned
  cases Option.some.inj eq
  exact (by decide : Zero.relation ops statement false ≠ some true) holds

theorem wrong_relation : ¬ OtherRelation.obligation model ops [] := by
  intro claim
  obtain ⟨w, returned, holds⟩ := claim statement commitment left right left_returns right_returns (by decide)
  have eq : (some true : Option Bool) = some w := returned
  cases Option.some.inj eq
  exact (by decide : OtherRelation.relation ops statement true ≠ some true) holds

/-- A verifier accepting an arbitrary response admits a bad fork even with the original extractor. -/
theorem wrong_verifier : ¬ OtherVerifier.obligation model ops [] := by
  intro claim
  let changed : Branch (model.Val scalarTy) := ⟨true,false⟩
  have one := (OtherVerifier.replay_returns model statement [] commitment left).2 (by decide +kernel)
  have two := (OtherVerifier.replay_returns model statement [] commitment changed).2 (by decide +kernel)
  obtain ⟨w, returned, holds⟩ := claim statement commitment left changed one two (by decide)
  have eq : (some false : Option Bool) = some w := returned
  cases Option.some.inj eq
  exact (by decide : OtherVerifier.relation ops statement false ≠ some true) holds

abbrev good : SameLog.Statement Bool := (false, true, false, true)
abbrev bad : SameLog.Statement Bool := (true, true, true, false)
abbrev pairCommitment : SameLog.Commitment Bool := (false, false, ())

-- A zero first base leaves the second equation responsible for the witness.
example : SameLog.accepts model good [] pairCommitment left :=
  (SameLog.verifier_equation model ops rows good [] pairCommitment left).2 (by decide)
example : SameLog.accepts model good [] pairCommitment right :=
  (SameLog.verifier_equation model ops rows good [] pairCommitment right).2 (by decide)
example : SameLog.extractor ops good pairCommitment left right = some true ∧
    SameLog.relation ops good true = some true := by decide

-- The original verifier rejects the right branch. The mutant accepts both branches.
example : ¬ SameLog.accepts model bad [] pairCommitment right := by
  intro h
  exact (by unfold SameLog.verifierConditions; decide +kernel : ¬ SameLog.verifierConditions model bad pairCommitment right)
    ((SameLog.model_equations model bad [] pairCommitment right).mp h)

private theorem missing_left : MissingGuard.accepts model bad [] pairCommitment left :=
  (MissingGuard.replay_returns model ..).2 (by decide +kernel)
private theorem missing_right : MissingGuard.accepts model bad [] pairCommitment right :=
  (MissingGuard.replay_returns model ..).2 (by decide +kernel)

theorem permitted_counterexample : ∀ leaf ∈ [left, right],
    MissingGuard.accepts model bad [] pairCommitment leaf ∧
    ∀ e ∈ (MissingGuard.observed model [] pairCommitment leaf).map Input.entry, Permitted model e.1 e.2 := by
  intro leaf mem
  constructor
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at mem
    rcases mem with rfl | rfl
    · exact missing_left
    · exact missing_right
  · apply Zkc.Formal.Written.permitted_fork
    · exact ⟨trivial, trivial, trivial⟩
    · exact ⟨trivial, ⟨[], scalarTy⟩, rfl, rfl, rfl, trivial⟩
    · trivial

theorem missing_guard : ¬ MissingGuard.obligation model ops [] := by
  intro claim
  obtain ⟨w, _, valid⟩ := claim bad pairCommitment left right missing_left missing_right (by decide)
  exact (by decide : ∀ x : Bool, MissingGuard.relation ops bad x ≠ some true) w valid

theorem missing_guard_admitted {adm : Admitted MissingGuard.V}
    (h : admit MissingGuard.stored ⟨[],[],[],[],[]⟩ = .ok adm) :
    ¬ MissingGuard.admittedObligation model ops adm [] := by
  obtain ⟨program, annotations, association, assured⟩ := adm
  have same := MissingGuard.readback h
  change program = MissingGuard.installed at same
  subst program
  rintro ⟨root, property⟩
  cases root with
  | head => exact missing_guard property
  | tail rest => cases rest

example : Baseline.coreObligation model [] := Baseline.certified_core model ops rows functionRows laws []
example : SameLog.coreObligation model [] := SameLog.certified_core model ops rows functionRows laws []
example : Swapped.coreExtractor model (true,false) commitment left right = none := by decide +kernel
example : Swapped.coreRelation model (true,false) false = some false := by rfl
example : Baseline.coreExtractor model statement commitment left left = none := by decide +kernel
#check NativeOnly.of_core_obligation

theorem compiled_wrong_extractor : ¬ Zero.coreObligation model [] := by
  intro claim
  obtain ⟨w, returned, holds⟩ := claim statement commitment left right left_returns right_returns (by decide)
  have result : Zero.coreExtractor model statement commitment left right = some false := by rfl
  cases Option.some.inj (result.symm.trans returned)
  exact (by decide +kernel : Zero.coreRelation model statement false ≠ some true) holds

theorem compiled_wrong_relation : ¬ OtherRelation.coreObligation model [] := by
  intro claim
  obtain ⟨w, returned, holds⟩ := claim statement commitment left right left_returns right_returns (by decide)
  have result : OtherRelation.coreExtractor model statement commitment left right = some true :=
    (Baseline.extractor_agrees model ops rows functionRows statement commitment left right).trans rfl
  cases Option.some.inj (result.symm.trans returned)
  exact (by decide +kernel : OtherRelation.coreRelation model statement true ≠ some true) holds

theorem missing_compiled_guard {p r e : Admitted MissingGuard.V}
    (hp : admit MissingGuard.stored ⟨[],[],[],[],[]⟩ = .ok p)
    (hr : admit MissingGuard.storedRelation ⟨[],[],[],[],[]⟩ = .ok r)
    (he : admit MissingGuard.storedExtractor ⟨[],[],[],[],[]⟩ = .ok e) :
    ¬ MissingGuard.compiledObligation model p r e [] := by
  unfold MissingGuard.compiledObligation
  rw [MissingGuard.readback hp, MissingGuard.RelationReadback r hr, MissingGuard.ExtractorReadback e he]
  rintro ⟨root, rel, ext, claim⟩
  cases root <;> try solve | cases ‹Member [] _›
  cases rel <;> try solve | cases ‹Member [] _›
  cases ext <;> try solve | cases ‹Member [] _›
  obtain ⟨w, _, holds⟩ := claim bad pairCommitment left right missing_left missing_right (by decide)
  cases w <;> exact Bool.noConfusion (Option.some.inj holds)

-- Target generation and concrete replay also work for an extra field equality,
-- outside the verifier rows currently interpreted by the algebraic proof strategy.
example : ScalarGuard.accepts model good [] pairCommitment left ↔
    ScalarGuard.replayCheck model good [] pairCommitment left = some () :=
  ScalarGuard.replay_returns model ..

#print axioms Baseline.certified_core_admitted
#print axioms SameLog.certified_core_admitted
#print axioms Reordered.certified_core_admitted
#print axioms ScalarGuard.certified_core_admitted
#print axioms compiled_wrong_extractor
#print axioms compiled_wrong_relation
#print axioms missing_compiled_guard
#print axioms Baseline.certified_admitted
#print axioms SameLog.certified_admitted
#print axioms Reordered.certified_admitted
#print axioms ScalarGuard.certified_admitted
#print axioms missing_guard_admitted
#print axioms permitted_counterexample
#print axioms wrong_verifier
#print axioms left_returns
#print axioms wrong_extractor
#print axioms wrong_relation

end WrittenControls
