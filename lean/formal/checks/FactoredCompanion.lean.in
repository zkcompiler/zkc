module

public import Baseline
public import Factored

@[expose] public section
open Zkc.Core Zkc.Formal.Written
set_option maxRecDepth 4000
set_option maxHeartbeats 1800000

namespace Factored
variable (M : Model V) (ops : Operations (M.Val scalarTy) (M.Val pointTy))
  [DecidableEq (M.Val scalarTy)] [DecidableEq (M.Val pointTy)]

omit [DecidableEq (M.Val pointTy)] in
/-- The wrapper and its callee return the primitive subtraction in their actual call table. -/
theorem challenge_gap (field : FunctionRows M ops) (x y : M.Val scalarTy) :
    localOp M (Defs.fnTable M ExtractorDependencies.defs) (.call .head) (.cons x (.cons y .nil)) =
      .done (.cons (ops.sub x y) .nil) := by
  change ((localOp M (Defs.fnTable M .nil) (.row (fr .sub) _ rfl)
    (.cons x (.cons y .nil))).bind _).bind _ = _
  rw [function_row (field.sub x y)]
  rfl

theorem extractor_agrees (_rows : GroupRows M ops) (field : FunctionRows M ops)
    (s : Statement (M.Val pointTy)) (a : M.Val historyTy) (l r : Branch (M.Val scalarTy)) :
    coreExtractor M s a l r = Baseline.extractor ops s a l r := by
  change functionResult (ExtractorBody.denote (localSem M _ (Defs.fnTable M ExtractorDependencies.defs))
    [] (Env.empty.extend ExtractorNames (extractorArguments M s a l r))) = _
  repeat' first
    | local_instruction _rows field
    | (apply function_op; compact_operands; exact challenge_gap M ops field _ _)
  check_function Baseline.extractor with _rows field

theorem certified_source_admitted {p r e : Admitted V}
    (hp : admit stored ⟨[],[],[],[],[]⟩ = .ok p)
    (hr : admit storedRelation ⟨[],[],[],[],[]⟩ = .ok r)
    (he : admit storedExtractor ⟨[],[],[],[],[]⟩ = .ok e)
    (rows : GroupRows M ops) (field : FunctionRows M ops) (laws : ActionLaws ops)
    (path : List Frame) : sourceObligation M p r e path := by
  apply of_compiled_obligation
  apply of_core_obligation M hp hr he
  intro s a l r hl hr apart
  obtain ⟨w, ext, rel⟩ := Baseline.certified M ops rows laws path s a l r hl hr apart
  exact ⟨w, (extractor_agrees M ops rows field s a l r).trans ext,
    (Baseline.relation_agrees M ops rows field s w).trans rel⟩

end Factored
